/* ---- Visit Note Summary: Patient Summary / This Visit Summary tabs + AI "What's New" ----
   Read-only summary layer over data already captured elsewhere in the Visit Note.
   Adds no new data-entry workflow; recomputes fresh every time the Patient Summary
   tab is opened so it always reflects the live state of the note. */
const ALLERGY_PRISTINE_META={};
function snapshotAllergyPristine(){
  document.querySelectorAll('.allergy-entry').forEach(el=>{
    const nameEl=el.querySelector('.allergy-name');
    const metaEl=el.querySelector('.allergy-entry-meta');
    ALLERGY_PRISTINE_META[el.id]={
      name: nameEl?nameEl.textContent.trim():'',
      meta: metaEl?metaEl.textContent.trim():''
    };
  });
}
/* Did this section already have any answered content before this visit's edits? */
function sectionHadContent(key){
  const html=SECTION_PRISTINE_HTML[key];
  if(html===undefined) return true; // unknown snapshot -- never over-claim "new"
  const tmp=document.createElement('div');
  tmp.innerHTML=html;
  if(tmp.querySelector('.narrative, .chip-row .chip.pos, .chip-row .chip.neg, .cx-chip.on, .cx-check input:checked, .prob-row, .plan-item, .em-chip.selected, .code-chip')) return true;
  const filled=[...tmp.querySelectorAll('input[type="text"],input[type="number"],input[type="date"],textarea')].some(el=>(el.value||el.textContent||'').trim());
  return filled;
}
function computeWhatsNew(){
  const items=[];
  document.querySelectorAll('.allergy-entry').forEach(el=>{
    const nameEl=el.querySelector('.allergy-name');
    const metaEl=el.querySelector('.allergy-entry-meta');
    const name=nameEl?nameEl.textContent.trim():'';
    const meta=metaEl?metaEl.textContent.trim():'';
    const before=ALLERGY_PRISTINE_META[el.id];
    if(!before){
      items.push({tag:'new', body:'New allergy documented: '+name+'. Status: '+(meta.split('·')[0]||'').trim()});
    } else if(before.name!==name || before.meta!==meta){
      items.push({tag:'updated', body:'Updated allergy: '+name+'. Now: '+meta});
    }
  });
  FORM_WINDOW_KEYS.forEach(key=>{
    if(key==='allergy' || key==='addendum') return;
    const label=SECTION_TITLES[key]||key;
    // Carried-forward content is reported as such, never as "New"/"Updated" --
    // and is reported instead of (not in addition to) the generic fact diff below.
    if(carriedForwardLog[key] && carriedForwardLog[key].length){
      carriedForwardLog[key].forEach(entry=>{
        items.push({tag:'carried', body:label+' — carried forward from previous visit ('+entry.date+'): '+ssumClamp(entry.text,120)});
      });
      return;
    }
    if(!unsavedMain[key]) return;
    let facts=[];
    try{ facts=extractSectionFacts(key); }catch(e){ facts=[]; }
    if(!facts.length) return;
    const isNew=!sectionHadContent(key);
    const preview=ssumClamp(facts.slice(0,2).join('; '), 130);
    items.push({tag: isNew?'new':'updated', body:(isNew?'New in ':'Updated: ')+label+' — '+preview});
  });
  return items;
}
function esc(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function renderWhatsNew(){
  const list=document.getElementById('ssumAiList');
  if(!list) return;
  const items=computeWhatsNew();
  if(!items.length){
    list.innerHTML='<div class="ssum-ai-empty">No new information has been added yet this visit. Documented findings will appear here as they are entered.</div>';
    return;
  }
  const tagLabel={new:'New', updated:'Updated', carried:'Carried Forward'};
  list.innerHTML=items.map(it=>
    '<div class="ssum-ai-item"><span class="ssum-ai-tag '+it.tag+'">'+(tagLabel[it.tag]||it.tag)+'</span><span class="ssum-ai-body">'+esc(it.body)+'</span></div>'
  ).join('');
}
function switchSsumTab(which){
  const btnP=document.getElementById('ssumTabBtn-patient'), btnV=document.getElementById('ssumTabBtn-visit');
  const panP=document.getElementById('ssumTabPatient'), panV=document.getElementById('ssumTabThisVisit');
  if(!btnP||!btnV||!panP||!panV) return;
  const toPatient = which==='patient';
  btnP.classList.toggle('on', toPatient);
  btnV.classList.toggle('on', !toPatient);
  btnP.setAttribute('aria-selected', String(toPatient));
  btnV.setAttribute('aria-selected', String(!toPatient));
  btnP.tabIndex = toPatient?0:-1;
  btnV.tabIndex = toPatient?-1:0;
  panP.hidden=!toPatient;
  panV.hidden=toPatient;
  if(toPatient){ (btnP).focus({preventScroll:true}); renderWhatsNew(); } else { (btnV).focus({preventScroll:true}); }
}
function ssumTabKeydown(e){
  if(e.key!=='ArrowLeft' && e.key!=='ArrowRight') return;
  e.preventDefault();
  const goingPatient = e.target.id==='ssumTabBtn-visit';
  switchSsumTab(goingPatient?'patient':'visit');
}
