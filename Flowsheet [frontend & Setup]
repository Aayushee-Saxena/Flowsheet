.ai-box{border:1px solid var(--ai-line);background:var(--ai-soft);border-radius:var(--radius-m);padding:10px 12px;margin-top:10px;}
.ai-head{display:flex;align-items:center;gap:6px;font-size:13px;font-weight:700;color:var(--ai);}
.ai-body{font-size:13.5px;color:var(--ink);margin-top:5px;line-height:1.5;}
.ai-actions{display:flex;gap:8px;margin-top:9px;flex-wrap:wrap;}
.ai-draftbox{background:var(--card);border:1px solid var(--ai-line);border-radius:8px;padding:9px 10px;margin-top:6px;font-size:13.5px;line-height:1.55;}

.sec-tools{display:flex;gap:6px;margin-bottom:9px;flex-wrap:wrap;position:relative;}

.pe-row{display:flex;align-items:center;gap:12px;padding:8px 0;border-bottom:1px solid var(--line-soft);}
