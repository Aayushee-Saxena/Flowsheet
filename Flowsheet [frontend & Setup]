<script>
/* =====================================================================
   [v4] Sign Visit Note -> review reminder (informational, never blocks signing).
   Sign Visit Note opens the reminder; "Continue to Sign" runs the existing signNote() unchanged;
   Cancel / Close / Esc dismiss it; "Go to Section" closes it and uses the existing section navigation.
   VN_SIGN_REMINDERS is the list shown (example sections for now); an item marked "review" drops off
   once that section is marked as reviewed.
   ===================================================================== */
window.VN_SIGN_REMINDERS = [
  {key: 'vitals',    title: 'Vital Signs',         need: 'review'},
  {key: 'allergy',   title: 'Allergy',             need: 'review'},
  {key: 'medrec',    title: 'Current Medications', need: 'fill'},
  {key: 'apsection', title: 'Assessment & Plan',   need: 'review'}
];
(function(){
  var orig = null, lastFocus = null;
  function esc(s){ return String(s).replace(/[&<>"]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }
  function reviewed(k){ var p = document.getElementById(k + '-reviewed-pill'); return !!(p && p.style.display && p.style.display !== 'none'); }
  function items(){ return (window.VN_SIGN_REMINDERS || []).filter(function(it){ return document.getElementById('sec-' + it.key) && !(it.need === 'review' && reviewed(it.key)); }); }
  var TAG = {fill: '<span class="srm-tag fill"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>Needs to be filled</span>',
             review: '<span class="srm-tag review"><i class="fa-solid fa-user-check" aria-hidden="true"></i>Needs to be reviewed</span>'};
  function render(list){
    var nf = list.filter(function(i){ return i.need === 'fill'; }).length, nr = list.length - nf;
    document.getElementById('signRemLegend').innerHTML =
      (nf ? '<span>' + TAG.fill + ' &times; ' + nf + '</span>' : '') + (nr ? '<span>' + TAG.review + ' &times; ' + nr + '</span>' : '');
    document.getElementById('signRemList').innerHTML = list.map(function(it){
      return '<li class="srm-row"><span class="srm-name">' + esc(it.title) + '</span>' + TAG[it.need === 'fill' ? 'fill' : 'review'] +
             '<button type="button" class="btn btn-xs srm-go" data-srm-go="' + esc(it.key) + '" aria-label="Go to ' + esc(it.title) + '">Go to Section <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button></li>';
    }).join('');
  }
  function open(){
    var list = items();
    if(!list.length) return false;
    render(list);
    lastFocus = document.activeElement;
    document.getElementById('signRemScrim').hidden = false;
    setTimeout(function(){ var b = document.getElementById('signRemContinue'); if(b) b.focus(); }, 0);
    return true;
  }
  function close(){
    var s = document.getElementById('signRemScrim'); if(!s || s.hidden) return;
    s.hidden = true;
    if(lastFocus && lastFocus.focus && document.contains(lastFocus)) try{ lastFocus.focus({preventScroll: true}); }catch(e){}
  }
  window.vnSignRemClose = close;
  window.vnSignRemContinue = function(){ close(); if(orig) return orig.apply(window, arguments); };
  window.vnSignRemGo = function(k){
    close(); lastFocus = null;
    if(typeof closeAllFlyouts === 'function') try{ closeAllFlyouts(); }catch(e){}
    jump('sec-' + k);   /* existing navigation: switches tab if needed, shows that section, selects it in the left panel */
  };
  function init(){
    orig = window.signNote; if(typeof orig !== 'function') return;
    window.signNote = function(){ if(open()) return; return orig.apply(this, arguments); };   /* nothing left to remind -> existing flow */
    try{ signNote = window.signNote; }catch(e){}
    var s = document.getElementById('signRemScrim');
    s.addEventListener('click', function(e){
      var g = e.target.closest('[data-srm-go]'); if(g){ vnSignRemGo(g.getAttribute('data-srm-go')); return; }
      if(e.target === s) close();
    });
    document.addEventListener('keydown', function(e){ if(e.key === 'Escape' && !s.hidden){ e.preventDefault(); close(); } });
  }
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function(){ setTimeout(init, 150); }); else setTimeout(init, 150);
})();
</script>
