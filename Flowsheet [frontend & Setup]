<script>
/* ==== Patient Demographic bar: Hide / Show ==== */
(function(){
  var KEY = 'vn_pdb_collapsed';
  function set(collapsed, save){
    var bar = document.getElementById('patientbar'), b = document.getElementById('pdbToggle'); if(!bar || !b) return;
    bar.classList.toggle('pdb-collapsed', collapsed);
    var lbl = collapsed ? 'Show patient demographics' : 'Hide patient demographics';
    b.setAttribute('aria-expanded', collapsed ? 'false' : 'true'); b.setAttribute('aria-label', lbl); b.setAttribute('data-tt', lbl);
    var ic = b.querySelector('i, svg'); if(ic){ ic.classList.toggle('fa-chevron-up', !collapsed); ic.classList.toggle('fa-chevron-down', collapsed); }
    /* problems: full list in the tooltip when the compact row has to shorten it */
    var pz = bar.querySelector('.pdb-z-prob .pdb-zb');
    if(pz) pz.title = collapsed ? [].map.call(pz.querySelectorAll('li'), function(li){ return li.getAttribute('title') || li.textContent.trim(); }).join('\n') : '';
    var cp = document.getElementById('consentsPop'); if(collapsed && cp) cp.hidden = true;
    if(typeof hidePbiTooltip === 'function') hidePbiTooltip();
