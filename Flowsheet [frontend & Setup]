    ['markReviewed', 'markReviewedSilently', 'vnUnreview', 'doResetSection'].forEach(function(n){
      var f = window[n]; if(typeof f !== 'function') return;
      window[n] = function(k){ var r = f.apply(this, arguments); if(typeof k === 'string') paint(k); return r; };
    });
