        f('Date given', '<input type="date" data-apv="date" data-id="'+id+'" value="'+E(v.date||'')+'">')+f('Dose #', '<input type="number" min="1" data-apv="dose" data-id="'+id+'" value="'+E(v.dose||'')+'">')+
        f('Lot #', '<input type="text" data-apv="lot" data-id="'+id+'" value="'+E(v.lot||'')+'">')+'</div>';
    if(pf.t === 'au') body = '<div class="ap-fields">'+f('Payer', '<input type="text" data-apv="payer" data-id="'+id+'" value="'+E(v.payer||'Anthem BC PPO')+'">')+
        f('Authorization #', '<input type="text" data-apv="num" data-id="'+id+'" value="'+E(v.num||'')+'">')+
        f('Status', '<select data-apv="status" data-id="'+id+'">'+['Pending','Approved','Denied'].map(function(o){ return '<option'+(o===v.status?' selected':'')+'>'+o+'</option>'; }).join('')+'</select>')+
        f('Visits / units', '<input type="number" min="0" data-apv="units" data-id="'+id+'" value="'+E(v.units||'')+'">')+
        f('Valid through', '<input type="date" data-apv="thru" data-id="'+id+'" value="'+E(v.thru||'')+'">')+'</div>';
    if(pf.t === 'ft') body = '<div class="ap-fields">'+f('Free text plan', '<textarea data-apv="text" data-id="'+id+'">'+E(v.text||'')+'</textarea>', true)+'</div>';
    var t = ptype(pf.t);
    return '<div class="ap-pform"><div class="ap-plan-hd">'+ico(t[2])+(pf.edit ? 'Edit ' : 'Add ')+t[1]+' for '+E(dxLabel(d))+'</div>'+body+
      '<div class="ap-actions">'+btn('pf-save', id, pf.edit ? 'Save changes' : 'Add to plan', 'btn-primary')+btn('pf-cancel', id, 'Cancel', 'btn-ghost')+'</div></div>';
  }
  function dxCard(d, i){
    var items = planItems(d), open = !!AP.openPlan[d.id];
    var inPl = AP.prob.some(function(p){ return p.fromDx === d.id && !p.removed; });
    var plan = '';
