/* ---- Complaints: accordion, chip-toggle, checklist, yes/no controls ---- */
.cx-acc{border:1px solid var(--line);border-radius:var(--radius-m);margin-top:10px;overflow:hidden;}
.cx-acc summary{list-style:none;cursor:pointer;display:flex;align-items:center;gap:8px;padding:10px 12px;background:var(--paper);font-size:13.6px;font-weight:700;color:var(--ink);user-select:none;}
.cx-acc summary::-webkit-details-marker{display:none;}
.cx-acc summary .car{transition:transform .15s;color:var(--ink-faint);flex:none;font-size:12px;}
.cx-acc[open] summary .car{transform:rotate(90deg);}
.cx-acc summary .cx-count{margin-left:auto;font-size:11.5px;font-weight:600;color:var(--ink-faint);background:var(--line-soft);border-radius:10px;padding:2px 8px;}
.cx-acc-bd{padding:14px 14px 4px;border-top:1px solid var(--line);}
/* Plain (non-card) section header — used for the handful of condition-specific
   panels that should read as simple headings within the form rather than as
   their own accordion/card (see .cx-acc above, which everything else still uses). */
.cx-plain{margin-top:10px;}
.cx-plain:first-child{margin-top:0;}
.cx-plain-hd{display:flex;align-items:center;gap:8px;font-size:14.5px;font-weight:700;color:var(--ink);padding-bottom:6px;margin-bottom:10px;border-bottom:1px solid var(--line-soft);}
.cx-plain-hd .cx-count{margin-left:auto;font-size:11.5px;font-weight:600;color:var(--ink-faint);background:var(--line-soft);border-radius:10px;padding:2px 8px;}
.cx-plain-bd{padding:0 2px;}
/* ---- ROS bulk Select All Positive/Negative (section header + each subsection header) ---- */
.ros-bulk{display:inline-flex;align-items:center;gap:4px;margin-left:10px;}
.ros-bulk-btn{width:23px;height:23px;padding:0;border:1px solid var(--line);border-radius:6px;background:var(--card);display:inline-flex;align-items:center;justify-content:center;font-size:13.5px;cursor:pointer;flex:none;}
.ros-bulk-btn:hover,.ros-bulk-btn:focus-visible{background:var(--line-soft);}
.ros-bulk-pos{color:var(--chip-pos-ink);}
.ros-bulk-neg{color:var(--chip-neg-ink);}
.ros-bulk-reset{color:var(--ink-faint);}
.hdr-reset-btn{color:var(--ink-faint);}
.hdr-reset-btn:hover,.hdr-reset-btn:focus-visible{color:var(--ink);background:var(--line-soft);}
.cx-sub{font-size:12px;font-weight:700;color:var(--ink-soft);text-transform:uppercase;letter-spacing:.4px;margin:14px 0 6px;}
.cx-sub:first-child{margin-top:0;}
.cx-note{font-size:12px;color:var(--ink-faint);margin:-2px 0 8px;font-style:italic;}
.cx-chiprow{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:10px;}
.cx-chip{border:1px solid var(--line);background:var(--paper);color:var(--ink-soft);border-radius:16px;padding:5px 12px;font-size:13px;font-weight:500;cursor:pointer;}
.cx-chip:hover{border-color:var(--brand-soft-line);background:var(--brand-soft);color:var(--brand-ink);}
/* ---- Selected chip state: Positive (green) is the default everywhere a
   chip is used; Review of Systems is the one section where every chip is
   Negative (red) except "All Normal" (data-chip-kind="positive"), per the
   explicit classification rule -- selection is never wording-based. Border
   + fill treatment carry the meaning, not color alone. */
.cx-chip.on{background:var(--chip-pos-bg);border:1px solid var(--chip-pos-line);color:var(--chip-pos-ink);font-weight:600;}
#sec-ros .cx-chip.on{background:var(--chip-neg-bg);border-color:var(--chip-neg-line);color:var(--chip-neg-ink);}
#sec-ros .cx-chip[data-chip-kind="positive"].on{background:var(--chip-pos-bg);border-color:var(--chip-pos-line);color:var(--chip-pos-ink);}
.cx-checklist{display:flex;flex-wrap:wrap;gap:8px 18px;margin-bottom:10px;}
.cx-check{display:flex;align-items:center;gap:6px;font-size:16px;color:var(--ink);cursor:pointer;font-weight:400;}
.cx-check input{accent-color:var(--brand);width:14px;height:14px;flex:none;}
.cx-locrow{display:flex;align-items:center;gap:14px;margin-bottom:8px;}
.cx-loclabel{font-size:13.3px;color:var(--ink);font-weight:600;min-width:80px;flex:none;}
.cx-locrow .cx-chiprow{margin-bottom:0;}
.cx-yn{display:flex;align-items:center;gap:14px;flex-wrap:wrap;row-gap:6px;font-size:13.3px;color:var(--ink);margin-top:4px;}
.cx-yn label{display:flex;align-items:center;gap:5px;cursor:pointer;font-weight:500;}
.cx-yn input{accent-color:var(--brand);width:14px;height:14px;}
.cx-field-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:10px 14px;margin-bottom:10px;}
.cx-field{display:flex;flex-direction:column;gap:4px;min-width:0;}
.cx-field label{font-size:16px;color:var(--ink-faint);font-weight:600;}
.cx-field input[type=text],.cx-field input[type=number],.cx-field input[type=date],.cx-field select{border:1px solid var(--line);border-radius:6px;padding:6px 8px;background:var(--card);color:var(--ink);font-size:13.3px;width:100%;}
.cx-field textarea{border:1px solid var(--line);border-radius:6px;padding:6px 8px;background:var(--card);color:var(--ink);font-size:13.3px;width:100%;min-height:52px;resize:vertical;font-family:var(--font-ui);}
.cx-field.wide{grid-column:1/-1;}
.cx-nested{border-left:2px solid var(--brand-soft-line);margin:-2px 0 12px 4px;padding:8px 0 2px 14px;}
.scr-q{font-size:13.3px;color:var(--ink);font-weight:600;margin:12px 0 2px;}
.scr-q:first-child{margin-top:0;}
.scr-skipnote{background:var(--brand-soft);color:var(--brand-ink);border:1px solid var(--brand-soft-line);border-radius:6px;padding:7px 11px;font-size:13px;font-weight:600;margin:12px 0;}
.ros-row{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin-bottom:10px;}
.ros-field{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line);border-radius:16px;padding:3px 6px 3px 12px;background:var(--paper);font-size:13px;color:var(--ink-soft);}
.ros-field label{font-weight:600;white-space:nowrap;}
.ros-field input[type=text],.ros-field input[type=date],.ros-field select{border:1px solid var(--line);border-radius:12px;padding:3px 8px;background:var(--card);color:var(--ink);font-size:13px;min-width:112px;}
.ros-field textarea{border:1px solid var(--line);border-radius:8px;padding:4px 8px;background:var(--card);color:var(--ink);font-size:13px;min-width:160px;min-height:28px;resize:vertical;font-family:var(--font-ui);}
/* ---- Family History questionnaire table: frozen first column + resizable
   columns ---- Scoped entirely to .fh-matrix / .fh-matrix-wrap; no other
   table in the app uses these classes. The wrapper scrolls horizontally
   (native touch + mouse/trackpad scrolling, no JS needed for that part); the
   first column uses position:sticky to stay put during that scroll, same
   technique on both axes so it works identically with touch. table-layout:
   fixed + an explicit <colgroup> is what makes per-column drag-resize
   (initFhMatrixResize, see script) possible and keeps one column's resize
   from reflowing the others. */
.fh-matrix-wrap{overflow-x:auto;overflow-y:hidden;-webkit-overflow-scrolling:touch;scrollbar-width:thin;scrollbar-color:var(--line) transparent;}
.fh-matrix{table-layout:fixed;border-collapse:collapse;font-size:13px;}
.fh-matrix th{position:relative;text-align:center;color:var(--ink-faint);font-size:11.3px;font-weight:700;text-transform:uppercase;letter-spacing:.3px;padding:6px 14px 6px 8px;border-bottom:1px solid var(--line-soft);border-right:1px solid var(--line-soft);background:var(--paper);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.fh-matrix th:first-child{position:sticky;left:0;z-index:2;background:var(--card);box-shadow:2px 0 4px -2px rgba(18,24,38,.15);}
.fh-matrix th:last-child{border-right:none;}
.fh-matrix td{padding:5px 8px;border-bottom:1px solid var(--line-soft);border-right:1px solid var(--line-soft);text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.fh-matrix td:first-child{position:sticky;left:0;z-index:1;background:var(--card);box-shadow:2px 0 4px -2px rgba(18,24,38,.1);text-align:left;font-weight:500;white-space:normal;color:var(--ink);overflow:visible;text-overflow:clip;}
.fh-matrix td:last-child{border-right:none;}
.fh-matrix tr:last-child td{border-bottom:none;}
.fh-matrix input[type=checkbox]{accent-color:var(--brand);width:14px;height:14px;}
.fh-matrix select{border:1px solid var(--line);border-radius:6px;padding:4px 6px;background:var(--card);color:var(--ink);font-size:12.5px;width:100%;min-width:0;}
.fh-livingrow td{font-weight:600;background:var(--paper);}
.fh-matrix .fh-livingrow td:first-child{background:var(--paper);}
.fh-col-resizer{position:absolute;top:0;right:-4px;width:8px;height:100%;cursor:col-resize;z-index:3;touch-action:none;}
.fh-col-resizer::after{content:"";position:absolute;top:0;bottom:0;left:3px;width:2px;background:transparent;}
.fh-col-resizer:hover::after,.fh-col-resizer.is-resizing::after{background:var(--brand-soft-line);}
.fh-matrix-wrap.fh-col-resizing{cursor:col-resize;user-select:none;}
.travel-toolbar{display:flex;justify-content:flex-end;gap:8px;margin-bottom:8px;}
table.travel-table{width:100%;border-collapse:collapse;font-size:13px;min-width:1100px;}
