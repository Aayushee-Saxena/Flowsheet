      plan = '<div class="ap-plan"><div class="ap-plan-hd">'+ico('fa-list-check')+'Plan for DX '+(i+1)+': '+E(dxLabel(d))+'</div>'+
        (open ? '<div class="ap-plan-opts">'+PTYPES.map(function(t){ return btn('plan-add', d.id, ico(t[2])+' '+t[1], (AP.pform[d.id]&&AP.pform[d.id].t===t[0]?'on':''), '', ' data-t="'+t[0]+'"'); }).join('')+'</div>' : '')+
        planForm(d)+
        (items.length ? '<div class="ap-pitems">'+items.map(function(it){ var t = ptype(it.t);
            return '<div class="ap-pitem"><span class="ap-ptype '+t[3]+'">'+t[1]+'</span><span class="ap-ptxt">'+E(it.txt)+'</span>'+
              btn('pi-edit', d.id, 'Edit', 'btn-ghost', '', ' data-t="'+it.t+'" data-pid="'+it.id+'"')+
              btn('pi-remove', d.id, 'Remove', 'btn-ghost', (it.t==='rx'||it.t==='ho'||it.t==='fu') ? 'Unlinks it from this diagnosis; it stays in its own section' : 'Removes this plan item', ' data-t="'+it.t+'" data-pid="'+it.id+'"')+'</div>'; }).join('')+'</div>'
          : (open ? '<div class="ap-ent-sub">No plan items yet. Choose an option above.</div>' : ''))+'</div>';
    }
    return '<div class="ap-card"><div class="ap-card-top"><span class="ap-tag">DX '+(i+1)+'</span>'+(d.code?'<span class="ap-code">'+E(d.code)+'</span>':'')+'<span class="ap-name">'+E(d.name)+'</span>'+
