.dx-entry.hl-active{border-left:5px solid var(--hl-color, transparent);}
.dx-entry-hd{display:flex;align-items:center;gap:9px;flex-wrap:wrap;}
.dx-name{font-size:14.5px;margin:0;}
.dx-entry-meta{font-size:13px;color:var(--ink-soft);margin-top:3px;}
.dx-visit-badge{display:inline-flex;align-items:center;gap:5px;font-size:11.5px;font-weight:700;color:var(--ink-faint);background:var(--line-soft);border-radius:10px;padding:2px 9px;white-space:nowrap;}
