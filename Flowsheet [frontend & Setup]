      menu(btn, [{label: 'Cancel', icon: 'fa-ban', disabled: off, run: function(){ prompt('Cancel the prescription for ' + m.drug + '?', [{label: 'No'}, {label: 'Yes', primary: true, run: function(){ setStatus(id, 'Cancelled', 'Cancelled'); }}], 'Cancel Prescription'); }},
                 {label: 'Discontinue', icon: 'fa-circle-stop', disabled: off, run: function(){ prompt('Discontinue ' + m.drug + '?', [{label: 'No'}, {label: 'Yes', primary: true, run: function(){ setStatus(id, 'Discontinued', 'Discontinued'); }}], 'Discontinue Medication'); }}]); },
