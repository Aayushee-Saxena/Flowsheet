/* Simple left-panel-only filter: typing hides non-matching nav items (and
   any group left with nothing visible); clearing the box restores the full
   list. Matches against each item's own visible name and, for "relevant
   element/question text", the same left-nav question index used above --
   nothing outside #navrail (no center form, Summary panel, or patient
   info) is searched or touched. */
function runNavSearch(q){
  q=q.trim().toLowerCase();
  const groups=[...document.querySelectorAll('#navBody .nav-group')];
  if(!q){
    document.querySelectorAll('#navBody .nav-item').forEach(it=>{ it.style.display=''; });
    groups.forEach(g=>{ g.style.display=''; });
    return;
  }
  const matchedKeys=new Set(
    NAV_QUESTION_INDEX.filter(i=>i.q.toLowerCase().includes(q)).map(i=>i.key)
  );
  groups.forEach(g=>{
    let anyVisible=false;
    g.querySelectorAll('.nav-item').forEach(it=>{
      const nameEl=it.querySelector('.nm');
      const name=(nameEl?nameEl.textContent:it.getAttribute('title')||'').toLowerCase();
