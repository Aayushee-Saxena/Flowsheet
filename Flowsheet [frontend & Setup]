      return '<div class="ap-tray-row"><span style="flex:1">'+E(x.code ? x.code+' '+x.name : (x.name||x.title))+'</span>'+btn(restoreAct, x.id, 'Restore', 'btn-ghost')+'</div>'; }).join('')+'</details>';
