<script>
/* =====================================================================
   [v4] Mark as Reviewed -- one global presentation for every review state.
   State still lives in the existing "<key>-reviewed-pill" (inline display =
   reviewed, text = "✓ Reviewed by <Dr> · <stamp>" written by markReviewed).
   Before review: the existing "Mark as Reviewed" button is shown as-is.
   After review: the button is hidden and the pill renders as the reviewed
   person icon (user + check) whose tooltip reads "Reviewed by <Dr> <stamp>".
   Applies to every section header, record (Allergy / Diagnosis entries) and
   recorded vital; nothing about the review data or toggling changes.
   ===================================================================== */
(function(){
  var ICON = '<span class="vn-rv-ico" aria-hidden="true"><i class="fa-solid fa-user"></i><i class="fa-solid fa-check vn-rv-chk"></i></span>';
  function isOn(p){ return !!(p && p.style.display && p.style.display !== 'none'); }
  function label(txt){
    var t = String(txt || '').replace(/^\s*(✓|&#10003;)\s*/, '').replace(/\s*·\s*/, ' · ').replace(/\s+/g, ' ').trim();
    return /^Reviewed\b/i.test(t) ? t.charAt(0).toUpperCase() + t.slice(1) : 'Reviewed';
  }
  function sync(p){
    if(!p) return;
    var on = isOn(p), txt = (p.querySelector('.vn-rv-txt') || p).textContent;
    if(on){
      var tip = label(txt);
      if(!p.classList.contains('vn-rv-on') || !p.querySelector('.vn-rv-txt') || p.getAttribute('data-tt') !== tip){
        p.innerHTML = '<span class="vn-rv-txt">' + txt.replace(/[&<>]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;'}[c]; }) + '</span>' + ICON;
        p.classList.add('vn-rv-on');
        p.setAttribute('data-tt', tip); p.setAttribute('aria-describedby', 'pbiTooltip');
        p.setAttribute('role', 'button'); p.setAttribute('aria-pressed', 'true'); p.setAttribute('aria-label', tip + '. Select to remove the review.'); p.setAttribute('tabindex', '0');
        if(typeof bindPbiTooltip === 'function') bindPbiTooltip(p);
      }
    } else if(p.classList.contains('vn-rv-on')){
      p.classList.remove('vn-rv-on');
      ['data-tt', 'aria-describedby', 'role', 'aria-label', 'aria-pressed', 'tabindex'].forEach(function(a){ p.removeAttribute(a); });
      if(typeof hidePbiTooltip === 'function') hidePbiTooltip();
      if(p.querySelector('.vn-rv-txt')) p.textContent = p.querySelector('.vn-rv-txt').textContent;
    }
    /* the "Mark as Reviewed" button(s) for this key are replaced by the icon while reviewed */
    var k = p.id.replace(/-reviewed-pill$/, '');
    [document.getElementById(k + '-review-btn'), document.getElementById(k + '-rv-ico'), k === 'vitals' ? document.getElementById('vsReviewIco') : null].forEach(function(b){
      if(!b) return;
      b.classList.toggle('vn-rv-replaced', on);
      if(!on && b.textContent.trim() !== 'Mark as Reviewed' && !b.querySelector('i, svg')) b.textContent = 'Mark as Reviewed';
    });
  }
  /* one toggle for every reviewed icon: clicking it calls the same markReviewed(key) that reviewed it */
  function unreview(p){
    if(!p || !p.classList.contains('vn-rv-on')) return;
    var k = p.id.replace(/-reviewed-pill$/, '');
    if(typeof hidePbiTooltip === 'function') hidePbiTooltip();
    if(typeof markReviewed === 'function') markReviewed(k);
    syncAll();
    var b = document.getElementById(k + '-review-btn') || document.getElementById(k + '-rv-ico') || (k === 'vitals' ? document.getElementById('vsReviewIco') : null);
    if(b && b.offsetParent !== null) b.focus();
  }
  document.addEventListener('click', function(ev){ var p = ev.target.closest && ev.target.closest('.pill-reviewed.vn-rv-on[id$="-reviewed-pill"]'); if(p){ ev.preventDefault(); ev.stopPropagation(); unreview(p); } }, true);
  document.addEventListener('keydown', function(ev){ if(ev.key !== 'Enter' && ev.key !== ' ') return; var p = ev.target.closest && ev.target.closest('.pill-reviewed.vn-rv-on[id$="-reviewed-pill"]'); if(p){ ev.preventDefault(); unreview(p); } }, true);
  function syncAll(){ document.querySelectorAll('[id$="-reviewed-pill"]').forEach(sync); }
  window.vnReviewSync = syncAll;
  function init(){
    ['markReviewed', 'markReviewedSilently', 'doResetSection', 'vnUnreview'].forEach(function(n){
      var f = window[n]; if(typeof f !== 'function') return;
      window[n] = function(){ var r = f.apply(this, arguments); syncAll(); return r; };
    });
    /* records re-rendered elsewhere (recorded vitals, allergy / diagnosis entries) pick the icon up too */
    if(window.MutationObserver) new MutationObserver(function(muts){
      for(var i = 0; i < muts.length; i++){
        var t = muts[i].target;
        if(muts[i].type === 'attributes' ? (t.id && /-reviewed-pill$/.test(t.id)) : (t.querySelector && t.querySelector('[id$="-reviewed-pill"]'))){ clearTimeout(init._t); init._t = setTimeout(syncAll, 0); return; }
      }
    }).observe(document.body, {subtree: true, childList: true, attributes: true, attributeFilter: ['style']});
    syncAll();
  }
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function(){ setTimeout(init, 0); }); else setTimeout(init, 0);
  window.addEventListener('load', function(){ setTimeout(syncAll, 0); });
})();
</script>
