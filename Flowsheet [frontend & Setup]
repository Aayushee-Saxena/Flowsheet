/* ---- Add new (New Diagnosis form) -- clones an existing .dx-entry row and
   re-keys every id/for/onclick on it, so a newly added diagnosis gets the
   exact same toggle/quick-edit/history/delete affordances for free. ---- */
let dxRowSeq=2;
function cloneDxRow(sourceKey, newKey){
  const src=document.getElementById('sec-'+sourceKey);
  if(!src) return null;
  const clone=src.cloneNode(true);
  clone.id='sec-'+newKey;
  clone.setAttribute('data-dx-key', newKey);
  clone.classList.remove('hl-active');
  clone.style.removeProperty('--hl-color');
  clone.querySelectorAll('[id]').forEach(el=>{ el.id=el.id.split(sourceKey).join(newKey); });
  clone.querySelectorAll('[for]').forEach(el=>{ el.setAttribute('for', el.getAttribute('for').split(sourceKey).join(newKey)); });
  clone.querySelectorAll('[onclick]').forEach(el=>{ el.setAttribute('onclick', el.getAttribute('onclick').split(sourceKey).join(newKey)); });
  clone.querySelectorAll('.hl-pop').forEach(el=>{ el.hidden=true; });
  clone.querySelectorAll('.dx-quickedit').forEach(el=>{ el.hidden=true; });
  clone.querySelectorAll('.ssum-confirm').forEach(el=>{ el.classList.remove('show'); });
  clone.querySelectorAll('.hl-dot').forEach(el=>{ el.hidden=true; });
  clone.querySelectorAll('.pill-reviewed').forEach(el=>{ el.style.display='none'; });
  return clone;
}
function openDxNew(){
  resetDxNewForm();
  document.getElementById('dxNewScrim').hidden=false;
}
function closeDxNew(){
  document.getElementById('dxNewScrim').hidden=true;
}
function dxCancelNew(){
  closeDxNew();
}
function resetDxNewForm(){
  const g=id=>document.getElementById(id);
  ['dxnew-diagnosis','dxnew-severity','dxnew-verification','dxnew-sourcetype','dxnew-source','dxnew-customstatus'].forEach(id=>{ const el=g(id); if(el) el.value=''; });
  const statusEl=g('dxnew-status'); if(statusEl) statusEl.value='Active';
  const dateEl=g('dxnew-startdate'); if(dateEl) dateEl.value='';
  const noteEl=g('dxnew-note'); if(noteEl) noteEl.value='';
  const probEl=g('dxnew-addproblist'); if(probEl) probEl.checked=false;
  const srcEl=g('dxnew-source'); if(srcEl) srcEl.disabled=true;
}
function dxSourceTypeChanged(){
  const t=document.getElementById('dxnew-sourcetype');
  const s=document.getElementById('dxnew-source');
  if(!t || !s) return;
  s.disabled = !t.value;
  if(!t.value) s.value='';
}
function saveDxNew(addAnother){
  const g=id=>document.getElementById(id);
  const dxSel=g('dxnew-diagnosis');
  if(!dxSel || !dxSel.value){ toast('Select a diagnosis.'); return; }
  const optText=dxSel.options[dxSel.selectedIndex].text;
  const dashIdx=optText.indexOf(' - ');
  const code=dashIdx>-1 ? optText.slice(0,dashIdx).trim() : '';
  const name=dashIdx>-1 ? optText.slice(dashIdx+3).trim() : optText;
  const status=g('dxnew-status').value || 'Active';
  const severity=g('dxnew-severity').value;
  const verification=g('dxnew-verification').value;
  const sourceType=g('dxnew-sourcetype').value;
  const source=g('dxnew-source').value;
  const customStatus=g('dxnew-customstatus').value;
  const addToProblemList=g('dxnew-addproblist').checked;

  const templateSrc=document.querySelector('.dx-entry');
  if(!templateSrc){ toast('Could not add diagnosis — no template row available.'); return; }
  dxRowSeq++;
  const newKey='dx-'+dxRowSeq;
  const clone=cloneDxRow(templateSrc.getAttribute('data-dx-key'), newKey);
  if(!clone){ toast('Could not add diagnosis.'); return; }
  const list=g('assess-dx-list');
  list.hidden=false;
  list.appendChild(clone);

  const codeDisp=g(newKey+'-code-display'); if(codeDisp) codeDisp.textContent=code;
  const nameDisp=g(newKey+'-name-display'); if(nameDisp) nameDisp.textContent=name;
  const statusPill=g(newKey+'-status-pill'); if(statusPill) statusPill.textContent=status;
  const badge=g(newKey+'-visit-badge'); const avb=g(newKey+'-addvisit-btn');
  if(badge){ badge.classList.remove('on'); badge.innerHTML='<i class="fa-solid fa-list" aria-hidden="true"></i>Master List'; badge.setAttribute('data-tt',"Not yet associated with today's visit"); }
  if(avb){ avb.innerHTML='<i class="icon fa-solid fa-calendar-plus" aria-hidden="true"></i><span>Add to this visit</span>'; }

  const today=fmtTodayLong();
  const metaParts=[status];
  if(severity) metaParts.push(severity);
  if(verification) metaParts.push(verification);
  metaParts.push(today);
  const metaEl=g(newKey+'-meta-display');
  if(metaEl){ metaEl.textContent=metaParts.join(' · '); metaEl.setAttribute('data-added-date', today); }

  const setQe=(field,val)=>{ const el=g('qe-'+newKey+'-'+field); if(el && val) el.value=val; };
  setQe('sourcetype', sourceType);
  setQe('source', source);
  setQe('verification', verification);
  setQe('customstatus', customStatus);
  setSegByValue('qe-'+newKey+'-status', status);
  const qeProb=g('qe-'+newKey+'-addproblist'); if(qeProb) qeProb.checked=addToProblemList;

  if(addToProblemList) addDxRowToProblemList(newKey);
  else toggleAddToVisit(newKey); /* a diagnosis documented today defaults onto today's visit */

  markPartial('assess');
  setStatus('assess','complete');
  onSectionFieldCommitted('assess');
  toast('Diagnosis added.');
  const emptyNote=g('dxEmptyNote'); if(emptyNote) emptyNote.style.display='none';

  resetDxNewForm();
  if(!addAnother) closeDxNew();
}

/* ---- Add to Problem List: a picker listing every diagnosis recorded for
   the patient, with a badge showing whether it's already part of today's
   visit, so selected items can be added to both the visit and the Problem
   List section in one step. ---- */
function addDxRowToProblemList(key){
  const codeEl=document.getElementById(key+'-code-display');
  const nameEl=document.getElementById(key+'-name-display');
  if(!codeEl || !nameEl) return false;
  const code=codeEl.textContent.trim();
  const title=nameEl.textContent.trim();
  const block=document.getElementById('problemlist-questionnaire-block');
  if(!block) return false;
  const dupe=[...block.querySelectorAll('.prob-row')].some(r=>{
    const c=r.querySelector('.prob-code'); const t=r.querySelector('.prob-title');
    return c && t && c.textContent.trim()===code && t.textContent.trim()===title;
  });
  if(!dupe){
    const row=document.createElement('div');
    row.className='prob-row';
    row.innerHTML='<div class="prob-code"></div><div class="prob-main"><div class="prob-title"></div><div class="prob-sub">From Diagnosis</div></div><div class="prob-actions"><span class="pill" style="background:var(--line-soft);color:var(--ink-soft);">On Problem List</span></div>';
    row.querySelector('.prob-code').textContent=code;
    row.querySelector('.prob-title').textContent=title;
    block.appendChild(row);
    setStatus('problemlist','complete');
  }
  const badge=document.getElementById(key+'-visit-badge');
  if(badge && !badge.classList.contains('on')) toggleAddToVisit(key);
  const qeProb=document.getElementById('qe-'+key+'-addproblist');
  if(qeProb) qeProb.checked=true;
  return true;
}
function openDxAddToProblemList(){
  const wrap=document.getElementById('dxProblemListPicker');
  if(!wrap) return;
  const rows=[...document.querySelectorAll('.dx-entry')];
  if(!rows.length){
    wrap.innerHTML='<p style="font-size:13px;color:var(--ink-faint);">No diagnoses recorded for this patient yet.</p>';
  } else {
    wrap.innerHTML=rows.map(r=>{
      const key=r.getAttribute('data-dx-key');
      const codeEl=document.getElementById(key+'-code-display');
      const nameEl=document.getElementById(key+'-name-display');
      const badgeEl=document.getElementById(key+'-visit-badge');
      const code=codeEl ? codeEl.textContent : '';
      const name=nameEl ? nameEl.textContent : '';
      const onVisit=badgeEl ? badgeEl.classList.contains('on') : false;
      const badgeHtml=onVisit
        ? '<span class="dx-visit-badge on"><i class="fa-solid fa-calendar-check" aria-hidden="true"></i>Added to Visit</span>'
        : '<span class="dx-visit-badge"><i class="fa-solid fa-list" aria-hidden="true"></i>Master List</span>';
      return '<label class="rf-mini-row" style="cursor:pointer;">'
        +'<span style="display:flex;align-items:center;gap:8px;"><input type="checkbox" class="dxplc-check" value="'+key+'" '+(onVisit?'checked':'')+'><span class="prob-code" style="margin-right:2px;">'+code+'</span>'+name+'</span>'
        +badgeHtml
        +'</label>';
    }).join('');
  }
  document.getElementById('dxAddToProblemListScrim').hidden=false;
}
function closeDxAddToProblemList(){
  document.getElementById('dxAddToProblemListScrim').hidden=true;
}
function applyDxAddToProblemList(){
  const checked=[...document.querySelectorAll('.dxplc-check:checked')];
  checked.forEach(chk=>addDxRowToProblemList(chk.value));
  closeDxAddToProblemList();
  toast(checked.length+' diagnosis'+(checked.length===1?'':'es')+' added to this visit and Problem List.');
}

