<script>
/* =====================================================================
   History tab -- Social / Infection / Menstrual / Pregnancy / Birth / Interval / Providers.
   List-detail rows use the existing vntChip / vqLdClear / field-commit behaviour unchanged.
   This script adds only what the new shapes need:
   - chip + attached box: typing in the box selects its chip (legacy "(+) [____]")
   - date tiles show the filled state once a date is entered
   - Infection History Yes / No table: Yes and No exclusive per row, All No, Clear, summary lines
   - Pregnancy History grid: Add / Add new row / delete row / show-hide columns, summary lines
   Everything lives in the section's own DOM, so values persist across section / tab switches,
   the Form Window, and Reset (which restores the as-loaded block).
   ===================================================================== */
(function(){
  function commit(el){ var c = el.closest('.card[id^="sec-"]'); if(!c) return; var k = c.id.slice(4);
    if(typeof markPartial === 'function') markPartial(k); if(typeof onSectionFieldCommitted === 'function') onSectionFieldCommitted(k);
    if(typeof vnfQueue === 'function') vnfQueue(k); }

  /* chip + attached box */
  document.addEventListener('input', function(e){
    var t = e.target; if(!t.closest) return;
    var f = t.closest('.hxn-list .vq-ld-field.hxn-att');
    if(f && t.value.trim()){ var chip = f.previousElementSibling;
      if(chip && chip.classList.contains('cx-chip') && !chip.classList.contains('on')){ chip.classList.add('on'); chip.setAttribute('aria-pressed', 'true'); } }
    var d = t.closest('.hxn-list .vq-ld-field.hxn-date'); if(d) d.classList.toggle('hxn-has', !!t.value);
  }, true);
  document.addEventListener('change', function(e){
    var t = e.target; if(!t.closest) return;
    var d = t.closest('.hxn-list .vq-ld-field.hxn-date'); if(d) d.classList.toggle('hxn-has', !!t.value);
  }, true);
  /* the row clear (vqLdClear) empties date inputs -> drop the filled state too */
  var oc = window.vqLdClear;
  if(typeof oc === 'function') window.vqLdClear = vqLdClear = function(btn){ var r = oc.apply(this, arguments);
    var q = btn && btn.closest('.vq'); if(q) q.querySelectorAll('.hxn-date').forEach(function(d){ d.classList.remove('hxn-has'); }); return r; };

  /* ---------- Infection History: Yes / No table ---------- */
  function iftMark(row){ var y = row.querySelector('.ift-yes'); row.classList.toggle('ift-yes-on', !!(y && y.checked)); }
  document.addEventListener('change', function(e){
    var t = e.target; if(!t.matches || !t.matches('.ift input[type=checkbox]')) return;
    var row = t.closest('tr');
    if(t.checked){ var other = row.querySelector(t.classList.contains('ift-yes') ? '.ift-no' : '.ift-yes'); if(other) other.checked = false; }
    iftMark(row);
  }, true);
  window.iftAllNo = function(btn){
    var w = btn.closest('.ift-wrap'); w.querySelectorAll('tbody tr').forEach(function(r){ var y = r.querySelector('.ift-yes'), n = r.querySelector('.ift-no'); if(!n) return; if(y) y.checked = false; n.checked = true; iftMark(r); });
    commit(btn); if(typeof toast === 'function') toast('All questions marked No.');
  };
  window.iftClear = function(btn){
    var w = btn.closest('.ift-wrap'); w.querySelectorAll('input').forEach(function(i){ if(i.type === 'checkbox') i.checked = false; else i.value = ''; });
    w.querySelectorAll('tbody tr').forEach(iftMark); commit(btn); if(typeof toast === 'function') toast('Infection History table cleared.');
  };

  /* ---------- Pregnancy History: grid ---------- */
  window.pgtAdd = function(btn){
    var w = btn.closest('.pgt-wrap'), tpl = w.querySelector('template.pgt-tpl'), tb = w.querySelector('tbody'); if(!tpl || !tb) return;
    tb.appendChild(tpl.content.cloneNode(true));
    var rows = tb.querySelectorAll('tr'), last = rows[rows.length - 1];
    var first = last && [].slice.call(last.querySelectorAll('input')).filter(function(i){ return i.offsetParent !== null; })[0];
    if(first) first.focus();
    commit(btn);
  };
  window.pgtDel = function(btn){
    var tr = btn.closest('tr'), tb = tr.parentNode, w = btn.closest('.pgt-wrap');
    if(tb.querySelectorAll('tr').length > 1) tr.remove(); else tr.querySelectorAll('input').forEach(function(i){ i.value = ''; });
    commit(w); if(typeof toast === 'function') toast('Row deleted.');
  };
  window.pgtColMenu = function(btn){
    var m = btn.parentNode.querySelector('.pgt-colmenu'); var open = m.hidden; m.hidden = !open; btn.setAttribute('aria-expanded', String(open));
  };
  window.pgtCol = function(cb){
    var w = cb.closest('.pgt-wrap'), i = cb.getAttribute('data-pgcol');
    var on = [].slice.call(w.querySelectorAll('[data-pgcol]')).filter(function(c){ return c.checked; });
    if(!on.length){ cb.checked = true; return; }   /* keep at least one column */
    w.classList.toggle('pgt-h' + i, !cb.checked);
  };
  document.addEventListener('click', function(e){
    document.querySelectorAll('.pgt-colmenu:not([hidden])').forEach(function(m){
      if(!m.parentNode.contains(e.target)){ m.hidden = true; var b = m.parentNode.querySelector('.pgt-colbtn'); if(b) b.setAttribute('aria-expanded', 'false'); }
    });
  });
  document.addEventListener('keydown', function(e){
    if(e.key !== 'Escape') return;
    document.querySelectorAll('.pgt-colmenu:not([hidden])').forEach(function(m){ m.hidden = true; var b = m.parentNode.querySelector('.pgt-colbtn'); if(b){ b.setAttribute('aria-expanded', 'false'); b.focus(); } });
  });

  /* ---------- summary lines (This Visit Summary) ---------- */
  var ef = window.extractSectionFacts;
  if(typeof ef === 'function') window.extractSectionFacts = extractSectionFacts = function(k){
    var out = ef.apply(this, arguments) || [], card = document.getElementById('sec-' + k); if(!card) return out;
    var it = card.querySelector('table.ift');
    if(it) it.querySelectorAll('tbody tr').forEach(function(r){
      var q = r.getAttribute('data-q').replace(/^\d+\.\s*/, ''), y = r.querySelector('.ift-yes'), n = r.querySelector('.ift-no'),
          sp = r.querySelector('.ift-spec'), cm = r.querySelector('.ift-comment');
      if(cm){ if(cm.value.trim()) out.push(q + ': ' + cm.value.trim()); return; }
      var v = y && y.checked ? 'Yes' : n && n.checked ? 'No' : '', d = sp ? sp.value.trim() : '';
      if(v || d) out.push(q + ': ' + [v, d].filter(Boolean).join(' · '));
    });
    var pg = card.querySelector('table.pgt');
    if(pg) pg.querySelectorAll('tbody tr').forEach(function(r){
      var bits = [].slice.call(r.querySelectorAll('input')).filter(function(i){ return i.value !== ''; }).map(function(i){ return i.getAttribute('data-col') + ' ' + i.value; });
      if(bits.length) out.push(bits.join(', '));
    });
    return out;
  };
})();

</script>
<script>
/* Medical History conditions table: Negative / Positive are mutually exclusive per row; All negative; Clear; summary lines */
(function(){
  function commit(el){ var c = el.closest('.card[id^="sec-"]'); if(!c) return; var k = c.id.slice(4);
    if(typeof markPartial === 'function') markPartial(k); if(typeof onSectionFieldCommitted === 'function') onSectionFieldCommitted(k);
    if(typeof vnfQueue === 'function') vnfQueue(k); }
  function mark(row){ var p = row.querySelector('.mht-pos'); row.classList.toggle('mht-pos-on', !!(p && p.checked)); }
  document.addEventListener('change', function(e){
    var t = e.target; if(!t.matches || !t.matches('.mht input[type=checkbox]')) return;
    var row = t.closest('tr'); if(t.checked){ var other = row.querySelector(t.classList.contains('mht-neg') ? '.mht-pos' : '.mht-neg'); if(other && other.checked){ other.checked = false; } }
    mark(row);
  }, true);
  window.mhtAllNegative = function(btn){
    var wrap = btn.closest('.mht-wrap'); wrap.querySelectorAll('tbody tr').forEach(function(r){ var n = r.querySelector('.mht-neg'), p = r.querySelector('.mht-pos'); if(p) p.checked = false; if(n) n.checked = true; mark(r); });
    commit(btn); if(typeof toast === 'function') toast('All conditions marked Negative.');
  };
  window.mhtClear = function(btn){
    var wrap = btn.closest('.mht-wrap'); wrap.querySelectorAll('input').forEach(function(i){ if(i.type === 'checkbox') i.checked = false; else i.value = ''; });
    wrap.querySelectorAll('tbody tr').forEach(mark); commit(btn); if(typeof toast === 'function') toast('Conditions table cleared.');
  };
  var ef = window.extractSectionFacts;
  if(typeof ef === 'function') window.extractSectionFacts = extractSectionFacts = function(k){
    var out = ef.apply(this, arguments) || [], card = document.getElementById('sec-' + k), tbl = card && card.querySelector('.mht');
    if(!tbl) return out;
    tbl.querySelectorAll('tbody tr').forEach(function(r){
      var n = r.querySelector('.mht-neg').checked, p = r.querySelector('.mht-pos').checked, d = r.querySelector('.mht-date').value, tx = r.querySelector('.mht-tx').value.trim(),
          no = r.querySelector('.mht-note').value.trim(), sp = r.querySelector('.mht-spec'), spec = sp ? sp.value.trim() : '';
