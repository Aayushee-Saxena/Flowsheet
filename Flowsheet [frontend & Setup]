.ift input[type=text]{width:100%;min-width:0;height:28px;box-sizing:border-box;border:1px solid var(--line);border-radius:var(--radius-s);background:var(--card);color:var(--ink);font:inherit;font-size:13px;padding:2px 8px;}
.ift input[type=text]:focus{outline:none;border-color:var(--brand);box-shadow:0 0 0 2px var(--brand-soft);}
.ift .ift-spec{display:block;margin-top:5px;max-width:360px;font-weight:400;}
.ift tr.ift-yes-on .ift-q > span{color:var(--rose);}

/* Pregnancy History -- grid (grid.png): column chooser + Add, header row, delete column, "Add new row" */
.pgt-bar{display:flex;justify-content:flex-end;align-items:center;gap:6px;margin-bottom:8px;}
.pgt-colwrap{position:relative;}
.pgt-colmenu{position:absolute;right:0;top:calc(100% + 4px);z-index:30;min-width:200px;background:var(--card);border:1px solid var(--line);border-radius:var(--radius-s);box-shadow:var(--shadow-lg);padding:6px;display:flex;flex-direction:column;gap:2px;}
