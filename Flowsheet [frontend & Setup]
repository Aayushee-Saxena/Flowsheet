    if(u === 'cm') return v / 100; if(u === 'in') return v * 0.0254; return (v * 12 + (parseFloat(r.val2) || 0)) * 0.0254; }
  function calcBmi(v){ var kg = toKg((v.weight||[])[0]), m = toM((v.height||[])[0]); return (kg > 0 && m > 0) ? (kg / (m * m)).toFixed(2) : ''; }

  /* =====================================================================
