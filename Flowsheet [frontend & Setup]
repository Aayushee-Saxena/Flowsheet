    });
    return out;
  }
  function activeTab(){ return typeof vntActive !== 'undefined' ? vntActive : null; }

  var busy = false;
  function apply(){
    var d = document.getElementById('vnsDoc'); if(!d || busy) return;
    busy = true;
    var NAV = navKeys(), TAB = activeTab();
    try{
      d.querySelectorAll('.vns-sec[data-key]').forEach(function(b){
        var k = b.getAttribute('data-key'), m = mode(k);
        var na = m === 'hide' || (m === 'content' && (b.hidden || b.classList.contains('vns-sec-empty')));
        if(b.classList.contains('vns-na') !== na) b.classList.toggle('vns-na', na);
        var off = !!PANEL_EXCLUDE[k] || !NAV[k];
