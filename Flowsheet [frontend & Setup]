<script>
/* ==== Left panel: status icons get a plain-language label ==== */
(function(){
  var LBL = {complete:'Completed', partial:'In progress', pending:'Not filled yet', unfilled:'Not filled yet', filled:'Filled',
             reviewed:'Reviewed', required:'Required', signed:'Signed', locked:'Locked'};
  function label(el){
    var k = Object.keys(LBL).filter(function(c){ return el.classList.contains(c); })[0];
    if(k){ el.title = LBL[k]; el.setAttribute('role','img'); el.setAttribute('aria-label', 'Status: ' + LBL[k]); }
  }
