  if(typeof setStatus === 'function'){
    var o = setStatus;
    window.setStatus = setStatus = function(key){ var r = o.apply(this, arguments);
      ['ic-'+key, 'ssum-ic-'+key].forEach(function(id){ var el = document.getElementById(id); if(el) label(el); }); return r; };
  }
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', all); else all();
