   row's own bound question highlighted. Opening the live form editor
   needs the Custom Form setup screen, which this prototype does not have. */
function openQnr(rid){
 const r=findRow(rid);if(!r||r.type!=='form'||!r.form)return;
 const cn=(CAT['Custom Form']||[]).find(c=>c.c===r.form);if(!cn)return;
 const bound=String(r.path||'');
 const ctl=(ty,lbl)=>{const a=`aria-label="${rEsc(lbl)}" disabled`;
  return ty==='number'?`<input type="number" ${a}/>`:ty==='date'?`<input type="date" ${a}/>`
   :ty==='checkbox'?`<input type="checkbox" ${a}/>`:ty==='capsule'?`<span class="qcap">${rEsc(lbl)}</span>`
   :ty==='select'||ty==='multi'?`<select ${a}><option>${ty==='multi'?'Select one or more…':'Select…'}</option></select>`
   :ty==='rta'?`<textarea rows="2" ${a}></textarea>`:`<input type="text" ${a}/>`;};
 let q=0;
 const item=(p,nm,ty,sub)=>{if(!sub)q++;
  return `<div class="qitem${sub?' sub':''}${bound===p?' bound':''}"><div class="ql"><span class="qn">${sub?'':q+'.'}</span>${rEsc(nm)} ${badge(ty)}${bound===p?'<span class="qtag">this row</span>':''}</div><div class="qc">${ctl(ty,nm)}</div></div>`;};
 const body=cn.items.map(([nm,ty,subs])=>{const p=`${cn.c} -> ${nm}`;
   return item(p,nm,ty,false)+(subs||[]).map(s=>item(`${p} -> ${s[0]}`,s[0],s[1],true)).join('');}).join('');
 document.getElementById('qnTitle').textContent=`Questionnaire — ${r.form}`;
 document.getElementById('qnFor').textContent=r.label?`opened from “${r.label}”`:'';
 document.getElementById('qnBody').innerHTML=`<div class="qmeta"><span class="srcchip">Custom Form</span> ${cn.items.length} question${cn.items.length===1?'':'s'} · preview, read-only</div>${body}`;
 document.getElementById('qnBack').classList.add('on');document.getElementById('qnModal').classList.add('on');
 setTimeout(()=>{const b=document.querySelector('#qnModal .qitem.bound');if(b)b.scrollIntoView({block:'nearest'});},0);
}
function closeQnr(){document.getElementById('qnBack').classList.remove('on');document.getElementById('qnModal').classList.remove('on');}
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&document.getElementById('qnModal')?.classList.contains('on'))closeQnr();});

