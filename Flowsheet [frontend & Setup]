        var on = g.getAttribute('data-tab') === TAB;
        if(g.classList.contains('vns-tab-off') === on) g.classList.toggle('vns-tab-off', !on);
        if(!on) return;
        var any = [].some.call(g.querySelectorAll('.vns-sec'), function(b){ return !b.hidden && !b.classList.contains('vns-na') && !b.classList.contains('vns-offtab'); });
        var em = g.querySelector(':scope > .vns-tab-empty');
        if(!em){ em = document.createElement('div'); em.className = 'vns-tab-empty'; em.setAttribute('role', 'status'); g.appendChild(em); }
        var txt = 'No summary yet for ' + (g.querySelector('.vns-tab-t') ? g.querySelector('.vns-tab-t').textContent.trim() : 'this tab') + '.';
        if(em.textContent !== txt) em.textContent = txt;
