 const rs=['navrail','vnSplitL','center'].map(id=>dockShown(document.getElementById(id))).filter(Boolean);
 if(!rs.length)return null;const L=Math.min(...rs.map(r=>r.left)),T=Math.min(...rs.map(r=>r.top)),R=Math.max(...rs.map(r=>r.right)),B=Math.max(...rs.map(r=>r.bottom));
