<script>
/* ==== [req 6] Save & Next -> validate the section's Required questions first.
   A question is Required when it carries the existing .req-star marker on its
   own label / fieldset title (section-level stars in the card header are not
   questions and are not validated here). Nothing entered is changed or lost. ==== */
(function(){
  var pending=null;
  function isHiddenPanel(el){ return !!el.closest('[hidden]'); }         /* e.g. closed Quick Edit panels */
  function valued(ctrl){
    if(ctrl.disabled) return false;
    var t=(ctrl.type||'').toLowerCase();
    if(ctrl.tagName==='SELECT'){
      if(ctrl.multiple) return ctrl.selectedOptions.length>0;
      var o=ctrl.options[ctrl.selectedIndex];
      return !!ctrl.value && !(o && /^select/i.test(o.textContent.trim()) && !o.value);
    }
    if(t==='checkbox'||t==='radio') return ctrl.checked;
    return (ctrl.value||'').trim()!=='';
  }
  function filled(box){
    var ctrls=[].slice.call(box.querySelectorAll('input,select,textarea')).filter(function(c){ return (c.type||'')!=='hidden'; });
    var checks=ctrls.filter(function(c){ return c.type==='checkbox'||c.type==='radio'; });
    var others=ctrls.filter(function(c){ return c.type!=='checkbox'&&c.type!=='radio'; });
    if(checks.length && checks.some(valued)) return true;
    if(others.some(valued)) return true;
    /* button-style choices: segmented controls, chips, E/M chips */
    if(box.querySelector('.segctrl button.on, .cx-chip.on, .em-chip.selected, [aria-pressed="true"], [aria-checked="true"]')) return true;
    return false;
  }
  function focusTarget(box){
    var c=[].slice.call(box.querySelectorAll('input,select,textarea,button,.em-chip,[tabindex]')).filter(function(x){ return (x.type||'')!=='hidden'&&!x.disabled; })[0];
    return c||box;
  }
  window.findMissingRequired=function(key){
    var card=document.getElementById('sec-'+key); if(!card) return [];
    var roots=[card], blk=document.getElementById(key+'-questionnaire-block');
    if(blk && !card.contains(blk)) roots.push(blk);                     /* block open in its Form Window */
    var out=[];
    roots.forEach(function(root){
      root.querySelectorAll('.req-star').forEach(function(star){
        if(star.closest('.card-hd') || isHiddenPanel(star)) return;
        var box=null;
        var fld=star.closest('.cx-field, .field, .q-row, .fh-row');
        if(fld) box=fld;
        else {
          var title=star.closest('.fieldset-title, .cx-sub, .cx-plain-hd');
          if(title){ var g=title.nextElementSibling; if(g) box={title:title, group:g}; }
        }
        if(!box) return;
        var isFilled = box.group ? filled(box.group) : filled(box);
        if(!isFilled) out.push(box);
      });
    });
    return out;
  };
  function mark(box, on){
    var els = box.group ? [box.title, box.group] : [box];
    els.forEach(function(e){ e.classList.toggle('req-missing', on); });
  }
  /* clear the indicator as soon as the question gets a value */
  function recheck(ev){
    var el=ev.target; if(!el||!el.closest) return;
    var m=el.closest('.req-missing'); if(!m) return;
    setTimeout(function(){
      if(m.classList.contains('fieldset-title')) return;
      var prev=m.previousElementSibling;
      if(prev && prev.classList.contains('fieldset-title')){ if(filled(m)){ m.classList.remove('req-missing'); prev.classList.remove('req-missing'); } }
      else if(filled(m)) m.classList.remove('req-missing');
    },0);
  }
  ['input','change','click'].forEach(function(t){ document.addEventListener(t, recheck, true); });

  window.reqDlgOk=function(){
    var dlg=document.getElementById('reqDlg'); dlg.hidden=true;
    var p=pending; pending=null; if(!p) return;
    p.list.forEach(function(b){ mark(b,true); });
    var first=p.list[0], anchor=first.group ? first.title : first;
