  if(k!==dockKey){dockKey=k;Object.assign(s.style,{left:Math.round(b.left)+'px',top:Math.round(b.top)+'px',width:Math.round(b.width)+'px',height:Math.round(b.height)+'px'});if(isOpen())paintInline();}}
