.req-star{color:var(--rose);margin-left:2px;}

textarea.docbox{width:100%;min-height:84px;border:1px solid var(--line);border-radius:var(--radius-s);padding:9px 10px;resize:vertical;background:var(--paper);color:var(--ink);font-size:14px;line-height:1.55;}
