}
function dirty(){catPaintDirty();}
function catChange(next){
 if(!CAT_SPEC[next]||next===CAT_CUR)return;
 /* finish an in-place edit (e.g. a group name) in the flowsheet it belongs to, before switching */
 const ae=document.activeElement;if(ae&&ae!==document.body&&ae.closest&&ae.closest('#gbody,#defFields')&&ae.blur)ae.blur();
 CAT_STATE[CAT_CUR]=catCollect();                    /* keep what was typed */
 CAT_CUR=next;
 catLoad(CAT_STATE[next]);
 catApply();renderGrid();genPaintErrors();catPaintDirty();renderDefs();
}

/* ---------- save / load ---------- */
/* older saves held one {fields, groups} — that was the Flowsheet category */
function setupMigrate(s){
 if(!s)return null;
 if(s.cats)return s;
 if(s.fields||s.groups){const f=Object.assign({},s.fields||{});delete f.cat;delete f.lcdur;delete f.lcby;   /* filters belong to Lab Comparison */return {def:s.def,cat:'flowsheet',cats:{flowsheet:{fields:f,groups:s.groups||[]}}};}
 return null;
}
function setupLoad(){
 let saved=window.FS_SETUP_SAVED||null;
 if(!saved){try{const all=JSON.parse(localStorage.getItem(FS_SETUP_KEY)||'{}');saved=all[FS_SETUP_DEF]||null;}catch(e){}}
 saved=setupMigrate(saved);
 catDefaults();
 CAT_KEYS.forEach(k=>{
  const st=saved&&saved.cats&&saved.cats[k];
  CAT_BASE[k]=st?{name:catName(k),fields:Object.assign({},CAT_DEFAULT[k].fields,st.fields||{}),groups:CAT_SPEC[k].rows?(st.groups||CAT_DEFAULT[k].groups):[]}:clone(CAT_DEFAULT[k]);
  if('name' in CAT_BASE[k].fields)CAT_BASE[k].fields.name=catName(k);   /* older saves may carry another name */
  CAT_STATE[k]=clone(CAT_BASE[k]);
 });
 CAT_CUR=saved&&CAT_SPEC[saved.cat]?saved.cat:'flowsheet';
 const cs=document.getElementById('catSel');if(cs)cs.value=CAT_CUR;
 catLoad(CAT_STATE[CAT_CUR]);
 CAT_BASE[CAT_CUR]=catCollect();                  /* normalised exactly as the screen reads it */
 catApply();catPaintDirty();
}
function setupCancel(){
 catLoad(CAT_BASE[CAT_CUR]);
 catApply();renderGrid();genPaintErrors();catPaintDirty();
 fsToast(`${catSpec().label}: changes discarded — back to its last saved setup.`);
}
document.getElementById('btnCancel').addEventListener('click',setupCancel);

function fsSetupSave(){
 const e=genPaintErrors();
 if(Object.keys(e).length){
  const first=document.querySelector('#defFields .bad input,#defFields .bad select');
  if(document.getElementById('secGen').classList.contains('collapsed'))secToggle('secGen');
  if(first)first.focus();
  fsToast('Not saved — fix the highlighted fields in General.');return;}
 const mine=catCollect();
 /* only this category changes; every other one goes out exactly as last saved */
 const cats={};CAT_KEYS.forEach(k=>{cats[k]=k===CAT_CUR?mine:CAT_BASE[k];});
 const cfg={def:FS_SETUP_DEF,cat:CAT_CUR,cats,savedAt:new Date().toISOString()};
 let where='';
 try{ if(window.opener&&!window.opener.closed&&typeof window.opener.fsSetupStore==='function'){window.opener.fsSetupStore(FS_SETUP_DEF,cfg);where='note';} }catch(err){}
 if(!where){ try{const all=JSON.parse(localStorage.getItem(FS_SETUP_KEY)||'{}');all[FS_SETUP_DEF]=cfg;localStorage.setItem(FS_SETUP_KEY,JSON.stringify(all));where='local';}catch(err){} }
 CAT_BASE[CAT_CUR]=clone(mine);CAT_STATE[CAT_CUR]=clone(mine);
 catPaintDirty();
 const f=mine.fields,lbl=catSpec().label;
 const pend=catSpec().rows?GROUPS.reduce((a,g)=>a+g.rows.filter(r=>!ROW_NA[r.src]&&(!r.type||(r.type==='form'&&!r.form)||!r.path)).length,0):0;
 const others=CAT_KEYS.filter(k=>k!==CAT_CUR&&sig(CAT_STATE[k])!==sig(CAT_BASE[k])).map(k=>CAT_SPEC[k].label);
 const told=where==='note'
  ?(CAT_CUR==='flowsheet'?` The flowsheet in the visit note is now ${f.editable?'editable':'read-only'}, shows ${f.vncount?'the last '+f.vncount:'all'} visit notes ${f.desc?'most recent first':'oldest first'}${f.vncase?' and opens on the visit’s case':''}.`:'')
  :where==='local'?' Kept in this browser — reopen the setup from the visit note to apply it there.':' Could not reach the visit note or browser storage — the setup will not be kept.';
 fsToast(`${lbl} saved.`+told+(pend?` ${pend} row${pend===1?' still needs':'s still need'} a form or source.`:'')+(others.length?` Not saved yet: ${others.join(', ')}.`:''));
}


/* =====================================================================
   LAB COMPARISON — Duration / Display By and the date-based lab filter
   ---------------------------------------------------------------------
   The two dropdowns live in General (data-k lcdur / lcby) and are saved
   with the Lab Comparison category like any other field. The Lab
   Results section lists the patient's results whose Order Date or
   Collection Date (Display By) falls inside [today − Duration, today],
   both ends included, and re-filters whenever either dropdown changes.
   ===================================================================== */

/* ---------- 1 · dates (pure; no DOM, no data) ----------
   Compared as local calendar dates (midnight), so the start and end days
   are both included whatever the time of day. */
const LC_DUR={'1m':{m:1,l:'1 Month'},'2m':{m:2,l:'2 Months'},'6m':{m:6,l:'6 Months'},'1y':{m:12,l:'1 Year'},'2y':{m:24,l:'2 Years'},'5y':{m:60,l:'5 Years'}};
const LC_BY={order:{k:'ordered',l:'Order Date'},collect:{k:'collected',l:'Collection Date'}};
function lcDay(d){return new Date(d.getFullYear(),d.getMonth(),d.getDate());}
/* always the real current date; LC_NOW exists only so tests can pin "today" */
function lcToday(){const n=window.LC_NOW;return lcDay(Object.prototype.toString.call(n)==='[object Date]'&&!isNaN(n)?new Date(+n):new Date());}
/* whole months back; a day missing in the target month clamps to its last day (Mar 31 − 1 month = Feb 28/29) */
function lcMinusMonths(d,m){const y=d.getFullYear(),mo=d.getMonth()-m,day=d.getDate(),last=new Date(y,mo+1,0).getDate();return new Date(y,mo,Math.min(day,last));}
function lcRangeOf(dur){const end=lcToday();return {start:lcMinusMonths(end,(LC_DUR[dur]||LC_DUR['1m']).m),end};}
/* strict ISO parse — malformed returns null, never a wrong date */
function lcParse(s){if(typeof s!=='string')return null;const m=/^(\d{4})-(\d{2})-(\d{2})$/.exec(s.trim());if(!m)return null;
 const y=+m[1],mo=+m[2]-1,d=+m[3],dt=new Date(y,mo,d);return (dt.getFullYear()===y&&dt.getMonth()===mo&&dt.getDate()===d)?dt:null;}
const lcP2=n=>String(n).padStart(2,'0');
function lcFmt(d){return d?`${lcP2(d.getMonth()+1)}/${lcP2(d.getDate())}/${d.getFullYear()}`:'—';}
function lcInRange(d,start,end){return !!d&&+d>=+start&&+d<=+end;}

/* ---------- 2 · data — read-only, from the Visit Note that opened this tab ----------
   window.LC_SOURCE is written in by fsSetupOpen() (fsLabSource there):
     tests [{id,p,n,u,lo,hi,ref,d}] · visits [{id,vn,date}] ·
     results [{t,vi,v,flag?,ordered,collected}] · origin · mock [{field,label,note}]
   Nothing is invented here; fields the Visit Note had to stand in for are
   listed in `mock` and badged on screen. */
const LC_SRC=(()=>{const s=window.LC_SOURCE||{};const A=x=>Array.isArray(x)?x:[];
 return {tests:A(s.tests),visits:A(s.visits),results:A(s.results),origin:s.origin||'none',mock:A(s.mock),patient:s.patient||null,sources:A(s.sources)};})();
const LC_TEST=new Map(LC_SRC.tests.map(t=>[t.id,t])),LC_VISIT=new Map(LC_SRC.visits.map(v=>[v.id,v]));
const lcEsc=s=>String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
const lcMissing=v=>v===undefined||v===null||(typeof v==='string'&&v.trim()==='');
const lcNum=v=>typeof v==='number'&&isFinite(v)?v:(typeof v==='string'&&/^\s*-?\d+(\.\d+)?\s*$/.test(v)?+v:null);
function lcRef(t){const d=t.d||0,f=x=>typeof x==='number'?x.toFixed(d):x;
 if(t.ref)return t.ref;if(t.lo!==undefined&&t.hi!==undefined)return `${f(t.lo)}–${f(t.hi)}`;if(t.hi!==undefined)return `≤ ${f(t.hi)}`;if(t.lo!==undefined)return `≥ ${f(t.lo)}`;return '';}
function lcFlag(t,r){if(r.flag)return String(r.flag).toUpperCase().charAt(0);const n=lcNum(r.v);if(n===null)return '';
 if(t.hi!==undefined&&n>t.hi)return 'H';if(t.lo!==undefined&&n<t.lo)return 'L';return '';}
const lcVal=(t,v)=>typeof v==='number'?v.toFixed(t.d||0):String(v);

/* ---------- 3 · the filter ---------- */
function lcDur(){const v=genVal('lcdur');return LC_DUR[v]?v:'1m';}
function lcBy(){const v=genVal('lcby');return LC_BY[v]?v:'order';}
function lcFilter(dur,by){
 const {start,end}=lcRangeOf(dur),field=LC_BY[by].k;let skipped=0;const rows=[];
 LC_SRC.results.forEach(r=>{const t=LC_TEST.get(r.t),vi=LC_VISIT.get(r.vi);if(!t||!vi||lcMissing(r.v))return;
  const d=lcParse(r[field]);if(!d){skipped++;return;}
  if(lcInRange(d,start,end))rows.push({r,t,vi,d});});
 rows.sort((a,b)=>(+b.d-+a.d)||a.t.p.localeCompare(b.t.p)||a.t.n.localeCompare(b.t.n));
 return {start,end,rows,skipped};
}
function lcGenSummary(){return `Lab Comparison  ·  ${LC_DUR[lcDur()].l} by ${LC_BY[lcBy()].l}`;}

/* ---------- 4 · render ---------- */
function lcRender(){
 const out=document.getElementById('lcOut');if(!out||catCurrent()!=='lab')return;
 const by=lcBy(),B=LC_BY[by],F=lcFilter(lcDur(),by),range=`${lcFmt(F.start)} – ${lcFmt(F.end)}`;
 document.getElementById('lcRange').innerHTML=`<i class="fa-regular fa-calendar" aria-hidden="true"></i><span><b>${lcFmt(F.start)}</b> – <b>${lcFmt(F.end)}</b> · by ${B.l}</span>`;
 const p=LC_SRC.patient,mock=LC_SRC.mock.find(m=>m.field===B.k);
 document.getElementById('lcSrc').innerHTML=(p?`<span class="lc-pt"><i class="fa-solid fa-user" aria-hidden="true"></i><b>${lcEsc(p.name)}</b>${p.meta?` <span class="mut">${lcEsc(p.meta)}</span>`:''}</span>`:'')
  +`<span class="lc-chip ${LC_SRC.origin==='production'?'prod':'proto'}" title="${lcEsc(LC_SRC.sources.join(' · '))}"><i class="fa-solid fa-database" aria-hidden="true"></i>${LC_SRC.origin==='production'?'Lab service':'Patient chart · this prototype'}</span>`
  +LC_SRC.mock.map(m=>`<span class="lc-chip mock${m===mock?' on':''}" title="${lcEsc(m.note)}"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>Prototype: ${lcEsc(m.label||m.field)}</span>`).join('')
  +`<span class="sp"></span><span class="lc-count" aria-live="polite"><b>${F.rows.length}</b> result${F.rows.length===1?'':'s'} · ${range}</span>`;
 const note=(h,w)=>`<div class="lc-note${w?' warn':''}"><i class="fa-solid ${w?'fa-triangle-exclamation':'fa-circle-info'}" aria-hidden="true"></i><span>${h}</span></div>`;
 document.getElementById('lcNotes').innerHTML=(mock?note(`<b>${B.l} is prototype data.</b> ${lcEsc(mock.note)}`,1):'')
  +(F.skipped?note(`${F.skipped} result${F.skipped===1?' is':'s are'} left out because ${F.skipped===1?'its':'their'} ${B.l.toLowerCase()} is not recorded.`):'');
 const sum=document.getElementById('secLabSum');if(sum)sum.textContent=`${LC_DUR[lcDur()].l}  ·  ${B.l}  ·  ${range}  ·  ${F.rows.length} result${F.rows.length===1?'':'s'}`;
 if(!LC_SRC.results.length){out.innerHTML=`<div class="lc-empty" role="status"><i class="fa-solid fa-flask" aria-hidden="true"></i><b>No lab results on file</b><span>This patient has no lab results in the chart.</span></div>`;return;}
 if(!F.rows.length){
  const sg=Object.keys(LC_DUR).find(k=>lcFilter(k,by).rows.length);
  const hint=sg?` The nearest results fall within <b>${LC_DUR[sg].l}</b>.`:` Nothing within 5 years by ${B.l}.`;
  out.innerHTML=`<div class="lc-empty" role="status"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><b>No lab results in this date range</b><span>No result has an ${B.l} between ${range}.${hint}</span>${sg?`<button class="btn pri" type="button" onclick="lcSetDur('${sg}')">Show ${LC_DUR[sg].l}</button>`:''}</div>`;return;}
 const dcell=(iso,on)=>{const d=lcParse(iso);return `<td class="dt${on?' on':''}">${d?lcFmt(d):'<span class="miss">Not recorded</span>'}</td>`;};
 out.innerHTML=`<div class="lc-scroll" tabindex="0" aria-label="Lab results in range"><table class="lcr"><caption class="sr">Lab results with an ${lcEsc(B.l)} from ${range}</caption><thead><tr>
   <th scope="col" class="${by==='order'?'on':''}">Order Date${by==='order'?' <i class="fa-solid fa-arrow-down-wide-short" aria-hidden="true"></i>':''}</th>
   <th scope="col" class="${by==='collect'?'on':''}">Collection Date${by==='collect'?' <i class="fa-solid fa-arrow-down-wide-short" aria-hidden="true"></i>':''}</th>
   <th scope="col" class="tn">Test</th><th scope="col">Result</th><th scope="col">Unit</th><th scope="col">Reference</th><th scope="col">Visit</th></tr></thead><tbody>`
  +F.rows.map(({r,t,vi})=>{const f=lcFlag(t,r);return `<tr><td class="dt${by==='order'?' on':''}">${lcFmt(lcParse(r.ordered))}</td>${dcell(r.collected,by==='collect')}
   <th scope="row" class="tn"><span class="nm">${lcEsc(t.n)}</span><span class="mt">${lcEsc(t.p)}</span></th>
   <td class="v${f?' ab':''}">${lcEsc(lcVal(t,r.v))}${f?` <span class="fl" aria-label="${f==='H'?'High':f==='L'?'Low':'Abnormal'}">${f}</span>`:''}</td>
   <td class="mut">${lcEsc(t.u||'—')}</td><td class="mut">${lcEsc(lcRef(t)||'—')}</td><td class="mut">${lcEsc(vi.vn)}</td></tr>`;}).join('')
  +'</tbody></table></div>';
}
function lcSetDur(k){const e=genField('lcdur');if(e&&LC_DUR[k]){e.value=k;dirty();lcRender();secSummary();}}
/* either dropdown changing re-filters at once */
document.addEventListener('change',e=>{const k=e.target&&e.target.dataset&&e.target.dataset.k;if((k==='lcdur'||k==='lcby')&&catCurrent()==='lab'){lcRender();secSummary();}});
/* a screen left open past midnight moves with the date */
let lcDayKey=lcFmt(lcToday());
setInterval(()=>{const k=lcFmt(lcToday());if(k!==lcDayKey){lcDayKey=k;lcRender();}},60000);

setupLoad();
paintRoleBtn();renderDefs();renderGrid();secPaint();
genPaintErrors();
document.getElementById('btnSave').addEventListener('click',fsSetupSave);

/* ---------- design-note tooltips: rendered to <body> at fixed position so they
   are never clipped by a scrolling grid, a modal, or an overflow:hidden pane ---------- */
(function(){
  const tip=document.createElement('div');
  tip.id='annTip';
  tip.style.cssText='position:fixed;display:none;z-index:2147483000;width:320px;background:#2a2f3d;color:#fff;'
    +'border-radius:8px;padding:11px 13px;font:12.5px/1.55 "Segoe UI",Roboto,system-ui,sans-serif;'
    +'box-shadow:0 16px 44px rgba(0,0,0,.38);pointer-events:none';
  document.body.appendChild(tip);
  function show(b){
    const card=b.parentElement && b.parentElement.querySelector('.anncard');
    if(!card)return;
    tip.innerHTML=card.innerHTML;
    tip.style.display='block';
    const w=Math.min(320,window.innerWidth-24);
    tip.style.width=w+'px';
    const r=b.getBoundingClientRect();
    let left=r.right-w;
    if(left<12)left=12;
    if(left+w>window.innerWidth-12)left=window.innerWidth-w-12;
    let top=r.bottom+9;
    const h=tip.offsetHeight;
    if(top+h>window.innerHeight-12){
      top=r.top-h-9;
      if(top<12)top=Math.max(12,window.innerHeight-h-12);
    }
    tip.style.left=Math.round(left)+'px';
    tip.style.top=Math.round(top)+'px';
  }
  document.addEventListener('mouseover',e=>{const b=e.target.closest&&e.target.closest('.annb');if(b)show(b);});
  document.addEventListener('mouseout',e=>{const b=e.target.closest&&e.target.closest('.annb');if(b)tip.style.display='none';});
  document.addEventListener('click',e=>{const b=e.target.closest&&e.target.closest('.annb');if(b){e.preventDefault();show(b);}});
  window.addEventListener('scroll',()=>{tip.style.display='none'},true);
})();
</script>
<script id="fsSetupOpener">
/* ==================================================================
   FLOWSHEET SETUP — opened from the blue bar (#fsSetupNav)
   ==================================================================
   The setup screen is carried here in three payload blocks, the same
   way flowsheet_setup.html carries it:
     #fssetupCSS   its stylesheet
     #fssetupBody  everything from <div class="mainwrap"> onward
     #fssetupJS    its script — one configuration per Category
   This layer adds the IMS on Web chrome cloned from this page (blue bar,
   tab strip, app dock), the saved setup (window.FS_SETUP_SAVED) and the
   patient's lab results for Lab Comparison (window.LC_SOURCE), then
   opens it in its own tab — prototype navigation only, as in
   flowsheet_setup.html. Saved setups come back through fsSetupStore:
     { def, cat, cats:{ lab, flowsheet, stimsheet, mrx, vncompare, images } }
   — one flowsheet per category, each named exactly as its category.
   Only cats.flowsheet drives the flowsheet in this Visit Note.

   LAB DATA — three layers, kept apart on purpose:
     A. PRODUCTION  window.IMS_LAB_PROVIDER.getLabSnapshot(patient)
                    If the host provides it, it is used as-is and
                    nothing below runs.
     B. PROTOTYPE   fsLabFromChart(): the lab results already on this
                    Visit Note — the Flowsheet's Lab Order rows
                    (window.FS_LAB_FEED) and the Results section table.
                    Order Date = the date of the visit the lab was
                    ordered from (this build's only lab date field).
     C. MOCK        FS_LAB_MOCK: values this build has no field for.
                    Today only Collection Date. Every mocked field is
                    declared in snapshot.mock and badged on screen.
   ================================================================== */
(function(){
'use strict';

/* ---------- C. MOCK — prototype only; delete when collection dates exist ----------
   Days between ordering and collection, per visit. null = not recorded
   (shows how a missing date is reported). Not used for anything else. */
const FS_LAB_MOCK = {
  collectionLagDays: {
    VN590:0, VN588:0, VN589:1, VN583:0, VN577:2, VN569:0, VN561:1,
    VN554:0, VN546:null, VN538:3, VN530:0, VN522:0, VN515:1, VN00048213:1
  }
};

/* ---------- helpers ---------- */
const p2 = n => String(n).padStart(2,'0');
const iso = d => d.getFullYear() + '-' + p2(d.getMonth()+1) + '-' + p2(d.getDate());
/* MM/DD/YY or MM/DD/YYYY → 'YYYY-MM-DD' (null when malformed) */
function usToIso(s){
  const m = /^\s*(\d{1,2})\/(\d{1,2})\/(\d{2}|\d{4})\s*$/.exec(String(s||''));
  if (!m) return null;
  const y = m[3].length === 2 ? 2000 + +m[3] : +m[3], mo = +m[1]-1, d = +m[2];
  const dt = new Date(y, mo, d);
  return (dt.getFullYear()===y && dt.getMonth()===mo && dt.getDate()===d) ? iso(dt) : null;
}
function addDays(isoStr, n){
  if (!isoStr || n === null || n === undefined) return null;
  const [y,m,d] = isoStr.split('-').map(Number);
  return iso(new Date(y, m-1, d + n));
}
function to24(t){
  const m = /^(\d{1,2}):(\d{2})\s*(AM|PM)$/i.exec(String(t||'').trim());
  if (!m) return '';
  let h = +m[1] % 12; if (/pm/i.test(m[3])) h += 12;
  return p2(h) + ':' + m[2];
}
const txt = el => el ? el.textContent.replace(/\s+/g,' ').trim() : '';

function fsPatient(){
  const nm = document.querySelector('#patientbar .pdb-name');
  const dem = document.querySelector('#patientbar .pb-demog');
  const name = nm ? txt(nm).replace(/\s*\(#?[^)]*\)\s*$/,'') : '';
  const chart = nm && nm.querySelector('.chartno') ? txt(nm.querySelector('.chartno')).replace(/[()]/g,'') : '';
  const dob = dem ? ((/DOB\s*([\d/]+)/.exec(dem.getAttribute('title')||'')||[])[1]||'') : '';
  return name ? { name, meta: [chart && 'Chart ' + chart, dob && 'DOB ' + dob].filter(Boolean).join(' · ') } : null;
}

/* ---------- B. PROTOTYPE — the lab results already on this Visit Note ---------- */
/* panel names follow the Lab Order paths in Flowsheet Setup → Rows */
const FS_PANEL = { r12:'CBC w/ Diff', r13:'Glucose Tolerance', r14:'Urinalysis' };
const RES_PANEL = { 'wbc':'CBC w/ Diff', 'cmp':'Comprehensive Metabolic Panel', 'rapid strep':'Microbiology' };
const IMAGING = /x-?ray|ct\b|mri|ultrasound|imaging|echo/i;

/* the Lab Comparison flowsheet's own data (FS_LAB_DATA: demo set or the
   lab provider) — the same results the flowsheet lists and charts */
function fsLabFromFlowsheet(d){
  const lag = vn => Object.prototype.hasOwnProperty.call(FS_LAB_MOCK.collectionLagDays, vn) ? FS_LAB_MOCK.collectionLagDays[vn] : 0;
  const tests = d.tests.map(t => ({ id:t.id, p:t.panel, n:t.name, u:t.unit || '', lo:t.lo, hi:t.hi, ref:t.ref, d:t.dec || 0 }));
  const visits = d.visits.map(v => ({ id:v.id, vn:v.vn, date:v.date, time:v.time || '', time24:to24(v.time) }));
  const results = [];
  d.tests.forEach(t => d.visits.forEach(v => {
    const val = d.results[t.id] ? d.results[t.id][v.id] : null;
    if (val === null || val === undefined || val === '') return;
    results.push({ t:t.id, vi:v.id, v:val, ordered:v.date, collected:addDays(v.date, lag(v.vn)) });
  }));
  const mock = [{ field:'collected', label:'Collection Date',
    note:'This build stores no collection date, so Collection Date = Order Date + a per-visit lag from FS_LAB_MOCK.' }];
  if (d.source === 'demo') mock.unshift({ field:'results', label:'Demo lab results',
    note:'LAB_DEMO — five demonstration visits shared with the Lab Comparison flowsheet; replace via IMS_LAB_PROVIDER.getLabFlowsheet.' });
  return { origin: d.source === 'demo' ? 'prototype' : 'production', generatedAt:new Date().toISOString(), patient:fsPatient(),
    tests, visits, results, sources:['Lab Comparison flowsheet' + (d.source === 'demo' ? ' · demo data (LAB_DEMO)' : '')], excluded:[], mock };
}

function fsLabFromChart(){
  const flow = typeof window.FS_LAB_DATA === 'function' ? window.FS_LAB_DATA() : null;
  if (flow && Array.isArray(flow.tests)) return fsLabFromFlowsheet(flow);
  const tests = [], visits = [], results = [], sources = [], excluded = [];
  const tById = {}, vById = {};
  const lag = vn => Object.prototype.hasOwnProperty.call(FS_LAB_MOCK.collectionLagDays, vn)
                    ? FS_LAB_MOCK.collectionLagDays[vn] : 0;
  const addVisit = v => { if (!vById[v.id]) { vById[v.id] = v; visits.push(v); } return vById[v.id]; };
  const addTest  = t => { if (!tById[t.id]) { tById[t.id] = t; tests.push(t); } return tById[t.id]; };

  /* 1) Flowsheet — Lab Order rows × visits (live values, edits included) */
  const feed = typeof window.FS_LAB_FEED === 'function' ? window.FS_LAB_FEED() : null;
  if (feed){
    sources.push('Flowsheet · Lab Order rows');
    feed.rows.forEach(r => addTest({ id:'fs-'+r.id, p:FS_PANEL[r.id] || r.group, n:r.lbl, u:r.u || '',
      lo:r.lo, hi:r.hi, d:r.p === undefined ? 0 : r.p }));
    feed.visits.forEach(v => {
      const date = usToIso(v.d); if (!date) return;
      addVisit({ id:'fs-'+v.id, vn:v.vn, date, time:v.t || '', time24:to24(v.t) });
    });
    feed.rows.forEach(r => feed.visits.forEach(v => {
      const c = feed.values[r.id] && feed.values[r.id][v.id];
      const val = c ? c.v : '';
      if (val === '' || val === null || val === undefined || val === false) return;
      const ordered = usToIso(v.d);
      results.push({ t:'fs-'+r.id, vi:'fs-'+v.id, v: typeof val === 'string' && /^-?\d+(\.\d+)?$/.test(val) ? +val : val,
        ordered, collected: addDays(ordered, lag(v.vn)) });
    }));
  }

  /* 2) Results section of this visit — WBC, CMP, Rapid Strep … (imaging left out) */
  const tbl = document.querySelector('#sec-results table.results');
  if (tbl){
    const vn = txt(document.getElementById('vngd-visitnum')) || 'This visit';
    const vdate = usToIso(txt(document.getElementById('vngd-date')));
    let used = 0;
    [...tbl.querySelectorAll('tr')].slice(1).forEach(tr => {
      const td = tr.querySelectorAll('td'); if (td.length < 4) return;
      const name = txt(td[0]);
      if (IMAGING.test(name)) { excluded.push(name + ' (imaging)'); return; }
      const raw = txt(td[1]), refRaw = txt(td[2]), date = usToIso(txt(td[3])) || vdate;
      if (!date) return;
      const m = /^(-?\d+(?:\.\d+)?)\s*([HL])?$/i.exec(raw);
      const rm = /^(-?\d+(?:\.\d+)?)\s*[–-]\s*(-?\d+(?:\.\d+)?)\s*(.*)$/.exec(refRaw);
      const id = 'res-' + name.toLowerCase().replace(/[^a-z0-9]+/g,'-');
      const dec = m && m[1].includes('.') ? m[1].split('.')[1].length : 0;
      addTest({ id, p: RES_PANEL[name.toLowerCase()] || 'Other results', n:name,
        u: rm ? rm[3].trim() : '', lo: rm ? +rm[1] : undefined, hi: rm ? +rm[2] : undefined,
        ref: !rm && refRaw && refRaw !== '—' ? refRaw : undefined, d: dec });
      const v = addVisit({ id:'res-'+vn, vn, date, time:txt(document.getElementById('vngd-starttime')), time24:to24(txt(document.getElementById('vngd-starttime'))) });
      results.push({ t:id, vi:v.id, v: m ? +m[1] : raw, flag: m && m[2] ? m[2].toUpperCase() : undefined,
        ordered: date, collected: addDays(date, lag(vn)) });
      used++;
    });
    if (used) sources.push('Visit Note · Results section (' + vn + ')');
  }

  return {
    origin: 'prototype', generatedAt: new Date().toISOString(), patient: fsPatient(),
    tests, visits, results, sources, excluded,
    mock: [{ field:'collected', label:'Collection Date',
      note:'This build stores no collection date, so Collection Date = Order Date + a per-visit lag from FS_LAB_MOCK (VN546 left blank to show a missing date). Results and Order Dates are the chart’s own.' }]
  };
}

/* ---------- A → B: production provider first, chart data otherwise ---------- */
function fsLabSource(){
  const prov = window.IMS_LAB_PROVIDER;
  if (prov && typeof prov.getLabSnapshot === 'function'){
    try {
      const s = prov.getLabSnapshot(fsPatient());
      if (s && Array.isArray(s.results)) return Object.assign({ origin:'production', mock:[] }, s);
    } catch (e) { console.warn('[flowsheet setup] lab provider failed — using chart data', e); }
  }
  return fsLabFromChart();
}

