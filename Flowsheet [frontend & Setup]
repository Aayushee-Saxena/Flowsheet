/* ==== Resizable panels: Left | Middle | Right ==== */
(function(){
  var LMIN = 140, LMAX = 380, RMIN = 300, MMIN = 440, RMAX_FR = 0.55, STEP = 16;
  var grid, nav, split, sum, splitL, splitR;
  function store(k, v){ try{ if(v == null) localStorage.removeItem(k); else localStorage.setItem(k, String(v)); }catch(e){} }
  function load(k){ try{ var v = parseFloat(localStorage.getItem(k)); return isFinite(v) ? v : null; }catch(e){ return null; } }
  function sideBySide(which){ return which === 'L' ? window.innerWidth > 980 : window.innerWidth > 1100; }
  function rightW(){ return sum.getBoundingClientRect().width; }
  function leftW(){ return nav.getBoundingClientRect().width; }
  function clampL(v){
    var room = grid.getBoundingClientRect().width - (document.getElementById('toolsdock') || {offsetWidth:0}).offsetWidth
               - (sideBySide('R') ? rightW() : 0) - MMIN;
    return Math.round(Math.max(LMIN, Math.min(v, LMAX, Math.max(LMIN, room))));
  }
  function clampR(v){
    var sw = split.getBoundingClientRect().width;
    return Math.round(Math.max(RMIN, Math.min(v, sw * RMAX_FR, Math.max(RMIN, sw - MMIN))));
  }
  function setL(v, save){ v = clampL(v); grid.style.setProperty('--vn-left', v + 'px'); grid.classList.add('vn-has-l');
    splitL.setAttribute('aria-valuenow', v); if(save) store('vn_w_left', v); }
  function setR(v, save){ v = clampR(v); grid.style.setProperty('--vn-right', v + 'px'); grid.classList.add('vn-has-r');
    splitR.setAttribute('aria-valuenow', v); if(save) store('vn_w_right', v); }
  function reset(which){
    if(which === 'L'){ grid.classList.remove('vn-has-l'); grid.style.removeProperty('--vn-left'); store('vn_w_left', null); }
    else { grid.classList.remove('vn-has-r'); grid.style.removeProperty('--vn-right'); store('vn_w_right', null); }
    if(typeof vntUpdateArrows === 'function') vntUpdateArrows();
  }
  function bind(el, which){
    el.setAttribute('aria-valuemin', which === 'L' ? LMIN : RMIN);
    el.setAttribute('aria-valuemax', which === 'L' ? LMAX : 900);
    var startX = 0, startW = 0, id = null;
    el.addEventListener('pointerdown', function(e){
      if(e.button !== 0 || !sideBySide(which)) return;
      e.preventDefault(); id = e.pointerId; el.setPointerCapture(id);
      startX = e.clientX; startW = which === 'L' ? leftW() : rightW();
      el.classList.add('is-drag'); document.body.classList.add('vn-resizing');
      if(typeof closeAllFlyouts === 'function') closeAllFlyouts();
    });
    el.addEventListener('pointermove', function(e){
      if(id === null || e.pointerId !== id) return;
      var dx = e.clientX - startX;
      if(which === 'L') setL(startW + dx, false); else setR(startW - dx, false);
    });
    function end(e){
      if(id === null || (e && e.pointerId !== id)) return;
      try{ el.releasePointerCapture(id); }catch(x){}
      id = null; el.classList.remove('is-drag'); document.body.classList.remove('vn-resizing');
      if(which === 'L') store('vn_w_left', leftW()); else store('vn_w_right', rightW());
      if(typeof vntUpdateArrows === 'function') vntUpdateArrows();
    }
    el.addEventListener('pointerup', end); el.addEventListener('pointercancel', end); el.addEventListener('lostpointercapture', end);
    el.addEventListener('dblclick', function(){ reset(which); });
    el.addEventListener('keydown', function(e){
      var d = e.key === 'ArrowLeft' ? -STEP : e.key === 'ArrowRight' ? STEP : 0;
      if(e.key === 'Home' || e.key === 'End' || e.key === 'Enter'){ if(e.key === 'Enter'){ e.preventDefault(); reset(which); } return; }
      if(!d || !sideBySide(which)) return; e.preventDefault();
      if(which === 'L') setL(leftW() + d, true); else setR(rightW() - d, true);
    });
  }
  function reclamp(){
    if(grid.classList.contains('vn-has-r') && sideBySide('R')) setR(rightW(), false);
    if(grid.classList.contains('vn-has-l') && sideBySide('L')) setL(leftW(), false);
  }
  function init(){
    grid = document.querySelector('.body-grid'); nav = document.getElementById('navrail');
    split = document.querySelector('.center-split'); sum = document.getElementById('sectionSummaryPanel');
    splitL = document.getElementById('vnSplitL'); splitR = document.getElementById('vnSplitR');
    if(!grid || !nav || !split || !sum || !splitL || !splitR) return;
    bind(splitL, 'L'); bind(splitR, 'R');
    var l = load('vn_w_left'), r = load('vn_w_right');
    if(r != null && sideBySide('R')) setR(r, false);
    if(l != null && sideBySide('L')) setL(l, false);
    splitL.setAttribute('aria-valuenow', Math.round(leftW())); splitR.setAttribute('aria-valuenow', Math.round(rightW()));
    splitL.title = splitR.title = 'Drag to resize · double-click to reset';
    var t = null; window.addEventListener('resize', function(){ clearTimeout(t); t = setTimeout(reclamp, 80); });
  }
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
})();
</script>

<script>
/* ==== Mark as Reviewed / Mark as Unreviewed + Reset clears review ====
   State lives in the existing "<key>-reviewed-pill" element (shown = reviewed), so anything that
   re-renders a block from its pristine HTML (Reset) is automatically unreviewed as well. */
(function(){
  var REVIEWER = 'Dr. Gyllenhaal';
  var prevStatus = {};                                   /* section status before it was reviewed */
  function pill(k){ return document.getElementById(k + '-reviewed-pill'); }
  function isReviewed(k){ var p = pill(k); return !!(p && p.style.display !== 'none' && p.style.display !== ''); }
  function menuItem(k){ return document.querySelector('.vn-tools-item[onclick^="markReviewed(\'' + k + '\')"]'); }
  /* action text follows the state */
  function syncAction(k){
    var on = isReviewed(k), btn = document.getElementById(k + '-review-btn'), mi = menuItem(k);
    if(btn){
      btn.style.display = '';
      btn.textContent = on ? 'Mark as Unreviewed' : '✓ Mark as Reviewed';
      btn.classList.toggle('vn-rv-on', on);
      btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      btn.title = on ? 'Return this section to unreviewed' : 'Mark this section as reviewed';
    }
    if(mi){
      var sp = mi.querySelector('span'); if(sp) sp.textContent = on ? 'Mark as Unreviewed' : 'Mark as Reviewed';
      var ic = mi.querySelector('i, svg'); if(ic){ ic.classList.toggle('fa-check', !on); ic.classList.toggle('fa-rotate-left', on); }
    }
  }
  function setReviewedUI(k, on){
    var p = pill(k); if(!p) return false;
    if(on){ p.textContent = '✓ Reviewed by ' + REVIEWER + ' · ' + fmtNowStamp(); p.style.display = 'inline-flex'; }
    else { p.style.display = 'none'; p.textContent = '✓ Reviewed'; }      /* no stale reviewer / timestamp */
    syncAction(k); return true;
  }
  function isSection(k){ return !!document.getElementById('sec-' + k); }

  window.markReviewed = markReviewed = function(key){
    if(!pill(key)) return;
    if(isReviewed(key)){
      setReviewedUI(key, false);
      if(isSection(key)){
        if(key in prevStatus){ setStatus(key, prevStatus[key]); delete prevStatus[key]; }
        onSectionFieldCommitted(key);
      }
      toast((isSection(key) ? (SECTION_TITLES[key] || 'Section') : 'Item') + ' marked as unreviewed.');
      return;
    }
    if(isSection(key) && typeof currentStatus !== 'undefined') prevStatus[key] = currentStatus[key];
    setReviewedUI(key, true);
    if(isSection(key)){ setStatus(key, 'complete'); onSectionFieldCommitted(key); }
  };
  /* review that happens as a side effect (e.g. answering a flagged question) shows the same toggle */
  if(typeof markReviewedSilently === 'function'){
    var ms = markReviewedSilently;
    window.markReviewedSilently = markReviewedSilently = function(key){
      var was = isReviewed(key); var r = ms.apply(this, arguments);
      if(!was && isReviewed(key)){ var p = pill(key); p.textContent = '✓ Reviewed by ' + REVIEWER + ' · ' + fmtNowStamp(); }
      syncAction(key); return r;
    };
  }
  /* Reset: section and every record inside it go back to unreviewed */
  var dr = doResetSection;
  window.doResetSection = doResetSection = function(key){
    var card = document.getElementById('sec-' + key), keys = [key];
    if(card) card.querySelectorAll('[id$="-reviewed-pill"]').forEach(function(p){ var k = p.id.replace(/-reviewed-pill$/, ''); if(keys.indexOf(k) < 0) keys.push(k); });
    keys.forEach(function(k){ if(pill(k)) setReviewedUI(k, false); delete prevStatus[k]; });
    var r = dr.apply(this, arguments);
    /* records re-rendered from pristine HTML: make sure their actions read correctly too */
    if(card) card.querySelectorAll('[id$="-reviewed-pill"]').forEach(function(p){ syncAction(p.id.replace(/-reviewed-pill$/, '')); });
    return r;
  };
  function init(){ document.querySelectorAll('[id$="-reviewed-pill"]').forEach(function(p){ syncAction(p.id.replace(/-reviewed-pill$/, '')); }); }
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
})();
</script>

<script>
/* ==== Section header actions: fixed order in two groups (same elements, same handlers) ==== */
(function(){
  function one(hd, sel){ var l = hd.querySelectorAll(sel); for(var i = 0; i < l.length; i++) if(!l[i].closest('.hl-pop')) return l[i]; return null; }
  function arrange(card){
    var key = card.id.slice(4), hd = card.querySelector(':scope > .card-hd'); if(!hd) return;
    var h3 = hd.querySelector(':scope > h3'); if(!h3) return;
    var L = hd.querySelector(':scope > .hdr-l'), R = hd.querySelector(':scope > .hdr-r');
    if(!L){ L = document.createElement('div'); L.className = 'hdr-l'; }
    if(!R){ R = document.createElement('div'); R.className = 'hdr-r'; }
    /* "Not started" goes; any other status line becomes the "Filled by" info */
    var meta = one(hd, '.meta');
    if(meta && /^\s*not started\s*$/i.test(meta.textContent)){ meta.remove(); meta = null; }
    if(meta && !meta.classList.contains('hdr-filled')){
      meta.classList.add('hdr-filled');
      if(/^\s*filled by/i.test(meta.textContent)) meta.insertAdjacentHTML('afterbegin', '<i class="fa-solid fa-user-pen" aria-hidden="true"></i>');
    }
    /* Save & Next in the header (same function as the section's foot button) */
    var next = one(hd, '.hdr-next-btn');
    if(!next && card.querySelector('.sec-continue [onclick*="saveAndContinueSection"]')){
      next = document.createElement('button'); next.type = 'button'; next.className = 'btn btn-xs hdr-next-btn';
      next.setAttribute('onclick', "saveAndContinueSection('" + key + "')");
      next.setAttribute('aria-label', 'Save & Next'); next.setAttribute('aria-describedby', 'pbiTooltip'); next.setAttribute('data-tt', 'Save & Next');
      next.innerHTML = '<i class="icon fa-solid fa-forward-step" aria-hidden="true"></i>';
      if(typeof bindPbiTooltip === 'function') bindPbiTooltip(next);
    }
    var pos = one(hd, '.ros-bulk-pos'), neg = one(hd, '.ros-bulk-neg'), rsel = one(hd, '.ros-bulk-reset');
    /* Reset Selection wherever a header offers Select All Positive / Negative */
    if(pos && neg && !rsel){
      rsel = document.createElement('button'); rsel.type = 'button'; rsel.className = 'ros-bulk-btn ros-bulk-reset';
      rsel.setAttribute('onclick', "vntResetSel('" + key + "')");
      rsel.setAttribute('aria-label', 'Reset Selection'); rsel.setAttribute('aria-describedby', 'pbiTooltip'); rsel.setAttribute('data-tt', 'Reset Selection');
      rsel.innerHTML = '<i class="fa-solid fa-xmark" aria-hidden="true"></i>';
      if(typeof bindPbiTooltip === 'function') bindPbiTooltip(rsel);
    }
    var left = [one(hd, ':scope > .hl-wrap') || one(hd, '.hdr-l > .hl-wrap'), one(hd, '.hdr-sum-btn'),
                one(hd, '[onclick*="openCopyPanel"]'), one(hd, '[id$="-copied-pill"]'),
                one(hd, '#' + key + '-review-btn'), one(hd, '#' + key + '-reviewed-pill'), meta].filter(Boolean);
    var bulk = [pos, neg, rsel].filter(Boolean);
    var tail = [one(hd, '[onclick*="openFormWindow"]'), next, one(hd, '.hdr-reset-btn') || one(hd, '[onclick*="confirmResetSection"]')].filter(Boolean);
    var known = left.concat(bulk, tail);
    /* section-specific actions (Add to Problem List, Quick Add, NKA, All Normal, Diagnosis tools ...) keep their order, first on the right */
    var extras = [], titleBits = [];
    [].slice.call(hd.querySelectorAll(':scope > *, :scope > .hdr-l > *, :scope > .hdr-r > *, :scope > .ros-bulk > *, :scope > .hdr-r > .ros-bulk > *')).forEach(function(el){
      if(el === h3 || el === L || el === R || el.classList.contains('vnt-cbtn') || el.classList.contains('spacer') || el.classList.contains('ros-bulk') || el.classList.contains('hdr-div')) return;
      if(known.indexOf(el) >= 0 || known.some(function(k){ return k.contains(el); })) return;
      if(el.matches('button, a, .btn, [role="button"]')) extras.push(el); else titleBits.push(el);
    });
    /* title area: collapse chevron, title, its own status pills (e.g. Unsaved) */
    titleBits.forEach(function(el){ hd.insertBefore(el, null); });
    var after = h3; titleBits.forEach(function(el){ after.after(el); after = el; });
    L.innerHTML = ''; R.innerHTML = '';
    left.forEach(function(el){ L.appendChild(el); });
    extras.forEach(function(el){ R.appendChild(el); });
    if(extras.length && tail.length) R.insertAdjacentHTML('beforeend', '<span class="hdr-div" aria-hidden="true"></span>');
    tail.forEach(function(el){ R.appendChild(el); });
    if(bulk.length){ R.insertAdjacentHTML('beforeend', '<span class="hdr-div" aria-hidden="true"></span>'); bulk.forEach(function(el){ R.appendChild(el); }); }
    hd.querySelectorAll(':scope > .spacer, :scope > .ros-bulk').forEach(function(s){ if(!s.children.length) s.remove(); });
    hd.appendChild(L); hd.appendChild(R);
  }
  function all(){ document.querySelectorAll('.card[id^="sec-"]').forEach(arrange); }
  window.vnArrangeHeaders = all;
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function(){ setTimeout(all, 0); }); else setTimeout(all, 0);
  window.addEventListener('load', all);
})();
</script>

