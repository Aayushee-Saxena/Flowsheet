const sectionSummary={};

function ssumExcluded(el){
  return el.closest('[id^="edit-"], .ai-box, .ai-draftbox, .flag-box, .cx-note');
}
function ssumClamp(s, max){ s=s.trim(); return s.length>max ? s.slice(0,max-1).trim()+'…' : s; }

/* Reads only ANSWERED values from a section's card — nothing is inferred. */
function extractSectionFacts(key){
  const card=document.getElementById('sec-'+key);
  if(!card) return [];
  const facts=[];
  const seen=new Set();
  const push=(s)=>{ s=(s||'').replace(/\s+/g,' ').trim(); if(s && !seen.has(s)){ seen.add(s); facts.push(s); } };

  // Narrative paragraphs (MA/provider free-text summaries already on the card)
  card.querySelectorAll('.card-bd > .narrative').forEach(p=>{ if(!ssumExcluded(p)) push(p.textContent); });

  // Static display chip rows (e.g. ROS positive/negative, Medical History chips)
  card.querySelectorAll('.chip-row').forEach(row=>{
    if(ssumExcluded(row)) return;
    const pos=[...row.querySelectorAll('.chip.pos')].map(c=>c.textContent.trim());
    const neg=[...row.querySelectorAll('.chip.neg')].map(c=>c.textContent.trim());
    const plain=[...row.querySelectorAll('.chip:not(.pos):not(.neg)')].map(c=>c.textContent.trim());
    if(pos.length) push('Positive: '+pos.join(', '));
    if(neg.length) push('Negative: '+neg.join(', '));
    if(plain.length) push(plain.join(', '));
  });

  // Interactive toggle chips (Complaints), grouped by their nearest sub-heading
  card.querySelectorAll('.cx-chip.on').forEach(chip=>{
    if(ssumExcluded(chip)) return;
    const sub=chip.closest('.cx-acc-bd')?.querySelector('.cx-sub')&&chip.previousElementSibling===null ? null : null;
    let subEl=chip.closest('.cx-chiprow')?.previousElementSibling;
    while(subEl && !subEl.classList.contains('cx-sub')) subEl=subEl.previousElementSibling;
    const label=subEl ? subEl.textContent.trim() : null;
    push((label?label+': ':'')+chip.textContent.trim());
  });

  // Checked checkboxes (Complaints checklists), grouped by nearest sub-heading
  card.querySelectorAll('.cx-check input[type="checkbox"]:checked').forEach(inp=>{
    const label=inp.closest('label');
    if(!label || ssumExcluded(label)) return;
    let subEl=label.closest('.cx-checklist')?.previousElementSibling;
    while(subEl && !subEl.classList.contains('cx-sub')) subEl=subEl.previousElementSibling;
    const sub=subEl ? subEl.textContent.trim() : null;
    push((sub?sub+': ':'')+label.textContent.trim());
  });

  // Yes/No questions that have been answered
  card.querySelectorAll('.cx-yn').forEach(yn=>{
    const checked=yn.querySelector('input:checked');
    if(!checked || ssumExcluded(yn)) return;
    const qLabel=yn.closest('.cx-field')?.querySelector('label');
    const q=qLabel?qLabel.textContent.trim():'Question';
    push(q+': '+checked.closest('label').textContent.trim());
  });

  // Labeled text / number / date / select fields with a real value
  card.querySelectorAll('.cx-field').forEach(f=>{
    if(ssumExcluded(f)) return;
    const label=f.querySelector('label');
    if(!label) return;
    const q=label.textContent.trim();
    const input=f.querySelector('input[type="text"], input[type="number"], input[type="date"]');
    if(input && input.value && input.value.trim()){ push(q+': '+ssumClamp(input.value,80)); return; }
    const sel=f.querySelector('select');
    if(sel && sel.value){ push(q+': '+sel.options[sel.selectedIndex].textContent.trim()); return; }
    const ta=f.querySelector('textarea');
    if(ta && ta.value && ta.value.trim()){ push(q+': '+ssumClamp(ta.value,100)); }
  });

  // Physical Exam — abnormal systems + normal count
  const peRows=[...card.querySelectorAll('.pe-row')];
  if(peRows.length){
    const abnormal=peRows.filter(r=>r.querySelector('.segctrl .on.abnormal'));
    const normal=peRows.filter(r=>r.querySelector('.segctrl .on.normal'));
    abnormal.forEach(r=>{
      const note=r.querySelector('.pe-note');
      const noteText=note ? (note.querySelector('input')?note.querySelector('input').value:note.textContent) : '';
      push(r.dataset.sys+' (abnormal): '+ssumClamp(noteText||'',90));
    });
    if(normal.length) push(normal.length+' system(s) normal: '+normal.map(r=>r.dataset.sys).join(', '));
  }

  // Results table — flagged values first, then a normal-count note
  const resultRows=[...card.querySelectorAll('table.results tr')].slice(1);
  if(resultRows.length){
    let abnCount=0;
    resultRows.forEach(tr=>{
      const cells=tr.querySelectorAll('td');
      if(!cells.length) return;
      const flagged=tr.querySelector('.flagH');
      if(flagged){ abnCount++; push(cells[0].textContent.trim()+': '+cells[1].textContent.trim()+' (flagged)'); }
    });
    if(resultRows.length-abnCount>0) push((resultRows.length-abnCount)+' result(s) within normal limits');
  }

  // Carried-forward items (Copy from Previous Visit)
  card.querySelectorAll('.carried-forward-item').forEach(it=>{
    if(ssumExcluded(it)) return;
    push('Carried forward: '+it.textContent.replace(/\s+/g,' ').trim());
  });

  // Problem / diagnosis rows
  card.querySelectorAll('.prob-row').forEach(r=>{
    if(ssumExcluded(r)) return;
    const title=r.querySelector('.prob-title');
    if(title) push(title.textContent.trim());
  });

  // Plan-style bullet items (Orders / Medication Changes / Patient Education / Follow-up)
  card.querySelectorAll('.plan-item').forEach(it=>{
    if(ssumExcluded(it)) return;
    push(it.textContent.trim());
  });

  // Billing — E/M level + codes
  const em=card.querySelector('.em-chip.selected');
  if(em) push('E/M level: '+em.textContent.trim().replace(/AI$/,'').trim());
  card.querySelectorAll('.code-chip').forEach(c=>push('Code: '+c.textContent.replace('×','').trim()));

  // Medication Reconciliation summary lines
  card.querySelectorAll('.summary-line .val').forEach(v=>{ if(!ssumExcluded(v)) push(v.textContent.trim()); });

  // Generic fallback: any other filled, enabled textarea not already covered above
  card.querySelectorAll('textarea.docbox').forEach(ta=>{
    if(ssumExcluded(ta) || ta.disabled) return;
    if(ta.closest('.cx-field')) return; // already handled
    if(ta.value && ta.value.trim()) push(ssumClamp(ta.value,140));
  });

  // Attestation
  const attestCheck=card.querySelector('#attestCheck');
  if(attestCheck && attestCheck.checked) push('Provider attestation confirmed.');
  const signedBanner=card.querySelector('#signedBanner');
  if(signedBanner && signedBanner.style.display!=='none' && signedBanner.style.display!=='') push('Visit Note signed.');

  return facts;
}
function factsHash(facts){ return JSON.stringify(facts); }
function formatSummaryText(facts){ return facts.length ? facts.map(f=>'• '+f).join('\n') : ''; }

function ensureSectionSummary(key){
  if(!sectionSummary[key]){
    const facts=extractSectionFacts(key);
    sectionSummary[key]={text:formatSummaryText(facts), edited:false, sourceHash:factsHash(facts)};
  }
  return sectionSummary[key];
}
/* Auto-fit a Summary textarea to its content so nothing is clipped or
   forces an inner scrollbar; the manual resize handle still works as an
   override until the content next changes. */
function autoSizeSsumTextarea(el){
  if(!el) return;
  el.style.height='auto';
  el.style.height=(el.scrollHeight+2)+'px';
}
/* Populate every section's persistent textarea once, on load. */
function renderAllSummaries(){
  document.querySelectorAll('.ssum-textarea[data-key]').forEach(ta=>{
    const rec=ensureSectionSummary(ta.dataset.key);
    ta.value=rec.text;
    autoSizeSsumTextarea(ta);
  });
}
/* Explicit, user-initiated navigation from the Summary panel to a section in
   the 60% Questions/Template area. The Summary panel is never scrolled or
   otherwise touched here — the two panels navigate independently, and this
   is the only way clicking inside the Summary moves the Questions column. */
function goToSection(key){
  if(!key) return;
  const id='sec-'+key;
  const el=document.getElementById(id);
  const center=document.getElementById('center');
  if(!el||!center) return;
  center.scrollTo({top: el.offsetTop - 8, behavior:'smooth'});
  document.querySelectorAll('.nav-item').forEach(r=>r.classList.remove('active'));
  const item=document.querySelector('.nav-item[data-target="'+id+'"]');
  if(item) item.classList.add('active');
  if(window.innerWidth<=1100) document.getElementById('sectionSummaryPanel').classList.remove('open');
  closeAllFlyouts();
}
/* Auto-saves on blur — no separate Save action. Never fires mid-keystroke. */
function onSsumBlur(key, el){
  const rec=ensureSectionSummary(key);
  if(el.value !== rec.text){
    rec.text=el.value;
    rec.edited=true;
  }
}
/* Summary-panel "Save & Next": commits any direct edit made in this
   textarea (same path as blur-autosave) in the background, then navigates
   to the corresponding section -- same mechanism as the Go To icon, only
   triggered here after the save. */
function saveAndContinueSummarySection(key){
  if(!key) return;
  const ta=document.querySelector('.ssum-textarea[data-key="'+key+'"]');
  if(ta) onSsumBlur(key, ta);
  clearSsumUnsaved(key);
  const order=Object.keys(SECTION_TITLES);
  const idx=order.indexOf(key);
  unlockThrough(idx+1);
  const next=order[idx+1];
  if(next) goToSection(next);
}
function refreshSectionSummary(key){
  const rec=ensureSectionSummary(key);
  if(rec.edited){
    const box=document.getElementById('ssum-confirm-'+key);
    if(box) box.classList.add('show');
    return;
  }
  doRefreshSectionSummary(key);
}
function confirmRefreshSectionSummary(key){
  const box=document.getElementById('ssum-confirm-'+key);
  if(box) box.classList.remove('show');
  doRefreshSectionSummary(key);
}
function cancelRefreshSectionSummary(key){
  const box=document.getElementById('ssum-confirm-'+key);
  if(box) box.classList.remove('show');
}
function doRefreshSectionSummary(key){
  const facts=extractSectionFacts(key);
  sectionSummary[key]={text:formatSummaryText(facts), edited:false, sourceHash:factsHash(facts)};
  const ta=document.querySelector('.ssum-textarea[data-key="'+key+'"]');
  if(ta){ ta.value=sectionSummary[key].text; autoSizeSsumTextarea(ta); }
}
/* Called after any committed change in a section's questions. Auto sections
   refresh silently; a manually-edited summary is never touched here. */
function onSectionFieldCommitted(key){
  if(!key) return;
  const facts=extractSectionFacts(key);
  let rec=sectionSummary[key];
  if(!rec){
    sectionSummary[key]={text:formatSummaryText(facts), edited:false, sourceHash:factsHash(facts)};
    rec=sectionSummary[key];
  } else if(!rec.edited){
    rec.text=formatSummaryText(facts);
    rec.sourceHash=factsHash(facts);
  }
  const ta=document.querySelector('.ssum-textarea[data-key="'+key+'"]');
  if(ta && document.activeElement!==ta){ ta.value=rec.text; autoSizeSsumTextarea(ta); }
}
/* Section-level "Save & Next": silently commits the section's current
   answers (same background sync every field-blur already triggers), then --
   only now, on this explicit click -- moves to the next section. Nothing
   moves until the button is clicked. */
function saveAndContinueSection(key){
  if(!key) return;
  onSectionFieldCommitted(key);
  clearUnsaved(key);
  const order=Object.keys(SECTION_TITLES);
  const idx=order.indexOf(key);
  unlockThrough(idx+1);
  const next=order[idx+1];
  if(next) goToSection(next);
}
/* Commit-time delegation for native controls: 'change' covers select/checkbox/radio
   immediately; capturing 'blur' covers text/number/date/textarea when the user
   leaves the field. Neither fires on every keystroke. */
(function(){
  const centerEl=document.getElementById('center');
  if(!centerEl) return;
  function handleCommit(e){
    const card=e.target.closest && e.target.closest('.card[id^="sec-"]');
    if(!card) return;
    const key=card.id.slice(4);
    markPartial(key);
    onSectionFieldCommitted(key);
  }
  centerEl.addEventListener('change', handleCommit);
  centerEl.addEventListener('blur', handleCommit, true);
})();

