/* ---- Question Search (left panel) ---- */
(function(){
  var saved = null, query = '';
  var UNIT_LEGACY = '.cx-plain, .cx-acc, .cx-field, .ros-row, .prob-row, .fieldset-title, .flag-box, textarea.docbox';
  function inner(){ return document.querySelector('#center .center-inner'); }
  function cards(){ return [].slice.call(inner().querySelectorAll(':scope > .card:not(.vss-off)')); }
  function units(card){
    var bd = card.querySelector(':scope > .card-bd'); if(!bd) return [];
    var v = [].slice.call(bd.querySelectorAll('.vq'));
    if(v.length) return v;
    var all = [].slice.call(bd.querySelectorAll(UNIT_LEGACY));
    return all.filter(function(el){ var p = el.parentElement.closest(UNIT_LEGACY); return !p || !bd.contains(p); });
  }
  function txt(el){ return (el.textContent || '').replace(/\s+/g, ' ').toLowerCase(); }
  function mark(root, q){
    var w = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, { acceptNode: function(n){
      var p = n.parentNode; if(!p || /^(TEXTAREA|SELECT|OPTION|SCRIPT|STYLE|MARK)$/.test(p.nodeName)) return NodeFilter.FILTER_REJECT;
      if(p.closest && p.closest('.vq-ctx, svg')) return NodeFilter.FILTER_REJECT;
      return n.nodeValue.toLowerCase().indexOf(q) >= 0 ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_SKIP; } });
    var list = []; while(w.nextNode()) list.push(w.currentNode);
    list.forEach(function(n){
      var s = n.nodeValue, low = s.toLowerCase(), i = 0, j, frag = document.createDocumentFragment();
      while((j = low.indexOf(q, i)) >= 0){
        if(j > i) frag.appendChild(document.createTextNode(s.slice(i, j)));
        var m = document.createElement('mark'); m.className = 'vqs-hit'; m.textContent = s.slice(j, j + q.length); frag.appendChild(m);
        i = j + q.length;
      }
      if(i < s.length) frag.appendChild(document.createTextNode(s.slice(i)));
      n.parentNode.replaceChild(frag, n);
    });
  }
  function unmark(){
    document.querySelectorAll('#center mark.vqs-hit').forEach(function(m){ var p = m.parentNode; p.replaceChild(document.createTextNode(m.textContent), m); p.normalize(); });
  }
  function save(){
    saved = { collapsed: {}, details: [] };
    cards().forEach(function(c){ saved.collapsed[c.id] = c.classList.contains('vnt-collapsed'); });
    inner().querySelectorAll('details').forEach(function(d){ saved.details.push([d, d.open]); });
  }
  function restore(){
    unmark();
    document.querySelectorAll('#center .vqs-hide').forEach(function(el){ el.classList.remove('vqs-hide'); });
    if(saved){
      cards().forEach(function(c){ if(c.id in saved.collapsed && typeof vntToggleCard === 'function') vntToggleCard(c, saved.collapsed[c.id]); });
      saved.details.forEach(function(p){ p[0].open = p[1]; });
    }
    saved = null;
    document.getElementById('vqsEmpty').hidden = true;
  }
  function run(){
    var q = query.trim().toLowerCase();
    if(!q){ restore(); return; }
    if(!saved) save();
    unmark();
    document.querySelectorAll('#center .vqs-hide').forEach(function(el){ el.classList.remove('vqs-hide'); });
    var found = 0;
    cards().forEach(function(card){
      var h3 = card.querySelector(':scope > .card-hd h3');
      var us = units(card), hit = 0;
      if(h3 && txt(h3).indexOf(q) >= 0){                    /* section name matches: show the whole section */
        mark(h3, q); hit = Math.max(1, us.length);
      } else if(!us.length){
        card.classList.add('vqs-hide'); return;
      } else {
        us.forEach(function(u){
          var grp = u.closest('.cx-plain'), hd = grp && grp !== u && grp.querySelector(':scope > .cx-plain-hd');
          var ok = txt(u).indexOf(q) >= 0 || (hd && txt(hd).indexOf(q) >= 0);
          u.classList.toggle('vqs-hide', !ok);
          if(ok){ hit++; mark(u, q); }
        });
        /* hide subsection wrappers that no longer hold a visible question; mark matching subsection headings */
        card.querySelectorAll('.cx-plain').forEach(function(g){
          var inside = us.filter(function(u){ return u !== g && g.contains(u); });
          if(!inside.length) return;
          var vis = inside.some(function(u){ return !u.classList.contains('vqs-hide'); });
          g.classList.toggle('vqs-hide', !vis);
          var hd = g.querySelector(':scope > .cx-plain-hd'); if(vis && hd && txt(hd).indexOf(q) >= 0) mark(hd, q);
        });
        /* eyebrow / questionnaire titles only when something below them is visible */
        card.querySelectorAll('.card-bd .fieldset-title').forEach(function(t){ if(us.indexOf(t) < 0) t.classList.toggle('vqs-hide', !hit); });
      }
      if(!hit){ card.classList.add('vqs-hide'); return; }
      found += hit;
      if(typeof vntToggleCard === 'function') vntToggleCard(card, false);            /* expand a collapsed section with a match */
      card.querySelectorAll('details').forEach(function(d){ if(d.querySelector('mark.vqs-hit')) d.open = true; });
    });
    document.getElementById('vqsEmpty').hidden = found > 0;
  }
  function init(){
    var inp = document.getElementById('vqsInput'), clr = document.getElementById('vqsClear'); if(!inp) return;
    var t = null;
    inp.addEventListener('input', function(){ query = inp.value; clr.hidden = !inp.value; clearTimeout(t); t = setTimeout(run, 120); });
    inp.addEventListener('keydown', function(e){ if(e.key === 'Escape' && inp.value){ e.preventDefault(); clr.click(); } });
    clr.addEventListener('click', function(){ inp.value = ''; query = ''; clr.hidden = true; restore(); inp.focus(); });
    /* switching tabs re-runs the search on the new tab's questions */
    var os = window.vntSwitch;
    window.vntSwitch = function(){ var had = !!query.trim(); if(had) restore(); var r = os.apply(this, arguments); if(had) run(); return r; };
    /* keep jump / Go To targets clear of the sticky search bar */
    var center = document.getElementById('center'), bar = document.querySelector('.vqs-bar'), oto = center.scrollTo.bind(center);
    center.scrollTo = function(a, b){
      if(a && typeof a === 'object' && typeof a.top === 'number'){ a = Object.assign({}, a, { top: Math.max(0, a.top - (bar ? bar.offsetHeight - 10 : 0)) }); return oto(a); }
      return oto(a, b);
    };
  }
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
  window.vqsRun = function(v){ var i = document.getElementById('vqsInput'); i.value = v; i.dispatchEvent(new Event('input')); };
})();

