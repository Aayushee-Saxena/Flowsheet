function annotate(){
 const tbl=document.querySelector('#fsGrid table');if(!tbl)return;
 annOn(tbl.querySelector('thead th:nth-child(3)'),7,'<b>L8 — Change indicators in the header</b><br>An amber dot marks your unsaved edits in that visit; a purple dot marks a change someone else made — hover for who, when and what. Quiet by default, so the grid stays readable, and it is how the flowsheet answers concurrent editing without a diff screen.','#23974 · #33303 · #21456');
 annOn(tbl.querySelector('tbody tr:not(.fs-gp) td.fs-rl'),6,'<b>L3 / L4 — Typed, editable rows</b><br>Every row carries its own type, unit, precision and normal range, and edits inline by type. Computed and auto rows stay read-only. Zero is a value, not a blank.','#4993 · #30681 · #11341 · #19981 · #30450 · #12831 · #6702');
 const cells=tbl.querySelectorAll('tbody tr:not(.fs-gp) td.fs-cellwrap');
 if(cells[3])annOn(cells[3],8,'<b>§5.3 — Provenance + drill-in</b><br>Hover any cell for source, who entered it and when — the metadata that also powers the audit distinction and staleness rules. Double-click a lab, vitals or document cell to open its real editor.','#33303 · #27886 · #21456');
}
function annOn(td,n,html,ier){if(!td||td.querySelector('.fs-ann'))return;
