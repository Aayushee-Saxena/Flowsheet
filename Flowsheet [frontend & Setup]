  var LIST = {header:'-custom-headers', comment:'-custom-comments', footer:'-custom-footers'};
  var LBL = {header:'Header', comment:'Comment', footer:'Footer'};
  function esc(s){ return String(s).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];}); }
  function canEdit(n){ return n.createdBy === VN_CURRENT_USER.id; }       /* the only permission rule */
