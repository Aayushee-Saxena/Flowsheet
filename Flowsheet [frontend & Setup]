/* ---- ROS bulk Select All Positive / Select All Negative --------------
   scopeEl is either the string 'section' (whole Review of Systems) or the
   bulk-select button itself, in which case we scope to that button's own
   .cx-plain subsection only -- never touching any other subsection.
   Classification matches the existing ROS rule: a chip is Positive only
   when it carries data-chip-kind="positive" (i.e. "All Normal"); every
   other ROS chip is Negative. */
function selectAllRos(scopeEl, polarity){
  let container;
  if(scopeEl==='section'){
    container=document.getElementById('sec-ros');
  } else {
    const wrap=scopeEl.closest('.cx-plain');
    container=wrap ? wrap.querySelector('.cx-plain-bd') : null;
  }
  if(!container) return;
  container.querySelectorAll('.cx-chip').forEach(chip=>{
    const isPositive=chip.getAttribute('data-chip-kind')==='positive';
    chip.classList.toggle('on', polarity==='positive' ? isPositive : !isPositive);
  });
  markPartial('ros');
  onSectionFieldCommitted('ros');
  toast('All '+(polarity==='positive'?'positive':'negative')+' chips selected'+(scopeEl==='section'?' across Review of Systems.':' in this subsection.'));
}
