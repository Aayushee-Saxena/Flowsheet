<script>
/* =====================================================================
   [v4] Left panel status icons -- state precedence (every section, every tab).
     Locked   -> red lock only (.vst-lock). Derived from VN_LOCKED[key] (e.g. ROS being
                 edited by another user), currentStatus[key] === 'locked' (e.g. Addendum
                 before sign-off) and isSectionLocked(key).
     Reviewed -> the existing reviewed icon (.vrv-nav) only; Other-user / Saved icons hidden.
                 Derived from the section's "<key>-reviewed-pill" (same source as the header).
     Neither  -> existing icons unchanged (Other user / Saved).
   Nothing is hardcoded; the layer repaints on every action that can change state.
   API: vnNavState.refresh(key) / refreshAll()
   ===================================================================== */
(function(){
  function esc(s){ return String(s).replace(/[&<>"]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }
  function reviewed(k){ var p = document.getElementById(k + '-reviewed-pill'); return !!(p && p.style.display && p.style.display !== 'none'); }
  function lockTip(k){
    if(window.VN_LOCKED && window.VN_LOCKED[k]) return 'Section locked · Currently being worked upon by Allen, Kris.';
    try{ if(typeof currentStatus !== 'undefined' && currentStatus[k] === 'locked') return 'Section locked'; }catch(e){}
    try{ if(typeof isSectionLocked === 'function' && isSectionLocked(k)) return 'Section locked'; }catch(e){}
    return '';
  }
  function paint(k){
    if(!k) return;
    var lt = lockTip(k), rv = !lt && reviewed(k);
    document.querySelectorAll('.nav-item[data-key="' + k + '"]').forEach(function(it){
      if(it.classList.contains('vst-is-locked') !== !!lt) it.classList.toggle('vst-is-locked', !!lt);
      if(it.classList.contains('vst-is-reviewed') !== rv) it.classList.toggle('vst-is-reviewed', rv);
      var el = it.querySelector(':scope > .vst-lock');
      if(!lt){ if(el){ if(typeof hidePbiTooltip === 'function' && el.matches(':hover,:focus')) hidePbiTooltip(); el.remove(); } return; }
      if(el && el.getAttribute('data-tt') === lt) return;
      var tmp = document.createElement('span');
      tmp.innerHTML = '<span class="vst vst-lock" role="img" tabindex="0" aria-label="' + esc(lt) + '" aria-describedby="pbiTooltip" data-tt="' + esc(lt) + '"><i class="fa-solid fa-lock" aria-hidden="true"></i></span>';
      var n = tmp.firstChild;
      if(el) el.replaceWith(n); else it.appendChild(n);
      if(typeof bindPbiTooltip === 'function') bindPbiTooltip(n);
    });
  }
  function all(){ var seen = {}; document.querySelectorAll('.nav-item[data-key]').forEach(function(it){ var k = it.getAttribute('data-key'); if(!seen[k]){ seen[k] = 1; paint(k); } }); }
  window.vnNavState = {refresh: paint, refreshAll: all};

  function wrap(name, after){
    var f = window[name]; if(typeof f !== 'function') return;
    window[name] = function(){ var r = f.apply(this, arguments); try{ after.apply(this, arguments); }catch(e){} return r; };
  }
  function init(){
    var byKey = function(k){ if(typeof k === 'string') paint(k); };
    ['markReviewed', 'markReviewedSilently', 'vnUnreview', 'doResetSection', 'setStatus', 'vnActiveSaved'].forEach(function(n){ wrap(n, byKey); });
    wrap('saveAndContinueSection', function(k){ if(typeof k === 'string') paint(k); all(); });
    try{ if(typeof saveAndContinueSection !== 'undefined') saveAndContinueSection = window.saveAndContinueSection; }catch(e){}
    ['rosSetLocked', 'vntSwitch', 'signNote'].forEach(function(n){ wrap(n, all); });
    if(window.MutationObserver){
      /* reviewed pill shown / hidden by any path */
      new MutationObserver(function(ms){
        var seen = {};
        for(var i = 0; i < ms.length; i++){ var id = ms[i].target && ms[i].target.id; if(id && /-reviewed-pill$/.test(id) && !seen[id]){ seen[id] = 1; paint(id.replace(/-reviewed-pill$/, '')); } }
      }).observe(document.body, {subtree: true, attributes: true, attributeFilter: ['style']});
      /* nav rebuilt (tab switch / search) -> repaint; paint() is idempotent so this settles */
      var nb = document.getElementById('navBody'), t;
      if(nb) new MutationObserver(function(ms){
        for(var i = 0; i < ms.length; i++){ var x = ms[i].target; if(x && x.closest && x.closest('.vst, .vrv-nav')) continue; clearTimeout(t); t = setTimeout(all, 30); return; }
      }).observe(nb, {childList: true, subtree: true});
    }
    all();
  }
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function(){ setTimeout(init, 260); }); else setTimeout(init, 260);
  window.addEventListener('load', function(){ setTimeout(all, 80); });
})();
</script>
