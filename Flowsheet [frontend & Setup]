    var act = own && !ed ? '<div class="vn-ft-act">'+
      '<button type="button" data-ft="edit" aria-label="Edit '+LBL[n.type].toLowerCase()+'" aria-describedby="pbiTooltip" data-tt="Edit"><i class="fa-solid fa-pen" aria-hidden="true"></i></button>'+
      '<button type="button" data-ft="remove" aria-label="Remove '+LBL[n.type].toLowerCase()+'" aria-describedby="pbiTooltip" data-tt="Remove"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button></div>' : '';
    var body = ed ? '<div class="vn-ft-edit"><textarea id="vn-ft-ta-'+n.id+'" aria-label="Edit '+LBL[n.type].toLowerCase()+'">'+esc(n.text)+'</textarea>'+
      '<div class="vn-ft-btns"><button type="button" class="btn btn-xs btn-ghost" data-ft="cancel">Cancel</button><button type="button" class="btn btn-xs btn-primary" data-ft="save">Save</button></div></div>'
      : '<div class="vn-ft-body">'+esc(n.text)+'</div>';
    return '<div class="vn-ft t-'+n.type+(own ? ' is-own' : ' is-ro')+'" data-ft-id="'+n.id+'" data-ft-key="'+key+'" data-created-by="'+esc(n.createdBy)+'">'+meta+act+body+'</div>';
  }
  function render(key){
    var notes = VN_FREETEXT[key] || [];
    Object.keys(LIST).forEach(function(t){
      var box = document.getElementById(key + LIST[t]); if(!box) return;
      box.innerHTML = notes.filter(function(n){ return n.type === t; }).map(function(n){ return noteHtml(key, n); }).join('');
      if(typeof bindPbiTooltip === 'function') box.querySelectorAll('[data-tt]').forEach(bindPbiTooltip);
    });
  }
  function renderAll(){ VN_FREETEXT_SECTIONS.forEach(render); }
  window.vnRenderFreeText = renderAll;
  function add(key, type, text, displayName){
    (VN_FREETEXT[key] = VN_FREETEXT[key] || []).push({id:'ft-' + (++seq), type:type, text:text,
      createdBy:VN_CURRENT_USER.id, createdByName:displayName || VN_CURRENT_USER.name, createdAt:stamp(), updatedAt:null});
    render(key);
  }
  function find(key, id){ return (VN_FREETEXT[key] || []).filter(function(n){ return n.id === id; })[0]; }

  /* Tools > Add Header / Add Comment / Add Footer: owned free-text notes in these sections */
  function hook(fn, type, field){
    var orig = window[fn]; if(typeof orig !== 'function') return;
    window[fn] = function(key){
      if(VN_FREETEXT_SECTIONS.indexOf(key) < 0) return orig.apply(this, arguments);
      var inp = document.getElementById(field + '-' + key), text = (inp && inp.value || '').trim();
      if(!text){ toast(type === 'comment' ? 'Enter a comment before saving.' : 'Enter ' + type + ' text before adding.'); return; }
      var who = type === 'comment' ? (document.getElementById('comment-who-' + key) || {}).value : '';
      add(key, type, text, (who || '').trim() || VN_CURRENT_USER.name);
      if(inp) inp.value = '';
      closeToolsPop(key); markPartial(key);
      toast(LBL[type] + ' added.');
    };
  }
  hook('submitHeader', 'header', 'header-text');
  hook('submitComment', 'comment', 'comment-text');
  hook('submitFooter', 'footer', 'footer-text');

  /* edit / save / cancel / remove -- the controls only exist for the creator, and are re-checked here */
  document.addEventListener('click', function(e){
    var b = e.target.closest && e.target.closest('[data-ft]'); if(!b) return;
    var row = b.closest('.vn-ft'), key = row.dataset.ftKey, n = find(key, row.dataset.ftId); if(!n) return;
    if(!canEdit(n)){ toast('Only ' + n.createdByName + ' can change this note.'); return; }
    var act = b.dataset.ft;
    if(act === 'edit'){ editing[n.id] = true; render(key); var ta = document.getElementById('vn-ft-ta-' + n.id); if(ta){ ta.focus(); ta.setSelectionRange(ta.value.length, ta.value.length); } }
    else if(act === 'cancel'){ delete editing[n.id]; render(key); }
    else if(act === 'save'){
      var v = (document.getElementById('vn-ft-ta-' + n.id) || {}).value || '';
      v = v.trim(); if(!v){ toast('Enter some text, or remove the ' + LBL[n.type].toLowerCase() + '.'); return; }
      if(v !== n.text){ n.text = v; n.updatedAt = stamp(); markPartial(key); toast(LBL[n.type] + ' updated.'); }
      delete editing[n.id]; render(key);
    } else if(act === 'remove'){
      VN_FREETEXT[key] = VN_FREETEXT[key].filter(function(x){ return x !== n; }); render(key); markPartial(key);
      toast(LBL[n.type] + ' removed.');
    }
  });
  /* Reset Section restores the questionnaire block's original markup; notes are re-drawn from the data */
  if(typeof doResetSection === 'function'){
    var dr = doResetSection;
    window.doResetSection = doResetSection = function(key){ var r = dr.apply(this, arguments); if(VN_FREETEXT_SECTIONS.indexOf(key) >= 0) render(key); return r; };
  }

  /* mock sign-in: switch the current user to demonstrate both permission cases */
  function setUser(id){
    var u = VN_USERS[id]; if(!u) return;
    VN_CURRENT_USER = u; editing = {};
    var b = document.getElementById('vnUserBtn');
    if(b){ b.textContent = u.initials; b.title = 'Signed in as ' + u.name; b.setAttribute('aria-label', 'Signed in as ' + u.name); }
    VN_FREETEXT_SECTIONS.forEach(function(k){ var w = document.getElementById('comment-who-' + k); if(w) w.value = u.name; });
    renderAll();
  }
  window.vnSetUser = setUser;
  var menu = null;
  function closeMenu(){ if(menu){ menu.remove(); menu = null; var b = document.getElementById('vnUserBtn'); if(b) b.setAttribute('aria-expanded','false'); } }
  document.addEventListener('click', function(e){
    var b = e.target.closest && e.target.closest('#vnUserBtn');
    if(b){
      if(menu){ closeMenu(); return; }
      var r = b.getBoundingClientRect();
      menu = document.createElement('div'); menu.className = 'vn-user-menu'; menu.setAttribute('role','menu');
      menu.innerHTML = '<div class="hd">Signed in as (prototype)</div>' + Object.keys(VN_USERS).map(function(id){
        var u = VN_USERS[id];
        return '<button type="button" role="menuitemradio" aria-checked="'+(u === VN_CURRENT_USER)+'" data-user="'+id+'"><span class="ck">'+(u === VN_CURRENT_USER ? '✓' : '')+'</span><span>'+esc(u.name)+'<br><span class="sub">'+esc(u.role)+'</span></span></button>';
      }).join('');
      document.body.appendChild(menu);
      menu.style.top = Math.round(r.bottom + 6) + 'px';
      menu.style.left = Math.round(Math.max(8, Math.min(r.right - menu.offsetWidth, window.innerWidth - menu.offsetWidth - 8))) + 'px';
      b.setAttribute('aria-expanded','true');
      return;
    }
    var it = e.target.closest && e.target.closest('.vn-user-menu [data-user]');
    if(it){ setUser(it.dataset.user); closeMenu(); toast('Signed in as ' + VN_CURRENT_USER.name + ' (prototype).'); return; }
    if(menu && !e.target.closest('.vn-user-menu')) closeMenu();
  });
  document.addEventListener('keydown', function(e){ if(e.key === 'Escape') closeMenu(); });

  function init(){ setUser(VN_CURRENT_USER.id); }
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function(){ setTimeout(init, 0); }); else setTimeout(init, 0);
})();
</script>

<script>
/* ==== Left panel: search on demand ==== */
(function(){
  var LIMIT = 5;
  function el(id){ return document.getElementById(id); }
  function hd(){ var i = el('navSearchInput'); return i && i.closest('.nav-hd'); }
  function count(){ return document.querySelectorAll('#navBody .nav-item').length; }   /* entries listed, filtered or not */
  function wide(){ var h = hd(), nav = el('navrail'); if(h && nav) h.classList.toggle('is-wide', nav.getBoundingClientRect().width < 240); }
  window.navSearchOpen = function(){
    var h = hd(), i = el('navSearchInput'), b = el('navSearchBtn'); if(!h || !i) return;
    if(h.classList.contains('is-searching')){ i.focus(); return; }
    h.classList.add('is-searching'); wide();
    if(b) b.setAttribute('aria-expanded','true');
    if(typeof hidePbiTooltip === 'function') hidePbiTooltip();
    i.focus(); i.setSelectionRange(i.value.length, i.value.length);
  };
  window.navSearchClose = function(silent){
    var h = hd(), i = el('navSearchInput'), b = el('navSearchBtn'), r = el('navSearchResults'); if(!h || !i) return;
    i.value = ''; if(typeof runNavSearch === 'function') runNavSearch('');          /* full list back */
    if(r){ r.style.display = 'none'; r.innerHTML = ''; }
    h.classList.remove('is-searching', 'is-wide');
    if(b){ b.setAttribute('aria-expanded','false'); if(!silent && !b.hidden) b.focus(); }
  };
  function update(){
    var b = el('navSearchBtn'); if(!b) return;
    var show = count() > LIMIT;
    b.hidden = !show;
    if(!show && hd() && hd().classList.contains('is-searching')) navSearchClose(true);
  }
  window.navSearchUpdate = update;
  function init(){
    var i = el('navSearchInput');
    if(i) i.addEventListener('keydown', function(e){
      if(e.key === 'Escape'){ e.preventDefault(); if(i.value){ i.value = ''; runNavSearch(''); } else navSearchClose(); }
    });
    var body = el('navBody');
    if(body && window.MutationObserver) new MutationObserver(update).observe(body, {childList:true, subtree:true});
    window.addEventListener('resize', wide);
    update();
  }
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function(){ setTimeout(init, 0); }); else setTimeout(init, 0);
})();
</script>
