    return h || '<div class="upd-empty">No further details were provided with this update.</div>';
  }
  function detail(t, it){
    var st = {reviewed: READ[DATA.pid] && READ[DATA.pid]['rev:' + it.id]};
    var meta = t.hideMeta ? '' : '<div class="upd-d-meta">' + (t.meta || [['Date','date'], ['Received','received'], ['Source','source']]).filter(function(p){ return it[p[1]]; })
      .map(function(p){ return '<div><span class="k">' + esc(p[0]) + '</span>' + esc(it[p[1]]) + '</div>'; }).join('') + '</div>';
    var acts = (t.actions || []).map(function(a, i){ return '<button type="button" class="btn btn-xs" data-upd-action="' + i + '"><i class="fa-solid ' + esc(a.icon || 'fa-arrow-right') + '" aria-hidden="true"></i>' + esc(a.label) + '</button>'; }).join('');
    return '<div class="upd-d-hd"><h3>' + esc(it.title) + '</h3>' + stPill(it) + mockTag() + '</div>' +
      (it.summary && !t.hideMeta ? '<p class="upd-d-sum">' + esc(it.summary) + '</p>' : '') + meta +
      (t.body ? t.body(it, st) : genericBody(it)) + (acts ? '<div class="upd-d-acts">' + acts + '</div>' : '');
  }
  function monthLabel(d){ var x = new Date(d); return isNaN(x) ? 'Earlier' : x.toLocaleDateString('en-US', {month:'long', year:'numeric'}); }

  /* ---------- left panel: one entry per configured type ---------- */
  var STATE = {type:null, id:null, q:''};
  function paintNav(){
    var nav = $('updNav'); if(!nav) return;
    var total = 0;
    nav.innerHTML = types().map(function(t){
      var n = itemsOf(t.key).length, u = unread(t.key); total += u;
      var on = !pane.hidden && STATE.type === t.key;
      return '<button type="button" class="upd-item' + (on ? ' active' : '') + (n ? '' : ' is-empty') + '" role="listitem" data-type="' + esc(t.key) + '"' + (on ? ' aria-current="true"' : '') +
        ' title="' + esc(t.label) + '" aria-label="' + esc(t.label) + ', ' + n + ' item' + (n === 1 ? '' : 's') + (u ? ', ' + u + ' new' : '') + '">' +
        '<i class="fa-solid ' + esc(t.icon || 'fa-bell') + '" aria-hidden="true"' + (t.iconColor ? ' style="color:' + t.iconColor + '"' : '') + '></i><span class="nm">' + esc(t.label) + '</span>' +
        '<span class="upd-ct' + (u ? ' has-new' : '') + '">' + (u ? u + ' new' : n) + '</span></button>';
    }).join('');
    /* indicator from the data itself: any entry → highlighted header + dot; unread → rose dot; nothing → no indicator */
    var items = types().reduce(function(a, t){ return a + itemsOf(t.key).length; }, 0);
    var g = $('updGroup'), dot = $('updTotal');
    if(g){ g.classList.toggle('has-updates', items > 0); g.classList.toggle('has-new', total > 0); }
    if(dot){
      dot.textContent = ''; dot.hidden = !items;
      var msg = !items ? '' : total ? total + ' unread update' + (total === 1 ? '' : 's') : items + ' update' + (items === 1 ? '' : 's') + ', all read';
      dot.title = msg; if(msg) dot.setAttribute('aria-label', msg); else dot.removeAttribute('aria-label');
    }
  }
  document.addEventListener('click', function(e){
    var b = e.target.closest && e.target.closest('#updNav .upd-item'); if(!b) return;
    openPane(b.dataset.type);
  });

  /* ---------- the pane (over the form column; nav + summary stay usable) ---------- */
  var pane = document.createElement('div');
  pane.id = 'vnUpdPane'; pane.className = 'vn-pane side-center'; pane.hidden = true;
  pane.setAttribute('role', 'region'); pane.setAttribute('aria-label', 'Updates');
  var F = vnPaneFollow(pane, function(){ return $('center'); });

  /* ---------- the Updates content: every type as its own section card, stacked in the content
     area exactly like the Visit Note's section cards — the left-panel entries jump to their card
     and the one in view is highlighted (scroll-spy), as the other left-panel items do.
     No internal tab bar: a type is chosen in the left panel, not inside the content. ---------- */
  STATE.open = {};      /* type -> id of the entry shown expanded */
  STATE.qs = {};        /* type -> filter text */
  function cardId(k){ return 'upd-card-' + k; }
  function scroller(){ return pane.querySelector('.upd-cards'); }
  function entryHtml(t, it, open){
    var u = !isRead(DATA.pid, it) || it.__wasNew;
    return '<div class="upd-entry' + (open ? ' open' : '') + '" data-type="' + esc(t.key) + '" data-id="' + esc(it.id) + '">' +
      '<button type="button" class="upd-row' + (u ? ' unread' : '') + (open ? ' on' : '') + '" data-id="' + esc(it.id) + '" aria-expanded="' + open + '">' +
        '<span class="ud" aria-hidden="true"></span><span class="t">' + esc(it.title) + '</span>' + (u ? '<span class="new">NEW<span class="sr-only"> update</span></span>' : '<span></span>') +
        '<span class="m"><span class="mono">' + esc(it.received || it.date) + '</span>' + stPill(it) + '</span>' +
        (it.summary && !open ? '<span class="d">' + esc(it.summary) + '</span>' : '') + '</button>' +
      (open ? '<div class="upd-detail" aria-live="polite">' + detail(t, it) + '</div>' : '') +
    '</div>';
  }
  function cardHtml(t){
    var all = itemsOf(t.key), n = all.length, un = unread(t.key), q = (STATE.qs[t.key] || '').trim().toLowerCase();
    var list = q ? all.filter(function(it){ return (it.title + ' ' + (it.summary || '') + ' ' + (it.status || '')).toLowerCase().indexOf(q) > -1; }) : all;
    var openId = STATE.open[t.key];
    /* New first, then by month — keeps long lists scannable */
    var groups = [], idx = {};
    list.forEach(function(it){ var g = (!isRead(DATA.pid, it) || it.__wasNew) ? 'New' : monthLabel(it.date); if(!(g in idx)){ idx[g] = groups.length; groups.push({name:g, items:[]}); } groups[idx[g]].items.push(it); });
    groups.sort(function(a, b){ return (b.name === 'New') - (a.name === 'New'); });
    var body = !n ? '<div class="upd-empty"><i class="fa-regular fa-folder-open" aria-hidden="true"></i><div>' + esc(t.empty || ('No ' + t.label.toLowerCase() + ' for this patient.')) + '</div></div>'
      : (n > 4 ? '<div class="upd-filter"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" data-upd-filter="' + esc(t.key) + '" placeholder="Filter ' + esc(t.label.toLowerCase()) + '…" aria-label="Filter ' + esc(t.label) + '" value="' + esc(STATE.qs[t.key] || '') + '"></div>' : '') +
        (!list.length ? '<div class="upd-empty">No ' + esc(t.label.toLowerCase()) + ' match “' + esc(STATE.qs[t.key]) + '”.</div>'
         : groups.map(function(g){ return (groups.length > 1 || g.name === 'New' ? '<div class="upd-grp">' + esc(g.name) + ' <span>' + g.items.length + '</span></div>' : '') +
             g.items.map(function(it){ return entryHtml(t, it, it.id === openId); }).join(''); }).join(''));
    return '<div class="card upd-card' + (n ? '' : ' is-empty') + '" id="' + cardId(t.key) + '" data-type="' + esc(t.key) + '">' +
      '<div class="card-hd"><i class="fa-solid ' + esc(t.icon || 'fa-bell') + ' upd-card-ic" aria-hidden="true"></i><h3>' + esc(t.label) + '</h3>' +
        '<span class="meta">' + (n ? n + ' item' + (n === 1 ? '' : 's') + (un ? ' · ' + un + ' new' : '') : 'No items') + '</span><span style="flex:1"></span>' +
        (n ? '<button type="button" class="btn btn-xs" data-upd-allread="' + esc(t.key) + '"' + (un ? '' : ' disabled') + '>Mark all read</button>' : '') + '</div>' +
      '<div class="card-bd upd-card-bd">' + body + '</div></div>';
  }
  function render(){
    var c = vnCtx();
    if(DATA.pid !== c.patientId){ load(); return; }         /* never show another patient's updates */
    var t = typeOf(STATE.type) || types()[0]; STATE.type = t.key;
    Object.keys(STATE.open).forEach(function(k){ if(STATE.open[k] && !find(k, STATE.open[k])) delete STATE.open[k]; });
    var openNow = STATE.open[t.key] ? find(t.key, STATE.open[t.key]) : null;
    if(openNow){ if(!isRead(DATA.pid, openNow)) openNow.__wasNew = true; markRead(DATA.pid, openNow.id); }   /* stays NEW while open */
    STATE.id = STATE.open[t.key] || null;
    var sc = scroller(), top = sc ? sc.scrollTop : 0;
    var fq = document.activeElement && document.activeElement.getAttribute && document.activeElement.getAttribute('data-upd-filter');
    pane.innerHTML =
      '<div class="vn-pane-hd"><h2><i class="fa-solid fa-bell" aria-hidden="true"></i>Updates</h2>' +
      '<span class="upd-mockbar">' + esc(c.patient) + ' <span class="mono">#' + esc(c.patientId) + '</span> ' + mockTag() + '</span><span style="flex:1"></span>' +
      '<button type="button" class="vn-pane-x" data-upd-close aria-label="Close updates" title="Close (Esc)"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button></div>' +
      '<div class="upd-cards">' + types().map(cardHtml).join('') + '</div>';
    sc = scroller(); if(sc){ sc.scrollTop = top; sc.addEventListener('scroll', spy, {passive:true}); }
    if(fq){ var fi = pane.querySelector('[data-upd-filter="' + fq + '"]'); if(fi){ fi.focus(); fi.setSelectionRange(fi.value.length, fi.value.length); } }
    if(typeof renderIcons === 'function') try{ renderIcons(pane); }catch(e){}
    paintNav();
  }
  /* bring a type's card to the top of the content area (the left panel's jump) */
  function showCard(k, smooth){
    var sc = scroller(), card = sc && document.getElementById(cardId(k)); if(!card) return;
    spyLock = Date.now() + 700;
    sc.scrollTo({top:Math.max(0, card.offsetTop - sc.offsetTop - 2), behavior:smooth ? 'smooth' : 'auto'});
    card.classList.remove('upd-flash'); void card.offsetWidth; card.classList.add('upd-flash');
  }
  /* scroll-spy: the card at the top of the content area is the selected left-panel entry */
  var spyLock = 0;
  function spy(){
    if(Date.now() < spyLock) return;
    var sc = scroller(); if(!sc) return;
    var y = sc.getBoundingClientRect().top + 24, cur = null;
    [].forEach.call(sc.querySelectorAll('.upd-card'), function(cd){ if(cd.getBoundingClientRect().top <= y) cur = cd.dataset.type; });
    if(!cur){ var f = sc.querySelector('.upd-card'); cur = f && f.dataset.type; }
    if(sc.scrollTop + sc.clientHeight >= sc.scrollHeight - 2){ var l = sc.querySelectorAll('.upd-card'); if(l.length) cur = l[l.length - 1].dataset.type; }
    if(cur && cur !== STATE.type){ STATE.type = cur; paintNav(); }
  }
  function clearWasNew(){ Object.keys(DATA.items).forEach(function(k){ DATA.items[k].forEach(function(it){ delete it.__wasNew; }); }); }
  function openPane(type, id){
    type = type || STATE.type || types()[0].key;
    var all = itemsOf(type);
    /* like before: arriving on a type shows its first unread (else newest) entry */
    if(id) STATE.open[type] = id;
    else if(!STATE.open[type] && all.length) STATE.open[type] = (all.filter(function(x){ return !isRead(DATA.pid, x); })[0] || all[0]).id;
    STATE.type = type;
    clearWasNew();
    if(pane.parentElement !== document.body) document.body.appendChild(pane);
    /* the Updates entry is now the selected item in the left panel */
    document.querySelectorAll('.nav-item.active').forEach(function(r){ r.classList.remove('active'); });
    var was = !pane.hidden;
    pane.hidden = false; F.start(); render();
    showCard(type, was);
  }
  function closePane(restoreHighlight){
    if(pane.hidden) return;
    pane.hidden = true; F.stop(); clearWasNew(); paintNav();
    var center = $('center');   /* hand the highlight back to the section in view (existing scroll-spy) */
    if(restoreHighlight && center) center.dispatchEvent(new Event('scroll'));
  }

  /* ---------- go to a Visit Note section (shared with Care Gaps) ---------- */
  window.vnGoSection = function(cid){
    closePane(false);
    if(cid === 'patientbar'){ if(typeof focusDemoBar === 'function') focusDemoBar(); return; }
    var t = (window.VNT_TABS || []).filter(function(x){ return x.id !== 'summary' && (x.cards || []).indexOf(cid) > -1; })[0];
    if(t && t.id !== window.vntActive && typeof vntSwitch === 'function') vntSwitch(t.id);
    requestAnimationFrame(function(){ var it = document.querySelector('#navBody .nav-item[data-target="' + cid + '"]'); if(it) it.click(); else if(typeof jump === 'function') jump(cid); });
  };

  pane.addEventListener('click', function(e){
    var el, ent = e.target.closest('.upd-entry'), k = ent ? ent.dataset.type : null, id = ent ? ent.dataset.id : null;
    if((el = e.target.closest('[data-upd-close]'))){ closePane(true); return; }
    if((el = e.target.closest('.upd-row'))){
      clearWasNew();
      STATE.type = k; STATE.open[k] = STATE.open[k] === id ? null : id;      /* a row opens / closes its details in place */
      render(); return;
    }
    if((el = e.target.closest('[data-upd-allread]'))){ var ak = el.getAttribute('data-upd-allread'); itemsOf(ak).forEach(function(it){ markRead(DATA.pid, it.id); }); clearWasNew(); render(); return; }
    if((el = e.target.closest('[data-upd-action]'))){
      var a = ((typeOf(k) || {}).actions || [])[+el.dataset.updAction]; if(!a) return;
      if(a.go) vnGoSection(a.go);
      else if(a.run === 'flowsheet' && (window.vnFlowsheet || window.FS)) (window.vnFlowsheet || window.FS).open();
      else if(a.run === 'docs' && window.vdDocs) vdDocs.open('right');
      return;
    }
    if((el = e.target.closest('[data-upd-tpl]'))){ if(typeof openTemplatePanel === 'function') openTemplatePanel(el.dataset.updTpl); return; }
    if((el = e.target.closest('[data-upd-dismiss]'))){ var box = el.closest('.ai-box'); if(box) box.remove(); return; }
    if((el = e.target.closest('[data-upd-review]'))){ markRead(DATA.pid, 'rev:' + id); render(); if(typeof toast === 'function') toast('AI summary marked as reviewed.'); return; }
    if((el = e.target.closest('[data-upd-hl]'))){
      e.preventDefault();
      var it = find(k, id), h = it && it.highlights[+el.dataset.updHl]; if(!h) return;
      if(h.go) vnGoSection(h.go);
      else if(h.open){ var p = h.open.split(':'); openPane(p[0], p[1]); }
      else if(h.copy && typeof openCopyPanel === 'function'){ closePane(true); openCopyPanel(h.copy); }
    }
  });
  pane.addEventListener('input', function(e){ var fk = e.target.getAttribute && e.target.getAttribute('data-upd-filter'); if(fk){ STATE.qs[fk] = e.target.value; STATE.type = fk; render(); } });
  document.addEventListener('keydown', function(e){ if(e.key === 'Escape' && !pane.hidden && !document.querySelector('.vlg-scrim, .overlay-scrim:not([hidden])')){ e.preventDefault(); closePane(true); } });

  /* ---------- never trap the user: any other navigation closes the pane first ---------- */
  document.addEventListener('click', function(e){
    if(pane.hidden || !e.target.closest) return;
    if(e.target.closest('#navBody .nav-item, #vntScroll .vnt-tab, .vns-go, .ssum-goto-inline, #patientbar .pdb-zh, .cg-go')) closePane(false);
  }, true);
  ['jump', 'goToSection', 'vntSwitch', 'focusDemoBar'].forEach(function(fn){
    var o = window[fn]; if(typeof o !== 'function') return;
    window[fn] = function(){ closePane(false); return o.apply(this, arguments); };
  });

  window.VNUpdates = {
    types: VN_UPDATE_TYPES,
    registerType: function(t){ VN_UPDATE_TYPES.push(t); load(); },            /* config-only extension point */
    addEntries: function(pid, key, entries){ var d = MOCK_UPDATES[pid] = MOCK_UPDATES[pid] || {}; d[key] = (d[key] || []).concat(entries); return load(); },
    removeEntries: function(pid, key, ids){ var d = MOCK_UPDATES[pid]; if(d && d[key]) d[key] = ids ? d[key].filter(function(x){ return ids.indexOf(x.id) < 0; }) : []; return load(); },
    items: function(pid, k){ return pid === DATA.pid ? itemsOf(k) : []; },
    open: openPane, close: closePane, reload: load, source: UpdatesSource,
    refreshLive: function(){
      if(!DATA.pid) return;
      var changed = false;
      VN_UPDATE_TYPES.forEach(function(t){
        if(!t.live) return;
        var next = t.live(DATA.pid).map(function(x){ return Object.assign({pid:DATA.pid, type:t.key}, x); });
        var sig = function(l){ return JSON.stringify(l.map(function(x){ return [x.id, x.summary, x.sectionName]; })); };
        if(sig(next) !== sig(itemsOf(t.key))){ DATA.items[t.key] = next; changed = true; }
      });
      if(changed){ paintNav(); if(!pane.hidden) render(); }
    }
  };
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', load); else load();
})();
</script>

<script>
/* =====================================================================
   CARE GAPS — Sign Off.
   CARE_GAP_RULES is the integration point: each rule = id, title, explain,
   section (Visit Note card id), mandatory, and either
     check:'frontend'  + resolved() evaluated against what is on screen, or
     check:'backend'   — cannot be evaluated here; shown as "Not verified".
   These rules and the sign-off block are a FRONTEND DEMONSTRATION (mock),
   not production care-gap or sign-off validation, and are labelled so.
   ===================================================================== */
(function(){
  function $(id){ return document.getElementById(id); }
  function esc(s){ return String(s == null ? '' : s).replace(/[&<>"]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }
  function reviewed(k){ var p = $(k + '-reviewed-pill'); return !!(p && p.style.display && p.style.display !== 'none'); }
  function hasFacts(k){ try{ return (extractSectionFacts(k) || []).length > 0; }catch(e){ return false; } }
  function statusOf(k){ return (typeof currentStatus !== 'undefined' && currentStatus[k]) || ''; }
  function titleOf(cid){
    if(cid === 'patientbar') return 'Patient Demographics';
    var it = document.querySelector('.nav-item[data-target="' + cid + '"]'); return it ? (it.getAttribute('title') || '').trim() : cid.replace(/^sec-/, '');
  }
  /* sample "required sections" list for the demo rule (production: configured per visit type / specialty) */
  var REQUIRED_SECTIONS = ['maofrecord', 'maros', 'billing'];
  function incompleteRequired(){ return REQUIRED_SECTIONS.filter(function(k){ return $('sec-' + k) && statusOf(k) !== 'complete' && !hasFacts(k); }); }

  var CARE_GAP_RULES = window.CARE_GAP_RULES = [
    {id:'dx', title:'Missing Diagnosis', explain:'No diagnosis has been recorded for this visit.', section:'sec-assess', mandatory:true, check:'frontend',
     resolved:function(){ return (typeof dxCount !== 'undefined' && dxCount > 0) || !!document.querySelector('#sec-assess .prob-row'); }},
    {id:'ap', title:'Incomplete Assessment & Plan', explain:'The assessment or treatment plan needs to be completed — finish it and use “Mark as Reviewed” in Assessment & Plan.', section:'sec-apsection', mandatory:true, check:'frontend',
     resolved:function(){ return statusOf('apsection') === 'complete' || reviewed('apsection'); }},
    {id:'medrev', title:'Medication Review Pending', explain:'Medication review has not been completed — use “Mark as Reviewed” in Medications.', section:'sec-medrec', mandatory:true, check:'frontend',
     resolved:function(){ return reviewed('medrec'); }},
    {id:'allrev', title:'Missing Allergy Review', explain:'Allergy information requires review — use “Mark as Reviewed” in Allergies.', section:'sec-allergy', mandatory:true, check:'frontend',
     resolved:function(){ return reviewed('allergy'); }},
    {id:'sections', title:'Unsigned Visit Note Section', mandatory:true, check:'frontend',
     explain:function(){ var x = incompleteRequired(); return x.length ? 'Required section' + (x.length === 1 ? '' : 's') + ' still incomplete: ' + x.map(function(k){ return titleOf('sec-' + k); }).join(', ') + '.' : 'All required sections have content.'; },
     section:function(){ var x = incompleteRequired(); return 'sec-' + (x[0] || REQUIRED_SECTIONS[0]); },
     resolved:function(){ return incompleteRequired().length === 0; }},
    {id:'quality', title:'Quality-measure / preventive care gaps', explain:'Payer and quality-measure gaps (for example overdue screenings) need backend care-gap rules and patient history. They are not evaluated in this prototype.', section:null, mandatory:false, check:'backend'}
  ];
  function val(v){ return typeof v === 'function' ? v() : v; }
  function evaluate(){
    return CARE_GAP_RULES.map(function(r){
      var state = r.check === 'backend' ? 'nv' : (r.resolved() ? 'res' : 'out');
      return {rule:r, state:state, section:val(r.section), explain:val(r.explain)};
    });
  }
  var LAST = [];
  function outstanding(list){ return (list || LAST).filter(function(g){ return g.state === 'out'; }); }

  function render(){
    var list = LAST = evaluate(), box = $('careGaps');
    var out = outstanding(list), res = list.filter(function(g){ return g.state === 'res'; }), nv = list.filter(function(g){ return g.state === 'nv'; });
    if(box){
      var order = out.concat(nv, res);
      box.classList.toggle('has-out', out.length > 0);
      box.innerHTML =
        '<div class="cg-hd"><h4 id="careGapsTitle"><i class="fa-solid ' + (out.length ? 'fa-triangle-exclamation' : 'fa-circle-check') + '" aria-hidden="true"></i>Care Gaps</h4>' +
        '<span class="cg-sum" aria-live="polite"><b>' + out.length + '</b> outstanding · ' + res.length + ' resolved' + (nv.length ? ' · ' + nv.length + ' not verified' : '') + '</span>' +
        '<span style="flex:1"></span><span class="vn-mock-tag">Sample rules</span></div>' +
        '<div class="cg-note">Demonstration only: these care-gap rules run in the browser against what is entered on this page. They are not clinical findings and not production sign-off validation.</div>' +
        '<ul class="cg-list">' + order.map(function(g){
          var r = g.rule, ic = g.state === 'out' ? 'fa-circle-exclamation' : (g.state === 'res' ? 'fa-circle-check' : 'fa-circle-question');
          var st = g.state === 'out' ? '<span class="cg-st out">Outstanding</span>' : (g.state === 'res' ? '<span class="cg-st res">Resolved</span>' : '<span class="cg-st nv">Not verified</span>');
          return '<li class="cg-item is-' + g.state + '" data-gap="' + esc(r.id) + '">' +
            '<i class="fa-solid ' + ic + ' cg-ic" aria-hidden="true"></i>' +
            '<div class="cg-t">' + esc(r.title) + st + '<span class="cg-req">' + (r.mandatory ? 'Required before sign off' : 'Advisory') + '</span></div>' +
            '<div class="cg-x">' + esc(g.explain) + '</div>' +
            (g.section ? '<div class="cg-sec">Section: ' + esc(titleOf(g.section)) + '</div>' : '<div class="cg-sec">Requires backend care-gap service</div>') +
            (g.section ? '<button type="button" class="btn btn-xs cg-go" data-cg-go="' + esc(g.section) + '" aria-label="Go to ' + esc(titleOf(g.section)) + ' for ' + esc(r.title) + '">Go to section<i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>' : '') +
            '</li>';
        }).join('') + '</ul>' + (box.__blocked && out.some(function(g){ return g.rule.mandatory; }) ? blockedMsg(out) : '');
    }
    paintBadges(out.length);
    if(window.VNUpdates && typeof VNUpdates.refreshLive === 'function') VNUpdates.refreshLive();   /* Updates → Care Gaps follows the rules */
  }
  function blockedMsg(out){
    var m = out.filter(function(g){ return g.rule.mandatory; });
    return '<div class="cg-blocked" role="alert"><b>Sign off blocked (demo validation).</b> Resolve ' + m.length + ' required care gap' + (m.length === 1 ? '' : 's') + ' first: ' +
      esc(m.map(function(g){ return g.rule.title; }).join(', ')) + '. This is a frontend mock of the intended rule, not production sign-off validation.</div>';
  }
  function badgeHtml(n){
    return n ? '<i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>' + n
             : '<i class="fa-solid fa-check" aria-hidden="true"></i>';
  }
  function paintBadges(n){
    var label = n ? n + ' outstanding care gap' + (n === 1 ? '' : 's') + ' (sample rules)' : 'All care gaps resolved (sample rules)';
    var hosts = [].slice.call(document.querySelectorAll('.nav-item[data-key="attest"]'));
    var tab = (window.VNT_TABS || []).filter(function(t){ return t.cards.indexOf('sec-attest') > -1; })[0];
    if(tab && $('vntTab-' + tab.id)) hosts.push($('vntTab-' + tab.id));
    hosts.forEach(function(h){
      var b = h.querySelector(':scope > .cg-badge');
      if(!b){ b = document.createElement('span'); b.className = 'cg-badge'; b.setAttribute('aria-describedby', 'pbiTooltip'); h.appendChild(b); }
      /* on the Visit Note tab the icon alone marks it (no number beside tab labels); the left panel keeps the count */
      b.classList.toggle('ok', !n); b.innerHTML = h.classList.contains('vnt-tab') ? badgeHtml(0).replace('fa-check', n ? 'fa-triangle-exclamation' : 'fa-check') : badgeHtml(n);
      b.setAttribute('data-tt', label); b.setAttribute('role', 'status'); b.setAttribute('aria-label', label);
      if(typeof bindPbiTooltip === 'function') bindPbiTooltip(b);
    });
  }
  var T = 0; function schedule(){ clearTimeout(T); T = setTimeout(render, 200); }
  window.vnCareGaps = {rules:CARE_GAP_RULES, evaluate:evaluate, refresh:render, outstanding:function(){ return outstanding(evaluate()); }};

  /* interactions */
  document.addEventListener('click', function(e){
    var b = e.target.closest && e.target.closest('[data-cg-go]'); if(!b) return;
    if(typeof vnGoSection === 'function') vnGoSection(b.getAttribute('data-cg-go'));
  });
  /* keep in sync with the demo state of the note */
  ['click', 'change', 'input'].forEach(function(ev){ document.addEventListener(ev, function(e){ if(!(e.target.closest && e.target.closest('#careGaps'))) schedule(); }, true); });
  ['setStatus', 'markReviewed', 'onSectionFieldCommitted'].forEach(function(fn){
    var o = window[fn]; if(typeof o !== 'function') return;
    window[fn] = function(){ var r = o.apply(this, arguments); schedule(); return r; };
  });

  /* Sign Off: mock validation — mandatory outstanding gaps block signing, with an explanation */
  var oSign = window.signNote;
  window.signNote = function(){
    var out = outstanding(evaluate()).filter(function(g){ return g.rule.mandatory; }), box = $('careGaps');
    if(out.length){
      if(box){ box.__blocked = true; render(); box.scrollIntoView({behavior:'smooth', block:'start'}); }
      if(typeof toast === 'function') toast('Sign off blocked (demo validation): ' + out.length + ' required care gap' + (out.length === 1 ? '' : 's') + ' outstanding.');
      return;
    }
    if(box) box.__blocked = false;
    return oSign.apply(this, arguments);
  };

  function init(){ render(); }
  if(document.readyState === 'complete') setTimeout(init, 0); else window.addEventListener('load', function(){ setTimeout(init, 0); });
})();
</script>

<script>
/* =====================================================================
   Flowsheet tab — after Billing & Care Coordination in the Visit Note tab
   bar. Opens the existing Flowsheet (window.FS) docked into the content
   area; the section list, the form and the Visit Note Summary are hidden
   (not removed) while it is active, and come back on any other tab.
   ===================================================================== */
(function(){
  var on = false, prev = null, leaving = false;
  function tabs(id){
    document.querySelectorAll('.vnt-tab').forEach(function(b){
      var a = b.dataset.tab === id;
      b.classList.toggle('on', a); b.setAttribute('aria-selected', a ? 'true' : 'false'); b.tabIndex = a ? 0 : -1;
      if(a && typeof vntRevealTab === 'function') vntRevealTab(b);
    });
  }
  function enter(){
    if(!window.FS) return;
    prev = window.vntActive || prev || 'marecord';
    if(on){ tabs('flowsheet'); return; }
    if(typeof closeAllFlyouts === 'function') try{ closeAllFlyouts(); }catch(e){}
    try{ if(window.VNUpdates) VNUpdates.close(); }catch(e){}
    try{ if(window.vdDocs && vdDocs.state && vdDocs.state().open) vdDocs.close(); }catch(e){}
    leaving = true; try{ if(FS.isOpen()) FS.close(); } finally { leaving = false; }      /* the dock-icon window gives way */
    on = true; document.body.classList.add('vn-fs-tab');
    tabs('flowsheet');
    FS.open();
  }
  function exit(){
    if(!on) return;
    on = false; document.body.classList.remove('vn-fs-tab');
    leaving = true; try{ if(FS.isOpen()) FS.close(); } finally { leaving = false; }
  }
  var orig = window.vntSwitch;
  window.vntSwitch = function(id){
    if(id === 'flowsheet'){ enter(); return; }
    exit();
    return orig.apply(this, arguments);
  };
  try{ vntSwitch = window.vntSwitch; }catch(e){}
  /* the Flowsheet's own close (×, Close, Save & Close, Esc) returns to the previous tab */
  window.vnFsTabLeave = function(){ if(!on || leaving) return; window.vntSwitch(prev || 'marecord'); };
  window.vnFlowsheetTab = { open: enter, close: function(){ window.vnFsTabLeave(); }, isOpen: function(){ return on; } };
  if(!window.vnFlowsheet) window.vnFlowsheet = window.vnFlowsheetTab;      /* Updates → "View in Flowsheet" */

  /* ---- right panel: Flowsheet icon in the Visit Note Summary header, beside Documents (as in the reference) ---- */
  var ICON = '<svg viewBox="0 0 24 24" class="vd-svg" aria-hidden="true"><rect x="3.5" y="4.5" width="17" height="15" rx="2" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M3.5 9.5h17M3.5 14.5h17M9.5 9.5v10" stroke="currentColor" stroke-width="1.5"/></svg>';
  function iconBtn(){
    var b = document.createElement('button');
    b.type = 'button'; b.id = 'vnFsIc'; b.className = 'btn btn-xs vd-hic vn-fs-ic';
    b.setAttribute('aria-label', 'Flowsheet — open in the Visit Note'); b.setAttribute('data-tt', 'Flowsheet');  
    b.setAttribute('aria-describedby', 'pbiTooltip'); b.setAttribute('aria-pressed', 'false');
    b.innerHTML = ICON;
    b.addEventListener('click', function(){ enter(); });
    if(typeof window.bindPbiTooltip === 'function') try{ window.bindPbiTooltip(b); }catch(e){}
    return b;
  }
  function place(){
    var slot = document.querySelector('#sectionSummaryPanel .ssum-panel-hd > .vd-hdslot'); if(!slot) return false;
    var me = document.getElementById('vnFsIc') || iconBtn(), docs = document.getElementById('vdIcR');
    if(docs && docs.parentElement === slot){ if(docs.nextElementSibling !== me) docs.after(me); }
    else if(me.parentElement !== slot) slot.appendChild(me);
    return true;
  }
  (function tryPlace(n){ if(place()){
      var hd = document.querySelector('#sectionSummaryPanel .ssum-panel-hd');
      if(hd && window.MutationObserver) new MutationObserver(function(){ place(); }).observe(hd, {childList: true, subtree: true});
      return; }
    if(n < 60) setTimeout(function(){ tryPlace(n + 1); }, 150); })(0);
})();
</script>
