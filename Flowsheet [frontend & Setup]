<script>
/* =====================================================================
   PATIENT REVIEW (right panel, beside the Documents icon)
   ---------------------------------------------------------------------
   * Icon: same .vd-hic button + tooltip as the Documents icon, placed in
     the same "Visit Note Summary" header slot, directly before it.
   * Window: the Documents shell (.vd-modal .vd-fixed[data-side=right]),
     re-measured every frame to cover exactly the summary pane -- the
     form on the left stays fully usable. Close = X or Close button.
     Opening one of Patient Review / Documents (right) closes the other.
   * Content is read live from the Visit Note (allergy entries, MX.meds(),
     VS records) and refreshes while open; each section collapses and has
     "Go to This Section", which switches tab and opens that section in
     the Visit Note without closing the window.
   ===================================================================== */
(function(){
  var esc = function(s){ return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); };
  var ICON = '<svg viewBox="0 0 24 24" class="vd-svg" aria-hidden="true"><rect x="5" y="4" width="14" height="17" rx="2" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M9 4V3h6v1" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M8 13h2l1.2-2.6 1.8 5 1.3-2.4H16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
  var X = '<svg viewBox="0 0 24 24" class="vd-svg"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>';
  var CHEV = '<svg viewBox="0 0 24 24" class="vd-svg"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
  var SECS = [{k: 'allergy', t: 'Allergies', card: 'sec-allergy'}, {k: 'meds', t: 'Current Medications', card: 'sec-medrec'}, {k: 'vitals', t: 'Vital Signs', card: 'sec-vitals'}];
  var open = false, side = 'right', raf = 0, last = '', collapsed = {}, M = null;

  /* ---------- data, read from the Visit Note itself ---------- */
  function allergies(){
    return [].slice.call(document.querySelectorAll('#sec-allergy .allergy-entry')).map(function(a){
      var nm = a.querySelector('.allergy-name'), meta = a.querySelector('.allergy-entry-meta');
      var parts = meta ? meta.textContent.replace(/\s+/g, ' ').trim().split(' · ') : [];
      var st = a.querySelector('[id$="-status-chip"]');
      return {name: nm ? nm.textContent.trim() : '', status: st ? st.textContent.trim() : (parts[0] || ''), type: parts[1] || '', cat: parts[2] || '',
              date: parts[3] || '', rxn: a.getAttribute('data-reaction') || '', visit: a.getAttribute('data-this-visit') === '1'};
    }).filter(function(x){ return x.name; });
  }
  function meds(){
    var list = []; try{ list = (window.MX && MX.meds) ? MX.meds() : []; }catch(e){}
    return list.filter(function(m){ return !m.status || /active/i.test(m.status); });
  }
  var VK = [['bp', 'Blood Pressure'], ['pulse', 'Pulse'], ['temp', 'Temperature'], ['rr', 'Respiratory Rate'],
            ['height', 'Height'], ['weight', 'Weight'], ['bmi', 'BMI'], ['o2', 'SpO₂']];
  function fmtV(k, e){
    if(!e || e.nr) return '';
    if(k === 'bp') return e.sys || e.dia ? (e.sys || '') + '/' + (e.dia || '') + ' <small>mmHg</small>' : '';
    if(!e.val) return '';
    if(k === 'height' && e.unit === 'ft') return esc(e.val) + ' <small>ft</small> ' + esc(e.val2 || 0) + ' <small>in</small>';
    var u = {pulse: 'bpm', rr: 'br/min', bmi: 'kg/m²', o2: '%'}[k] || (e.unit ? (k === 'temp' ? '°' + e.unit : e.unit) : '');
    return esc(e.val) + (u ? ' <small>' + esc(u) + '</small>' : '');
  }
  function vitals(){
    var recs = []; try{ recs = (window.VS && VS.records) ? VS.records().slice() : []; }catch(e){}
    var cur = recs.filter(function(r){ return r.visit === 'cur' || r.inVisit; });
