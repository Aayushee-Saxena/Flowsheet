    img: '<svg viewBox="0 0 24 24" class="vd-svg"><rect x="3" y="4" width="18" height="16" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="9" cy="10" r="2" fill="currentColor"/><path d="M4 18l5-5 4 4 3-3 4 4" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>',
    dl: '<svg viewBox="0 0 24 24" class="vd-svg"><path d="M12 3v11m0 0l-4.5-4.5M12 14l4.5-4.5M4 17v3h16v-3" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    info: '<svg viewBox="0 0 24 24" class="vd-svg"><circle cx="12" cy="5" r="2" fill="currentColor"/><path d="M9 10h4v9h2" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    trash: '<svg viewBox="0 0 24 24" class="vd-svg"><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>',
    up: '<svg viewBox="0 0 24 24" class="vd-svg"><path d="M12 19V5m0 0l-6 6m6-6l6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    down: '<svg viewBox="0 0 24 24" class="vd-svg"><path d="M12 5v14m0 0l-6-6m6 6l6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    minus: '<svg viewBox="0 0 24 24" class="vd-svg"><path d="M5 12h14" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>',
    plus: '<svg viewBox="0 0 24 24" class="vd-svg"><path d="M5 12h14M12 5v14" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>',
    side: '<svg viewBox="0 0 24 24" class="vd-svg"><rect x="3" y="4" width="18" height="16" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M9 4v16" stroke="currentColor" stroke-width="1.7"/></svg>',
    find: '<svg viewBox="0 0 24 24" class="vd-svg"><circle cx="10.5" cy="10.5" r="6" fill="none" stroke="currentColor" stroke-width="2"/><path d="M15 15l5 5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>',
    print: '<svg viewBox="0 0 24 24" class="vd-svg"><path d="M7 8V3h10v5M7 17H4v-7h16v7h-3M7 14h10v7H7z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>',
    out: '<svg viewBox="0 0 24 24" class="vd-svg"><path d="M14 4h6v6M20 4l-9 9M18 14v6H4V6h6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    x: '<svg viewBox="0 0 24 24" class="vd-svg"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>',
    chevL: '<svg viewBox="0 0 24 24" class="vd-svg"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    chevR: '<svg viewBox="0 0 24 24" class="vd-svg"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    folder: '<svg viewBox="0 0 24 24" class="vd-svg"><path d="M3 6.5A1.5 1.5 0 0 1 4.5 5H10l2 2h7.5A1.5 1.5 0 0 1 21 8.5v9A1.5 1.5 0 0 1 19.5 19h-15A1.5 1.5 0 0 1 3 17.5z" fill="currentColor"/></svg>',
    docs: '<svg viewBox="0 0 24 24" class="vd-svg"><path d="M8 3h7l4 4v11H8z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M15 3v4h4" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M5 7v14h11" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M11 11h5M11 14h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>'
  };
  const noteB = t => (cfg.note ? cfg.note(t) : '');

  /* ---------- toast ---------- */
  function toast(m){
    let t = document.getElementById('vdToast');
    if (!t){ t = document.createElement('div'); t.id = 'vdToast'; document.body.appendChild(t); }
    t.innerHTML = m; t.classList.add('on'); clearTimeout(toast.t); toast.t = setTimeout(() => t.classList.remove('on'), 3200);
  }

  /* ==================================================================
     The modal — one node, moved between panes
     ================================================================== */
  const M = document.createElement('div'); M.id = 'vdModal'; M.className = 'vd-modal';
  M.setAttribute('role', 'dialog'); M.setAttribute('aria-label', 'Documents');
  const docs = () => D.docs[S.folder] || [];
  const curDoc = () => S.doc ? (D.docs[S.doc.folder] || [])[S.doc.i] : null;

  function treeHTML(){
    const q = S.fq.trim().toLowerCase();
    const list = D.folders.filter(f => !q || f.toLowerCase().includes(q));
    return list.map(f => `<button type="button" class="vd-f${f === S.folder ? ' on' : ''}${has(f) ? ' has' : ''}" data-vd-folder="${esc(f)}" title="${esc(f)}">
        <span class="vd-chev">${D.kids.has(f) ? SV.chevR : ''}</span><span class="vd-fi">${SV.folder}</span><span class="vd-fn">${esc(f)}</span></button>`).join('')
      || '<div class="vd-none">No folder matches.</div>';
  }
  function listHTML(){
    const d = docs();
    const rows = d.length ? d.map((x, i) => `<tr class="vd-row${S.last && S.last.folder === S.folder && S.last.i === i ? ' last' : ''}" data-vd-doc="${i}" tabindex="0" title="Open ${esc(x.f)}">
        <td class="c-f"><span class="vd-ft-ic${x.img ? ' img' : ''}">${x.img ? SV.img : SV.pdf}</span><span class="vd-fname">${esc(x.f)}</span><span class="vd-fmeta">${x.svc} · ${x.kb}</span></td>
        <td class="c-s">${x.svc}</td><td class="c-c">${x.cr}</td><td class="c-e"></td><td class="c-z">${x.kb}</td>
        <td class="c-a"><button type="button" data-vd="info" data-i="${i}" title="Document details">${SV.info}</button><button type="button" data-vd="dl" data-i="${i}" title="Download">${SV.dl}</button><button type="button" disabled title="Delete — not permitted">${SV.trash}</button></td></tr>`).join('')
      : `<tr><td colspan="6" class="vd-empty">No documents in <b>${esc(S.folder)}</b>.</td></tr>`;
    return `<div class="vd-hd"><b>Documents</b><span class="vd-help" title="Patient documents, by folder. Click a document to view it here; the note stays usable on the other side.">?</span>
        <span class="vd-sp"></span>${noteB('Documents open over this side only — the other side of the note stays usable')}
        <button type="button" class="vd-x" data-vd="close" title="Close documents">${SV.x}</button></div>
      <div class="vd-sub"><button type="button" class="vd-ctx" data-vd="ctx">${esc(cfg.scope || 'Visit Note')} ${SV.chevR.replace('vd-svg', 'vd-svg vd-rot')}</button><span class="vd-sp"></span>
        <button type="button" class="vd-up" data-vd="upload">Upload Document</button></div>
      <div class="vd-body">
        <div class="vd-tree${S.tree ? '' : ' off'}">
          <div class="vd-ts"><span class="vd-tsi">${SV.find}</span><input data-vd-in="folder" placeholder="Search Folder" value="${esc(S.fq)}"/>
            <button type="button" class="vd-add" data-vd="addf" title="Add folder">${SV.plus}</button>
            <button type="button" class="vd-col" data-vd="tree" title="Collapse folders">${SV.chevL}</button></div>
          <div class="vd-tl">${treeHTML()}</div></div>
        ${S.tree ? '' : `<button type="button" class="vd-treeopen" data-vd="tree" title="Show folders">${SV.chevR}<span>${esc(S.folder)}</span></button>`}
        <div class="vd-files"><table class="vd-tbl"><thead><tr><th class="c-f">File</th><th class="c-s">Service Date</th><th class="c-c">Created Date</th>
          <th class="c-e">Expiry Date</th><th class="c-z">File Size</th><th class="c-a"></th></tr></thead><tbody>${rows}</tbody></table></div>
      </div>
      <div class="vd-foot"><button type="button" class="vd-close" data-vd="close">Close</button></div>`;
  }
  function viewerHTML(){
    const x = curDoc(), pages = x.pages();
    return `<div class="vd-vh"><button type="button" class="vd-back" data-vd="back" title="Close the document — back to the list">${SV.x}</button>
        <span class="vd-vname" title="${esc(x.f)}">${esc(x.f)}</span><span class="vd-sp"></span>
        <button type="button" class="vd-tbtn light" data-vd="newtab" title="Open in a new tab">${SV.out}</button></div>
      <div class="vd-tb">
        <button type="button" class="vd-tbtn" title="Sidebar — not in the prototype" disabled>${SV.side}</button>
        <button type="button" class="vd-tbtn" title="Find in document — not in the prototype" disabled>${SV.find}</button>
        <button type="button" class="vd-tbtn" data-vd="prev" title="Previous page">${SV.up}</button>
        <button type="button" class="vd-tbtn" data-vd="next" title="Next page">${SV.down}</button>
        <input class="vd-pg" data-vd-in="page" value="1" inputmode="numeric" aria-label="Page"/><span class="vd-of">of ${pages.length}</span>
        <span class="vd-sp"></span>
        <button type="button" class="vd-tbtn" data-vd="zout" title="Zoom out">${SV.minus}</button>
        <button type="button" class="vd-tbtn" data-vd="zin" title="Zoom in">${SV.plus}</button>
        <select class="vd-zoom" data-vd-in="zoom" aria-label="Zoom">${[['auto', 'Automatic Zoom'], ['fit', 'Page Fit'], ['0.5', '50%'], ['0.75', '75%'], ['1', '100%'], ['1.25', '125%'], ['1.5', '150%']]
          .map(o => `<option value="${o[0]}"${String(S.zoom) === o[0] ? ' selected' : ''}>${o[1]}</option>`).join('')}${isNaN(+S.zoom) || ['0.5', '0.75', '1', '1.25', '1.5'].includes(String(S.zoom)) ? '' : `<option value="${S.zoom}" selected>${Math.round(S.zoom * 100)}%</option>`}</select>
        <span class="vd-sp"></span>
        <button type="button" class="vd-tbtn" data-vd="print" title="Print">${SV.print}</button>
        <button type="button" class="vd-tbtn" data-vd="dl" data-i="${S.doc.i}" title="Download">${SV.dl}</button></div>
      <div class="vd-pages">${pages.map((p, i) => `<div class="vd-page${x.img ? ' img' : ''}" data-pg="${i + 1}"><div class="vdp">${p}</div></div>`).join('')}</div>`;
  }
  function paint(){
    M.classList.toggle('viewing', !!S.doc);
    M.innerHTML = S.doc ? viewerHTML() : listHTML();
    if (S.doc){ fitZoom(); const pg = M.querySelector('.vd-pages'); pg.scrollTop = S.scroll; pg.addEventListener('scroll', onPageScroll); }
  }
  function zoomValue(){
    const pg = M.querySelector('.vd-pages'); if (!pg) return 1;
    const avail = Math.max(120, pg.clientWidth - 28), h = Math.max(120, pg.clientHeight - 24);
    const x = curDoc(), pw = x && x.img ? 520 : 816, ph = x && x.img ? 330 : 1056;
    if (S.zoom === 'auto') return Math.min(1.25, avail / pw);
    if (S.zoom === 'fit') return Math.min(avail / pw, h / ph);
    return +S.zoom;
  }
  function fitZoom(){
    const z = zoomValue();
    M.querySelectorAll('.vd-page').forEach(p => { if (p.style.zoom !== String(z)) p.style.zoom = z; });
  }
  /* a page's top inside the scroller, independent of offsetParent and zoom */
  const pageTop = (pg, p) => p.getBoundingClientRect().top - pg.getBoundingClientRect().top + pg.scrollTop;
  function onPageScroll(e){
    const pg = e.currentTarget; S.scroll = pg.scrollTop;
    const pages = [...pg.querySelectorAll('.vd-page')], mid = pg.scrollTop + pg.clientHeight / 3;
    let n = 1; pages.forEach((p, i) => { if (pageTop(pg, p) <= mid) n = i + 1; });
    const inp = M.querySelector('.vd-pg'); if (inp && document.activeElement !== inp) inp.value = n;
  }
  function goPage(n){
    const pg = M.querySelector('.vd-pages'), pages = pg ? [...pg.querySelectorAll('.vd-page')] : [];
    if (!pages.length) return; n = Math.max(1, Math.min(pages.length, n));
    pg.scrollTop = pageTop(pg, pages[n - 1]) - 8;
    const inp = M.querySelector('.vd-pg'); if (inp) inp.value = n;
  }
  const curPage = () => +((M.querySelector('.vd-pg') || {}).value || 1);
  new ResizeObserver(() => { if (S.doc) fitZoom(); }).observe(M);

  function openDoc(i){ S.doc = { folder: S.folder, i }; S.last = { folder: S.folder, i }; S.scroll = 0; S.zoom = 'auto'; paint(); }
  M.addEventListener('click', e => {
    const f = e.target.closest('[data-vd-folder]');
    if (f){ S.folder = f.dataset.vdFolder; paint(); return; }
    const b = e.target.closest('[data-vd]');
    if (b){
      const a = b.dataset.vd, x = b.dataset.i !== undefined ? docs()[+b.dataset.i] || curDoc() : null;
      if (a === 'close') return API.close();
      if (a === 'tree'){ S.tree = !S.tree; paint(); return; }
      if (a === 'back'){ S.doc = null; S.scroll = 0; paint(); const r = M.querySelector('.vd-row.last'); if (r) r.focus(); return; }
      if (a === 'prev') return goPage(curPage() - 1);
      if (a === 'next') return goPage(curPage() + 1);
      if (a === 'zin' || a === 'zout'){ const z = zoomValue(); S.zoom = +(Math.max(.25, Math.min(3, z + (a === 'zin' ? .1 : -.1)))).toFixed(2); const p = curPage(); paint(); goPage(p); return; }
      if (a === 'info' && x) return toast(`<b>${esc(x.f)}</b> · ${esc(S.doc ? S.doc.folder : S.folder)} · ${x.pages().length} page${x.pages().length > 1 ? 's' : ''} · ${x.kb} · uploaded ${x.cr}${x.by ? ' by ' + esc(x.by) : ''}`);
      if (a === 'dl') return toast('Download — not wired in the prototype.');
      if (a === 'print') return toast('Print — not wired in the prototype.');
      if (a === 'upload') return toast('Upload Document — not wired in the prototype.');
      if (a === 'addf') return toast('Add folder — not wired in the prototype.');
      if (a === 'ctx') return toast('Visit Note / Patient scope switch — not wired in the prototype.');
      if (a === 'newtab') return newTab();
      return;
    }
    const r = e.target.closest('[data-vd-doc]');
    if (r) openDoc(+r.dataset.vdDoc);
  });
  M.addEventListener('keydown', e => {
    const r = e.target.closest && e.target.closest('[data-vd-doc]');
    if (r && (e.key === 'Enter' || e.key === ' ')){ e.preventDefault(); openDoc(+r.dataset.vdDoc); }
    if (e.target.matches && e.target.matches('[data-vd-in="page"]') && e.key === 'Enter') goPage(+e.target.value || 1);
  });
  M.addEventListener('input', e => {
    if (e.target.matches('[data-vd-in="folder"]')){ S.fq = e.target.value; M.querySelector('.vd-tl').innerHTML = treeHTML(); }
  });
  M.addEventListener('change', e => {
    if (e.target.matches('[data-vd-in="zoom"]')){ const v = e.target.value; S.zoom = isNaN(+v) ? v : +v; const p = curPage(); paint(); goPage(p); }
  });
  function newTab(){
    const x = curDoc(), css = (document.getElementById('vdCss') || {}).textContent || '';
    const html = `<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="color-scheme" content="only light"><title>${esc(x.f)}</title><style>${css}
      body{margin:0;background:#525659}.vd-page{margin:16px auto}</style></head><body>${x.pages().map(p => `<div class="vd-page${x.img ? ' img' : ''}"><div class="vdp">${p}</div></div>`).join('')}</body></html>`;
    const w = window.open('', '_blank');
    if (w){ w.document.write(html); w.document.close(); } else toast('The browser blocked the new tab — allow pop-ups for this page.');
  }
  /* ==================================================================
     Widget search — whatever the host lists
     ================================================================== */
  const SR = document.createElement('div'); SR.id = 'vdSearch'; SR.className = 'vd-search';
  SR.innerHTML = `<span class="vd-si">${SV.find}</span><input type="search" placeholder="Find a widget…" autocomplete="off" aria-label="Find a widget"/><div class="vd-sres" role="listbox"></div>`;
  const SI = SR.querySelector('input'), SL = SR.querySelector('.vd-sres');
  function results(){
    const q = SI.value.trim().toLowerCase();
    return (cfg.widgets ? cfg.widgets() : []).filter(w => !q || w.t.toLowerCase().includes(q) || (w.m || '').toLowerCase().includes(q));
  }
  function paintResults(){
    const r = results(); S.hi = Math.min(S.hi, Math.max(0, r.length - 1));
    SL.innerHTML = r.length ? r.map((w, i) => `<div class="vd-sr${i === S.hi ? ' hi' : ''}" role="option" data-vd-go="${esc(w.id)}">
        <span class="t">${esc(w.t)}</span><span class="m">${esc(w.m || '')}${w.here ? ' · here' : ''}</span></div>`).join('')
      : '<div class="vd-sr none">No widget matches.</div>';
    SL.classList.add('on');
    const hi = SL.querySelector('.vd-sr.hi'); if (hi && hi.scrollIntoViewIfNeeded) hi.scrollIntoViewIfNeeded(false);
  }
  function go(id){
    SI.value = ''; S.sq = ''; SL.classList.remove('on'); S.hi = 0; SI.blur();
    if (cfg.go) cfg.go(id);
  }
  SI.addEventListener('focus', () => { S.hi = 0; paintResults(); });
  SI.addEventListener('input', () => { S.sq = SI.value; S.hi = 0; paintResults(); });
  SI.addEventListener('blur', () => setTimeout(() => SL.classList.remove('on'), 120));
  SI.addEventListener('keydown', e => {
    const r = results();
    if (e.key === 'ArrowDown'){ e.preventDefault(); S.hi = Math.min(r.length - 1, S.hi + 1); paintResults(); }
    else if (e.key === 'ArrowUp'){ e.preventDefault(); S.hi = Math.max(0, S.hi - 1); paintResults(); }
    else if (e.key === 'Enter' && r[S.hi]){ e.preventDefault(); go(r[S.hi].id); }
    else if (e.key === 'Escape'){ e.stopPropagation(); SL.classList.remove('on'); SI.blur(); }
  });
  SL.addEventListener('mousedown', e => { const it = e.target.closest('[data-vd-go]'); if (it){ e.preventDefault(); go(it.dataset.vdGo); } });

  const API = {
    init(c){ cfg = c || {}; D = Object.assign({ folders: [], kids: new Set(), docs: {} }, cfg.data || {}); S = fresh(); return API; },
    open(side){ S.open = true; S.side = side; paint(); if (cfg.onOpen) cfg.onOpen(side); },
    /* closing returns to the list next time — "initially the folder and doc list" */
    close(){ S.open = false; S.doc = null; S.scroll = 0; SI.value = ''; SL.classList.remove('on'); if (cfg.onClose) cfg.onClose(); },
    reset(){ S = fresh(); },
    /* open straight onto one document (used by the Flowsheet's Patient Documents links) */
    show(folder, i, side){ if (!(D.docs[folder] || [])[i]) return false; S.folder = folder; S.doc = { folder, i }; S.last = { folder, i }; S.scroll = 0; S.zoom = 'auto';
      S.open = true; S.side = side || S.side; paint(); if (cfg.onOpen) cfg.onOpen(S.side); return true; },
    state: () => S, modal: M, search: SR, icon: SV, toast,
    fit(){ if (S.doc){ const p = M.querySelector('.vd-pages'); if (p && p.scrollTop !== S.scroll) p.scrollTop = S.scroll; fitZoom(); } }
  };
  return API;
})();

</script>
<script>
/* ==================================================================
   VN DOCUMENT VIEWER — seed documents for Stephen, Renata (#8827301)
   Patient facts are the colleague prototype's own (patient bar, full
   demographics, problem list, medications, allergies). Every document
   is rendered as HTML pages so the viewer has something real to show.
   Prototype content — not clinically reviewed.
