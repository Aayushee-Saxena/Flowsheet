      section('ap-dx', 'fa-stethoscope', 'DX / Diagnosis', 'Assessment', dxA.length, 'add-dx', 'Add Diagnosis', dxA.map(dxCard).join('') + tray(AP.dx.map(function(d){ return {id:d.id, code:d.code, name:d.name, removed:!d.inA}; }), 'Removed from Assessment', 'dx-restore')) +
      section('ap-pl', 'fa-notes-medical', 'Problem List', 'Patient problems', pl.length, 'add-pl', 'Add Problem', pl.map(probCard).join('') + tray(AP.prob, 'Removed from this visit', 'pl-restore')) +
