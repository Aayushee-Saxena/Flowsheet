/* ---- Diagnosis-level Plan (Assessment & Plan enhancement) ----
   Each dx-entry gets its own Plan toggle + panel so Rx / Handout / Follow-up /
   Immunization / Authorization / Free Text Plan stay visually and functionally
   distinct per diagnosis, and the diagnosis <-> plan relationship is always
   visible: the panel lives directly under that diagnosis, never pooled into a
   generic list. cloneDxRow() (used for every newly added diagnosis) copies
   this markup for free, so multiple diagnoses each keep an independent plan. */
.dx-plan-toggle.on{background:var(--brand-soft);border-color:var(--brand-soft-line);color:var(--brand-ink);}
.dx-plan-panel{margin-top:10px;padding:11px 12px 2px;border:1px solid var(--brand-soft-line);border-left:3px solid var(--brand);border-radius:10px;background:var(--brand-soft);}
.dx-plan-panel-hd{font-size:11.5px;font-weight:700;color:var(--brand-ink);text-transform:uppercase;letter-spacing:.4px;margin-bottom:8px;display:flex;align-items:center;gap:6px;}
.dxplan-group{background:var(--card);border:1px solid var(--line);border-radius:9px;padding:9px 11px;margin-bottom:9px;}
.dxplan-group:last-child{margin-bottom:11px;}
.dxplan-group-hd{display:flex;align-items:center;gap:7px;margin-bottom:5px;}
.dxplan-group-hd .dxpi{width:20px;height:20px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:10.5px;flex:none;}
.dxplan-group-hd h5{font-size:12.8px;font-weight:700;flex:1;}
.dxplan-item{display:flex;align-items:center;gap:7px;font-size:13.3px;padding:3px 0;}
.dxplan-item .bdot{width:5px;height:5px;border-radius:50%;flex:none;}
.dxplan-empty{font-size:12.3px;color:var(--ink-faint);margin:2px 0;}
.dxplan-quickadd{display:flex;gap:6px;margin-top:5px;}
.dxplan-quickadd input{flex:1;min-width:0;border:1px solid var(--line);border-radius:6px;padding:5px 7px;font:inherit;font-size:12.8px;background:var(--paper);color:var(--ink);}
.dxpi-rx{background:var(--teal-soft);color:var(--teal);}
.dxpi-handout{background:var(--blue-soft);color:var(--blue);}
.dxpi-followup{background:var(--green-soft);color:var(--green);}
.dxpi-immun{background:var(--ai-soft);color:var(--ai);}
.dxpi-auth{background:var(--amber-soft);color:var(--amber);}
.dxpi-freetext{background:var(--line-soft);color:var(--ink-soft);}
.dxplan-item.t-rx .bdot{background:var(--teal);}
.dxplan-item.t-handout .bdot{background:var(--blue);}
.dxplan-item.t-followup .bdot{background:var(--green);}
.dxplan-item.t-immun .bdot{background:var(--ai);}
.dxplan-item.t-auth .bdot{background:var(--amber);}

/* Remove (x) affordance reused on Problem List / Rx / Handout / Follow-up rows,
   and on every diagnosis-level plan item, so all entities share one lightweight
   remove interaction -- an icon (not the literal "x" character) so it never
   gets swept into the This Visit Summary textContent diff. */
.item-x{background:none;border:none;color:var(--ink-faint);font-size:12px;line-height:1;padding:3px 4px;cursor:pointer;flex:none;border-radius:5px;}
.item-x:hover{color:var(--rose);background:var(--rose-soft);}

.em-row{display:flex;gap:8px;flex-wrap:wrap;}
.em-chip{border:1.5px dashed var(--rose-line);border-radius:9px;padding:9px 13px;font-size:13.5px;text-align:center;min-width:78px;font-weight:600;color:var(--ink-soft);position:relative;}
.em-chip.selected{border:1.5px solid var(--brand);border-style:solid;background:var(--brand-soft);color:var(--brand-ink);}
.em-chip .tag{position:absolute;top:-9px;right:6px;background:var(--ai);color:#fff;font-size:10px;padding:1px 6px;border-radius:8px;font-weight:700;}
.code-list{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px;}
.code-chip{display:inline-flex;align-items:center;gap:6px;background:var(--paper);border:1px solid var(--line);border-radius:7px;padding:4px 6px 4px 9px;font-family:var(--font-mono);font-size:12.5px;}
.code-chip button{background:none;border:none;color:var(--ink-faint);font-size:14px;line-height:1;padding:0 2px;}

.attest-box{border:1px solid var(--line);border-radius:var(--radius-m);padding:13px 14px;background:var(--paper);}
.attest-checkline{display:flex;gap:9px;align-items:flex-start;margin-top:10px;font-size:13.5px;}
.signed-banner{display:flex;align-items:center;gap:10px;background:var(--green-soft);border:1px solid var(--green-line);color:var(--green);border-radius:var(--radius-m);padding:12px 14px;font-weight:600;font-size:14px;}
.req-help{font-size:12.5px;margin-top:9px;font-weight:600;}
.req-help.bad{color:var(--rose);} .req-help.good{color:var(--green);}

.aisummary{border:1px solid var(--ai-line);background:linear-gradient(180deg,var(--ai-soft),var(--card) 70%);}
.highlight-item{display:flex;gap:8px;align-items:flex-start;padding:6px 0;font-size:13.5px;border-bottom:1px solid var(--line-soft);}
.highlight-item:last-child{border-bottom:none;}
.highlight-item .dot2{width:6px;height:6px;border-radius:50%;margin-top:5px;flex:none;}
.highlight-item.new .dot2{background:var(--teal);}
.highlight-item.warn .dot2{background:var(--amber);}
.highlight-item.abn .dot2{background:var(--rose);}
.highlight-item.gap .dot2{background:var(--ink-faint);}
.highlight-item a{font-size:12.5px;text-decoration:none;font-weight:600;flex:none;}

.overlay-scrim{position:fixed;inset:0;background:rgba(15,20,30,.42);z-index:90;display:flex;justify-content:flex-end;}
.overlay-panel{width:min(800px,100%);height:100%;background:var(--card);box-shadow:var(--shadow-lg);display:flex;flex-direction:column;animation:slidein .18s ease-out;}
@keyframes slidein{from{transform:translateX(24px);opacity:.4;}to{transform:translateX(0);opacity:1;}}
.overlay-hd{display:flex;align-items:center;gap:10px;padding:16px 18px;border-bottom:1px solid var(--line);}
.overlay-hd h2{font-size:16px;}
.overlay-hd .spacer{flex:1;}
.overlay-bd{flex:1;overflow:auto;padding:16px 18px;}
.overlay-ft{display:flex;justify-content:flex-end;gap:10px;padding:13px 18px;border-top:1px solid var(--line);background:var(--paper);}

.visit-pick{border:1px solid var(--line);border-radius:var(--radius-m);padding:11px 12px;margin-bottom:8px;cursor:pointer;}
.visit-pick:hover{border-color:var(--brand-soft-line);background:var(--brand-soft);}
.visit-pick.active{border-color:var(--brand);background:var(--brand-soft);}
.visit-pick .vp-date{font-weight:700;font-size:14px;}
.visit-pick .vp-sub{font-size:12.5px;color:var(--ink-faint);margin-top:1px;}

.copy-section{border:1px solid var(--line);border-radius:var(--radius-m);margin-bottom:10px;overflow:hidden;}
.copy-section-hd{display:flex;align-items:center;gap:8px;padding:9px 11px;background:var(--paper);border-bottom:1px solid var(--line);}
.copy-section-hd label{font-weight:600;font-size:13.5px;flex:1;}
.copy-section-bd{padding:9px 11px;display:flex;flex-direction:column;gap:7px;}
.copy-q{display:flex;gap:8px;align-items:flex-start;font-size:13px;}
.copy-q .qtxt{flex:1;}
.copy-q .qtxt .ql{color:var(--ink-faint);font-size:11.5px;}

.tpl-preview-row{display:flex;gap:8px;align-items:flex-start;padding:7px 0;border-bottom:1px solid var(--line-soft);font-size:13px;}
.tpl-preview-row:last-child{border-bottom:none;}
.tpl-preview-row .field{color:var(--ink-faint);width:120px;flex:none;font-size:12px;}
.tpl-preview-row .oldv{color:var(--ink-faint);text-decoration:line-through;}
.tpl-preview-row .newv{color:var(--teal);font-weight:600;}

.toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%);background:var(--ink);color:var(--card);padding:10px 18px;border-radius:10px;font-size:13.5px;font-weight:600;box-shadow:var(--shadow-lg);z-index:200;display:flex;align-items:center;gap:8px;max-width:min(90vw,460px);}
.lock-toast{flex-wrap:wrap;}
.lock-toast-action{background:none;border:none;padding:0;margin:0;color:inherit;font:inherit;font-weight:700;text-decoration:underline;cursor:pointer;flex:none;}

@media (max-width: 1100px){
  .section-summary-panel{position:fixed;right:54px;top:0;bottom:0;z-index:75;transform:translateX(10%);transition:transform .18s;box-shadow:var(--shadow-lg);width:min(420px,92vw);max-height:none;border-left:1px solid var(--line);border-top:none;}
  .section-summary-panel.open{transform:translateX(0);}
  .sp-toggle{display:inline-flex!important;}
}
@media (max-width: 980px){
  .navrail{position:fixed;left:0;top:0;bottom:0;z-index:75;width:236px;transform:translateX(-105%);transition:transform .18s;box-shadow:var(--shadow-lg);}
  .navrail.open{transform:translateX(0);}
  .nav-toggle{display:inline-flex!important;}
  .pb-full-grid{grid-template-columns:repeat(2,1fr);}
  .vng-grid{grid-template-columns:repeat(3,1fr);}
  .vngd-grid{grid-template-columns:repeat(2,1fr);}
}
@media (max-width: 640px){
  .pb-compact{gap:9px;padding:7px 12px;}
  .pb-mini-vitals{border-left:none;padding-left:0;}
  .pb-tags-row{padding:0 12px 8px;}
  .center{padding:12px 12px 80px;}
  .pb-full-grid{grid-template-columns:1fr 1fr;}
  .vng-grid{grid-template-columns:1fr 1fr;}
  .vngd-grid{grid-template-columns:1fr;}
  .overlay-panel{width:100%;}
  .flyout{width:min(320px,88vw);right:0;}
  .toolsdock{width:46px;}
  .dock-btn{width:34px;height:34px;}
}
.nav-toggle,.sp-toggle{display:none;}

/* ==== Old-Web layout: Patient Demographics card at the top of the form column ==== */
.pd-card{border-bottom:1px solid var(--line);}
.pd-wrap{display:flex;gap:14px;align-items:flex-start;padding:10px 14px;}
.pd-photo-col{flex:none;display:flex;}
.pd-card .photo{width:75px;height:70px;border-radius:var(--radius-m,10px);font-size:22px;letter-spacing:.5px;box-shadow:var(--shadow-sm);}
.pd-card .pb-compact.pd-info{flex:1;min-width:0;padding:0;display:flex;flex-direction:column;align-items:stretch;flex-wrap:nowrap;row-gap:5px;column-gap:0;}
.pd-line{display:flex;align-items:center;gap:8px 10px;flex-wrap:wrap;}
.pd-line-name{min-height:28px;flex-wrap:nowrap;}
.pd-card .pb-id{flex:0 1 auto;min-width:0;white-space:normal;}
.pd-card .pd-line-name > *:not(.pb-id):not(.pb-spacer){flex:none;}
.pd-card .pb-id .chartno,.pd-card .pb-id .pron{white-space:nowrap;display:inline-block;}
.pd-line-sub{font-size:13px;}
.pd-sep{width:1px;height:12px;background:var(--line);flex:none;}
.pd-card .pb-demog{border-left:none;padding-left:0;font-size:13px;color:var(--ink);}
.pd-card .pb-contact-link{font-size:13px;}
.pd-card .pb-tags-row{padding:0;margin-left:4px;}
.pd-facts{display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:4px 14px;margin-top:3px;padding-top:6px;border-top:1px solid var(--line-soft);}
.pd-facts .fact .k{font-size:10.5px;margin-bottom:0;}
.pd-facts .fact .v{font-size:13px;overflow-wrap:anywhere;}
.statico.pd-navico{background:var(--brand-soft);color:var(--brand-ink);}
.statico.pd-navico i{font-size:8px;}
/* 70% column is narrower than the old full-width center on laptop widths: 2-up VN General grid there */
@media (min-width:1101px) and (max-width:1400px){
  .vng-grid{grid-template-columns:repeat(2,1fr);}
}
@media (max-width:640px){
  .pd-wrap{flex-direction:column;align-items:stretch;}
  .pd-card .photo{width:60px;height:56px;font-size:18px;}
}

/* ==== This Visit Summary -- Vitals (recorded this visit) + Allergies ==== */
.tvs-glance{display:flex;flex-direction:column;gap:6px;flex:none;}
.tvs-blk{border:1px solid var(--line-soft);border-radius:8px;background:var(--card);padding:6px 8px 8px;}
.tvs-hd{display:flex;align-items:center;gap:6px;font-size:13px;font-weight:600;color:var(--ink);margin-bottom:6px;}
.tvs-hd .tvs-ico{font-size:11px;color:var(--ink-faint);width:14px;text-align:center;}
.tvs-hd .tvs-sub{font-size:11px;font-weight:500;color:var(--ink-faint);}
.tvs-hd .tvs-count{font-size:10px;font-weight:600;color:var(--ink-faint);background:var(--line-soft);border-radius:8px;padding:1px 6px;}
.tvs-hd .spacer{flex:1;}
.tvs-hd .ssum-goto-inline{flex:none;width:22px;height:22px;padding:0;border-radius:6px;border:1px solid var(--line);background:var(--card);color:var(--ink-faint);display:flex;align-items:center;justify-content:center;font-size:12px;}
.tvs-hd .ssum-goto-inline:hover{background:var(--line-soft);color:var(--ink);}
.tvs-vitals{display:grid;grid-template-columns:repeat(auto-fill,minmax(74px,1fr));gap:5px;}
.tvs-vt{background:var(--paper);border:1px solid var(--line-soft);border-radius:7px;padding:4px 7px;min-width:0;}
.tvs-vt .k{color:var(--ink-faint);font-size:10.5px;text-transform:uppercase;letter-spacing:.3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.tvs-vt .v{font-family:var(--font-mono);font-weight:600;font-size:13.5px;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.tvs-empty{font-size:12.5px;color:var(--ink-faint);}
.tvs-allergies{display:flex;flex-direction:column;gap:6px;}
.tvs-al{display:flex;flex-direction:column;align-items:flex-start;gap:2px;}
.tvs-al .allergy-chip{white-space:normal;}
.tvs-al .tvs-al-meta{font-size:11.5px;color:var(--ink-faint);padding-left:4px;}
.tvs-nka{display:inline-flex;align-items:center;background:var(--green-soft);color:var(--green);border:1px solid var(--green-line);border-radius:20px;padding:2px 9px;font-size:12px;font-weight:600;}

/* ==== [req 4] Summary tables: Allergies + previous Diagnosis (neutral, no red) ==== */
.tvs-tbl{width:100%;border-collapse:collapse;font-size:12.5px;table-layout:auto;}
.tvs-tbl th{text-align:left;font-size:10.5px;font-weight:700;color:var(--ink-faint);text-transform:uppercase;letter-spacing:.3px;padding:2px 6px 4px 0;border-bottom:1px solid var(--line-soft);white-space:nowrap;}
.tvs-tbl td{padding:5px 6px 5px 0;border-bottom:1px solid var(--line-soft);vertical-align:top;color:var(--ink);overflow-wrap:anywhere;}
.tvs-tbl tr:last-child td{border-bottom:none;}
.tvs-tbl .al-nm{font-weight:600;}
.tvs-tbl .al-dt{white-space:nowrap;}
.tvs-tbl .al-dt .mono{font-size:12px;}
.tvs-when{display:block;font-size:10.5px;color:var(--ink-faint);}
.tvs-tbl tr.is-cur .tvs-when{color:var(--brand);font-weight:600;}
.tvs-nka{display:inline-flex;align-items:center;background:var(--line-soft);color:var(--ink-soft);border:1px solid var(--line);border-radius:20px;padding:2px 9px;font-size:12px;font-weight:600;}
.tvs-dx{display:flex;flex-direction:column;}
.tvs-dx-row{display:flex;align-items:flex-start;gap:8px;padding:6px 0;border-bottom:1px solid var(--line-soft);}
.tvs-dx-row:first-child{padding-top:0;}
.tvs-dx-row:last-child{border-bottom:none;padding-bottom:0;}
.tvs-dx-main{flex:1;min-width:0;font-size:12.5px;line-height:1.35;}
.tvs-dx-main .prob-code{margin-right:5px;}
.tvs-dx-nm{font-weight:600;color:var(--ink);}
.tvs-dx-sub{font-size:11.5px;color:var(--ink-faint);margin-top:1px;}
.tvs-dx-act{flex:none;}
.tvs-dx-act .btn{color:var(--brand);border-color:var(--brand-soft-line);}
.tvs-dx-act .btn:hover{background:var(--brand-soft);}
.tvs-dx-act .btn.is-done{color:var(--ink-soft);border-color:var(--line-soft);background:var(--line-soft);}

/* ==== [req 5] NKA: toggle state + neutral message (no red) ==== */
#allergyNkaBtn.is-on{background:var(--line-soft);border-color:var(--line);color:var(--ink);}
.allergy-nka-banner{font-size:14px;font-weight:600;}
.tvs-count:empty{display:none;}
.tvs-nka-msg{font-size:13px;font-weight:600;color:var(--ink-soft);background:var(--paper);border:1px solid var(--line-soft);border-radius:7px;padding:8px 10px;}

/* ==== [req 6] Required-question validation on Save & Next ==== */
/* spacing the removed Free Text Note used to provide between a flag box and the questionnaire title */
#flag-sh-cessation + .fieldset-title,#flag-screen-tobacco + .fieldset-title{margin-top:16px!important;}
.req-dlg-scrim{position:fixed;inset:0;background:rgba(15,20,30,.42);z-index:220;display:flex;align-items:center;justify-content:center;padding:16px;}
.req-dlg{background:var(--card);border-radius:var(--radius-l,12px);box-shadow:var(--shadow-lg);width:min(360px,100%);padding:18px 18px 14px;animation:slidein .15s ease-out;}
.req-dlg-msg{display:flex;align-items:center;gap:10px;font-size:15px;font-weight:700;color:var(--ink);margin-bottom:16px;}
.req-dlg-msg i{color:var(--amber);font-size:17px;}
.req-dlg-ft{display:flex;justify-content:flex-end;}
.req-missing{outline:2px solid var(--rose-line);outline-offset:3px;border-radius:6px;background:var(--rose-soft);}
.req-missing > label, .fieldset-title.req-missing{color:var(--rose);}

/* ==== [req 7] "Go to Summary" icon on section headers ==== */
.card-hd .hdr-sum-btn{min-width:26px;justify-content:center;color:var(--ink-faint);}
.card-hd .hdr-sum-btn:hover{color:var(--brand);}
.ssum-flash{outline:2px solid var(--brand-soft-line);outline-offset:1px;background:var(--brand-soft);transition:background .6s,outline-color .6s;}

/* ==================== [tabbed layout] Visit Note tab bar ==================== */
.vnt-bar{display:flex;align-items:stretch;gap:4px;background:var(--card);border-bottom:1px solid var(--line);flex:none;height:35px;padding:0 10px 0 6px;}
.vnt-scroll{flex:1;min-width:0;display:flex;align-items:stretch;overflow-x:auto;overflow-y:hidden;scrollbar-width:none;scroll-behavior:smooth;}
.vnt-scroll::-webkit-scrollbar{display:none;}
.vnt-tab{flex:none;display:flex;align-items:center;gap:7px;border:none;background:transparent;padding:0 14px;font-size:13.5px;font-weight:600;color:var(--ink-soft);white-space:nowrap;cursor:pointer;border-bottom:2.5px solid transparent;margin-bottom:-1px;font-family:inherit;}
.vnt-tab:hover{color:var(--ink);background:var(--line-soft);}
.vnt-tab.on{color:var(--brand);border-bottom-color:var(--brand);font-weight:700;background:var(--brand-soft);}
.vnt-tab:focus-visible{outline:2px solid var(--brand);outline-offset:-2px;}
.vnt-prog{font-size:11px;font-weight:600;color:var(--ink-faint);background:var(--line-soft);border-radius:10px;padding:1px 7px;}
.vnt-tab.on .vnt-prog{background:var(--card);color:var(--brand-ink);}
.vnt-prog.done{background:var(--green-soft);color:var(--green);}
.vnt-arrow{flex:none;border:none;background:transparent;color:var(--ink-faint);width:26px;cursor:pointer;}
.vnt-arrow:hover{color:var(--ink);background:var(--line-soft);}
.vnt-arrow[hidden]{display:none;}
.vnt-tools{flex:none;display:flex;align-items:center;gap:4px;padding-left:8px;border-left:1px solid var(--line-soft);margin-left:4px;}
/* collapsible section headers */
.vnt-cbtn{border:none;background:transparent;color:var(--ink-faint);width:22px;height:22px;border-radius:6px;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;flex:none;transition:transform .15s;margin-left:-6px;}
.vnt-cbtn:hover{background:var(--line-soft);color:var(--ink);}
.card.vnt-collapsed .vnt-cbtn{transform:rotate(-90deg);}
.card.vnt-collapsed > :not(.card-hd){display:none!important;}
.card.vnt-collapsed > .card-hd{border-bottom:none;}
.card-hd h3.vnt-h3{cursor:pointer;}
.center-inner .cx-note{margin-bottom:10px;}
#vntCardStore,#vntNavStore{display:none!important;}
/* summary scope control */
.vnt-scope{display:flex;align-items:center;gap:8px;flex:none;font-size:12px;color:var(--ink-faint);margin:4px 0 2px;}
.vnt-scope-lbl{flex:1;min-width:0;}
.vnt-scope-lbl b{color:var(--ink);}
.vnt-seg{display:inline-flex;border:1px solid var(--line);border-radius:7px;overflow:hidden;flex:none;}
.vnt-seg button{border:none;background:var(--card);color:var(--ink-soft);font-size:11.5px;font-weight:600;padding:3px 9px;cursor:pointer;font-family:inherit;}
.vnt-seg button + button{border-left:1px solid var(--line);}
.vnt-seg button.on{background:var(--brand-soft);color:var(--brand-ink);}
.ssum-sec.vnt-off{display:none;}
/* compiled Visit Note document (Visit Summary tab) */
:root{--doc-bg:#ffffff;--doc-ink:#1d2430;--doc-soft:#4a5566;--doc-faint:#7b8594;--doc-line:#d9dee6;--doc-head:#264E82;}
.vnd-pane{display:flex;flex-direction:column;gap:8px;min-width:0;}
.vnd-pane[hidden]{display:none;}
.vnd-toolbar{display:flex;align-items:center;gap:6px;flex:none;}
.vnd-tb-title{display:flex;align-items:center;gap:6px;font-size:13px;font-weight:700;color:var(--ink);}
.vnd-tb-title i,.vnd-tb-title svg{color:var(--brand);}
.vnd-tb-sub{font-size:11.5px;color:var(--ink-faint);}
.vnd-page{background:var(--doc-bg);color:var(--doc-ink);border:1px solid var(--line);border-radius:6px;box-shadow:var(--shadow-sm);padding:22px 20px 26px;font-size:12.6px;line-height:1.5;}
.vnd-page h1{font-size:15px;font-weight:800;color:var(--doc-head);margin:0;letter-spacing:.2px;}
.vnd-org{display:flex;justify-content:space-between;gap:10px;align-items:flex-start;border-bottom:2px solid var(--doc-head);padding-bottom:8px;margin-bottom:10px;}
.vnd-org .addr{font-size:11px;color:var(--doc-soft);text-align:right;}
.vnd-doctitle{font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:var(--doc-soft);margin:2px 0 8px;}
.vnd-meta{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:4px 14px;border:1px solid var(--doc-line);border-radius:4px;padding:8px 10px;margin-bottom:12px;background:#f7f9fc;}
.vnd-meta div{min-width:0;}
.vnd-meta .k{font-size:10px;text-transform:uppercase;letter-spacing:.4px;color:var(--doc-faint);font-weight:700;}
.vnd-meta .v{font-size:12.2px;color:var(--doc-ink);font-weight:600;overflow-wrap:anywhere;}
.vnd-part{font-size:11.5px;font-weight:800;text-transform:uppercase;letter-spacing:.7px;color:var(--doc-head);border-bottom:1px solid var(--doc-line);padding-bottom:3px;margin:16px 0 6px;}
.vnd-sec{margin:0 0 8px;break-inside:avoid;}
.vnd-sec .t{font-weight:700;color:var(--doc-ink);}
.vnd-sec .b{color:var(--doc-soft);white-space:pre-wrap;overflow-wrap:anywhere;}
.vnd-sec .b.empty{color:var(--doc-faint);font-style:italic;}
.vnd-sig{margin-top:18px;border-top:1px solid var(--doc-line);padding-top:10px;display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;font-size:11.5px;color:var(--doc-soft);}
.vnd-sig .line{font-weight:700;color:var(--doc-ink);font-size:12.5px;}
.vnd-stat{display:inline-block;font-size:10.5px;font-weight:700;border-radius:8px;padding:1px 8px;background:#fff4e0;color:#9a5b00;border:1px solid #f1d3a0;}
.vnd-stat.ok{background:#e6f5ec;color:#1d7a45;border-color:#b5e0c6;}
.section-summary-panel.vnt-docmode .ssum-tabs,.section-summary-panel.vnt-docmode .ssum-tabpanel{display:none!important;}

/* selected Negative chips read red, Positive green -- same treatment as Review of Systems */
#sec-stressors .cx-chip[data-chip-kind="negative"].on,#sec-developmental .cx-chip[data-chip-kind="negative"].on{background:var(--chip-neg-bg);border-color:var(--chip-neg-line);color:var(--chip-neg-ink);}
/* ==== [tabbed layout] legacy question rows (Current Stressors, Developmental) ==== */
.vq-list{display:flex;flex-direction:column;}
.vq{padding:10px 0 4px;border-top:1px solid var(--line-soft);}
.vq:first-child{border-top:none;padding-top:0;}
.vq > .vq-q{display:flex;align-items:center;gap:8px;margin:0 0 7px;}
.vq-qt{min-width:0;}
.vq > .vq-q .ros-bulk{margin-left:2px;}   /* ROS: icons follow the heading text; the flex gap supplies the rest of the 10px */
.vq-row{align-items:center;gap:6px 8px;}
.vq-row .cx-chip{max-width:100%;overflow-wrap:anywhere;text-align:left;}
.vq-row .vq-f{flex-direction:row;align-items:center;gap:6px;flex:0 1 auto;}
.vq-row .vq-f.vq-area{align-items:flex-start;flex:1 1 240px;max-width:380px;}
.vq-row .vq-f > label::after{content:":";}
.vq-row .vq-f > label{font-size:13px;font-weight:600;color:var(--ink-faint);white-space:nowrap;flex:none;}
.vq-row .vq-f.vq-area > label{padding-top:7px;}
.vq-row .vq-f input[type=number]{width:96px;}
.vq-row .vq-f input[type=text]{width:180px;}
.vq-row .vq-f select{width:170px;}
.vq-row .vq-f textarea{min-height:40px;flex:1;min-width:0;}
.vq-ctx{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;}
@media (max-width:640px){ .vq-row .vq-f{flex-wrap:wrap;} .vq-row .vq-f.vq-area{max-width:none;flex-basis:100%;} }

/* ==== [tabbed layout] HPI questionnaire ==== */
#sec-hpi .cx-chip[data-chip-kind="negative"].on{background:var(--chip-neg-bg);border-color:var(--chip-neg-line);color:var(--chip-neg-ink);}
#sec-hpi .hpi-grp .vq{border-top:none;padding-top:0;}
#sec-hpi .hpi-grp .vq + .vq{border-top:1px solid var(--line-soft);padding-top:10px;}
.hpi-item{display:inline-flex;align-items:center;gap:3px;max-width:100%;}
.hpi-open{flex:none;width:22px;height:22px;padding:0;border:1px solid transparent;border-radius:6px;background:transparent;color:var(--ink-faint);display:inline-flex;align-items:center;justify-content:center;font-size:11px;cursor:pointer;}
.hpi-open:hover,.hpi-open:focus-visible{background:var(--line-soft);border-color:var(--line);color:var(--ink);}
.hpi-score{font-size:12.5px;font-weight:700;color:var(--ink-soft);margin:0 0 8px;}
.hpi-score span{font-variant-numeric:tabular-nums;color:var(--ink);}

/* ==== [tabbed layout] Past Psychiatric History questionnaire (same treatment as HPI) ==== */
#sec-psychhx .cx-chip[data-chip-kind="negative"].on{background:var(--chip-neg-bg);border-color:var(--chip-neg-line);color:var(--chip-neg-ink);}
#sec-psychhx .hpi-grp .vq{border-top:none;padding-top:0;}
#sec-psychhx .hpi-grp .vq + .vq{border-top:1px solid var(--line-soft);padding-top:10px;}
#sec-psychhx .pph-wide{flex:1 1 100%;}
#sec-psychhx .pph-wide textarea{min-height:64px;}

/* ==== [tabbed layout] Medical History questionnaire (same treatment as HPI / Past Psychiatric History) ==== */
#sec-mh .cx-chip[data-chip-kind="negative"].on{background:var(--chip-neg-bg);border-color:var(--chip-neg-line);color:var(--chip-neg-ink);}

/* ==== [tabbed layout] Family Psych/Med Hx questionnaire (same treatment as HPI / Past Psychiatric History) ==== */
#sec-fh .cx-chip[data-chip-kind="negative"].on{background:var(--chip-neg-bg);border-color:var(--chip-neg-line);color:var(--chip-neg-ink);}
#sec-fh .hpi-grp .vq{border-top:none;padding-top:0;}
#sec-fh .hpi-grp .vq + .vq{border-top:1px solid var(--line-soft);padding-top:10px;}
#sec-fh .pph-wide{flex:1 1 100%;}
#sec-fh .vnt-eyebrow{margin:14px 0 2px;}

/* ==== [tabbed layout] Social Hx questionnaire (same treatment as the other History sections) ==== */
#sec-sh .hpi-grp .vq{border-top:none;padding-top:0;}
#sec-sh .hpi-grp .vq + .vq{border-top:1px solid var(--line-soft);padding-top:10px;}
#sec-sh .pph-wide{flex:1 1 100%;}
.sh-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px 24px;max-width:1080px;width:100%;flex:1 1 100%;align-items:end;}
.sh-grid .cx-chip{justify-self:start;}
.sh-grid .cx-field label{font-size:13px;}
@media (max-width:640px){ .sh-grid{grid-template-columns:minmax(0,1fr);} .sh-grid .sh-blank{display:none;} }

/* ==== [tabbed layout] Substance Abuse Hx questionnaire (same treatment as the other History sections) ==== */
#sec-substancehx .cx-chip[data-chip-kind="negative"].on{background:var(--chip-neg-bg);border-color:var(--chip-neg-line);color:var(--chip-neg-ink);}

/* ==== [tabbed layout] New MSE questionnaire (same treatment as the History sections) ==== */
#sec-newmse .cx-chip[data-chip-kind="negative"].on{background:var(--chip-neg-bg);border-color:var(--chip-neg-line);color:var(--chip-neg-ink);}
#sec-newmse .hpi-grp .vq{border-top:none;padding-top:0;}
#sec-newmse .hpi-grp .vq + .vq{border-top:1px solid var(--line-soft);padding-top:10px;}
#sec-newmse .pph-wide{flex:1 1 100%;}
.vq-row .vq-f select.vq-multi{height:32px;min-height:32px;overflow-y:auto;padding:3px 6px;}
.vq-row .vq-f select.vq-multi option{padding:2px 4px;}

.gsum-grp{margin-top:14px;}
.gsum{display:flex;flex-direction:column;align-items:flex-start;gap:4px;}
.gsum:empty{display:none;}
.gsum-q{display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-top:4px;}
.gsum-q:first-child{margin-top:0;}
.gsum-lbl{border:1px solid var(--brand-soft-line);border-radius:4px;padding:2px 6px;font-size:13px;font-weight:700;color:var(--brand);background:var(--card);}
.gsum-goals{font-size:13px;font-weight:700;color:var(--brand);}
.gsum-goal{border:1px solid var(--brand-soft-line);border-radius:4px;padding:3px 7px;font-size:13px;color:var(--ink);background:var(--card);max-width:100%;overflow-wrap:anywhere;}
/* ==== [tabbed layout] Goals SubstanceA questionnaire (same treatment as the History sections) ==== */

/* ==== [tabbed layout] Question Search (left panel) ==== */
.vqs-bar{position:sticky;top:-10px;z-index:6;margin:-10px -12px 10px;padding:10px 12px 8px;background:var(--paper);border-bottom:1px solid var(--line-soft);}
.vqs-box{position:relative;display:flex;align-items:center;}
.vqs-box .vqs-ico{position:absolute;left:10px;font-size:12px;color:var(--ink-faint);pointer-events:none;}
.vqs-box input{width:100%;border:1px solid var(--line);border-radius:8px;padding:7px 32px 7px 30px;font-size:13.5px;font-family:inherit;background:var(--card);color:var(--ink);}
.vqs-box input:focus{outline:2px solid var(--brand-soft-line);border-color:var(--brand);}
.vqs-clear{position:absolute;right:5px;width:24px;height:24px;border:none;border-radius:6px;background:transparent;color:var(--ink-faint);display:inline-flex;align-items:center;justify-content:center;cursor:pointer;font-size:12px;}
.vqs-clear:hover,.vqs-clear:focus-visible{background:var(--line-soft);color:var(--ink);}
.vqs-clear[hidden]{display:none;}
.vqs-empty{padding:28px 12px;text-align:center;color:var(--ink-faint);font-size:14px;}
.vqs-empty[hidden]{display:none;}
.vqs-hide{display:none!important;}
mark.vqs-hit{background:var(--amber-soft);color:inherit;border-radius:2px;padding:0 1px;box-shadow:0 0 0 1px var(--amber-line);}
@media (max-width:1100px){ .vqs-bar{top:-16px;margin:-16px -20px 10px;padding:12px 20px 8px;} }
@media (max-width:640px){ .vqs-bar{top:-12px;margin:-12px -12px 10px;padding:10px 12px 8px;} }

/* ==== [tabbed layout] Intervention SubstanceA + Intervention Sublevel view ==== */
.isub-link{display:inline-flex;align-items:center;gap:6px;border:none;background:none;padding:0;margin:0;font:inherit;color:var(--brand);text-transform:inherit;letter-spacing:inherit;cursor:pointer;text-align:left;}
.isub-link:hover,.isub-link:focus-visible{text-decoration:underline;}
.isub-link svg,.isub-link i{font-size:10px;}
.isub-nav{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:0 0 12px;}
.isub-back{display:inline-flex;align-items:center;gap:6px;}
.isub-sep{font-size:10px;color:var(--ink-faint);}
.isub-cur{font-size:14px;font-weight:700;color:var(--ink);}
.isub .isub-title{text-transform:none;letter-spacing:0;font-size:13px;font-weight:600;color:var(--ink-soft);padding-bottom:8px;margin:0 0 12px;border-bottom:1px solid var(--line);}
.isub .isub-list{flex-direction:column;align-items:stretch;gap:8px;}
.isub .isub-list .cx-chip{text-align:left;border-radius:6px;}
.isub .isub-other textarea{min-height:40px;}
.isub[hidden]{display:none;}

/* ==== [tabbed layout] Plan (Next Session) -- legacy single-column layout ==== */
.plan-col{flex-direction:column;align-items:stretch;max-width:430px;gap:8px;}
.plan-col .plan-opt{text-align:left;border-radius:6px;}
.plan-col .plan-field label{font-size:13px;}
.plan-col .plan-field textarea{min-height:40px;}

/* ==== [tabbed layout] DSM-5 questionnaire (same treatment as the other question sets) ==== */
#sec-dsm5 .hpi-grp .vq{border-top:none;padding-top:0;}
#sec-dsm5 .hpi-grp .vq + .vq{border-top:1px solid var(--line-soft);padding-top:10px;}
.cx-chip.dsm-no .dsm-no-tag{font-weight:700;color:var(--ink-faint);margin-right:8px;padding-right:8px;border-right:1px solid var(--line);}
.cx-chip.dsm-no.on .dsm-no-tag{color:inherit;border-right-color:currentColor;}

/* ==== [tabbed layout] Assessment & Plan -- entity workflow ==== */
.ap{display:flex;flex-direction:column;gap:12px;}
.ap-ent{border:1px solid var(--line);border-radius:var(--radius-m);background:var(--card);overflow:hidden;}
.ap-ent-hd{display:flex;align-items:center;gap:8px;padding:9px 12px;background:var(--paper);border-bottom:1px solid var(--line-soft);flex-wrap:wrap;}
.ap-ent-ico{width:24px;height:24px;border-radius:7px;display:inline-flex;align-items:center;justify-content:center;font-size:12px;flex:none;color:#fff;}
.ap-ent-title{font-size:14px;font-weight:700;color:var(--ink);}
.ap-ent-sub{font-size:12px;color:var(--ink-faint);}
.ap-count{font-size:11px;font-weight:700;border-radius:9px;padding:1px 7px;background:var(--line-soft);color:var(--ink-soft);}
.ap-ent-bd{padding:10px 12px;display:flex;flex-direction:column;gap:8px;}
.ap-dx  .ap-ent-ico{background:var(--brand);}   .ap-dx{border-left:3px solid var(--brand);}
.ap-pl  .ap-ent-ico{background:var(--teal);}    .ap-pl{border-left:3px solid var(--teal);}
.ap-rx  .ap-ent-ico{background:var(--blue);}    .ap-rx{border-left:3px solid var(--blue);}
.ap-ho  .ap-ent-ico{background:var(--ai);}      .ap-ho{border-left:3px solid var(--ai);}
.ap-fu  .ap-ent-ico{background:var(--amber);}   .ap-fu{border-left:3px solid var(--amber);}
.ap-empty{display:flex;align-items:center;justify-content:center;gap:8px;border:1.5px dashed var(--line);border-radius:10px;padding:14px;background:transparent;color:var(--brand);font-weight:700;font-size:13.5px;cursor:pointer;width:100%;font-family:inherit;}
.ap-empty:hover,.ap-empty:focus-visible{background:var(--brand-soft);border-color:var(--brand-soft-line);}
.ap-card{border:1px solid var(--line);border-radius:10px;padding:10px 12px;background:var(--card);display:flex;flex-direction:column;gap:8px;}
.ap-card-top{display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
.ap-code{font-family:var(--font-mono);font-size:12px;font-weight:700;color:var(--brand-ink);background:var(--brand-soft);border:1px solid var(--brand-soft-line);border-radius:5px;padding:1px 6px;}
.ap-name{font-size:14px;font-weight:700;color:var(--ink);}
.ap-tag{font-size:11px;font-weight:700;border-radius:9px;padding:1px 8px;border:1px solid var(--line);color:var(--ink-soft);background:var(--paper);}
.ap-tag.link{border-color:var(--brand-soft-line);color:var(--brand-ink);background:var(--brand-soft);}
.ap-tag.ok{border-color:var(--green-line);color:var(--green);background:var(--green-soft);}
.ap-fields{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:8px 12px;}
.ap-f{display:flex;flex-direction:column;gap:3px;min-width:0;}
.ap-f label{font-size:12px;font-weight:600;color:var(--ink-faint);}
.ap-f input,.ap-f select,.ap-f textarea{border:1px solid var(--line);border-radius:6px;padding:5px 8px;background:var(--card);color:var(--ink);font-size:13px;font-family:inherit;width:100%;}
.ap-f textarea{min-height:50px;resize:vertical;}
.ap-f.wide{grid-column:1/-1;}
.ap-actions{display:flex;gap:6px;flex-wrap:wrap;align-items:center;}
.ap-actions .spacer{flex:1;}
.btn.ap-danger{color:var(--rose);border-color:var(--rose-line);}
.btn.ap-danger:hover{background:var(--rose-soft);}
.btn.ap-plan-btn{background:var(--brand);border-color:var(--brand);color:#fff;}
.btn.ap-plan-btn.open{background:var(--brand-ink);}
.ap-plan-n{background:rgba(255,255,255,.25);border-radius:8px;padding:0 6px;font-size:11px;}
.ap-plan{border:1px solid var(--brand-soft-line);border-left:3px solid var(--brand);border-radius:8px;background:var(--brand-soft);padding:10px 12px;display:flex;flex-direction:column;gap:8px;}
.ap-plan-hd{font-size:12.5px;font-weight:700;color:var(--brand-ink);display:flex;align-items:center;gap:6px;flex-wrap:wrap;}
.ap-plan-opts{display:flex;gap:6px;flex-wrap:wrap;}
.ap-plan-opts .btn{background:var(--card);}
.ap-plan-opts .btn.on{border-color:var(--brand);color:var(--brand);box-shadow:inset 0 0 0 1px var(--brand);}
.ap-pitems{display:flex;flex-direction:column;gap:5px;}
.ap-pitem{display:flex;align-items:flex-start;gap:8px;background:var(--card);border:1px solid var(--line-soft);border-radius:7px;padding:6px 8px;font-size:13px;}
.ap-pitem .ap-ptype{flex:none;font-size:11px;font-weight:700;border-radius:6px;padding:1px 7px;min-width:92px;text-align:center;}
.ap-pitem .ap-ptxt{flex:1;min-width:0;color:var(--ink);overflow-wrap:anywhere;}
.pt-rx{background:var(--blue-soft);color:var(--blue);} .pt-ho{background:var(--ai-soft);color:var(--ai);} .pt-fu{background:var(--amber-soft);color:var(--amber);}
.pt-im{background:var(--green-soft);color:var(--green);} .pt-au{background:var(--line-soft);color:var(--ink-soft);} .pt-ft{background:var(--brand-soft);color:var(--brand-ink);}
.ap-pform{background:var(--card);border:1px solid var(--line);border-radius:8px;padding:10px;display:flex;flex-direction:column;gap:8px;}
.ap-allergy{border:1px solid var(--rose-line);background:var(--rose-soft);border-radius:8px;padding:8px 10px;font-size:13px;color:var(--ink);}
.ap-allergy-hd{font-size:12px;font-weight:700;color:var(--rose);display:flex;align-items:center;gap:6px;margin-bottom:4px;}
.ap-tray{border-top:1px dashed var(--line);padding-top:8px;font-size:12.5px;color:var(--ink-soft);}
.ap-tray summary{cursor:pointer;font-weight:600;}
.ap-tray-row{display:flex;align-items:center;gap:8px;padding:4px 0;}
.ap-undo{display:flex;align-items:center;gap:8px;font-size:12.5px;background:var(--amber-soft);border:1px solid var(--amber-line);color:var(--ink);border-radius:7px;padding:5px 8px;}
.ap-savebar{display:flex;align-items:center;gap:10px;justify-content:flex-end;flex-wrap:wrap;}
.ap-saved{border:1px solid var(--line);border-radius:var(--radius-m);background:var(--paper);padding:12px;display:flex;flex-direction:column;gap:10px;}
.ap-saved-hd{display:flex;align-items:center;gap:8px;font-size:14px;font-weight:700;color:var(--ink);}
.ap-sdx{background:var(--card);border:1px solid var(--line);border-left:3px solid var(--brand);border-radius:8px;padding:10px 12px;display:flex;flex-direction:column;gap:6px;}
.ap-sdx-hd{display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
.ap-srow{display:grid;grid-template-columns:130px 1fr;gap:8px;font-size:13px;}
.ap-srow .k{color:var(--ink-faint);font-weight:600;}
.ap-sblock{background:var(--card);border:1px solid var(--line);border-radius:8px;padding:10px 12px;font-size:13px;}
.ap-sblock h4{font-size:12.5px;margin:0 0 6px;color:var(--ink-soft);text-transform:uppercase;letter-spacing:.4px;}
.ap-sub-ul{margin:0;padding-left:18px;}
.ap-pick-tabs{display:flex;gap:2px;border-bottom:1px solid var(--line-soft);margin-bottom:10px;}
.ap-pick-tabs button{border:none;background:transparent;padding:7px 12px;font-weight:700;font-size:13px;color:var(--ink-faint);border-bottom:2px solid transparent;cursor:pointer;font-family:inherit;}
.ap-pick-tabs button.on{color:var(--brand);border-bottom-color:var(--brand);}
.ap-pick-search{width:100%;border:1px solid var(--line);border-radius:8px;padding:7px 10px;font-size:13.5px;margin-bottom:10px;font-family:inherit;background:var(--card);color:var(--ink);}
.ap-pick-list{display:flex;flex-direction:column;gap:6px;}
.ap-pick-row{display:flex;align-items:center;gap:8px;border:1px solid var(--line-soft);border-radius:8px;padding:7px 10px;}
.ap-pick-row .nm{flex:1;min-width:0;font-size:13.5px;}
.ap-pick-row .sub{display:block;font-size:12px;color:var(--ink-faint);}
.ap-pick-none{color:var(--ink-faint);font-size:13px;padding:10px 2px;}
.ap-review{border:1px solid var(--blue-line);background:var(--blue-soft);border-radius:8px;padding:10px 12px;font-size:13px;}
.ap-warn{border:1px solid var(--rose-line);background:var(--rose-soft);color:var(--rose);border-radius:8px;padding:7px 10px;font-size:12.5px;font-weight:600;}
@media (max-width:640px){ .ap-srow{grid-template-columns:1fr;} }
/* ==== Static Patient Demographic bar (replaces the in-scroll demographics card) ==== */
.pdbar{display:flex;align-items:stretch;gap:0;padding:0;box-shadow:0 1px 3px rgba(18,24,38,.06);position:relative;z-index:5;min-width:0;}
.pdbar .pdb-id{flex:1 1 0;min-width:0;display:flex;align-items:center;gap:12px;padding:8px 16px 8px 14px;}
.pdbar .photo.pdb-photo{width:46px;height:46px;border-radius:50%;font-size:15px;padding:0;cursor:pointer;box-shadow:var(--shadow-sm);}
.pdbar .photo.pdb-photo:hover{border-color:var(--brand-soft-line);}
.pdbar .pdb-idtext{flex:1;min-width:0;display:flex;flex-direction:column;gap:5px;}
.pdb-l1,.pdb-l2{display:flex;align-items:center;flex-wrap:wrap;gap:4px 10px;min-width:0;}
.pdb-l1 > *,.pdb-l2 > *{flex:none;}
.pdbar .pb-id .nm{font-size:15px;line-height:1.25;}
.pdb-name{background:none;border:none;padding:0;font:inherit;font-weight:700;color:var(--brand);text-decoration:underline;text-decoration-color:var(--brand-soft-line);text-underline-offset:3px;cursor:pointer;}
.pdb-name:hover{text-decoration-color:var(--brand);}
.pdb-name .chartno{text-decoration:none;display:inline-block;}
.pdbar .pb-risk-pill{padding:2px 8px;font-size:10.5px;}
.pdbar .pbi-icon{width:26px;height:26px;font-size:12px;}
.pdb-sep{width:1px;height:16px;background:var(--line);}
.pdb-item{display:inline-flex;align-items:center;gap:5px;font-size:13px;color:var(--ink);white-space:nowrap;}
.pdb-item i{font-size:11.5px;color:var(--ink-faint);}
.pdbar .pb-demog{border-left:none;padding-left:0;}
.pdb-dot{width:3px;height:3px;border-radius:50%;background:var(--ink-faint);margin:0 3px;}
.pdbar a.pb-contact-link{color:var(--ink);}
.pdbar a.pb-contact-link:hover{color:var(--brand);}
.pdb-money{font-size:13px;white-space:nowrap;color:var(--ink);}
.pdb-money .k{color:var(--ink-soft);}
.pdb-money .mono{font-weight:700;color:var(--brand);}
.pdbar .pb-tags-row{padding:0;gap:4px;}
.pdbar .ptag{padding:1px 8px;font-size:11.5px;}
.pdb-fact{font-size:12.5px;color:var(--ink);white-space:nowrap;}
.pdb-fact .k{font-size:10.5px;font-weight:700;letter-spacing:.35px;text-transform:uppercase;color:var(--ink-faint);margin-right:3px;}
.pdb-more{display:inline-flex;align-items:center;gap:4px;background:none;border:none;padding:1px 2px;color:var(--brand);font-size:12.5px;font-weight:600;cursor:pointer;border-radius:5px;}
.pdb-more i{font-size:10px;}
.pdb-more:hover{background:var(--brand-soft);}

.pdb-zone{flex:0 0 auto;min-width:0;display:flex;flex-direction:column;gap:3px;padding:7px 14px 8px;border-left:1px solid var(--line);}
.pdb-z-allergy{flex-basis:200px;} .pdb-z-prob{flex-basis:260px;} .pdb-z-vitals{flex-basis:300px;}
.pdb-zh{align-self:flex-start;display:inline-flex;align-items:center;gap:5px;background:none;border:none;padding:0 2px;margin-left:-2px;border-radius:4px;font-size:10.5px;font-weight:700;letter-spacing:.4px;text-transform:uppercase;color:var(--ink-faint);cursor:pointer;line-height:1.5;}
.pdb-zh i{font-size:10px;}
.pdb-zh:hover{color:var(--brand);background:var(--brand-soft);}
.pdb-zc{font-size:10px;font-weight:700;background:var(--line-soft);color:var(--ink-soft);border-radius:8px;padding:0 6px;letter-spacing:0;}
.pdb-zc:empty{display:none;}
.pdb-zsub{font-weight:500;text-transform:none;letter-spacing:0;font-size:10.5px;}
.pdb-zb{font-size:12.5px;line-height:1.35;color:var(--ink);min-width:0;}
.pdb-empty{color:var(--ink-faint);font-size:12.5px;}
.pdb-al{display:flex;flex-wrap:wrap;gap:3px;}
.pdbar .allergy-chip{padding:0 7px;font-size:11.5px;max-width:100%;overflow:hidden;text-overflow:ellipsis;}
.pdb-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:1px;}
.pdb-list li{display:flex;align-items:baseline;gap:6px;min-width:0;white-space:nowrap;}
.pdb-list li::before{content:"";width:5px;height:5px;border-radius:50%;background:var(--flag);flex:none;transform:translateY(-1px);}
.pdb-list .pdb-code{font-family:var(--font-mono);font-size:11.5px;color:var(--ink-faint);flex:none;}
.pdb-list .pdb-nm{overflow:hidden;text-overflow:ellipsis;min-width:0;}
.pdb-plus{background:none;border:none;padding:0;color:var(--brand);font-size:12px;font-weight:600;cursor:pointer;}
.pdb-plus:hover{text-decoration:underline;}
.pdb-vgrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px 12px;}
.pdb-vt{display:flex;gap:4px;align-items:baseline;min-width:0;white-space:nowrap;}
.pdb-vt .k{font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.3px;color:var(--ink-faint);flex:none;}
.pdb-vt .v{font-family:var(--font-mono);font-weight:600;font-size:12.5px;overflow:hidden;text-overflow:ellipsis;min-width:0;}
.pdb-vt.is-empty .v{color:var(--ink-faint);font-weight:400;}
.pdbar.pdb-flash{animation:pdbFlash 1.1s ease-out;}
@keyframes pdbFlash{0%{box-shadow:inset 0 0 0 2px var(--brand);background:var(--brand-soft);}100%{box-shadow:inset 0 0 0 2px transparent;background:var(--card);}}

/* Form column gains the height the old in-scroll card used. (.center padding is left as-is:
   the sticky Question Search bar is offset against it.) */
.pdb-zh.is-static{cursor:default;} .pdb-zh.is-static:hover{color:var(--ink-faint);background:none;}

/* Priority fitting: lower-priority identity facts give way first (all remain in Full Demographics) */
@media (max-width:1679px){ .pdb-f-refdr,.pdb-f-ref{display:none;} }
@media (max-width:1499px){ .pdb-f-next,.pdb-f-lang{display:none;} .pdb-z-allergy{flex-basis:160px;} .pdb-z-prob{flex-basis:210px;} .pdb-z-vitals{flex-basis:244px;} .pdb-zone{padding-left:12px;padding-right:12px;} .pdb-vgrid{column-gap:10px;} }
/* Below laptop width: identity gets its own full row, clinical glance zones share the row below */
@media (max-width:1279px){
  .pdbar{flex-wrap:wrap;}
  .pdbar .pdb-id{flex:1 1 100%;border-bottom:1px solid var(--line-soft);}
  .pdb-f-next,.pdb-f-lang,.pdb-f-ref,.pdb-f-refdr{display:inline;}
  .pdb-zone{flex:1 1 0;padding-top:6px;padding-bottom:7px;}
  .pdb-z-allergy{border-left:none;}
}
@media (max-width:760px){
  .pdb-zone{flex:1 1 50%;}
  .pdb-z-vitals{flex-basis:100%;border-left:none;border-top:1px solid var(--line-soft);}
  .pdb-f-ref,.pdb-f-refdr{display:none;}
}
@media (max-width:640px){
  .pdbar .pdb-id{padding:8px 12px;align-items:flex-start;}
  .pdbar .photo.pdb-photo{width:38px;height:38px;font-size:13px;}
  .pdb-l1 .pdb-sep{display:none;}
  .pdb-zone{padding-left:12px;padding-right:12px;}
  .pdb-vgrid{grid-template-columns:repeat(3,minmax(0,1fr));}
}
@media (max-width:480px){
  .pdb-zone{flex-basis:100%;border-left:none;border-top:1px solid var(--line-soft);}
  .pdb-vgrid{grid-template-columns:repeat(2,minmax(0,1fr));}
}

/* ==== Left panel: no group titles; Collapse / Expand beside the section search ==== */
.nav-hd.nav-hd-row{display:flex;align-items:center;gap:6px;padding:9px 10px 8px;}
.nav-hd-row .nav-search{flex:1;min-width:0;margin-bottom:0;}
.nav-cx{flex:none;display:flex;gap:2px;}
.nav-cx .btn{width:28px;height:30px;padding:0;justify-content:center;color:var(--ink-soft);}
.nav-cx .btn:hover{color:var(--ink);}
#navBody .nav-group > summary{display:none;}
#navBody .nav-group{border-bottom:none;}
#navBody .nav-group-body{padding-top:2px;}

/* ==== Question search: icon in the tab bar, field opens in place ==== */
.vqs-tool{gap:4px;}
.vqs-tool .vqs-toggle{width:30px;height:30px;padding:0;justify-content:center;color:var(--ink-soft);}
.vqs-tool .vqs-toggle:hover{color:var(--ink);}
.vqs-tool .vqs-box{width:min(280px,42vw);animation:vqsIn .14s ease-out;}
@keyframes vqsIn{from{opacity:.4;width:120px;}to{opacity:1;}}
.vqs-tool .vqs-box input{padding:5px 32px 5px 30px;font-size:13px;height:30px;}
.vqs-tool .vqs-clear{display:none!important;}           /* one X: Close clears and collapses */
.vqs-close{position:absolute;right:3px;width:24px;height:24px;border:none;border-radius:6px;background:transparent;color:var(--ink-faint);display:inline-flex;align-items:center;justify-content:center;cursor:pointer;padding:0;}
.vqs-close:hover,.vqs-close:focus-visible{background:var(--line-soft);color:var(--ink);}
.vqs-tool.is-active .vqs-toggle{color:var(--brand);}
@media (prefers-reduced-motion:reduce){ .vqs-tool .vqs-box{animation:none;} }
@media (max-width:640px){ .vqs-tool .vqs-box{width:min(220px,60vw);} }
@media (pointer:coarse){ .vqs-tool .vqs-toggle,.nav-cx .btn{width:34px;height:34px;} .vqs-close{width:30px;height:30px;} }

/* ==== "New" chips: one treatment everywhere ==== */
.chip.new,.status-pill.pill-new,.ssum-ai-tag.new{background:#e1e5ea;color:#264e82;border-color:#e1e5ea;}

/* ==== Left panel status: neutral "not filled yet" indicator (replaces the red dot) ==== */
.statico.pending{background:transparent;border:1.5px dashed var(--ink-faint);}
.statico.pending::after{content:none;}

/* ==== Resizable panels ==== */
.vn-split{flex:none;width:7px;margin:0 -3px;position:relative;z-index:8;cursor:col-resize;touch-action:none;outline:none;}
.vn-split::after{content:"";position:absolute;top:0;bottom:0;left:2px;width:3px;border-radius:2px;background:transparent;transition:background .12s;}
.vn-split:hover::after{background:var(--brand-soft-line);}
.vn-split:focus-visible::after,.vn-split.is-drag::after{background:var(--brand);}
body.vn-resizing{cursor:col-resize;user-select:none;-webkit-user-select:none;}
body.vn-resizing iframe{pointer-events:none;}
.body-grid{min-width:0;overflow:hidden;}
@media (min-width:981px){ .body-grid.vn-has-l .navrail{width:var(--vn-left);} }
@media (min-width:1101px){ .body-grid.vn-has-r .section-summary-panel{flex:0 0 var(--vn-right);} }
@media (max-width:1100px){ #vnSplitR{display:none;} }
@media (max-width:980px){ #vnSplitL{display:none;} }
@media (pointer:coarse){ .vn-split{width:13px;margin:0 -6px;} .vn-split::after{left:5px;} }

/* ==== Mark as Reviewed / Mark as Unreviewed ==== */
.btn.vn-rv-on{color:var(--ink-soft);}
.btn.vn-rv-on:hover{color:var(--ink);}

/* ==== Section header: Left (primary) | Right (section actions) ==== */
.card-hd .hdr-l,.card-hd .hdr-r{display:flex;align-items:center;flex-wrap:wrap;gap:6px;min-width:0;}
.card-hd .hdr-l{margin-left:4px;}
.card-hd .hdr-r{margin-left:auto;justify-content:flex-end;}
.card-hd .hdr-div{width:1px;height:18px;background:var(--line);flex:none;margin:0 1px;}
.card-hd .hdr-filled{display:inline-flex;align-items:center;gap:5px;font-size:12px;color:var(--ink-faint);white-space:nowrap;}
.card-hd .hdr-filled i,.card-hd .hdr-filled svg{font-size:10.5px;}
.card-hd .hdr-next-btn{min-width:26px;justify-content:center;}
.card-hd .hdr-r .ros-bulk{margin-left:0;}

/* ==== Section header: compact "Unsaved changes" mark (replaces the Unsaved chip) ==== */
.card-hd .pill-unsaved.vn-unsaved{width:16px;height:16px;padding:0;margin:0 0 0 -2px;border:none;border-radius:50%;background:transparent;color:var(--amber);font-size:10px;letter-spacing:0;text-transform:none;justify-content:center;align-items:center;flex:none;cursor:default;position:relative;}
.card-hd .pill-unsaved.vn-unsaved::after{content:"";position:absolute;right:0;bottom:1px;width:5px;height:5px;border-radius:50%;background:var(--amber);border:1px solid var(--card);}
.card-hd .pill-unsaved.vn-unsaved svg,.card-hd .pill-unsaved.vn-unsaved i{width:10px;height:10px;font-size:10px;}
@media (pointer:coarse){ .card-hd .pill-unsaved.vn-unsaved{width:22px;height:22px;} }

/* ==== Patient Demographic bar: Hide / Show ==== */
.pdbar{padding-right:34px;}
.pdb-toggle{position:absolute;top:6px;right:6px;height:24px;min-width:24px;padding:0 5px;display:inline-flex;align-items:center;justify-content:center;gap:5px;border:1px solid transparent;border-radius:6px;background:transparent;color:var(--ink-faint);font:inherit;font-size:11.5px;font-weight:600;cursor:pointer;z-index:2;}
.pdb-toggle:hover,.pdb-toggle:focus-visible{background:var(--line-soft);border-color:var(--line);color:var(--ink);}
.pdb-toggle:focus-visible{outline:2px solid var(--brand-soft-line);outline-offset:1px;}
.pdb-toggle i,.pdb-toggle svg{font-size:11px;}
.pdb-toggle .pdb-toggle-t{display:none;}
/* hidden state: one compact identification / clinical row */
.pdbar.pdb-collapsed{align-items:center;padding-right:112px;}
.pdbar.pdb-collapsed .pdb-toggle{top:50%;transform:translateY(-50%);color:var(--brand);border-color:var(--brand-soft-line);background:var(--brand-soft);}
.pdbar.pdb-collapsed .pdb-toggle:hover{background:var(--card);}
.pdbar.pdb-collapsed .pdb-toggle .pdb-toggle-t{display:inline;}
.pdbar.pdb-collapsed .pdb-photo,
.pdbar.pdb-collapsed .pb-risk-pill,
.pdbar.pdb-collapsed .consents-wrap,
.pdbar.pdb-collapsed .pb-contact-link,
.pdbar.pdb-collapsed .pdb-mail,
.pdbar.pdb-collapsed .pdb-money,
.pdbar.pdb-collapsed .pdb-l2,
.pdbar.pdb-collapsed .pdb-l1 .pdb-sep ~ .pdb-sep{display:none!important;}
.pdbar.pdb-collapsed .pdb-id{flex:0 1 auto;padding:4px 14px 4px 14px;}
.pdbar.pdb-collapsed .pdb-idtext{gap:0;}
.pdbar.pdb-collapsed .pdb-l1{flex-wrap:nowrap;gap:4px 8px;}
.pdbar.pdb-collapsed .pb-id .nm{font-size:14px;white-space:nowrap;}
.pdbar.pdb-collapsed .pdb-zone{flex:1 1 0;flex-direction:row;align-items:center;gap:7px;padding:4px 12px;min-width:0;}
.pdbar.pdb-collapsed .pdb-z-allergy{flex-grow:1;} .pdbar.pdb-collapsed .pdb-z-prob{flex-grow:1.4;} .pdbar.pdb-collapsed .pdb-z-vitals{flex-grow:1.8;}
.pdbar.pdb-collapsed .pdb-zh{flex:none;align-self:center;}
.pdbar.pdb-collapsed .pdb-zsub{display:none;}
.pdbar.pdb-collapsed .pdb-zb{flex:1;min-width:0;}
.pdbar.pdb-collapsed .pdb-al{flex-wrap:nowrap;overflow:hidden;}
.pdbar.pdb-collapsed .pdb-list{flex-direction:row;gap:0 10px;overflow:hidden;}
.pdbar.pdb-collapsed .pdb-list li{flex:0 1 auto;min-width:0;}
.pdbar.pdb-collapsed .pdb-plus{white-space:nowrap;}
.pdbar.pdb-collapsed .pdb-zb:has(.pdb-list){display:flex;align-items:baseline;gap:8px;}
.pdbar.pdb-collapsed .pdb-vgrid{display:flex;flex-wrap:nowrap;gap:0 12px;overflow:hidden;}
.pdbar.pdb-collapsed .pdb-vt.is-empty{display:none;}
.pdbar.pdb-collapsed .pdb-vgrid:not(:has(.pdb-vt:not(.is-empty)))::before{content:"None recorded";color:var(--ink-faint);font-size:12.5px;}
/* narrower screens: identity on its own line, clinical glance on the next (still compact) */
@media (max-width:1279px){
  .pdbar.pdb-collapsed{padding-right:0;}
  .pdbar.pdb-collapsed .pdb-id{flex:1 1 100%;padding-right:112px;border-bottom:1px solid var(--line-soft);}
  .pdbar.pdb-collapsed .pdb-toggle{top:5px;transform:none;}
  .pdbar.pdb-collapsed .pdb-zone{padding-top:3px;padding-bottom:3px;}
}
@media (max-width:760px){
  .pdbar.pdb-collapsed .pdb-zone{flex:1 1 100%;border-left:none;border-top:1px solid var(--line-soft);}
  .pdbar.pdb-collapsed .pdb-l1{flex-wrap:wrap;}
  .pdbar.pdb-collapsed .pb-id .nm{white-space:normal;}
}
@media (pointer:coarse){ .pdb-toggle{height:32px;min-width:32px;} .pdbar{padding-right:42px;} }

/* ==== Leave-guard dialog (Continue without saving?) ==== */
.vlg-scrim{position:fixed;inset:0;z-index:500;background:rgba(15,20,30,.45);display:flex;align-items:flex-start;justify-content:center;padding:12vh 16px 16px;}
.vlg-dlg{width:min(470px,100%);background:var(--card);color:var(--ink);border:1px solid var(--line);border-radius:6px;box-shadow:var(--shadow-lg);animation:vlgIn .14s ease-out;font-family:var(--font-ui);}
@keyframes vlgIn{from{transform:translateY(-6px);opacity:.6;}to{transform:none;opacity:1;}}
@media (prefers-reduced-motion:reduce){ .vlg-dlg{animation:none;} }
.vlg-hd{display:flex;align-items:center;gap:10px;padding:12px 12px 11px 16px;border-bottom:1px solid var(--line);}
.vlg-hd h2{flex:1;margin:0;font-size:16px;font-weight:700;color:var(--ink);}
.vlg-x{width:28px;height:28px;border:none;border-radius:6px;background:transparent;color:var(--ink-soft);display:inline-flex;align-items:center;justify-content:center;cursor:pointer;font-size:15px;}
.vlg-x:hover,.vlg-x:focus-visible{background:var(--line-soft);color:var(--ink);}
.vlg-bd{padding:18px 16px 20px;font-size:13.5px;color:var(--ink);border-bottom:1px solid var(--line);}
.vlg-ft{display:flex;justify-content:flex-end;gap:10px;padding:10px 12px;}
.vlg-btn{min-height:32px;padding:5px 14px;border-radius:4px;font:inherit;font-size:13.5px;font-weight:500;cursor:pointer;}
.vlg-cancel{border:1px solid #A9B4C4;background:var(--card);color:#2F3B52;}
.vlg-cancel:hover{background:var(--line-soft);}
.vlg-go{border:1px solid #5B5BD6;background:#5B5BD6;color:#fff;}
.vlg-go:hover{background:#4A4AC4;border-color:#4A4AC4;}
.vlg-btn:focus-visible,.vlg-x:focus-visible{outline:2px solid var(--brand-soft-line);outline-offset:2px;}
@media (pointer:coarse){ .vlg-btn{min-height:40px;padding:8px 16px;} .vlg-x{width:36px;height:36px;} }
@media (max-width:480px){ .vlg-ft{flex-direction:column-reverse;} .vlg-btn{width:100%;} }
/* where "Continue" lands in this prototype: a stand-in for the destination screen */
.vlg-away{position:fixed;inset:0;z-index:480;background:var(--paper);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;padding:24px;text-align:center;font-family:var(--font-ui);color:var(--ink);}
.vlg-away h2{margin:0;font-size:20px;}
.vlg-away p{margin:0;color:var(--ink-soft);font-size:13.5px;max-width:420px;}

/* ==== Visit Note Summary: question-generated vs manually entered content ==== */
.ssm-host > .ssum-textarea{display:none;}
.ssm{display:flex;flex-direction:column;gap:4px;}
/* question-generated: same box as the legacy summary textarea */
.ssm-auto{position:relative;border:1px solid var(--line);border-radius:var(--radius-s);background:var(--card);box-shadow:var(--shadow-sm);padding:5px 6px 5px 8px;font-size:13.2px;line-height:1.5;color:var(--ink);cursor:text;min-height:36px;}
.ssm-auto.is-empty{min-height:40px;}
.ssm-empty{color:var(--ink-faint);padding:3px 26px 3px 2px;}
.ssm-item{display:flex;align-items:flex-start;gap:6px;border-radius:5px;}
.ssm-item + .ssm-item{margin-top:1px;}
.ssm-src{flex:none;width:18px;height:21px;display:inline-flex;align-items:center;justify-content:center;border:none;background:none;padding:0;color:var(--brand);opacity:.55;font-size:10.5px;cursor:pointer;border-radius:4px;}
.ssm-src:hover,.ssm-src:focus-visible{opacity:1;background:var(--brand-soft);}
.ssm-item.is-edited .ssm-src{position:relative;}
.ssm-item.is-edited .ssm-src::after{content:"";position:absolute;right:1px;top:3px;width:5px;height:5px;border-radius:50%;background:var(--brand);border:1px solid var(--card);}
.ssm-item.is-stale .ssm-src{color:var(--amber);opacity:.9;}
.ssm-t{flex:1;min-width:0;overflow-wrap:anywhere;padding:0 2px;border-radius:4px;outline:none;}
.ssm-t:focus{background:var(--brand-soft);box-shadow:0 0 0 1px var(--brand-soft-line);}
.ssm-x{flex:none;width:21px;height:21px;border:none;background:none;color:var(--ink-faint);font-size:11px;border-radius:5px;display:inline-flex;align-items:center;justify-content:center;opacity:.45;padding:0;cursor:pointer;}
.ssm-item:hover .ssm-x,.ssm-x:focus-visible{opacity:1;}
.ssm-x:hover{color:var(--rose);background:var(--rose-soft);opacity:1;}
.ssm-add{position:absolute;right:4px;bottom:4px;width:22px;height:22px;border:none;background:none;color:var(--ink-faint);border-radius:5px;font-size:11px;display:inline-flex;align-items:center;justify-content:center;opacity:.6;padding:0;cursor:pointer;}
.ssm-add:hover,.ssm-add:focus-visible{opacity:1;color:var(--teal);background:var(--teal-soft);}
.ssm-auto:not(.is-empty) .ssm-item:last-of-type{padding-right:22px;}
/* manually entered: no box, no shadow; teal rule + pen glyph */
.ssm-man{display:flex;align-items:flex-start;gap:6px;border-left:2px solid var(--teal);background:var(--teal-soft);border-radius:0 var(--radius-s) var(--radius-s) 0;padding:3px 6px 3px 6px;}
.ssm-man[hidden]{display:none!important;}
.ssm-man-ico{flex:none;width:18px;height:21px;display:inline-flex;align-items:center;justify-content:center;color:var(--teal);font-size:10.5px;}
.ssm-mta{flex:1;min-width:0;border:none;background:transparent;resize:none;overflow:hidden;font:inherit;font-family:var(--font-ui);font-size:13.2px;line-height:1.5;color:var(--ink);padding:0 2px;min-height:21px;outline:none;border-radius:4px;}
.ssm-mta::placeholder{color:var(--ink-faint);}
.ssm-man:focus-within{box-shadow:0 0 0 1px var(--teal);}
/* removed-from-summary note (only when something was removed) */
.ssm-rm{display:flex;align-items:center;gap:6px;flex-wrap:wrap;font-size:11.5px;color:var(--ink-faint);padding:0 2px;}
.ssm-rm i{font-size:10px;}
.ssm-rm button{border:none;background:none;padding:0 2px;font:inherit;font-weight:600;color:var(--brand);cursor:pointer;border-radius:4px;}
.ssm-rm button:hover{text-decoration:underline;}
/* touch (iPad): bigger targets, controls always fully visible */
@media (pointer:coarse){
  .ssm-src,.ssm-x{width:28px;height:28px;font-size:12px;}
  .ssm-x{opacity:.8;}
  .ssm-add{width:28px;height:28px;opacity:.85;}
  .ssm-auto:not(.is-empty) .ssm-item:last-of-type{padding-right:28px;}
  .ssm-t,.ssm-mta{padding-top:3px;}
  .ssm-rm button{padding:4px 6px;}
}

/* ==== Tools popover: float above every panel while open ==== */
.hl-pop.vn-float{position:fixed;top:0;left:0;right:auto;margin:0;z-index:260;max-height:calc(100vh - 16px);overflow:auto;overscroll-behavior:contain;}

/* ==== Mark as Unreviewed lives in Tools ==== */
.card-hd .btn.vn-rv-hidden{display:none!important;}
.vn-tools-item.vn-unrev[hidden]{display:none!important;}

/* ==== Owned free-text notes (Header / Comment / Footer) ==== */
.vn-ft{position:relative;border:1px solid var(--line-soft);border-left:3px solid var(--line);border-radius:8px;padding:6px 9px 7px 10px;margin-bottom:8px;font-size:13.5px;background:var(--paper);}
.vn-ft:last-child{margin-bottom:0;}
.vn-ft.t-header{border-left-color:var(--brand);}
.vn-ft.t-comment{border-left-color:var(--teal);}
.vn-ft.t-footer{border-left-color:var(--ink-faint);}
.vn-ft-meta{display:flex;align-items:center;gap:6px;flex-wrap:wrap;font-size:11.5px;color:var(--ink-faint);margin-bottom:2px;padding-right:56px;}
.vn-ft-type{font-size:10.5px;font-weight:800;letter-spacing:.5px;text-transform:uppercase;color:var(--ink-soft);}
.vn-ft.t-header .vn-ft-type{color:var(--brand);}
.vn-ft.t-comment .vn-ft-type{color:var(--teal);}
.vn-ft-by{font-weight:600;}
.vn-ft-ro{display:inline-flex;align-items:center;gap:3px;}
.vn-ft-ro i,.vn-ft-ro svg{font-size:9.5px;}
.vn-ft-body{color:var(--ink);white-space:pre-wrap;overflow-wrap:anywhere;}
.vn-ft.t-header .vn-ft-body,.vn-ft.t-footer .vn-ft-body{font-weight:700;}
.vn-ft-act{position:absolute;top:4px;right:4px;display:flex;gap:2px;}
.vn-ft-act button{width:24px;height:24px;border:none;border-radius:6px;background:transparent;color:var(--ink-faint);display:inline-flex;align-items:center;justify-content:center;cursor:pointer;font-size:11.5px;}
.vn-ft-act button:hover,.vn-ft-act button:focus-visible{background:var(--line-soft);color:var(--ink);}
.vn-ft-edit textarea{width:100%;min-height:54px;border:1px solid var(--brand-soft-line);border-radius:6px;padding:6px 8px;font:inherit;font-size:13.5px;color:var(--ink);background:var(--card);resize:vertical;}
.vn-ft-edit textarea:focus{outline:2px solid var(--brand-soft-line);border-color:var(--brand);}
.vn-ft-edit .vn-ft-btns{display:flex;justify-content:flex-end;gap:6px;margin-top:6px;}
@media (pointer:coarse){ .vn-ft-act button{width:32px;height:32px;} .vn-ft-meta{padding-right:72px;} }
/* mock sign-in (top-bar avatar) */
.nw-avatar.vn-user-btn{cursor:pointer;border:none;font:inherit;font-weight:700;font-size:11.5px;}
.vn-user-menu{position:fixed;z-index:270;min-width:230px;background:var(--card);color:var(--ink);border:1px solid var(--line);border-radius:10px;box-shadow:var(--shadow-md);padding:6px;font-size:13px;}
.vn-user-menu .hd{font-size:10.5px;font-weight:800;letter-spacing:.5px;text-transform:uppercase;color:var(--ink-faint);padding:4px 8px 6px;}
.vn-user-menu button{display:flex;align-items:center;gap:8px;width:100%;border:none;background:transparent;border-radius:7px;padding:7px 8px;font:inherit;color:var(--ink);cursor:pointer;text-align:left;}
.vn-user-menu button:hover{background:var(--line-soft);}
.vn-user-menu button .ck{width:14px;color:var(--brand);}
.vn-user-menu .sub{color:var(--ink-faint);font-size:11.5px;}

/* ==== Left panel: search on demand (icon when > 5 entries) ==== */
.nav-hd.nav-hd-row{flex-wrap:wrap;position:relative;z-index:20;row-gap:7px;}
.nav-hd-row .nav-cx{order:1;margin-left:auto;}
.nav-hd-row .nav-search{order:2;flex:1 0 100%;min-width:220px;display:none;}
.nav-hd-row.is-searching .nav-search{display:block;animation:navSrchIn .14s ease-out;}
@keyframes navSrchIn{from{opacity:0;transform:translateY(-3px);}to{opacity:1;transform:none;}}
@media (prefers-reduced-motion:reduce){ .nav-hd-row.is-searching .nav-search{animation:none;} }
.nav-hd-row .nav-search input{height:32px;padding:6px 32px 6px 28px;font-size:13px;line-height:1.3;text-overflow:clip;}
.nav-hd-row .nav-search{box-shadow:none;}
.nav-hd-row.is-searching.is-wide .nav-search input{box-shadow:var(--shadow-md);background:var(--card);}
.nav-search-close{position:absolute;right:4px;top:50%;transform:translateY(-50%);width:24px;height:24px;border:none;border-radius:6px;background:transparent;color:var(--ink-faint);display:inline-flex;align-items:center;justify-content:center;cursor:pointer;padding:0;font-size:12px;}
.nav-search-close:hover,.nav-search-close:focus-visible{background:var(--line-soft);color:var(--ink);}
.nav-cx .nav-search-btn[hidden]{display:none!important;}
.nav-hd-row.is-searching .nav-search-btn{color:var(--brand);background:var(--brand-soft);border-color:var(--brand-soft-line);}
@media (pointer:coarse){ .nav-hd-row .nav-search input{height:38px;} .nav-search-close{width:30px;height:30px;} }


/* ============================= [v4] TAB LAYOUT ADDITIONS ============================= */
/* placeholder container for sections whose question set is not yet provided */
.vn-ph{display:flex;align-items:flex-start;gap:10px;padding:14px 16px;border:1.5px dashed var(--brand-soft-line);border-radius:var(--radius-s);background:var(--brand-soft);color:var(--brand-ink);}
.vn-ph-ico{font-size:16px;margin-top:2px;opacity:.8;}
.vn-ph-t{font-weight:700;font-size:13.5px;}
.vn-ph-s{font-size:12.5px;color:var(--ink-soft);margin-top:2px;}
/* nav: groups that hold sections retained from the previous tab set */
.nav-group summary .grpname{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.grp-retained{font-size:9.5px;font-weight:700;letter-spacing:.3px;text-transform:uppercase;color:var(--amber);background:var(--amber-soft);border:1px solid var(--amber-line);border-radius:4px;padding:0 4px;line-height:15px;flex:none;}
/* right dock: 19 options -- scrolls inside its own column when taller than the viewport */
.toolsdock{overscroll-behavior:contain;}
.toolsdock .dock-sep{flex:none;}


/* ============================= [v4] SINGLE-SECTION VIEW ============================= */
/* every section except the selected one is hidden (same DOM, state kept) */
.center.vss-on .center-inner > .card.vss-off{display:none!important;}

/* ============================= [v4] LIST-DETAIL QUESTION ROWS (MA Record) ============================= */
/* label column | answer tiles | row clear -- one ruled row per question, no cards */
.vq-ld-list{border-top:1px solid var(--line-soft);}
.vq.vq-ld{display:grid;grid-template-columns:minmax(120px,170px) minmax(0,1fr) auto;align-items:start;gap:0 14px;padding:10px 0;border-top:none;border-bottom:1px solid var(--line-soft);}
.vq.vq-ld:first-child{padding-top:10px;}
.vq.vq-ld > .vq-q{margin:0;padding-top:6px;text-transform:none;letter-spacing:0;font-size:13.5px;font-weight:600;color:var(--ink);}
.vq-ld-opts{display:grid!important;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:6px 8px;margin:0;}
.vq-ld-opts .cx-chip.vq-ld-tile{border-radius:var(--radius-s);text-align:left;padding:6px 10px;}
.vq-ld-opts .vq-ld-field{display:flex;align-items:center;gap:6px;min-width:0;}
.vq-ld-opts .vq-ld-field > label{font-size:13px;font-weight:600;color:var(--ink-faint);white-space:nowrap;flex:none;}
.vq-ld-opts .vq-ld-field > label::after{content:":";}
.vq-ld-opts .vq-ld-field input[type=text]{flex:1;min-width:0;width:auto;}
.vq-ld-clear{width:26px;height:26px;margin-top:3px;border:none;background:transparent;color:var(--ink-faint);border-radius:5px;display:flex;align-items:center;justify-content:center;cursor:pointer;}
.vq-ld-clear:hover{background:var(--line-soft);color:var(--ink-soft);}
@media (max-width:760px){
  .vq.vq-ld{grid-template-columns:minmax(0,1fr) auto;}
  .vq.vq-ld > .vq-q{grid-column:1 / -1;padding-top:0;margin-bottom:6px;}
  .vq-ld-opts{grid-template-columns:repeat(auto-fill,minmax(150px,1fr));}
}

/* ============================= [v4] HPI TAB -- List-Detail rows (shares .vq-ld from MA Record) ============================= */
.vq-hpi-list .vq-ld-opts{grid-template-columns:repeat(auto-fill,minmax(190px,1fr));}
.vq-hpi-list .vq-ld-wide{grid-column:span 2;}
.vq-hpi-list .vq-ld-field{border:1px solid var(--line);border-radius:var(--radius-s);background:var(--card);padding:3px 4px 3px 10px;min-height:32px;}
.vq-hpi-list .vq-ld-field > label{white-space:normal;flex:1 1 auto;min-width:0;font-weight:500;color:var(--ink-soft);line-height:1.25;}
.vq-hpi-list .vq-ld-field > label::after{content:"";}
.vq-hpi-list .vq-ld-field input[type=text]{flex:0 1 96px;min-width:60px;height:24px;padding:2px 6px;}
.vq-hpi-list .vq-ld-field input.vq-ld-num{flex:0 0 64px;width:64px;height:24px;padding:2px 6px;text-align:right;}
.vq-hpi-list .vq-ld-field:focus-within{border-color:var(--brand);}
.vq-hpi-list .vq-ld-field:has(input:not(:placeholder-shown)){border-color:var(--chip-pos-line);background:var(--chip-pos-bg);}
.vq-hpi-list .vq-ld-field:has(input:not(:placeholder-shown)) > label{color:var(--chip-pos-ink);font-weight:600;}
.vq-req-row > .vq-q .vq-qt{color:var(--rose);}
.vq-req{color:var(--rose);margin-left:2px;font-weight:700;}
.vq-hpi-list .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;}
@media (max-width:760px){ .vq-hpi-list .vq-ld-wide{grid-column:auto;} }

/* ============================= [v4] VITAL SIGNS (MA Record) ============================= */
/* header: icon actions (existing text "Mark as Reviewed" button replaced by an icon for this section only) */
#sec-vitals #vitals-review-btn{display:none!important;}
/* header review: text button until reviewed, then the green reviewed check (reviewer + time in its tooltip) */

.vs-ico{min-width:30px;justify-content:center;}
.vs-ico.vs-on{background:var(--green-soft);border-color:var(--green-line);color:var(--green);}
.btn.vs-split{display:inline-flex;align-items:stretch;padding:0;border:none;background:none;gap:0;box-shadow:none;min-height:0;}
.vs-split > .btn{border-radius:0;}
.vs-split > .btn:first-child{border-top-left-radius:var(--radius-s);border-bottom-left-radius:var(--radius-s);}
.vs-split > .btn:last-child{border-top-right-radius:var(--radius-s);border-bottom-right-radius:var(--radius-s);margin-left:-1px;padding-left:6px;padding-right:6px;}
.vs-caret i,.vs-caret svg{font-size:10px;}
/* popovers / menus */
.vs-pop{position:fixed;z-index:200;background:var(--card);border:1px solid var(--line);border-radius:var(--radius-m);box-shadow:var(--shadow-md);padding:6px;min-width:170px;}
.vs-pop.vs-menu{display:flex;flex-direction:column;}
.vs-pop .vn-tools-item[disabled]{opacity:.45;cursor:default;}
.vs-colopt{display:flex;align-items:center;gap:8px;padding:4px 6px;font-size:13px;color:var(--ink-soft);white-space:nowrap;}
.vs-colopt select{margin-left:auto;}
/* recorded block (recorded_vital.png) -- ruled, compact, label/value grid */
.vs-root{display:flex;flex-direction:column;gap:10px;}
.vs-empty{font-size:13px;color:var(--ink-faint);padding:10px 12px;border:1px dashed var(--line);border-radius:var(--radius-s);}
.vs-rec{border:1px solid var(--line);border-radius:var(--radius-s);background:var(--card);overflow:visible;}
.vs-rec.vs-other{background:var(--paper);border-style:dashed;}
.vs-rec.hl-active{box-shadow:inset 3px 0 0 var(--hl-color);}
.vs-rec-hd{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:6px 12px;padding:6px 8px 6px 12px;background:var(--paper);border-bottom:1px solid var(--line-soft);border-radius:var(--radius-s) var(--radius-s) 0 0;}
.vs-rec.vs-other .vs-rec-hd{background:transparent;}
.vs-rec-meta{display:flex;align-items:center;flex-wrap:wrap;gap:6px 8px;min-width:0;font-size:13px;color:var(--ink-soft);}
.vs-bullet{width:8px;height:8px;border-radius:50%;background:var(--brand);flex:none;}
.vs-rec.vs-other .vs-bullet{background:var(--ink-faint);}
.vs-by b{color:var(--ink);font-weight:700;}
.vs-time{font-size:12px;color:var(--ink-faint);padding-left:8px;border-left:1px solid var(--line);}
.vs-tag{font-size:11px;font-weight:600;color:var(--ink-soft);background:var(--line-soft);border-radius:4px;padding:1px 6px;line-height:16px;}
.vs-tag-warn{color:var(--amber);background:var(--amber-soft);}
.vs-rec-meta .pill-reviewed{font-size:11.5px;}
.vs-rec-acts{display:inline-flex;align-items:center;gap:6px;margin-left:auto;}
.vs-lines{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));column-gap:20px;padding:6px 12px 8px;}
.vs-lrow{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;column-gap:6px;border-bottom:1px solid var(--line-soft);position:relative;min-height:32px;}
.vs-lrow:has(> .vq.vqs-hide){display:none;}
.vs-lrow > .vn-annot-list{grid-column:1 / -1;}
.vs-lrow > .vn-annot-list:empty{display:none;}
.vs-lrow.hl-active{background:color-mix(in srgb,var(--hl-color) 10%,transparent);box-shadow:inset 3px 0 0 var(--hl-color);border-radius:3px;}
.vq.vs-line{display:grid;grid-template-columns:minmax(118px,42%) minmax(0,1fr);align-items:center;column-gap:10px;padding:5px 4px;border:none;border-radius:0;font-size:13px;min-width:0;}
.vq.vs-line:first-child{padding-top:5px;}
.vs-k{color:var(--ink-faint);font-size:12.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.vs-vwrap{display:flex;flex-direction:column;min-width:0;}
.vs-v{color:var(--ink);font-weight:700;font-variant-numeric:tabular-nums;overflow-wrap:anywhere;}
.vs-v.vs-nr{font-weight:400;font-style:italic;color:var(--ink-faint);}
.vs-cmt{font-size:11.5px;color:var(--ink-faint);margin-top:1px;}
.vs-ltools{display:inline-flex;align-items:center;}
.vs-ltools .hl-wrap{position:relative;}
@media (max-width:620px){ .vs-lines{grid-template-columns:1fr;} .vs-rec-acts{margin-left:0;} }
/* Add New / Edit form -- grouped rows: label + NR | input groups */
.vs-form{border:1px solid var(--brand-soft-line);border-radius:var(--radius-s);background:var(--card);box-shadow:var(--shadow-sm);}
.vs-form-hd{display:flex;align-items:center;flex-wrap:wrap;gap:4px 14px;padding:8px 12px;background:var(--brand-soft);border-bottom:1px solid var(--brand-soft-line);border-radius:var(--radius-s) var(--radius-s) 0 0;font-size:13px;color:var(--ink-soft);}
.vs-form-t{display:inline-flex;align-items:center;gap:7px;font-weight:700;font-size:13.5px;color:var(--brand-ink);}
.vs-form-sub b{color:var(--ink);}
.vs-form-hint{margin-left:auto;font-size:12px;color:var(--ink-faint);}
.vs-fgroup{padding:8px 12px 2px;}
.vs-fgroup + .vs-fgroup{border-top:1px solid var(--line-soft);}
.vs-fgroup-t{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--ink-faint);margin:0 0 4px;}
.vs-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(400px,1fr));column-gap:24px;}
.vq.vs-cell{display:grid;grid-template-columns:150px minmax(0,1fr);align-items:center;column-gap:12px;padding:6px 0;border:none;border-bottom:1px dashed var(--line-soft);min-width:0;}
.vq.vs-cell:first-child{padding-top:6px;}
.vs-cell-hd{display:flex;align-items:center;justify-content:space-between;gap:8px;min-width:0;}
