  function fuText(x){ return (x.num ? 'In '+x.num+' '+x.unit : 'Date '+(x.date||'—')) + (x.vtype ? ' · '+x.vtype : '') + (x.who ? ' · with '+x.who : '') + (x.reason ? ' · '+x.reason : ''); }
  function fuCard(x){
    var d = dxById(x.dx);
    return '<div class="ap-card"><div class="ap-card-top"><span class="ap-name">'+E(fuText(x))+'</span>'+(d ? '<span class="ap-tag link">for DX: '+E(dxLabel(d))+'</span>' : '')+'</div>'+
      (x.notes ? '<div class="ap-srow"><span class="k">Notes</span><span>'+E(x.notes)+'</span></div>' : '')+
      '<div class="ap-actions">'+btn('fu-edit', x.id, ico('fa-pen')+' Edit')+'<span class="spacer"></span>'+btn('fu-remove', x.id, 'Remove', '', 'Takes it off this visit; it can be restored')+
        btn('fu-delete', x.id, ico('fa-trash-can')+' Delete', 'ap-danger', 'Deletes the followup from this Visit Note')+'</div></div>';
  }

  /* ---- saved structured view ---- */
  function savedView(){
    var S = AP.saved; if(!S) return '';
    var dx = S.dx.filter(function(d){ return d.inA; });
    function items(list, d){ return list.filter(function(x){ return x.dx === d.id && !x.removed; }); }
    var html = dx.map(function(d, i){
      var rx = items(S.rx, d), ho = items(S.ho, d), fu = items(S.fu, d);
      var rows = [];
      rx.forEach(function(m){ rows.push(['Medication', '<b>'+E(m.name)+'</b>'+(m.sig?' — '+E(m.sig):'')+(m.qty?' · Qty '+E(m.qty):'')+(m.ref?' · Refills '+E(m.ref):'')+(m.notes?'<br><span style="color:var(--ink-faint)">'+E(m.notes)+'</span>':'')]); });
      ho.forEach(function(h){ rows.push(['Handout', E(h.title)+(h.via?' ('+E(h.via)+')':'')]); });
      fu.forEach(function(x){ rows.push(['Followup', E(fuText(x))]); });
      d.plans.forEach(function(p){ rows.push([ptype(p.t)[1], E(p.txt)]); });
      return '<div class="ap-sdx"><div class="ap-sdx-hd"><span class="ap-tag">DX '+(i+1)+'</span>'+(d.code?'<span class="ap-code">'+E(d.code)+'</span>':'')+'<span class="ap-name">'+E(d.name)+'</span><span class="ap-tag">'+E(d.status)+'</span><span class="ap-tag">'+E(d.type)+'</span></div>'+
        (d.onset ? '<div class="ap-srow"><span class="k">Onset</span><span>'+E(d.onset)+'</span></div>' : '')+
        (d.notes ? '<div class="ap-srow"><span class="k">Details</span><span>'+E(d.notes)+'</span></div>' : '')+
        '<div class="ap-plan"><div class="ap-plan-hd">'+ico('fa-list-check')+'Plan</div>'+(rows.length ? rows.map(function(r){ return '<div class="ap-srow"><span class="k">'+r[0]+'</span><span>'+r[1]+'</span></div>'; }).join('') : '<div class="ap-ent-sub">No plan recorded.</div>')+'</div>'+
        (rx.length ? allergyHtml('Allergy (checked against this medication)') : '')+'</div>';
    }).join('') || '<div class="ap-ent-sub">No diagnoses in the assessment.</div>';
    function block(title, list, fmt){ var l = list.filter(function(x){ return !x.removed; }); return l.length ? '<div class="ap-sblock"><h4>'+title+'</h4><ul class="ap-sub-ul">'+l.map(function(x){ return '<li>'+fmt(x)+'</li>'; }).join('')+'</ul></div>' : ''; }
    html += block('Problem List', S.prob, function(p){ var d = find(S.dx, p.dx); return (p.code?E(p.code)+' ':'')+E(p.name)+' — '+E(p.status)+(d?' · assessment: '+E(dxLabel(d)):''); });
    html += block('Other Medications / Rx', S.rx.filter(function(m){ return !m.dx; }), function(m){ return '<b>'+E(m.name)+'</b>'+(m.sig?' — '+E(m.sig):''); });
    html += block('Other Handouts', S.ho.filter(function(h){ return !h.dx; }), function(h){ return E(h.title); });
    html += block('Other Followups', S.fu.filter(function(x){ return !x.dx; }), function(x){ return E(fuText(x)); });
    html += allergyHtml('Allergy');
    return '<div class="ap-saved"><div class="ap-saved-hd">'+ico('fa-clipboard-check')+'Saved Assessment &amp; Plan<span class="ap-ent-sub" style="font-weight:500">· saved '+E(S.at)+'</span></div>'+html+'</div>';
  }

