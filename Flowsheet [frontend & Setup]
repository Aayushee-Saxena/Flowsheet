  /* ---------- BMI (kg / m²) ---------- */
  function toKg(r){ if(!has(r) || r.nr) return NaN; var v = parseFloat(r.val); if(isNaN(v)) return NaN; if((r.unit||'lb') === 'kg') return v; return (v + (parseFloat(r.val2) || 0) / 16) * 0.45359237; }
