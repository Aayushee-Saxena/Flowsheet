  function cell(k, body){ var off = fv(k).nr; return '<div class="vq vs-cell'+(off ? ' is-nr' : '')+'"><div class="vs-cell-hd"><span class="vs-cell-t">'+e(BY[k].label)+'</span>'+nr(k)+'</div><div class="vs-cell-bd">'+body+'</div></div>'; }
