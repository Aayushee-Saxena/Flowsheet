    var k = e.target.getAttribute && e.target.getAttribute('data-sn-in');
    if(k && e.key === 'Enter' && (e.ctrlKey || e.metaKey)){ var s2 = e.target.parentNode.querySelector('[data-sn-act="save"]'); if(s2 && !s2.disabled){ e.preventDefault(); s2.click(); } }
    if(k && e.key === 'Escape'){ var c = e.target.parentNode.querySelector('[data-sn-act="cancel"]'); if(c) c.click(); }
  }, true);

  /* ---------------- sign-off: lock notes, switch headers to Addendum ---------------- */
  function init(){
    var sg = window.signNote;
    if(typeof sg === 'function') window.signNote = signNote = function(){ var r = sg.apply(this, arguments);
      if(signed()){ Object.keys(ED).forEach(function(k){ if(ED[k].mode !== 'add') delete ED[k]; }); paintAll(); } return r; };
    var arr = window.vnArrangeHeaders;
    if(typeof arr === 'function') window.vnArrangeHeaders = function(){ var r = arr.apply(this, arguments); paintAll(); return r; };
    paintAll();
  }
  window.vnSectionNotes = {open: openWin, paintAll: paintAll, signed: signed};
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function(){ setTimeout(init, 40); }); else setTimeout(init, 40);
  window.addEventListener('load', function(){ setTimeout(paintAll, 0); });
})();
