.vs-nr-lbl{display:inline-flex;align-items:center;gap:4px;font-size:11.5px;font-weight:600;color:var(--ink-faint);cursor:pointer;padding:1px 6px 1px 4px;border:1px solid var(--line);border-radius:10px;background:var(--card);flex:none;}
.vs-nr-lbl input{margin:0;width:12px;height:12px;}
.vs-nr-lbl:has(input:checked){background:var(--amber-soft);border-color:var(--amber-line);color:var(--amber);}
.vs-cell-bd{display:flex;align-items:center;flex-wrap:wrap;gap:6px 8px;min-width:0;}
.vs-ig{display:inline-flex;align-items:stretch;height:30px;border:1px solid var(--line);border-radius:5px;background:var(--card);overflow:hidden;flex:0 0 auto;}
.vs-ig:focus-within{border-color:var(--brand);box-shadow:0 0 0 2px var(--brand-soft);}
.vs-ig.is-dis{background:var(--line-soft);}
.vs-ig .vs-in{border:none;border-radius:0;width:76px;height:100%;padding:0 8px;background:transparent;text-align:right;font-variant-numeric:tabular-nums;}
.vs-ig .vs-in:focus{outline:none;}
.vs-ig .vs-in::placeholder{text-align:left;color:var(--ink-faint);}
.vs-ig .vs-sel.vs-unit{border:none;border-left:1px solid var(--line);border-radius:0;min-width:58px;height:100%;padding:0 4px 0 8px;background:var(--paper);color:var(--ink-soft);}
.vs-ig .vs-sel.vs-unit:disabled{background:var(--line-soft);}
.vs-sfx{display:inline-flex;align-items:center;padding:0 9px;border-left:1px solid var(--line);background:var(--paper);font-size:12.5px;color:var(--ink-soft);white-space:nowrap;}
.vs-slash{display:inline-flex;align-items:center;color:var(--ink-faint);padding:0 2px;}
.vs-in{border:1px solid var(--line);border-radius:5px;padding:4px 7px;font:inherit;font-size:13px;background:var(--card);color:var(--ink);min-width:0;}
.vs-in:disabled,.vs-sel:disabled{background:var(--line-soft);color:var(--ink-faint);cursor:not-allowed;}
.vs-sel{border:1px solid var(--line);border-radius:5px;padding:4px 6px;font:inherit;font-size:13px;background:var(--card);color:var(--ink);min-width:120px;}
.vs-sel.vs-pick{height:30px;min-width:118px;max-width:150px;}
.vs-sel.vs-pick:focus,.vs-ig .vs-sel:focus{outline:2px solid var(--brand-soft-line);outline-offset:0;}
.vs-sel.vs-unit{min-width:70px;}
.vs-form-ft{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;padding:8px 12px;background:var(--paper);border-top:1px solid var(--line-soft);border-radius:0 0 var(--radius-s) var(--radius-s);}
.vs-form-ft-l,.vs-form-ft-r{display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
.vs-form-ft-r{margin-left:auto;}
@media (max-width:620px){ .vs-grid{grid-template-columns:1fr;} .vq.vs-cell{grid-template-columns:1fr;row-gap:6px;} .vs-form-hint{margin-left:0;} }
/* centered windows (Add in Detail / Grid-Chart) built on the existing overlay */
