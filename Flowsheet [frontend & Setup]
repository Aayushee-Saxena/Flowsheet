.pgt-colopt:hover{background:var(--line-soft);}
.pgt-colopt input{accent-color:var(--brand);}
.pgt{width:100%;border-collapse:collapse;font-size:13px;min-width:820px;table-layout:fixed;}
.pgt th,.pgt td{border-bottom:1px solid var(--line-soft);border-right:1px solid var(--line-soft);padding:0;vertical-align:middle;}
.pgt thead th{position:sticky;top:0;z-index:1;background:var(--paper);font-size:12px;font-weight:600;color:var(--ink-soft);text-align:center;padding:7px 6px;border-bottom:1px solid var(--line);line-height:1.25;}
.pgt td input{width:100%;height:34px;box-sizing:border-box;border:1px solid transparent;background:transparent;color:var(--ink);font:inherit;font-size:13px;padding:2px 8px;text-align:right;font-variant-numeric:tabular-nums;}
.pgt td input::placeholder{color:var(--ink-faint);opacity:.55;text-align:left;}
.pgt td input:focus{outline:none;border-color:var(--brand);background:var(--card);box-shadow:0 0 0 2px var(--brand-soft);}
.pgt tbody tr:hover td{background:var(--line-soft);}
.pgt .pgt-del{width:44px;text-align:center;border-right:none;}
.pgt-delbtn{width:30px;height:30px;border:none;background:transparent;color:var(--ink-faint);border-radius:5px;cursor:pointer;}
.pgt-delbtn:hover{background:var(--rose-soft);color:var(--rose);}
.pgt-wrap.pgt-h0 [data-pgc="0"],.pgt-wrap.pgt-h1 [data-pgc="1"],.pgt-wrap.pgt-h2 [data-pgc="2"],.pgt-wrap.pgt-h3 [data-pgc="3"],
