      section('ap-ho', 'fa-file-lines', 'Handout', 'Patient education', ho.length, 'add-ho', 'Add Handout', ho.map(hoCard).join('') + tray(AP.ho.map(function(h){ return {id:h.id, name:h.title, removed:h.removed}; }), 'Removed from this visit', 'ho-restore')) +
      section('ap-fu', 'fa-calendar-check', 'Followup', 'Next visit', fu.length, 'add-fu', 'Add Followup', fu.map(fuCard).join('') + tray(AP.fu.map(function(x){ return {id:x.id, name:fuText(x), removed:x.removed}; }), 'Removed from this visit', 'fu-restore')) +
      '<div class="ap-savebar">'+(AP.dirty && AP.saved ? '<span class="pill pill-unsaved" style="display:inline-flex">● Unsaved changes</span>' : '')+
        '<button type="button" class="btn btn-primary btn-sm" data-ap="save">'+ico('fa-floppy-disk')+' Save Assessment &amp; Plan</button></div>' + savedView();
