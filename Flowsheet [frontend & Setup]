<script>
/* ==== Leave-guard: warn before leaving the Visit Note with unsaved changes ==== */
(function(){
  /* what counts as leaving the Visit Note (everything else stays inside it) */
  function leaveTarget(el){
    var b;
    if((b = el.closest('.appdock .dk-btn')) && !b.classList.contains('active') && !b.classList.contains('dk-more'))
      return b.getAttribute('data-tt') || b.getAttribute('title') || b.getAttribute('aria-label') || 'another screen';
    if((b = el.closest('.nw-tab'))){
      var name = (b.firstChild && b.firstChild.nodeType === 3 ? b.firstChild.nodeValue : b.textContent.replace('✕','')).trim();
      if(el.closest('.x')) return b.classList.contains('active') ? 'Close Visit Note' : null;   /* closing another tab keeps you here */
      return b.classList.contains('active') ? null : name;
    }
    if((b = el.closest('.nw-topbar .nw-iconbtn, .nw-topbar .nw-plain'))){
      var t = b.getAttribute('data-tt') || b.getAttribute('title') || b.getAttribute('aria-label') || '';
      return (/help/i.test(t) || b.id === 'fsSetupNav') ? null : t;   /* Help and Flowsheet Setup open alongside, they do not leave */
    }
    return null;
  }
  function unsaved(){ return typeof hasUnsavedAnywhere === 'function' && hasUnsavedAnywhere(); }
  function discard(){
    try{ Object.keys(localStorage).forEach(function(k){ if(/^vn_unsaved_|^vn_ssm_/.test(k)) localStorage.removeItem(k); }); }catch(e){}
    if(typeof SECTION_TITLES !== 'undefined') Object.keys(SECTION_TITLES).forEach(function(k){
      if(typeof clearUnsaved === 'function') clearUnsaved(k); if(typeof clearSsumUnsaved === 'function') clearSsumUnsaved(k); });
  }
  function go(dest){
    var v = document.createElement('div'); v.className = 'vlg-away'; v.setAttribute('role','main');
    v.innerHTML = '<h2></h2><p>Prototype stand-in for this screen. The Visit Note was closed without saving the unsaved changes.</p>'+
                  '<button type="button" class="btn btn-primary btn-sm">Return to Visit Note</button>';
    v.querySelector('h2').textContent = dest === 'Close Visit Note' ? 'Visit Note closed' : dest;
    v.querySelector('button').addEventListener('click', function(){ location.reload(); });
    document.body.appendChild(v);
    v.querySelector('button').focus();
  }
  var open = null;
  function ask(dest, opener){
    if(open) return;
    var sc = document.createElement('div'); sc.className = 'vlg-scrim';
    sc.innerHTML = '<div class="vlg-dlg" role="alertdialog" aria-modal="true" aria-labelledby="vlgT" aria-describedby="vlgM">'+
      '<div class="vlg-hd"><h2 id="vlgT">Continue without saving?</h2><button type="button" class="vlg-x" data-act="cancel" aria-label="Close"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button></div>'+
      '<div class="vlg-bd" id="vlgM">Changes you made will not be saved.</div>'+
      '<div class="vlg-ft"><button type="button" class="vlg-btn vlg-cancel" data-act="cancel">Cancel</button>'+
      '<button type="button" class="vlg-btn vlg-go" data-act="go">Continue without save</button></div></div>';
    function close(){ document.removeEventListener('keydown', key, true); sc.remove(); open = null; if(opener && opener.focus) opener.focus(); }
    function key(e){
      if(e.key === 'Escape'){ e.preventDefault(); close(); return; }
      if(e.key === 'Tab'){                                   /* keep focus inside the dialog */
        var f = [].slice.call(sc.querySelectorAll('button')), i = f.indexOf(document.activeElement);
        e.preventDefault(); f[(i + (e.shiftKey ? f.length - 1 : 1)) % f.length].focus();
      }
    }
    sc.addEventListener('click', function(e){
      var a = e.target.closest('[data-act]');
      if(!a){ if(e.target === sc) close(); return; }        /* clicking outside = Cancel */
      if(a.dataset.act === 'cancel'){ close(); return; }
      close(); discard(); go(dest);
    });
    document.addEventListener('keydown', key, true);
    document.body.appendChild(sc); open = sc;
    if(typeof hidePbiTooltip === 'function') hidePbiTooltip();
    sc.querySelector('.vlg-cancel').focus();
  }
  /* capture phase: runs before any handler on the navigation control */
  document.addEventListener('click', function(e){
    if(open || !e.target.closest) return;
    var dest = leaveTarget(e.target); if(!dest) return;
    e.preventDefault(); e.stopPropagation();
    if(unsaved()) ask(dest, e.target.closest('button, .nw-tab')); else go(dest);
  }, true);
  /* browser refresh / close / address-bar navigation: the browser's own prompt */
  window.addEventListener('beforeunload', function(e){
    if(document.querySelector('.vlg-away')) return;        /* already left via Continue */
    if(unsaved()){ e.preventDefault(); e.returnValue = ''; return ''; }
  });
  window.vnLeaveGuard = {ask: ask, isUnsaved: unsaved};
})();
</script>

<script>
/* ==== Visit Note Summary: question-generated vs manually entered content ====
   Per section: items[] = lines generated from the section's answers (f = source fact,
   t = shown text, edited, removed, stale) + manual = what the user typed themselves.
   Answers are the source of truth for items; nothing here ever writes back to a question. */
(function(){
  var SSM = window.SSM = {};
  function esc(s){ return String(s).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];}); }
  function ta(key){ return document.querySelector('.ssum-textarea[data-key="'+key+'"]'); }
  function title(key){ return (typeof SECTION_TITLES!=='undefined' && SECTION_TITLES[key]) || 'this section'; }
  function rec(key){ return SSM[key] || (SSM[key] = {items:[], manual:''}); }

  /* keep items in step with the answers; user edits/removals survive while the answer is unchanged */
  function sync(key){
    var r = rec(key), facts = [];
    try{ facts = extractSectionFacts(key) || []; }catch(e){}
    var by = {}; r.items.forEach(function(it){ by[it.f] = it; });
    var next = facts.map(function(f){ var o = by[f]; if(o){ o.stale = false; delete by[f]; return o; } return {f:f, t:f, edited:false, removed:false, stale:false}; });
    /* an edited line whose answer has since changed is kept (never silently lost) and flagged */
    Object.keys(by).forEach(function(f){ var o = by[f]; if(o.edited && !o.removed){ o.stale = true; next.push(o); } });
    r.items = next;
  }
  function compose(key){
    var r = rec(key), lines = r.items.filter(function(i){ return !i.removed; }).map(function(i){ return '• ' + i.t; });
    var m = (r.manual || '').trim(); if(m) lines.push(m);
    return lines.join('\n');
  }
  function userChanged(r){ return !!((r.manual||'').trim() || r.items.some(function(i){ return i.edited || i.removed; })); }
  /* the hidden legacy textarea + sectionSummary record always carry the composed text */
  function write(key){
    var r = rec(key), text = compose(key), el = ta(key), facts = r.items.map(function(i){ return i.f; });
    if(typeof sectionSummary !== 'undefined') sectionSummary[key] = {text:text, edited:userChanged(r), sourceHash:JSON.stringify(facts)};
    if(el) el.value = text;
  }
  function dirty(key){
    write(key);
    if(typeof markSsumUnsaved === 'function') markSsumUnsaved(key);
    try{ localStorage.setItem('vn_ssm_'+key, JSON.stringify(SSM[key])); }catch(e){}
  }
  function fit(t){ if(!t) return; t.style.height = 'auto'; t.style.height = t.scrollHeight + 'px'; }

  function render(key){
    var el = ta(key); if(!el) return;
    var body = el.parentElement; body.classList.add('ssm-host');
    var box = body.querySelector(':scope > .ssm');
    if(!box){ box = document.createElement('div'); box.className = 'ssm'; box.dataset.key = key; body.insertBefore(box, el.nextSibling); }
    var r = rec(key), shown = r.items.filter(function(i){ return !i.removed; }), removed = r.items.length - shown.length;
    var man = document.activeElement && document.activeElement.classList && document.activeElement.classList.contains('ssm-mta') && box.contains(document.activeElement);
    var src = 'From a question in ' + esc(title(key)) + ' — go to question';
    var html = '';
    if(shown.length || !(r.manual||'').trim()){
      html += '<div class="ssm-auto'+(shown.length?'':' is-empty')+'" data-role="auto">';
      html += shown.length ? shown.map(function(it){
        var i = r.items.indexOf(it), cls = 'ssm-item' + (it.edited ? ' is-edited' : '') + (it.stale ? ' is-stale' : '');
        var tip = it.stale ? 'Source answer changed since this line was edited — go to question' : (it.edited ? 'From a question in ' + esc(title(key)) + ' · edited here — go to question' : src);
        return '<div class="'+cls+'" data-i="'+i+'"><button type="button" class="ssm-src" data-act="src" aria-label="'+tip+'" aria-describedby="pbiTooltip" data-tt="'+tip+'"><i class="fa-solid fa-link" aria-hidden="true"></i></button>'+
               '<span class="ssm-t" contenteditable="true" spellcheck="true" role="textbox" aria-label="Summary line from '+esc(title(key))+'">'+esc(it.t)+'</span>'+
               '<button type="button" class="ssm-x" data-act="rm" aria-label="Remove from summary (the answer stays)" aria-describedby="pbiTooltip" data-tt="Remove from summary — the answer stays"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button></div>';
      }).join('') : '<div class="ssm-empty">No summary available yet.</div>';
      html += '<button type="button" class="ssm-add" data-act="add" aria-label="Add your own note" aria-describedby="pbiTooltip" data-tt="Add your own note"><i class="fa-solid fa-pen" aria-hidden="true"></i></button></div>';
    }
    html += '<div class="ssm-man" data-role="man"'+((r.manual||'').trim() || man ? '' : ' hidden')+'><span class="ssm-man-ico" aria-describedby="pbiTooltip" data-tt="Entered manually"><i class="fa-solid fa-pen" aria-hidden="true"></i></span>'+
            '<textarea class="ssm-mta" id="ssm-mta-'+key+'" rows="1" placeholder="Type your own note…" aria-label="Manual note for '+esc(title(key))+'"></textarea></div>';
    if(removed) html += '<div class="ssm-rm"><i class="fa-solid fa-eye-slash" aria-hidden="true"></i><span>'+removed+' removed from summary · answers unchanged</span><button type="button" data-act="restore">Restore</button></div>';
    var keepFocus = man;
    box.innerHTML = html;
    var mta = box.querySelector('.ssm-mta'); mta.value = r.manual || ''; fit(mta);
    if(keepFocus){ mta.focus(); mta.setSelectionRange(mta.value.length, mta.value.length); }
    if(typeof bindPbiTooltip === 'function') box.querySelectorAll('[data-tt]').forEach(bindPbiTooltip);
  }
  function openManual(box){
    var m = box.querySelector('.ssm-man'), t = box.querySelector('.ssm-mta'); if(!m||!t) return;
    m.hidden = false; t.focus(); t.setSelectionRange(t.value.length, t.value.length);
  }
  function refresh(key){ sync(key); write(key); render(key); }
  window.ssmRefresh = refresh;

  /* ---- interactions (delegated on the summary panel) ---- */
  function onClick(e){
    var box = e.target.closest && e.target.closest('.ssm'); if(!box) return;
    var key = box.dataset.key, r = rec(key), b = e.target.closest('[data-act]');
    if(b){
      e.preventDefault(); e.stopPropagation();
      var it = b.closest('.ssm-item'), i = it ? +it.dataset.i : -1;
      if(b.dataset.act === 'rm' && r.items[i]){
        r.items[i].removed = true; dirty(key); render(key);
        toast('Removed from summary. The answer in ' + title(key) + ' is unchanged.');
      } else if(b.dataset.act === 'restore'){
        r.items.forEach(function(x){ x.removed = false; }); dirty(key); render(key);
        toast('Restored to summary.');
      } else if(b.dataset.act === 'src'){
        goToSection(key);
      } else if(b.dataset.act === 'add'){
        openManual(box);
      }
      return;
    }
    /* clicking the box itself (not a line) = start typing your own note */
    if(e.target.closest('.ssm-auto') && !e.target.closest('.ssm-t')) openManual(box);
  }
  function commitItem(span){
    var box = span.closest('.ssm'), key = box.dataset.key, r = rec(key), i = +span.closest('.ssm-item').dataset.i, it = r.items[i]; if(!it) return;
    var v = span.textContent.replace(/\s+/g,' ').trim();
    if(!v){ it.removed = true; dirty(key); render(key); toast('Removed from summary. The answer in ' + title(key) + ' is unchanged.'); return; }
    if(v !== it.t){ it.t = v; it.edited = (v !== it.f); dirty(key); render(key); }
  }
  function onKey(e){
    var span = e.target.closest && e.target.closest('.ssm-t'); if(!span) return;
    if(e.key === 'Enter'){ e.preventDefault(); var box = span.closest('.ssm'); span.blur(); openManual(box); }
    else if(e.key === 'Escape'){ var box2 = span.closest('.ssm'); span.blur(); render(box2.dataset.key); }
  }
  function onInput(e){
    var t = e.target; if(!t.classList) return;
    if(t.classList.contains('ssm-mta')){ var bx = t.closest('.ssm'), key = bx.dataset.key; rec(key).manual = t.value; fit(t); dirty(key);
      var ea = bx.querySelector('.ssm-auto.is-empty'); if(ea) ea.hidden = !!t.value.trim(); }
    else if(t.classList.contains('ssm-t')){ var k2 = t.closest('.ssm').dataset.key; if(typeof markSsumUnsaved === 'function') markSsumUnsaved(k2); }
  }
  function onFocusOut(e){
    var t = e.target; if(!t.classList) return;
    if(t.classList.contains('ssm-t')) commitItem(t);
    else if(t.classList.contains('ssm-mta') && !t.value.trim()){ var m = t.closest('.ssm-man'); setTimeout(function(){ if(document.activeElement !== t) m.hidden = true; }, 0); }
  }
  /* pasting into a line keeps it plain text */
  function onPaste(e){
    var span = e.target.closest && e.target.closest('.ssm-t'); if(!span) return;
    e.preventDefault(); var txt = (e.clipboardData || window.clipboardData).getData('text').replace(/\s+/g,' ');
    document.execCommand('insertText', false, txt);
  }

  function init(){
    var panel = document.getElementById('sectionSummaryPanel'); if(!panel) return;
    panel.addEventListener('click', onClick);
    panel.addEventListener('keydown', onKey);
    panel.addEventListener('input', onInput);
    panel.addEventListener('focusout', onFocusOut);
    panel.addEventListener('paste', onPaste);
    document.querySelectorAll('.ssum-textarea[data-key]').forEach(function(el){
      var key = el.dataset.key;
      var raw = null; try{ raw = localStorage.getItem('vn_ssm_'+key); if(raw){ var o = JSON.parse(raw); if(o && o.items) SSM[key] = o; } }catch(e){}
      sync(key);
      /* summary text left unsaved by a pre-change build (single textarea): lines that are not generated become the manual note */
      if(!SSM[key].manual && el.value && !raw){
        var gen = {}; SSM[key].items.forEach(function(i){ gen['• '+i.f] = 1; });
        var extra = el.value.split('\n').filter(function(l){ return l.trim() && !gen[l]; }).join('\n');
        if(extra) SSM[key].manual = extra;
      }
      write(key); render(key);
    });
    /* answers committed -> regenerate this section's question lines (manual note untouched) */
    if(typeof onSectionFieldCommitted === 'function'){
      var prev = onSectionFieldCommitted;
      window.onSectionFieldCommitted = onSectionFieldCommitted = function(key){ var r = prev.apply(this, arguments); if(key && ta(key)) refresh(key); return r; };
    }
    /* "Replace with the latest auto-generated summary" regenerates the question lines only */
    window.doRefreshSectionSummary = doRefreshSectionSummary = function(key){
      var r = rec(key); r.items = []; sync(key); write(key); render(key);
    };
    window.renderAllSummaries = renderAllSummaries = function(){ document.querySelectorAll('.ssum-textarea[data-key]').forEach(function(el){ refresh(el.dataset.key); }); };
    /* Save & Next clears the unsaved copy of this layer too */
    if(typeof clearSsumUnsaved === 'function'){
      var pc = clearSsumUnsaved;
      window.clearSsumUnsaved = clearSsumUnsaved = function(key){ var r = pc.apply(this, arguments); try{ localStorage.removeItem('vn_ssm_'+key); }catch(e){} return r; };
    }
  }
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
})();
</script>

<script>
/* ==== Tools popover: fixed-position layer so the question column can never clip it ==== */
(function(){
  var GAP = 5, EDGE = 8;
  function trigFor(pop){ var w = pop.closest('.hl-wrap'); return w && w.querySelector(':scope > .btn, :scope > button'); }
  function place(pop){
    if(!pop || pop.hidden) return;
    var t = trigFor(pop); if(!t) return;
    var r = t.getBoundingClientRect(), center = document.getElementById('center');
    /* the button scrolled out of its column: close, as a dropdown would */
    if(center && center.contains(t)){
      var c = center.getBoundingClientRect();
      if(r.bottom < c.top || r.top > c.bottom){ pop.hidden = true; t.setAttribute('aria-expanded','false'); return; }
    }
    pop.classList.add('vn-float');
    var W = window.innerWidth, H = window.innerHeight, pw = pop.offsetWidth, ph = pop.offsetHeight;
    var x = r.left;                                         /* open to the right of the Tools button */
    if(x + pw > W - EDGE) x = r.right - pw;                 /* not enough room: align to its right edge */
    x = Math.max(EDGE, Math.min(x, W - EDGE - pw));
    var y = r.bottom + GAP;
    if(y + ph > H - EDGE && r.top - GAP - ph >= EDGE) y = r.top - GAP - ph;   /* flip above */
    y = Math.max(EDGE, Math.min(y, H - EDGE - ph));
    pop.style.left = Math.round(x) + 'px'; pop.style.top = Math.round(y) + 'px';
  }
  function placeOpen(){ document.querySelectorAll('.hl-pop:not([hidden])').forEach(place); }
  function wrap(name){
    var f = window[name]; if(typeof f !== 'function') return;
    window[name] = function(){ var r = f.apply(this, arguments); placeOpen(); return r; };
  }
  /* open / sub-view changes (Color Palette, Comment, Header, Footer) re-measure the popover */
  ['toggleHlPop', 'openToolsSub', 'resetToolsPopView'].forEach(wrap);
  window.addEventListener('resize', placeOpen);
  document.addEventListener('scroll', placeOpen, true);
  if(window.ResizeObserver){
    var ro = new ResizeObserver(placeOpen);
    function observe(){ document.querySelectorAll('.hl-pop').forEach(function(p){ ro.observe(p); }); }
    if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', observe); else observe();
  }
  /* closed popovers drop the floating layout, so nothing lingers */
  if(window.MutationObserver){
    new MutationObserver(function(ms){ ms.forEach(function(m){ var p = m.target;
      if(p.classList && p.classList.contains('hl-pop') && p.hidden){ p.classList.remove('vn-float'); p.style.left = p.style.top = ''; } }); })
      .observe(document.documentElement, {subtree:true, attributes:true, attributeFilter:['hidden']});
  }
})();
</script>

<script>
