 const why=x.kind==='hidden'?`${LOBS_BY[r.lobs.by]} ${usFmt(r.lobs.by==='order'?x.dates.order:x.dates.collect)} is outside the ${(LOBS_DUR[r.lobs.dur]||LOBS_DUR['1y'])[0].toLowerCase()} window`:'no result';
