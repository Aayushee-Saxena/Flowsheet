let unsavedMain={};
let unsavedSummary={};
/* Positional snapshot of a section's own fields -- good enough to survive an
   accidental reload of this prototype; not a real persistence layer. */
function serializeSection(key){
  const card=document.getElementById('sec-'+key);
  if(!card) return null;
  const vals=[...card.querySelectorAll('input,select,textarea')].map(el=>
    (el.type==='checkbox'||el.type==='radio') ? el.checked : el.value);
  const chips=[...card.querySelectorAll('button.cx-chip')].map(el=>el.classList.contains('on'));
  return {vals, chips};
}
function applySection(key, data){
  const card=document.getElementById('sec-'+key);
  if(!card || !data) return;
  const inputs=[...card.querySelectorAll('input,select,textarea')];
  (data.vals||[]).forEach((v,i)=>{
    const el=inputs[i]; if(!el) return;
    if(el.type==='checkbox'||el.type==='radio'){ el.checked=!!v; } else { el.value=v; }
  });
  const chips=[...card.querySelectorAll('button.cx-chip')];
  (data.chips||[]).forEach((v,i)=>{ const el=chips[i]; if(el) el.classList.toggle('on', !!v); });
}
function showUnsavedPill(id){ const p=document.getElementById(id); if(p) p.style.display='inline-flex'; }
function hideUnsavedPill(id){ const p=document.getElementById(id); if(p) p.style.display='none'; }
/* Called on every field commit across a section (see the #center delegated
   listener below, plus the chip-toggle and add-record actions that already
   call it directly). Marks the section "Unsaved" and keeps a temporary
   local-storage snapshot so in-progress edits survive an accidental reload --
   navigating to another section never clears this on its own. */
function markPartial(key){
  if(!key) return;
  unsavedMain[key]=true;
  showUnsavedPill(key+'-unsaved-pill');
  try{ localStorage.setItem('vn_unsaved_'+key, JSON.stringify(serializeSection(key))); }catch(e){}
}
/* Called only by an explicit Save & Next -- clears the unsaved status and
   drops the temporary local-storage copy for that section. */
function clearUnsaved(key){
  if(!key) return;
  unsavedMain[key]=false;
  hideUnsavedPill(key+'-unsaved-pill');
  try{ localStorage.removeItem('vn_unsaved_'+key); }catch(e){}
}
/* Same idea for the Visit Note Summary panel's own per-section textareas. */
function markSsumUnsaved(key){
  if(!key) return;
  unsavedSummary[key]=true;
  showUnsavedPill('ssum-'+key+'-unsaved-pill');
  try{
    const ta=document.querySelector('.ssum-textarea[data-key="'+key+'"]');
    if(ta) localStorage.setItem('vn_unsaved_ssum_'+key, ta.value);
  }catch(e){}
}
function clearSsumUnsaved(key){
  if(!key) return;
  unsavedSummary[key]=false;
  hideUnsavedPill('ssum-'+key+'-unsaved-pill');
  try{ localStorage.removeItem('vn_unsaved_ssum_'+key); }catch(e){}
}
function hasUnsavedAnywhere(){
  return Object.keys(SECTION_TITLES).some(k=>unsavedMain[k]) || Object.keys(SECTION_TITLES).some(k=>unsavedSummary[k]);
}
/* Adds a hidden "Unsaved" pill next to each section's heading (Questions
   area) and each row's label (Summary panel), if not already present. */
function initUnsavedPills(){
  Object.keys(SECTION_TITLES).forEach(key=>{
    const hd=document.querySelector('#sec-'+key+' .card-hd');
    if(hd && !document.getElementById(key+'-unsaved-pill')){
      const pill=document.createElement('span');
      pill.className='pill pill-unsaved';
      pill.id=key+'-unsaved-pill';
      pill.style.display='none';
      pill.textContent='● Unsaved';
      const h3=hd.querySelector('h3');
      if(h3) hd.insertBefore(pill, h3.nextElementSibling); else hd.appendChild(pill);
    }
    const row=document.querySelector('.ssum-sec[data-key="'+key+'"] summary');
    if(row && !document.getElementById('ssum-'+key+'-unsaved-pill')){
      const pill=document.createElement('span');
