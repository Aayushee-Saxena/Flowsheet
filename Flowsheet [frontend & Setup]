   focus both trigger it (see initPbiTooltips). Kept visually consistent with
   the existing .toast component (dark pill, same shadow/radius language). ---- */
.pbi-fixed-tt{position:fixed;background:var(--ink);color:var(--card);font-size:12px;font-weight:600;line-height:1.3;padding:5px 10px;border-radius:7px;box-shadow:var(--shadow-md);z-index:300;pointer-events:none;white-space:nowrap;max-width:260px;}

.pb-full{padding:0 20px 14px;border-top:1px solid var(--line-soft);margin-top:2px;}
.pb-full-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:9px 20px;padding-top:12px;}
.vngd-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px 20px;}
.fact .k{color:var(--ink-faint);font-size:11.5px;text-transform:uppercase;letter-spacing:.4px;margin-bottom:1px;}
.fact .v{color:var(--ink);font-weight:500;}
.fact .v a{text-decoration:none;font-weight:600;}

/* ---- Patient bar: tags, second line ----
   Patient Tags (Established Patient, Chronic Care Mgmt, ...) sit on their
   own line below the info row per spec. Left-aligned under the photo/name,
   wraps if a patient ever has many tags (this row isn't part of the
   "single line" requirement -- that applies to the demographic info above
   it) with minimal padding to keep the whole header's vertical footprint
   small. */
.pb-tags-row{display:flex;flex-wrap:wrap;align-items:center;gap:5px;padding:0 20px 8px;}
.pb-full.editing .v-static{display:none;} .pb-full:not(.editing) .v-edit{display:none;}
.overlay-bd .pb-full-grid .v-edit{display:none;}
.v-edit input,.v-edit select{width:100%;border:1px solid var(--brand-soft-line);background:var(--brand-soft);border-radius:5px;padding:3px 6px;font-size:13px;font-family:inherit;color:inherit;}

.vng-block.editing .v-static{display:none;} .vng-block:not(.editing) .v-edit{display:none;}
.vng-label{font-size:11.5px;font-weight:700;color:var(--ink-faint);text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px;}
.vng-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px 28px;}
.vng-grid .fact{display:flex;align-items:baseline;justify-content:space-between;gap:14px;}
.vng-grid .fact .k{margin-bottom:0;flex:none;white-space:nowrap;}
.vng-grid .fact .v{text-align:right;overflow-wrap:anywhere;}

.showmore-btn{display:flex;align-items:center;gap:4px;color:var(--brand);font-weight:600;font-size:12.5px;background:none;border:none;padding:4px 0;margin:0 20px 8px;}
.showmore-btn svg{transition:transform .15s;}
.patientbar.expanded .showmore-btn svg{transform:rotate(180deg);}
.patientbar:not(.expanded) .pb-full{display:none;}

/* ---- Body 4-column ---- */
.body-grid{display:flex;flex:1;min-height:0;}

/* 1) LEFT NAV — fixed, not a drawer */
.navrail{width:150px;flex:none;background:var(--card);border-right:1px solid var(--line);display:flex;flex-direction:column;}
.nav-hd{padding:11px 12px 9px;border-bottom:1px solid var(--line-soft);flex:none;}
.nav-search{position:relative;margin-bottom:9px;}
.nav-search input{width:100%;border:1px solid var(--line);border-radius:8px;padding:6px 10px 6px 28px;font-size:13px;background:var(--paper);}
.nav-search input:focus{outline:2px solid var(--brand-soft-line);border-color:var(--brand);background:var(--card);}
.nav-search svg{position:absolute;left:8px;top:50%;transform:translateY(-50%);color:var(--ink-faint);}
.nav-search-results{position:absolute;left:0;right:0;top:100%;margin-top:4px;background:var(--card);border:1px solid var(--line);border-radius:8px;box-shadow:var(--shadow-md);z-index:30;max-height:280px;overflow:auto;}
.nav-search-item{padding:6px 9px;font-size:12.5px;cursor:pointer;}
.nav-search-item:hover{background:var(--line-soft);}
.nav-legend{display:flex;flex-wrap:wrap;gap:5px 9px;font-size:11px;color:var(--ink-faint);}
.nav-legend b{color:var(--ink);font-family:var(--font-mono);}
.nav-legend .lg{display:flex;align-items:center;gap:3px;}

.nav-body{flex:1;overflow:auto;padding:6px;}
.nav-group-label{font-size:11px;font-weight:700;color:var(--ink-faint);text-transform:uppercase;letter-spacing:.5px;padding:10px 8px 5px;}
.nav-item{display:flex;align-items:center;gap:8px;padding:7px 8px;border-radius:8px;color:var(--ink-soft);font-size:13.3px;font-weight:500;cursor:pointer;}
.nav-item:hover{background:var(--line-soft);}
.nav-item.active{background:var(--brand-soft);color:var(--brand-ink);font-weight:600;}
.nav-item.searchmatch{outline:1.5px solid var(--brand-soft-line);}
.statico{width:15px;height:15px;flex:none;border-radius:50%;display:flex;align-items:center;justify-content:center;}
.statico.unfilled{border:1.6px solid var(--line);}
.statico.partial{background:conic-gradient(var(--amber) 0 180deg, transparent 180deg 360deg);border:1.6px solid var(--amber-line);}
.statico.filled{background:var(--blue);}
.statico.reviewed{background:var(--green);}
.statico.required{background:var(--rose);}
.statico.signed{background:var(--brand);}
.statico svg{width:9px;height:9px;color:#fff;}
.nav-item .nm{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.nav-item .stxt{font-size:10.5px;color:var(--ink-faint);flex:none;}
.own-tag{font-size:9.5px;font-weight:700;letter-spacing:.3px;padding:1px 5px;border-radius:5px;flex:none;}
.own-tag.ma{background:var(--blue-soft);color:var(--blue);}
.own-tag.provider{background:var(--ai-soft);color:var(--ai);}
.own-tag.both{background:var(--teal-soft);color:var(--teal);}
.nav-group{border-bottom:1px solid var(--line-soft);}
.nav-group:last-child{border-bottom:none;}
.nav-group summary{list-style:none;display:flex;align-items:center;gap:6px;padding:9px 8px 6px;font-size:11px;font-weight:700;color:var(--ink-faint);text-transform:uppercase;letter-spacing:.5px;cursor:pointer;user-select:none;}
.nav-group summary::-webkit-details-marker{display:none;}
.nav-group summary .grpcar{font-size:9px;color:var(--ink-faint);transition:transform .15s;flex:none;}
.nav-group[open] summary .grpcar{transform:rotate(90deg);}
.nav-group summary .grpcount{margin-left:auto;font-size:10px;font-weight:600;color:var(--ink-faint);background:var(--line-soft);border-radius:8px;padding:1px 6px;}
.nav-group-body{padding-bottom:4px;}
.statico.complete{background:var(--green);}
.statico.pending{background:var(--card);border:1.6px solid var(--rose);}
.statico.pending::after{content:'';width:6px;height:6px;border-radius:50%;background:var(--rose);flex:none;}
.statico.locked{background:var(--line-soft);border:1.6px solid var(--line);}
.statico.locked i{color:var(--ink-faint);font-size:9px;}
.pr-badge{display:flex;align-items:center;justify-content:center;width:15px;height:15px;flex:none;border-radius:50%;background:var(--flag-soft);color:var(--flag);}
.pr-badge i{font-size:9px;}
.nav-search-item .grp{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.3px;color:var(--brand);margin-right:4px;}

/* 2) MAIN FORM — split into 60% questions / 40% unified summary */
.center-split{flex:1 1 auto;min-width:0;display:flex;min-height:0;}
.center{flex:7 1 0;min-width:0;overflow:auto;padding:5px 12px 90px 8px;position:relative;}
.center-inner{max-width:none;display:flex;flex-direction:column;gap:8px;}

/* 2b) UNIFIED VISIT NOTE SUMMARY (36%) — every section, SOAP-organized, editable in place */
.section-summary-panel{flex:3 1 0;min-width:0;overflow:auto;border-left:1px solid var(--line);background:var(--paper);padding:5px 14px 90px 14px;display:flex;flex-direction:column;gap:6px;}
.ssum-panel-hd{flex:none;font-size:14.5px;font-weight:700;color:var(--ink);}
.ssum-attn{display:flex;flex-direction:column;gap:5px;flex:none;}
.ssum-attn-item{border:1px solid var(--amber-line);background:var(--amber-soft);color:var(--amber);border-radius:8px;padding:7px 9px;font-size:12.5px;display:flex;gap:6px;align-items:flex-start;cursor:pointer;}
.ssum-attn-item a{color:var(--amber);font-weight:700;text-decoration:none;flex:none;}

.ssum-tabs{display:flex;gap:2px;flex:none;border-bottom:1px solid var(--line-soft);margin-bottom:2px;}
.ssum-tab{flex:1 1 50%;border:none;background:transparent;padding:7px 4px 8px;font-size:12.5px;font-weight:700;color:var(--ink-faint);cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-1px;text-align:center;border-radius:6px 6px 0 0;}
.ssum-tab:hover{background:var(--line-soft);color:var(--ink);}
.ssum-tab.on{color:var(--brand);border-bottom-color:var(--brand);background:var(--brand-soft, transparent);}
.ssum-tab.on::before{content:"\2713 ";font-size:10px;}
.ssum-tab:focus-visible{outline:2px solid var(--brand);outline-offset:-2px;}
.ssum-tabpanel{display:flex;flex-direction:column;gap:6px;min-width:0;}
.ssum-tabpanel[hidden]{display:none;}
.ssum-ai-card{border:1px solid var(--ai-line);background:var(--ai-soft);border-radius:10px;padding:10px 11px;flex:none;}
.ssum-ai-hd{display:flex;align-items:center;gap:7px;font-size:12.5px;font-weight:700;color:var(--ai);margin-bottom:8px;}
.ssum-ai-badge{display:inline-flex;align-items:center;gap:4px;font-size:10px;font-weight:800;letter-spacing:.3px;background:var(--ai);color:#fff;border-radius:9px;padding:2px 7px 2px 6px;flex:none;}
.ssum-ai-item{display:flex;gap:7px;align-items:flex-start;padding:6px 0;border-top:1px solid var(--ai-line);font-size:12.5px;}
.ssum-ai-item:first-child{border-top:none;padding-top:0;}
.ssum-ai-tag{flex:none;font-size:10px;font-weight:700;border-radius:8px;padding:2px 6px;margin-top:1px;border:1px solid transparent;}
.ssum-ai-tag.new{background:var(--green-soft);color:var(--green);border-color:var(--green-line, var(--green));}
.ssum-ai-tag.updated{background:var(--blue-soft, var(--brand-soft));color:var(--blue, var(--brand));border-color:var(--blue-line, var(--brand));}
.ssum-ai-body{color:var(--ink);line-height:1.4;}
.ssum-ai-empty{font-size:12.5px;color:var(--ink-faint);padding:2px 0;}
.ssum-past-hd{font-size:12.5px;font-weight:700;color:var(--ink);margin:10px 0 2px;flex:none;}
.ssum-past-card{border:1px solid var(--line-soft);border-radius:8px;padding:8px 10px;font-size:12.5px;flex:none;}
.ssum-past-date{font-weight:700;color:var(--ink);margin-bottom:3px;}
.ssum-past-row{color:var(--ink-soft);line-height:1.5;}
.ssum-past-row .lbl{color:var(--ink-faint);font-weight:600;}
.ssum-past-copy-btn{margin-top:7px;}
.ssum-ai-tag.carried{background:var(--line-soft);color:var(--ink-soft);border-color:var(--line);}

.carried-forward-box{border:1px solid var(--blue-line);background:var(--blue-soft);border-radius:9px;padding:8px 10px;margin-bottom:10px;}
.carried-forward-hd{display:flex;align-items:center;gap:6px;font-size:12px;font-weight:700;color:var(--blue);margin-bottom:6px;}
.carried-forward-list{display:flex;flex-direction:column;gap:5px;}
.carried-forward-item{font-size:13px;color:var(--ink);line-height:1.45;padding:4px 0 0;border-top:1px solid var(--blue-line);}
.carried-forward-item:first-child{border-top:none;padding-top:0;}
.carried-forward-item .cf-date{font-weight:700;color:var(--blue);margin-right:6px;}
.cf-badge{display:inline-flex;align-items:center;font-size:10px;font-weight:700;background:var(--blue-soft);color:var(--blue);border:1px solid var(--blue-line);border-radius:8px;padding:1px 7px;margin-right:6px;white-space:nowrap;}

.ssum-group{border:1px solid var(--line);border-radius:var(--radius-m);background:var(--card);overflow:hidden;flex:none;}
.ssum-group summary{list-style:none;display:flex;align-items:center;gap:6px;padding:8px 10px;font-size:11px;font-weight:700;color:var(--ink-faint);text-transform:uppercase;letter-spacing:.5px;cursor:pointer;user-select:none;background:var(--paper);}
.ssum-group summary::-webkit-details-marker{display:none;}
.ssum-group summary .grpcar{font-size:9px;transition:transform .15s;flex:none;}
.ssum-group[open] summary .grpcar{transform:rotate(90deg);}
.ssum-group summary .grpcount{margin-left:auto;font-size:10px;font-weight:600;color:var(--ink-faint);background:var(--line-soft);border-radius:8px;padding:1px 6px;}
.ssum-group-body{padding:5px 7px 7px;display:flex;flex-direction:column;gap:5px;}

.ssum-sec{border:1px solid var(--line-soft);border-radius:8px;}
.ssum-sec summary{list-style:none;display:flex;align-items:center;gap:6px;padding:6px 8px;font-size:13px;font-weight:600;color:var(--ink);cursor:pointer;user-select:none;}
.ssum-sec summary::-webkit-details-marker{display:none;}
.ssum-sec summary .nm{flex:1;min-width:0;overflow-wrap:break-word;}
.ssum-sec summary .sec-car{font-size:10px;color:var(--ink-faint);transition:transform .15s;flex:none;}
.ssum-sec summary .ssum-goto-inline{flex:none;width:22px;height:22px;padding:0;border-radius:6px;border:1px solid var(--line);background:var(--card);color:var(--ink-faint);display:flex;align-items:center;justify-content:center;font-size:12px;}
.ssum-sec summary .ssum-goto-inline:hover{background:var(--line-soft);color:var(--ink);}
.ssum-sec summary .ssum-goto-inline.is-locked{opacity:.4;cursor:not-allowed;}
.ssum-sec[open] summary .sec-car{transform:rotate(90deg);}
.ssum-sec-body{padding:0 8px 7px;}
.ssum-textarea{width:100%;min-height:64px;border:1px solid var(--line);border-radius:var(--radius-s);padding:8px 10px;background:var(--card);color:var(--ink);font-size:13.2px;line-height:1.5;resize:vertical;font-family:var(--font-ui);box-shadow:var(--shadow-sm);}
.ssum-textarea:focus{outline:2px solid var(--brand-soft-line);border-color:var(--brand);background:var(--card);}
.ssum-sec-actions{display:flex;align-items:center;gap:6px;justify-content:flex-end;margin-top:4px;}
.ssum-goto-btn{margin-right:auto;}
.ssum-refresh-btn{width:22px;height:22px;border-radius:6px;border:1px solid var(--line);background:var(--card);color:var(--ink-faint);display:flex;align-items:center;justify-content:center;font-size:11.5px;flex:none;}
.ssum-refresh-btn:hover{background:var(--line-soft);color:var(--ink);}
.ssum-savecontinue-btn{width:22px;height:22px;border-radius:6px;border:1px solid var(--line);background:var(--card);color:var(--ink-faint);display:flex;align-items:center;justify-content:center;font-size:12px;flex:none;}
.ssum-savecontinue-btn:hover{background:var(--line-soft);color:var(--ink);}
.ssum-savecontinue-btn.is-locked{opacity:.4;cursor:not-allowed;}
.ssum-confirm{display:none;align-items:center;gap:7px;flex-wrap:wrap;background:var(--rose-soft);border:1px solid var(--rose-line);color:var(--rose);border-radius:7px;padding:7px 9px;font-size:12px;margin-top:6px;}
.ssum-confirm.show{display:flex;}
.ssum-confirm .sp{flex:1 1 100%;font-weight:600;}

@media (max-width:100px){
  .center{flex:1 1 auto;padding:16px 20px 20px;}
  /* iPad-friendly touch targets for section headers (portrait ~810-834px,
     landscape ~1024-1194px both fall in this range) -- bump tap area only,
     layout/order is unchanged so hierarchy stays identical to desktop. */
  .card-hd{gap:10px;}
  .card-hd .btn.btn-xs{padding:7px 10px;min-height:32px;}
  .card-hd .btn.btn-sm{padding:7px 13px;min-height:34px;}
  .card-hd .hl-wrap>.btn-xs,.card-hd .hdr-reset-btn{min-width:32px;justify-content:center;}
}

/* 4) RIGHT ICON DOCK */
.toolsdock{width:70px;flex:none;background:var(--card);border-left:1px solid var(--line);display:flex;flex-direction:column;align-items:center;padding:10px 0;gap:4px;overflow-y:auto;position:relative;}
.dock-btn{width:50px;height:50px;border-radius:10px;border:1px solid transparent;background:transparent;color:var(--ink-soft);display:flex;align-items:center;justify-content:center;position:relative;flex:none;}
.dock-btn:hover{background:var(--line-soft);}
.dock-btn.active{background:var(--brand-soft);color:var(--brand-ink);border-color:var(--brand-soft-line);}
.dock-btn .badge{position:absolute;top:-3px;right:-3px;background:var(--rose);color:#fff;font-size:9.5px;font-weight:700;border-radius:8px;min-width:14px;height:14px;display:flex;align-items:center;justify-content:center;padding:0 3px;}
.dock-sep{width:30px;height:1px;background:var(--line);margin:5px 0;}

.flyout{position:fixed;top:0;bottom:0;right:54px;width:320px;background:var(--card);border-left:1px solid var(--line);box-shadow:var(--shadow-lg);z-index:70;display:flex;flex-direction:column;animation:flyin .15s ease-out;}
@keyframes flyin{from{transform:translateX(14px);opacity:.5;}to{transform:translateX(0);opacity:1;}}
.flyout-hd{display:flex;align-items:center;gap:8px;padding:13px 14px;border-bottom:1px solid var(--line);flex:none;}
.flyout-hd h3{font-size:14.5px;}
.flyout-hd .spacer{flex:1;}
.flyout-bd{flex:1;overflow:auto;padding:12px 14px 24px;font-size:13px;}
.dock-search-box{position:relative;}
.dock-search-box input{width:100%;border:1px solid var(--line);border-radius:8px;padding:8px 10px 8px 30px;font-size:13.5px;background:var(--paper);}
.dock-search-box svg{position:absolute;left:9px;top:50%;transform:translateY(-50%);color:var(--ink-faint);}
.dock-search-results{margin-top:10px;}
.dock-search-group{font-size:11px;text-transform:uppercase;letter-spacing:.4px;color:var(--ink-faint);font-weight:700;margin:10px 0 3px;}
.dock-search-group:first-child{margin-top:0;}
.dock-search-item{padding:7px 8px;border-radius:7px;cursor:pointer;display:flex;justify-content:space-between;gap:6px;}
.dock-search-item:hover{background:var(--line-soft);}

.rf-mini-row{display:flex;justify-content:space-between;align-items:center;padding:6px 0;border-bottom:1px solid var(--line-soft);gap:8px;}
.rf-mini-row:last-child{border-bottom:none;}
.status-pill{font-size:10.5px;font-weight:700;padding:2px 7px;border-radius:9px;text-transform:uppercase;letter-spacing:.3px;flex:none;}
.status-pill.reviewed{background:var(--green-soft);color:var(--green);}
.status-pill.required{background:var(--rose-soft);color:var(--rose);}
.status-pill.pending{background:var(--line-soft);color:var(--ink-faint);}
.spark{display:block;}

/* ============================= CARDS ============================= */
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius-l);box-shadow:var(--shadow-sm);scroll-margin-top:14px;}
.card-hd{display:flex;align-items:center;gap:9px;padding:12px 16px;border-bottom:1px solid var(--line-soft);flex-wrap:wrap;}
.card-hd h3{font-size:15px;}
.card-hd .meta{font-size:12px;color:var(--ink-faint);}
.card-hd .spacer{flex:1;}
.card-bd{padding:5px 10px;}
.sec-continue{padding:12px 16px;border-top:1px solid var(--line-soft);display:flex;justify-content:flex-end;}
.card.sec-locked{opacity:.45;pointer-events:none;}

/* ---- Staff highlight color palette (section-level) ---- */
.hl-wrap{position:relative;display:inline-flex;}
.hl-trigger-active{border-color:var(--ink-faint);}
.hl-dot{width:8px;height:8px;border-radius:50%;display:inline-block;margin-left:5px;}
.hl-pop{position:absolute;top:100%;right:0;margin-top:5px;background:var(--card);border:1px solid var(--line);border-radius:10px;box-shadow:var(--shadow-md);width:244px;z-index:40;padding:9px;}
.hl-pop-label{font-size:11.5px;font-weight:700;color:var(--ink-faint);text-transform:uppercase;letter-spacing:.3px;margin-bottom:7px;}
.hl-swrow{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:8px;}
.hl-swatch{width:24px;height:24px;border-radius:50%;border:2px solid var(--card);box-shadow:0 0 0 1px var(--line);cursor:pointer;padding:0;}
.hl-swatch.active{box-shadow:0 0 0 2px var(--ink);}
.hl-clear{width:100%;justify-content:center;}
.vn-tools-menu{display:flex;flex-direction:column;gap:2px;}
.vn-tools-item{display:flex;align-items:center;gap:8px;width:100%;padding:7px 8px;border:none;background:transparent;border-radius:6px;font-size:13.5px;font-weight:600;color:var(--ink);cursor:pointer;text-align:left;}
.vn-tools-item:hover,.vn-tools-item:focus-visible{background:var(--line-soft);}
.vn-tools-item .icon{width:14px;text-align:center;color:var(--ink-faint);flex:none;}
.vn-tools-sub{display:flex;flex-direction:column;gap:6px;}
.vn-tools-label{font-size:11.5px;font-weight:700;color:var(--ink-faint);text-transform:uppercase;letter-spacing:.4px;margin-top:2px;}
.vn-tools-input,.vn-tools-textarea{width:100%;border:1px solid var(--line);border-radius:7px;padding:6px 8px;font:inherit;font-size:13.5px;background:var(--card);color:var(--ink);resize:vertical;}
.vn-tools-actions{display:flex;gap:6px;justify-content:flex-end;margin-top:2px;}
.vn-annot-list:empty{display:none;}
.vn-annot-list:not(:empty){margin-bottom:10px;}
.vn-annot-list.vn-annot-list-footer:not(:empty){margin-bottom:0;margin-top:10px;}
.vn-annot{position:relative;border:1px solid var(--line-soft);border-radius:8px;padding:7px 26px 7px 9px;margin-bottom:8px;font-size:13.5px;background:var(--paper);}
.vn-annot:last-child{margin-bottom:0;}
.vn-annot-meta{font-size:11.5px;font-weight:700;color:var(--ink-faint);margin-bottom:3px;}
.vn-annot-body{color:var(--ink);white-space:pre-wrap;overflow-wrap:break-word;}
.vn-annot-header .vn-annot-body,.vn-annot-footer .vn-annot-body{font-weight:700;}
