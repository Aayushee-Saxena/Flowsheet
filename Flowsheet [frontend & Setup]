  /* ---- drawer (pickers + forms) ---- */
  var drawer = null;
  function openDrawer(title, bodyHtml, footHtml){
    if(!drawer){
      drawer = document.createElement('div'); drawer.className = 'overlay-scrim'; drawer.id = 'apScrim'; drawer.hidden = true;
      drawer.innerHTML = '<div class="overlay-panel" style="width:min(600px,100%);" role="dialog" aria-modal="true" aria-labelledby="apDrTitle"><div class="overlay-hd"><h2 id="apDrTitle"></h2><div class="spacer"></div><button type="button" class="btn btn-ghost btn-sm" data-apd="close">Close</button></div><div class="overlay-bd" id="apDrBody"></div><div class="overlay-ft" id="apDrFoot"></div></div>';
      document.body.appendChild(drawer);
      drawer.addEventListener('click', function(e){ if(e.target === drawer) closeDrawer(); onDrawerClick(e); });
      drawer.addEventListener('input', onDrawerInput);
      document.addEventListener('keydown', function(e){ if(e.key === 'Escape' && drawer && !drawer.hidden) closeDrawer(); });
    }
    drawer.querySelector('#apDrTitle').textContent = title;
    drawer.querySelector('#apDrBody').innerHTML = bodyHtml;
    drawer.querySelector('#apDrFoot').innerHTML = footHtml || '<button type="button" class="btn btn-primary" data-apd="close">Done</button>';
    drawer.hidden = false;
    var s = drawer.querySelector('.ap-pick-search, input, select'); if(s) setTimeout(function(){ s.focus(); }, 30);
  }
  function closeDrawer(){ if(drawer) drawer.hidden = true; AP.pick = null; }

  /* picker: kind = dx | pl | ho | rx ; preset dx id for plan-driven adds */
  function openPicker(kind, dxId){
    AP.pick = {kind:kind, dx:dxId || '', tab: kind === 'rx' ? 'search' : 'tpl', q:''};
    var titles = {dx:'Add Diagnosis', pl:'Add Problem', ho:'Add Handout', rx:'Add Medication'};
    var d = dxById(dxId);
    openDrawer(titles[kind] + (d ? ' — for ' + dxLabel(d) : ''), pickerBody());
  }
  function pickerBody(){
    var P = AP.pick, tpl = {dx:DX_TPL, pl:PB_TPL, ho:HO_TPL}[P.kind], all = {dx:DX_ALL, pl:PB_ALL, ho:HO_ALL, rx:RX_ALL}[P.kind];
    var tabs = P.kind === 'rx' ? '' : '<div class="ap-pick-tabs" role="tablist"><button type="button" role="tab" class="'+(P.tab==='tpl'?'on':'')+'" data-apd="tab" data-v="tpl">Templates</button><button type="button" role="tab" class="'+(P.tab==='search'?'on':'')+'" data-apd="tab" data-v="search">Search '+({dx:'Diagnosis', pl:'Problems', ho:'Handouts'}[P.kind])+'</button></div>';
    var srch = P.tab === 'search' ? '<input type="text" class="ap-pick-search" id="apPickQ" placeholder="'+(P.kind==='rx'?'Search medication name or class':'Search by name or code')+'" value="'+E(P.q)+'" autocomplete="off">' : '';
    return tabs + srch + '<div class="ap-pick-list" id="apPickList">'+pickerRows(P.tab === 'tpl' ? tpl : all)+'</div>';
  }
  function pickerRows(list){
    var P = AP.pick, q = P.tab === 'search' ? P.q.trim().toLowerCase() : '';
    var rows = list.map(function(it, i){
      var code = '', name = '', sub = '';
      if(P.kind === 'rx'){ name = it.n; sub = it.g; } else if(typeof it === 'string'){ name = it; } else { code = it[0]; name = it[1]; }
      return {i:i, code:code, name:name, sub:sub};
    }).filter(function(r){ return !q || (r.code + ' ' + r.name + ' ' + r.sub + ' ' + alias(r.code, r.name)).toLowerCase().indexOf(q) >= 0; });
    if(P.tab === 'search' && !q && P.kind !== 'rx') return '<div class="ap-pick-none">Type to search.</div>';
    if(!rows.length) return '<div class="ap-pick-none">No matches found.</div>';
    return rows.map(function(r){
      var added = isAdded(P.kind, r.code, r.name);
      return '<div class="ap-pick-row">'+(r.code?'<span class="ap-code">'+E(r.code)+'</span>':'')+'<span class="nm">'+E(r.name)+(r.sub?'<span class="sub">'+E(r.sub)+'</span>':'')+'</span>'+
        (added && P.kind !== 'rx' ? '<span class="ap-tag ok">'+ico('fa-check')+' Added</span>' : '<button type="button" class="btn btn-xs btn-primary" data-apd="pick" data-code="'+E(r.code)+'" data-name="'+E(r.name)+'" data-sub="'+E(r.sub)+'">'+(P.kind==='rx'?'Select':'Add')+'</button>')+'</div>';
    }).join('');
  }
  /* common abbreviations so "PTSD", "GAD", "MDD", "OCD" also find their diagnoses */
  function alias(code, name){
    var n2 = (name || '').toLowerCase(), o = [];
    if(/post-traumatic/.test(n2)) o.push('ptsd'); if(/generalized anxiety/.test(n2)) o.push('gad'); if(/major depressive/.test(n2)) o.push('mdd depression');
    if(/obsessional|obsessive/.test(n2)) o.push('ocd'); if(/adhd/.test(n2)) o.push('add attention'); if(/dysthymic/.test(n2)) o.push('depression');
    return o.join(' ');
  }
  function isAdded(kind, code, name){
    if(kind === 'dx') return AP.dx.some(function(d){ return d.inA && d.name === name; });
    if(kind === 'pl') return AP.prob.some(function(p){ return !p.removed && p.name === name; });
    if(kind === 'ho') return AP.ho.some(function(h){ return !h.removed && h.title === name && (!AP.pick.dx || h.dx === AP.pick.dx); });
    return false;
  }
  function addDx(code, name){ var d = {id:uid('dx'), code:code, name:name, status:'Active', type: activeDx().length ? 'Secondary' : 'Primary', onset:'', notes:'', inA:true, plans:[]}; AP.dx.push(d); return d; }
  function addProb(code, name, fromDx){ var p = {id:uid('pl'), code:code, name:name, status:'Active', onset:'', dx: fromDx || '', fromDx: fromDx || '', removed:false}; AP.prob.push(p); return p; }

  /* medication details form (select -> details -> review -> save) */
  function openMedForm(med, existing, dxId){
    var m = existing || {name:med.n || med.name, g:med.g || med.sub || '', sig:'', qty:'', ref:'0', start:'', notes:'', dx: dxId || ''};
    AP.medDraft = {edit: existing ? existing.id : null, v: Object.assign({}, m)};
    var a = allergies(), warn = '';
    a.list.forEach(function(x){ var w = x.n.replace(/[^a-z ]/gi,'').toLowerCase().split(' ')[0]; if(w && w.length > 3 && m.name.toLowerCase().indexOf(w) >= 0) warn = '<div class="ap-warn">'+ico('fa-triangle-exclamation')+' Possible allergy match: '+E(x.n)+'</div>'; });
    var v = AP.medDraft.v;
    openDrawer((existing ? 'Edit Medication' : 'Medication Details') + ' — ' + v.name,
      warn + allergyHtml('Allergy') + '<div style="height:10px"></div><div class="ap-fields">'+
      f('Medication', '<input type="text" data-apm="name" value="'+E(v.name)+'">', true)+
      f('Directions (Sig)', '<input type="text" data-apm="sig" value="'+E(v.sig)+'" placeholder="e.g. 1 tablet by mouth daily">', true)+
      f('Quantity', '<input type="number" min="0" data-apm="qty" value="'+E(v.qty)+'">')+f('Refills', '<input type="number" min="0" data-apm="ref" value="'+E(v.ref)+'">')+
      f('Start date', '<input type="date" data-apm="start" value="'+E(v.start)+'">')+
      f('Associated diagnosis', '<select data-apm="dx">'+dxOptions(v.dx)+'</select>')+
      f('Instructions / notes', '<textarea data-apm="notes">'+E(v.notes)+'</textarea>', true)+'</div>'+
      '<div style="height:10px"></div><div class="ap-review" id="apMedReview"></div>',
      '<button type="button" class="btn btn-ghost" data-apd="close">Cancel</button><button type="button" class="btn btn-primary" data-apd="med-save">'+(existing?'Save changes':'Save Medication')+'</button>');
    medReview();
  }
  function medReview(){
    var v = AP.medDraft.v, d = dxById(v.dx), r = document.getElementById('apMedReview'); if(!r) return;
    r.innerHTML = '<b>Review:</b> '+E(v.name)+(v.sig?' — '+E(v.sig):'')+' · Qty '+E(v.qty||'—')+' · Refills '+E(v.ref||'0')+(v.start?' · starts '+E(v.start):'')+(d?'<br>For DX: '+E(dxLabel(d)):'<br>Not linked to a diagnosis');
  }
  function openFuForm(existing, dxId){
    var x = existing || {num:'4', unit:'Weeks', date:'', vtype:'Follow-up', who:'Jake Gyllenhaal, MD', reason:'', notes:'', dx: dxId || ''};
    AP.fuDraft = {edit: existing ? existing.id : null, v: Object.assign({}, x)};
    var v = AP.fuDraft.v, d = dxById(v.dx);
    function s(k, opts){ return '<select data-apu="'+k+'">'+opts.map(function(o){ return '<option'+(o===v[k]?' selected':'')+'>'+o+'</option>'; }).join('')+'</select>'; }
    openDrawer((existing ? 'Edit Followup' : 'Add Followup') + (d ? ' — for ' + dxLabel(d) : ''),
      '<div class="ap-fields">'+f('Return in', '<input type="number" min="0" data-apu="num" value="'+E(v.num)+'">')+f('Unit', s('unit', ['Days','Weeks','Months']))+
      f('Or on date', '<input type="date" data-apu="date" value="'+E(v.date)+'">')+f('Visit type', s('vtype', ['Follow-up','Medication check','Therapy session','Telehealth']))+
      f('With', '<input type="text" data-apu="who" value="'+E(v.who)+'">')+f('Associated diagnosis', '<select data-apu="dx">'+dxOptions(v.dx)+'</select>')+
      f('Reason', '<input type="text" data-apu="reason" value="'+E(v.reason)+'">', true)+f('Notes', '<textarea data-apu="notes">'+E(v.notes)+'</textarea>', true)+'</div>',
      '<button type="button" class="btn btn-ghost" data-apd="close">Cancel</button><button type="button" class="btn btn-primary" data-apd="fu-save">'+(existing?'Save changes':'Save Followup')+'</button>');
  }

  function onDrawerInput(e){
    var t = e.target;
    if(t.id === 'apPickQ'){ AP.pick.q = t.value; var l = document.getElementById('apPickList'); var all = {dx:DX_ALL, pl:PB_ALL, ho:HO_ALL, rx:RX_ALL}[AP.pick.kind]; l.innerHTML = pickerRows(all); return; }
    if(t.dataset.apm && AP.medDraft){ AP.medDraft.v[t.dataset.apm] = t.value; medReview(); return; }
    if(t.dataset.apu && AP.fuDraft){ AP.fuDraft.v[t.dataset.apu] = t.value; return; }
  }
  function onDrawerClick(e){
    var b = e.target.closest('[data-apd]'); if(!b) return;
    var a = b.dataset.apd;
    if(a === 'close'){ closeDrawer(); return; }
    if(a === 'tab'){ AP.pick.tab = b.dataset.v; drawer.querySelector('#apDrBody').innerHTML = pickerBody(); var s = document.getElementById('apPickQ'); if(s) s.focus(); return; }
    if(a === 'pick'){
      var P = AP.pick, code = b.dataset.code, name = b.dataset.name;
      if(P.kind === 'rx'){ openMedForm({n:name, g:b.dataset.sub}, null, P.dx); return; }
      if(P.kind === 'dx'){ addDx(code, name); }
      if(P.kind === 'pl'){ addProb(code, name); }
      if(P.kind === 'ho'){ AP.ho.push({id:uid('ho'), title:name, via:'Printed', dx:P.dx, removed:false}); }
      changed(name + ' added.');
      var l = document.getElementById('apPickList'); if(l) l.innerHTML = pickerRows(P.tab === 'tpl' ? {dx:DX_TPL, pl:PB_TPL, ho:HO_TPL}[P.kind] : {dx:DX_ALL, pl:PB_ALL, ho:HO_ALL}[P.kind]);
      return;
    }
    if(a === 'med-save'){
      var v = AP.medDraft.v; if(!v.name.trim()){ toast('Enter a medication name.'); return; }
      if(AP.medDraft.edit){ Object.assign(find(AP.rx, AP.medDraft.edit), v); } else { AP.rx.push(Object.assign({id:uid('rx'), removed:false}, v)); }
      if(v.dx) AP.openPlan[v.dx] = true;
      closeDrawer(); changed(v.name + (AP.medDraft.edit ? ' updated.' : ' added to Rx / Medication.')); return;
    }
    if(a === 'fu-save'){
      var u = AP.fuDraft.v;
      if(AP.fuDraft.edit){ Object.assign(find(AP.fu, AP.fuDraft.edit), u); } else { AP.fu.push(Object.assign({id:uid('fu'), removed:false}, u)); }
      if(u.dx) AP.openPlan[u.dx] = true;
      closeDrawer(); changed('Followup ' + (AP.fuDraft.edit ? 'updated.' : 'added.')); return;
    }
  }

  /* ---- main (card) interactions ---- */
  function onClick(e){
    var b = e.target.closest('[data-ap]'); if(!b) return;
    var a = b.dataset.ap, id = b.dataset.id, d, i, x;
    switch(a){
      case 'add-dx': openPicker('dx'); break;
      case 'add-pl': openPicker('pl'); break;
      case 'add-rx': openPicker('rx'); break;
      case 'add-ho': openPicker('ho'); break;
      case 'add-fu': openFuForm(null); break;
      case 'plan-toggle': AP.openPlan[id] = !AP.openPlan[id]; if(!AP.openPlan[id]) delete AP.pform[id]; render(); break;
      case 'plan-add':
        var t = b.dataset.t;
        if(t === 'rx') openPicker('rx', id); else if(t === 'ho') openPicker('ho', id); else if(t === 'fu') openFuForm(null, id);
        else { AP.pform[id] = {t:t, v:{}}; render(); var fe = document.querySelector('#apRoot .ap-pform input, #apRoot .ap-pform textarea, #apRoot .ap-pform select'); if(fe) fe.focus(); }
        break;
      case 'pf-cancel': delete AP.pform[id]; render(); break;
      case 'pf-save':
        d = dxById(id); var pf = AP.pform[id], v = pf.v, txt = '';
        if(pf.t === 'im') txt = (v.vac || IMM[0]) + (v.dose ? ' · dose ' + v.dose : '') + (v.date ? ' · given ' + v.date : '') + (v.lot ? ' · lot ' + v.lot : '');
        if(pf.t === 'au') txt = (v.payer || 'Anthem BC PPO') + (v.num ? ' · auth # ' + v.num : '') + ' · ' + (v.status || 'Pending') + (v.units ? ' · ' + v.units + ' visits/units' : '') + (v.thru ? ' · through ' + v.thru : '');
        if(pf.t === 'ft'){ if(!(v.text||'').trim()){ toast('Enter the plan text.'); return; } txt = v.text.trim(); }
        if(pf.edit){ x = find(d.plans, pf.edit); x.txt = txt; x.v = v; } else d.plans.push({id:uid('p'), t:pf.t, txt:txt, v:v});
        delete AP.pform[id]; changed(ptype(pf.t)[1] + ' saved to the plan for ' + dxLabel(d) + '.'); break;
      case 'pi-edit':
        d = dxById(id); var pt = b.dataset.t, pid = b.dataset.pid;
        if(pt === 'rx'){ x = find(AP.rx, pid); openMedForm(null, x); }
        else if(pt === 'fu'){ x = find(AP.fu, pid); openFuForm(x); }
        else if(pt === 'ho'){ toast('Handouts have no editable details; remove and add another if needed.'); }
        else { x = find(d.plans, pid); AP.openPlan[id] = true; AP.pform[id] = {t:pt, v:Object.assign({}, x.v || {text:x.txt}), edit:pid}; render(); }
        break;
      case 'pi-remove':
        d = dxById(id); pt = b.dataset.t; pid = b.dataset.pid;
        if(pt === 'rx'){ find(AP.rx, pid).dx = ''; changed('Medication unlinked from ' + dxLabel(d) + '; it stays under Rx / Medication.'); }
        else if(pt === 'ho'){ find(AP.ho, pid).dx = ''; changed('Handout unlinked from ' + dxLabel(d) + '; it stays under Handout.'); }
        else if(pt === 'fu'){ find(AP.fu, pid).dx = ''; changed('Followup unlinked from ' + dxLabel(d) + '; it stays under Followup.'); }
        else { d.plans = d.plans.filter(function(p){ return p.id !== pid; }); changed('Plan item removed.'); }
        break;
      case 'dx-to-pl': d = dxById(id); addProb(d.code, d.name, d.id); changed(dxLabel(d) + ' added to the Problem List.'); break;
      case 'dx-remove': d = dxById(id); d.inA = false; delete AP.openPlan[id]; changed(dxLabel(d) + ' removed from the assessment. Restore it from "Removed from Assessment".'); break;
      case 'dx-restore': d = dxById(id); d.inA = true; changed(dxLabel(d) + ' restored to the assessment.'); break;
      case 'dx-delete':
        i = AP.dx.findIndex(function(z){ return z.id === id; }); d = AP.dx[i];
        var linked = {rx:AP.rx.filter(function(m){ return m.dx === id; }), ho:AP.ho.filter(function(h){ return h.dx === id; }), fu:AP.fu.filter(function(z){ return z.dx === id; })};
        AP.dx.splice(i, 1); linked.rx.concat(linked.ho, linked.fu).forEach(function(z){ z.dx = ''; });
        AP.prob.forEach(function(p){ if(p.dx === id) p.dx = ''; });
        undoable(dxLabel(d) + ' deleted from this Visit Note.', function(){ AP.dx.splice(i, 0, d); linked.rx.concat(linked.ho, linked.fu).forEach(function(z){ z.dx = id; }); });
        changed(dxLabel(d) + ' deleted.'); break;
      case 'undo': if(AP.undo){ AP.undo.restore(); AP.undo = null; changed('Restored.'); } break;
      case 'pl-to-dx': x = find(AP.prob, id); d = addDx(x.code, x.name); x.dx = d.id; x.fromDx = d.id; changed(x.name + ' added to the assessment as a diagnosis.'); break;
      case 'pl-remove': x = find(AP.prob, id); x.removed = true; changed(x.name + ' removed from this visit (kept on the patient\'s Problem List).'); break;
      case 'pl-restore': x = find(AP.prob, id); x.removed = false; changed(x.name + ' restored.'); break;
      case 'pl-delete': i = AP.prob.findIndex(function(z){ return z.id === id; }); x = AP.prob.splice(i, 1)[0];
        undoable(x.name + ' deleted from the Problem List.', function(){ AP.prob.splice(i, 0, x); }); changed(x.name + ' deleted.'); break;
      case 'rx-edit': openMedForm(null, find(AP.rx, id)); break;
      case 'rx-remove': x = find(AP.rx, id); x.removed = true; changed(x.name + ' removed from this visit.'); break;
      case 'rx-restore': x = find(AP.rx, id); x.removed = false; changed(x.name + ' restored.'); break;
      case 'rx-delete': i = AP.rx.findIndex(function(z){ return z.id === id; }); x = AP.rx.splice(i, 1)[0];
        undoable(x.name + ' deleted.', function(){ AP.rx.splice(i, 0, x); }); changed(x.name + ' deleted.'); break;
      case 'ho-remove': x = find(AP.ho, id); x.removed = true; changed(x.title + ' removed from this visit.'); break;
      case 'ho-restore': x = find(AP.ho, id); x.removed = false; changed(x.title + ' restored.'); break;
      case 'ho-delete': i = AP.ho.findIndex(function(z){ return z.id === id; }); x = AP.ho.splice(i, 1)[0];
        undoable(x.title + ' deleted.', function(){ AP.ho.splice(i, 0, x); }); changed(x.title + ' deleted.'); break;
      case 'fu-edit': openFuForm(find(AP.fu, id)); break;
      case 'fu-remove': x = find(AP.fu, id); x.removed = true; changed('Followup removed from this visit.'); break;
      case 'fu-restore': x = find(AP.fu, id); x.removed = false; changed('Followup restored.'); break;
      case 'fu-delete': i = AP.fu.findIndex(function(z){ return z.id === id; }); x = AP.fu.splice(i, 1)[0];
        undoable('Followup deleted.', function(){ AP.fu.splice(i, 0, x); }); changed('Followup deleted.'); break;
      case 'save':
        AP.saved = JSON.parse(JSON.stringify({dx:AP.dx, prob:AP.prob, rx:AP.rx, ho:AP.ho, fu:AP.fu}));
        AP.saved.at = new Date().toLocaleString('en-US', {month:'short', day:'numeric', hour:'numeric', minute:'2-digit'});
        AP.dirty = false;
        if(typeof onSectionFieldCommitted === 'function') onSectionFieldCommitted(KEY);
        if(typeof clearUnsaved === 'function') clearUnsaved(KEY);
        render(); toast('Assessment & Plan saved.');
        var sv = document.querySelector('#apRoot .ap-saved'), c = document.getElementById('center');
        if(sv && c) c.scrollTo({top: sv.getBoundingClientRect().top - c.getBoundingClientRect().top + c.scrollTop - 12, behavior:'smooth'});
        break;
    }
  }
  function onChange(e){
    var t = e.target;
    if(t.dataset.apv){ var pf = AP.pform[t.dataset.id]; if(pf){ pf.v[t.dataset.apv] = t.value; } return; }
    if(!t.dataset.apf) return;
    var id = t.dataset.id, obj = dxById(id) || find(AP.prob, id) || find(AP.ho, id) || find(AP.rx, id) || find(AP.fu, id); if(!obj) return;
    obj[t.dataset.apf] = t.value; AP.dirty = true;
    if(typeof markPartial === 'function') markPartial(KEY);
    if(t.tagName === 'SELECT') render();
    else { var sb = document.querySelector('#apRoot .ap-savebar'); if(sb && AP.saved && !sb.querySelector('.pill-unsaved')) sb.insertAdjacentHTML('afterbegin', '<span class="pill pill-unsaved" style="display:inline-flex">● Unsaved changes</span>'); }
  }

  /* summary panel / compiled document read the structured A&P */
  (function(){
    var o = window.extractSectionFacts;
    window.extractSectionFacts = function(key){
      if(key !== KEY) return o.apply(this, arguments);
      var S = AP.saved || AP, facts = [];
      S.dx.filter(function(d){ return d.inA; }).forEach(function(d, i){
        facts.push('DX ' + (i+1) + ': ' + dxLabel(d) + ' (' + d.status + ', ' + d.type + ')' + (d.notes ? ' — ' + d.notes : ''));
        S.rx.forEach(function(m){ if(m.dx === d.id && !m.removed) facts.push('  Plan · Medication: ' + m.name + (m.sig ? ' — ' + m.sig : '')); });
        S.ho.forEach(function(h){ if(h.dx === d.id && !h.removed) facts.push('  Plan · Handout: ' + h.title); });
        S.fu.forEach(function(x){ if(x.dx === d.id && !x.removed) facts.push('  Plan · Followup: ' + fuText(x)); });
        d.plans.forEach(function(p){ facts.push('  Plan · ' + ptype(p.t)[1] + ': ' + p.txt); });
      });
      S.prob.forEach(function(p){ if(!p.removed) facts.push('Problem: ' + (p.code ? p.code + ' ' : '') + p.name + ' (' + p.status + ')'); });
      S.rx.forEach(function(m){ if(!m.dx && !m.removed) facts.push('Medication: ' + m.name + (m.sig ? ' — ' + m.sig : '')); });
      S.ho.forEach(function(h){ if(!h.dx && !h.removed) facts.push('Handout: ' + h.title); });
      S.fu.forEach(function(x){ if(!x.dx && !x.removed) facts.push('Followup: ' + fuText(x)); });
      return facts;
    };
    var r = window.doResetSection;
    window.doResetSection = function(key){
      var res = r.apply(this, arguments);
      if(key === KEY){ AP.dx = []; AP.prob = []; AP.rx = []; AP.ho = []; AP.fu = []; AP.saved = null; AP.dirty = false; AP.openPlan = {}; AP.pform = {}; AP.undo = null; bind(); render(); }
      return res;
    };
  })();
  function bind(){
    var root = document.getElementById('apRoot'); if(!root || root._apBound) return;
    root._apBound = true; root.addEventListener('click', onClick); root.addEventListener('change', onChange);
  }
  function init(){ bind(); render(); }
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
})();

/* ---- boot (after the legacy DOMContentLoaded handlers) ---- */
function vntInit(){
  /* retitle reused legacy sections to the tab names (card header, nav, summary row) */
  Object.keys(VNT_TITLES).forEach(function(k){
    var t = VNT_TITLES[k], h3 = document.querySelector('#sec-'+k+' > .card-hd > h3');
    if(h3){ var star = h3.querySelector('.req-star'); h3.textContent = t; if(star){ h3.appendChild(document.createTextNode(' ')); h3.appendChild(star); } }
    var nm = document.querySelector('.nav-item[data-key="'+k+'"] .nm'); if(nm){ nm.textContent = t; nm.parentNode.title = t; }
    var sn = document.querySelector('.ssum-sec[data-key="'+k+'"] summary .nm'); if(sn) sn.textContent = t;
  });
  /* searchable question index for the new sections */
  VNT_NEW.forEach(function(k){
    var card = document.getElementById('sec-'+k); if(!card) return;
    var tab = vntTabFor('sec-'+k);
    card.querySelectorAll('.cx-field > label, .cx-sub, .cx-check').forEach(function(l){ NAV_QUESTION_INDEX.push({key:k, group:tab?tab.name:'', section:SECTION_TITLES[k], q:l.textContent.trim()}); });
  });
  /* per-section minimize (header chevron / title click) removed: sections always show their full form */
  /* the Visit Note Summary note feeds the compiled document live */
  var center = document.getElementById('center'), t = null;
  function live(){ if(!window.vntDocMode) return; clearTimeout(t); t = setTimeout(vntCompileDoc, 250); }
  center.addEventListener('input', live); center.addEventListener('change', live);
  /* tab bar: keyboard + overflow arrows */
  var sc = document.getElementById('vntScroll');
  sc.addEventListener('keydown', function(e){
    var ids = VNT_TABS.map(function(x){ return x.id; }), i = ids.indexOf(vntActive), n = null;
    if(e.key === 'ArrowRight') n = ids[(i+1) % ids.length]; else if(e.key === 'ArrowLeft') n = ids[(i-1+ids.length) % ids.length];
    else if(e.key === 'Home') n = ids[0]; else if(e.key === 'End') n = ids[ids.length-1];
    if(n){ e.preventDefault(); vntSwitch(n); document.getElementById('vntTab-'+n).focus(); }
  });
  sc.addEventListener('scroll', vntUpdateArrows, {passive:true});
  window.addEventListener('resize', vntUpdateArrows);
  document.querySelectorAll('#vntBar [data-tt], #vnDocPane [data-tt]').forEach(function(el){ if(typeof bindPbiTooltip === 'function') bindPbiTooltip(el); });
  vntSwitch(VNT_TABS[0].id);
  vntUpdateProgress(); vntUpdateArrows();
}
if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', vntInit); else vntInit();
</script>

<script>
/* ==== Static Patient Demographic bar: live clinical glance + nav focus ====
   Reads the same DOM the This Visit Summary reads (allergy records, Problem
   List rows, Vital Signs fields), wherever those blocks currently live (card
   or Form Window), so the bar never holds its own copy of clinical data. */
(function(){
  function esc(s){ return String(s).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];}); }
  var MAX=3;
  function more(n,target){ return n>0 ? '<button type="button" class="pdb-plus" onclick="jump(\''+target+'\')">+'+n+' more</button>' : ''; }

  function renderAllergies(){
    var out=document.getElementById('pdbAllergies'), cnt=document.getElementById('pdbAllergyCount'); if(!out) return;
    var nka=document.getElementById('allergyNkaBanner');
    if(nka && !nka.hidden){ out.innerHTML='<span class="pdb-empty">No Known Allergies</span>'; if(cnt) cnt.textContent=''; return; }
    var items=[];
    document.querySelectorAll('#allergyRecordsList .allergy-entry').forEach(function(e){
      var nm=e.querySelector('.allergy-name'); if(!nm||!nm.textContent.trim()) return;
      var r=e.getAttribute('data-reaction')||'';
      items.push('<span class="allergy-chip" title="'+esc(nm.textContent.trim()+(r?' — '+r:''))+'">⚠ '+esc(nm.textContent.trim())+'</span>');
    });
    out.innerHTML = items.length ? '<div class="pdb-al">'+items.slice(0,MAX).join('')+more(items.length-MAX,'sec-allergy')+'</div>'
                                 : '<span class="pdb-empty">No Allergies Found.</span>';
    if(cnt) cnt.textContent = items.length ? items.length : '';
  }
  function renderProblems(){
    var out=document.getElementById('pdbProblems'), cnt=document.getElementById('pdbProbCount'); if(!out) return;
    var items=[];
