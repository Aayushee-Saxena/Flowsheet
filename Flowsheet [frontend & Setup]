.pgt-foot{display:flex;justify-content:flex-end;padding:6px 2px 0;}
.pgt-addlink{border:none;background:transparent;color:var(--brand);font:inherit;font-size:13px;font-weight:600;cursor:pointer;padding:4px 6px;border-radius:5px;}
.pgt-addlink:hover{background:var(--brand-soft);text-decoration:underline;}
