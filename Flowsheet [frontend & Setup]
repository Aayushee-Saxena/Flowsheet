/* =====================================================================
   CATEGORIES — one independent configuration per category
   ---------------------------------------------------------------------
   The Category dropdown switches which configuration the screen shows.
   Each category keeps its own General fields and its own row grid:
     lab        Duration + Display By, and the date-filtered Lab Results
     flowsheet  every General field + the full row grid (all five Types)
     vncompare  every General field + rows limited to Custom Form entries
     stimsheet, mrx
                nothing below Category yet — requirements not final.
                Add their fields by listing them in CAT_SPEC.
   Switching keeps each category's values in memory (CAT_STATE); Save
   writes only the category on screen and leaves the others as they were
   last saved (CAT_BASE).
   ===================================================================== */
/* five flowsheets — one per category, each named exactly after it, each with its own General values and row grid */
const CAT_SPEC={
 flowsheet:{label:'Flowsheet',         fields:'general', rows:'all'},
 lab:      {label:'Lab Comparison',    fields:'general', rows:'all'},
 stimsheet:{label:'Stimsheet',         fields:'general', rows:'all'},
 mrx:      {label:'MRX',               fields:'general', rows:'all'},
