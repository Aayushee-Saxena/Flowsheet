    var body = a.nka ? 'No known allergies.' : (a.list.length ? a.list.map(function(x){ return '<b>'+E(x.n)+'</b>' + (x.r ? ' — '+E(x.r) : ''); }).join('; ') : 'No allergies recorded.');
