/* ---------- setup store — per definition, survives reopen (and reload, when storage allows) ---------- */
const FS_SETUP_KEY = 'fs_setup_defs_v1';
const FS_SETUP_MEM = {};
function fsSetupAll(){ try { return JSON.parse(localStorage.getItem(FS_SETUP_KEY) || '{}') || {}; } catch (e) { return {}; } }
window.fsSetupGet = def => FS_SETUP_MEM[def] || fsSetupAll()[def] || null;
/* the setup tab calls this on Save (window.opener); the copy cuts it loose from that window */
window.fsSetupStore = function(def, cfg){
  if (!def || !cfg) return;
  const c = JSON.parse(JSON.stringify(cfg));
  FS_SETUP_MEM[def] = c;
  try { const all = fsSetupAll(); all[def] = c; localStorage.setItem(FS_SETUP_KEY, JSON.stringify(all)); } catch (e) {}
  if (window.FS && typeof window.FS.applySetup === 'function') window.FS.applySetup(true);
};

function fssPayload(id){ const el = document.getElementById(id); return el ? el.textContent : ''; }

/* clone the live chrome so the new tab carries the real icons and labels */
function fssChrome(){
  const pick = sel => { const n = document.querySelector(sel); return n ? n.cloneNode(true) : null; };
  const bar = pick('.nw-topbar');
  if (bar){
    /* the setup icon would point at this very tab; Sections / Summary belong to the note */
    bar.querySelectorAll('#fsSetupNav,.nav-toggle,.sp-toggle').forEach(n => n.remove());
    bar.querySelectorAll('[id]').forEach(n => n.removeAttribute('id'));
    bar.querySelectorAll('[onclick]').forEach(n => n.removeAttribute('onclick'));
  }
  const tabs = pick('.nw-tabbar');
  if (tabs){
    tabs.querySelectorAll('.nw-tab.active').forEach(t => t.classList.remove('active'));
    const box = tabs.querySelector('.nw-tabs');
    if (box){ const t = document.createElement('div'); t.className = 'nw-tab active'; t.innerHTML = 'Flowsheet Setup <span class="x">✕</span>'; box.appendChild(t); }
  }
  const dock = pick('.appdock');
  if (dock){
    dock.querySelectorAll('.dk-btn.active').forEach(b => b.classList.remove('active'));
    const gear = [...dock.querySelectorAll('.dk-btn')].find(b => /settings/i.test(b.getAttribute('title')||''));
    if (gear) gear.classList.add('active');      /* setup screens live under Settings */
  }
  return { bar: bar ? bar.outerHTML : '', tabs: tabs ? tabs.outerHTML : '', dock: dock ? dock.outerHTML : '' };
}

/* '</' inside injected JSON must not close the script element */
const safeJson = o => JSON.stringify(o).replace(/</g, '\\u003c');

function fsSetupDoc(){
  const css = fssPayload('fssetupCSS'), body = fssPayload('fssetupBody'), js = fssPayload('fssetupJS');
  if (!css || !body || !js) return null;
  const c = fssChrome();
  const S = 'scr' + 'ipt';
  return '<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="color-scheme" content="only light">' +
    '<meta name="viewport" content="width=device-width,initial-scale=1"/>' +
    '<title>Flowsheet Setup · IMS on Web</title>' +
    '<' + S + ' defer src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/js/all.min.js"></' + S + '>' +
    '<style>' + css + '</style><style>' + FSS_CHROME_CSS + '</style>' +
    '</head><body>' + c.bar +
    '<div class="fss-shell">' + c.dock + '<div class="fss-right">' + c.tabs +
    '<div class="shell">' + body + '</div></div>' +      /* body closes .shell; these close .fss-right / .fss-shell */
    '<' + S + '>window.LC_SOURCE=' + safeJson(fsLabSource()) + ';window.FS_SETUP_SAVED=' + safeJson(window.fsSetupGet('ante')) + ';window.DOC_CATEGORIES=' + safeJson((window.VD_DATA && window.VD_DATA.folders) || []) + ';</' + S + '>' +
    '<' + S + '>' + js + '</' + S + '>' +
    '</body></html>';
}

function fsSetupFlash(msg){
  if (window.FS && typeof window.FS.flash === 'function' && window.FS.isOpen && window.FS.isOpen()) { window.FS.flash(msg); return; }
  if (typeof window.toast === 'function') { window.toast(msg); return; }
  console.warn('[flowsheet setup]', msg);
}

function fsSetupOpen(){
  const doc = fsSetupDoc();
  if (!doc){ fsSetupFlash('Flowsheet Setup payload is missing from this build'); return; }
  const w = window.open('', '_blank');
  if (w){ w.document.open(); w.document.write(doc); w.document.close(); return; }
  /* popup blocked, or window.open is inert (artifact frame) */
  try { window.open(URL.createObjectURL(new Blob([doc], { type:'text/html' })), '_blank'); }
  catch (e){ console.warn('[flowsheet setup] could not open the setup tab', e); fsSetupFlash('The browser blocked the new tab — allow pop-ups for this page'); }
}

window.fsSetupOpen = fsSetupOpen;
window.fsLabSource = fsLabSource;          /* exposed for QA / the console */
})();
</script>

