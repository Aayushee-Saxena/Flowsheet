/* ---- Allergies: structured records, bulk actions, Detail Edit modal ---- */
.segctrl button.on.st-active{background:var(--green-soft);color:var(--green);}
.segctrl button.on.st-inactive{background:var(--line-soft);color:var(--ink-soft);}
.segctrl button.on.st-resolved{background:var(--blue-soft);color:var(--blue);}
