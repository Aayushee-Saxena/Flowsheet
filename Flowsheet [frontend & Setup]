  }
  function persist(k){ try{ localStorage.setItem('vn_ssm_' + k, JSON.stringify(rec(k))); }catch(e){} }

  /* ---------- rendering: one card per section, a plain text area under its header ---------- */
  function fit(t){ if(!t) return; t.style.height = 'auto'; t.style.height = Math.max(t.scrollHeight + 2, 64) + 'px'; }
  function secInner(k){
    var r = rec(k), unsaved = typeof unsavedSummary !== 'undefined' && unsavedSummary[k];
    var removed = r ? r.items.filter(function(it){ return it.removed; }).length : 0, lk = locked(k);
    return '<div class="vns-sec-hd"><span class="vns-sec-t">'+esc(title(k))+'</span>'+(unsaved ? '<span class="vns-unsaved">Unsaved</span>' : '')+
      '<span class="vns-acts"><button type="button" class="vns-btn vns-save" data-act="save"'+(lk ? ' disabled' : '')+'>Save</button></span></div>'+
      '<div class="vns-body">'+(lk ? lockRow() : '')+'<textarea class="vns-ta" data-key="'+esc(k)+'" rows="3" spellcheck="true" placeholder="No summary available yet." aria-label="'+esc(title(k))+' summary"'+(lk ? ' readonly aria-readonly="true"' : '')+'>'+esc(compose(k))+'</textarea>'+
      (removed ? '<div class="vns-rm"><i class="fa-solid fa-eye-slash" aria-hidden="true"></i>'+removed+' removed from summary · answers unchanged <button type="button" data-act="restore"'+(lk ? ' disabled' : '')+'>Restore</button></div>' : '')+'</div>';
  }
  function hasContent(k){
    var r = rec(k); if(!r) return false;
    if(r.items.length) return true;
    var n = notes(k); return Object.keys(n).some(function(a){ return (n[a] || '').trim(); });
  }
  function renderSec(k){
    var box = document.getElementById('vns-sec-' + k); if(!box) return;
    if(box.contains(document.activeElement) && document.activeElement.classList.contains('vns-ta')){ box._pending = true; return; }   /* never yank the caret */
    box._pending = false;
    box.hidden = !hasContent(k) && !ALWAYS[k];
    box.classList.toggle('ros-locked-sum', locked(k));
    box.innerHTML = box.hidden ? '' : secInner(k);
    fit(box.querySelector('.vns-ta'));
    var hl = typeof sectionHighlight !== 'undefined' && sectionHighlight[k];
    box.classList.toggle('hl-active', !!hl); if(hl) box.style.setProperty('--hl-color', hl.color); else box.style.removeProperty('--hl-color');
  }
  function build(){
    var host = document.getElementById('ssumTabThisVisit'); if(!host || doc()) return;
    var seen = {}; ORDER = [];
    var h = '<div class="vns-wrap"><div class="vns-doc" id="vnsDoc" aria-label="This Visit Summary">';
    VNT_TABS.forEach(function(t){
      h += '<div class="vns-tab" data-tab="'+esc(t.id)+'" id="vns-tab-'+esc(t.id)+'"><div class="vns-tab-t">'+esc(t.name)+'</div>'+
           '<textarea class="vns-ta vns-tabta" rows="1" spellcheck="true" data-tabnote="'+esc(t.id)+'" placeholder="Add a note for '+esc(t.name)+'…" aria-label="Note for '+esc(t.name)+'">'+esc(TABNOTES[t.id] || '')+'</textarea>';
      t.cards.forEach(function(cid){
        if(cid.indexOf('sec-') !== 0) return; var k = cid.slice(4);
        if(k === 'vngeneral' || seen[k]) return; seen[k] = 1; ORDER.push(k); OWNER[k] = t.id;
        h += '<div class="vns-sec" id="vns-sec-'+esc(k)+'" data-key="'+esc(k)+'" hidden></div>';
      });
      h += '</div>';
    });
    h += '</div></div>';
    var anchor = document.getElementById('vntScope') || host.querySelector('.ssum-sec');
    var w = document.createElement('div'); w.innerHTML = h; w = w.firstChild;
    if(anchor) anchor.after(w); else host.appendChild(w);
    ORDER.forEach(function(k){ if(!rec(k) && typeof ssmRefresh === 'function'){ try{ ssmRefresh(k); }catch(e){} } renderSec(k); writeBack(k); });
    w.querySelectorAll('.vns-tabta').forEach(fit);
  }

  /* ---------- tab switch: scroll the one document to the tab's first section ---------- */
  function scrollToTab(id){
    var panel = document.getElementById('sectionSummaryPanel'), group = document.getElementById('vns-tab-' + id); if(!panel || !group) return;
    var tab = VNT_TABS.filter(function(t){ return t.id === id; })[0], target = null;
    if(tab) for(var i = 0; i < tab.cards.length && !target; i++){
      var k = tab.cards[i].slice(4), el = document.getElementById('vns-sec-' + k);
      if(el && !el.hidden && group.contains(el)) target = el;
      else if(tab.cards[i].indexOf('sec-') === 0 && OWNER[k] === id && k !== 'vngeneral') break;   /* first section of the tab has no summary yet: show the tab's heading */
    }
    target = target || group;
    var top = target.getBoundingClientRect().top - panel.getBoundingClientRect().top + panel.scrollTop - 8;
        panel.scrollTo({top: Math.max(0, top), behavior: 'smooth'});
  }

  /* ---------- interactions ---------- */
  function secOf(el){ var b = el.closest('.vns-sec'); return b ? b.getAttribute('data-key') : null; }
  function onClick(e){
    var b = e.target.closest('.vns-wrap [data-act]'); if(!b) return;
    e.preventDefault();
    var k = secOf(b), r = rec(k); if(!k) return;
    if(locked(k) && b.dataset.act !== 'go') return;   /* locked by another user: read-only */
    if(b.dataset.act === 'go'){ goToSection(k); }
    else if(b.dataset.act === 'save'){ var t = document.querySelector('#vns-sec-' + k + ' .vns-ta'); if(t) parse(k, t.value); writeBack(k); if(typeof clearSsumUnsaved === 'function') clearSsumUnsaved(k); renderSec(k); toast(title(k) + ' summary saved.'); }
    else if(b.dataset.act === 'restore'){ if(r){ r.items.forEach(function(x){ x.removed = false; }); changed(k, true); toast('Restored to summary.'); } }
  }
  function changed(k, rerender){ writeBack(k); persist(k); if(typeof markSsumUnsaved === 'function') markSsumUnsaved(k); if(rerender) renderSec(k); }
  function onInput(e){
