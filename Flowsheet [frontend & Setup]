    var oc = window.onSectionFieldCommitted;
    if(typeof oc === 'function') window.onSectionFieldCommitted = onSectionFieldCommitted = function(){ var r = oc.apply(this, arguments); soon(); return r; };
    var sw = window.vntSwitch;
