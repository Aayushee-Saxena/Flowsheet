  }
  function comments(rec, k){ return (rec.v[k] || []).map(function(r){ return r.cmt; }).filter(Boolean); }
  function pad(n){ return (n < 10 ? '0' : '') + n; }
  function nowTime(){ var d = new Date(), h = d.getHours(), ap = h >= 12 ? 'PM' : 'AM'; h = h % 12 || 12; return pad(h) + ':' + pad(d.getMinutes()) + ' ' + ap; }
  function today(){ var d = new Date(); return pad(d.getMonth()+1) + '/' + pad(d.getDate()) + '/' + String(d.getFullYear()).slice(2); }
