<script>
/* =====================================================================
   [v4] "Active" status badge -- one look everywhere in the Visit Note.
   Font #ff69b4, background #ff69b44d, compact pill (.vn-st-active).
   Statuses that are only text (allergy / diagnosis meta lines, history
   table cells, status pills) get the badge class; the existing segmented
   "Active" selector and medication status reuse the same colours in CSS.
   Re-applied whenever those elements are rewritten; other statuses untouched.
   ===================================================================== */
(function(){
  var META = '.dx-entry-meta';
  var PILLS = '[id$="-status-pill"], .status-pill, .card-bd .pill:not(.pill-reviewed)';
  var CELLS = 'table td';
  function isActive(t){ return /^\s*Active\s*$/.test(t || ''); }
  function apply(){
    /* "Active · Allergy · …" meta lines: badge the leading status word only */
    document.querySelectorAll(META).forEach(function(m){
      if(m.querySelector(':scope > .vn-st-active')){ var s = m.querySelector(':scope > .vn-st-active'); if(isActive(s.textContent)) return; s.replaceWith(document.createTextNode(s.textContent)); m.normalize(); }
      var n = m.firstChild; if(!n || n.nodeType !== 3) return;
      var mm = /^(\s*)Active(?=\s*(·|$))/.exec(n.nodeValue); if(!mm) return;
      var rest = n.nodeValue.slice(mm[0].length), span = document.createElement('span');
      span.className = 'vn-st-active'; span.textContent = 'Active';
      m.insertBefore(span, n); n.nodeValue = rest;
    });
    /* Allergies: the Active chip sits right after the allergy name; the meta line keeps its text
       (summary / search / existing code still read "Active · …") but hides the moved word */
    document.querySelectorAll('.allergy-entry').forEach(function(ent){
      var key = ent.getAttribute('data-allergy-key'), m = key && document.getElementById(key + '-meta-display'), nm = key && document.getElementById(key + '-name-display');
      if(!m || !nm) return;
      var mv = m.querySelector(':scope > .vn-st-moved');
      if(mv && !/^\s*Active\s*·?\s*$/.test(mv.textContent)){ mv.replaceWith(document.createTextNode(mv.textContent)); m.normalize(); mv = null; }
      if(!mv){ var n = m.firstChild;
        if(n && n.nodeType === 3){ var mm = /^\s*Active(\s*·\s*|\s*$)/.exec(n.nodeValue);
          if(mm){ mv = document.createElement('span'); mv.className = 'vn-st-moved'; mv.textContent = mm[0]; m.insertBefore(mv, n); n.nodeValue = n.nodeValue.slice(mm[0].length); } } }
      var chip = document.getElementById(key + '-status-chip');
      if(mv && !chip){ chip = document.createElement('span'); chip.id = key + '-status-chip'; chip.className = 'vn-st-active al-chip'; chip.textContent = 'Active'; nm.after(chip); }
      else if(!mv && chip) chip.remove();
      else if(chip && chip.previousElementSibling !== nm) nm.after(chip);
    });
    /* stand-alone status pills */
    document.querySelectorAll(PILLS).forEach(function(p){ var on = isActive(p.textContent); if(p.classList.contains('vn-st-active') !== on) p.classList.toggle('vn-st-active', on); });
    /* status cells in history tables */
    document.querySelectorAll(CELLS).forEach(function(td){
      if(td.children.length === 1 && td.firstElementChild.classList.contains('vn-st-active')) return;
      if(td.children.length || !isActive(td.textContent)) return;
      td.innerHTML = '<span class="vn-st-active">Active</span>';
    });
  }
  var t = null; function soon(){ if(t) return; t = setTimeout(function(){ t = null; apply(); }, 40); }
  window.vnActiveBadges = apply;
  function init(){
    apply();
    if(window.MutationObserver) new MutationObserver(soon).observe(document.body, {subtree: true, childList: true, characterData: true});
  }
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function(){ setTimeout(init, 0); }); else setTimeout(init, 0);
})();
</script>
<script>
/* =====================================================================
   [v4] Allergies (MA Record tab)
   - record actions: Detail Edit -> Edit icon (opens the existing Allergy
     Details window), Add to This Visit / Remove from Visit -> icon buttons
     (same toggleAddToVisit), labels move to tooltips
   - header "More Options" (…) -> Timeline window (allergy_timeline.png)
   The Active chip next to the allergy name lives in the Active badge layer.
   ===================================================================== */
var AL = (function(){
  var e = function(s){ return String(s == null ? '' : s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); };
  function tt(label){ return ' aria-label="'+e(label)+'" aria-describedby="pbiTooltip" data-tt="'+e(label)+'"'; }
  function bind(root){ (root || document).querySelectorAll('[data-tt]').forEach(function(el){ if(typeof bindPbiTooltip === 'function') bindPbiTooltip(el); }); }
  function pad(n){ return (n < 10 ? '0' : '') + n; }
  var MON = {jan:1,feb:2,mar:3,apr:4,may:5,jun:6,jul:7,aug:8,sep:9,sept:9,oct:10,nov:11,dec:12};
  function shortDate(long){ var m = /^(\d{1,2})\s+([A-Za-z]+)\s+(\d{4})$/.exec((long || '').trim()); if(!m) return long || ''; return pad(MON[m[2].toLowerCase()] || 1) + '/' + pad(+m[1]) + '/' + m[3].slice(2); }
  function nowStamp(){ var d = new Date(), h = d.getHours(), ap = h >= 12 ? 'PM' : 'AM'; return pad(d.getMonth()+1) + '/' + pad(d.getDate()) + '/' + String(d.getFullYear()).slice(2) + ' ' + pad(h % 12 || 12) + ':' + pad(d.getMinutes()) + ' ' + ap; }
  function dnum(s){ var m = /^(\d\d)\/(\d\d)\/(\d\d)/.exec(s || ''); return m ? Date.UTC(2000 + +m[3], +m[1] - 1, +m[2]) : NaN; }
  function visitNo(){ var el = document.getElementById('vng-visitnum'); return el ? el.textContent.trim() : ''; }

  /* ---------- record actions: icon buttons (same handlers) ---------- */
  function iconize(){
    document.querySelectorAll('#sec-allergy .allergy-entry').forEach(function(ent){
      var key = ent.getAttribute('data-allergy-key'); if(!key) return;
      var av = document.getElementById(key + '-addvisit-btn');
      if(av){
        var rm = /remove/i.test(av.textContent) || !!av.querySelector('.fa-calendar-xmark, [data-icon="calendar-xmark"]');
        var label = rm ? 'Remove from Visit' : 'Add to This Visit', icon = rm ? 'fa-calendar-xmark' : 'fa-calendar-plus';
        if(av.getAttribute('data-al-state') !== label || av.textContent.trim()){
          av.setAttribute('data-al-state', label);
          av.classList.add('vs-ico', 'al-ico');
          av.innerHTML = '<i class="fa-solid ' + icon + '" aria-hidden="true"></i>';
          av.setAttribute('aria-label', label); av.setAttribute('data-tt', label); av.setAttribute('aria-describedby', 'pbiTooltip');
          if(typeof bindPbiTooltip === 'function') bindPbiTooltip(av);
        }
      }
      var de = ent.querySelector('.allergy-entry-hd button[onclick^="openAllergyDetail"]');
      if(de && !de.classList.contains('al-ico')){
        de.classList.add('vs-ico', 'al-ico'); de.removeAttribute('title');
        de.innerHTML = '<i class="fa-solid fa-pencil" aria-hidden="true"></i>';
        de.setAttribute('aria-label', 'Edit'); de.setAttribute('data-tt', 'Edit'); de.setAttribute('aria-describedby', 'pbiTooltip');
        if(typeof bindPbiTooltip === 'function') bindPbiTooltip(de);
      }
    });
  }

  /* ---------- Timeline store: one row per allergy change ---------- */
  var T = { rows: [], seq: 0, fopen: false, f: {}, page: 1, size: 10 };
  function snapshot(key, stamp, visit){
    var ent = document.getElementById('sec-' + key); if(!ent) return null;
    var name = (document.getElementById(key + '-name-display') || {}).textContent || '';
    var meta = document.getElementById(key + '-meta-display'), created = meta ? shortDate(meta.getAttribute('data-added-date')) : '';
    var st = typeof segValue === 'function' ? segValue('qe-' + key + '-status') : '';
    var risk = typeof segValue === 'function' ? segValue('qe-' + key + '-risk') : '';
    var ver = (document.getElementById('qe-' + key + '-verification') || {}).value || '';
    if(!st && meta){ st = (meta.textContent.split('·')[0] || '').trim(); }
    return {id: 'alt-' + (++T.seq), key: key, allergen: name.trim(), update: stamp, visit: visit, status: st, verification: ver, risk: risk, reaction: ent.getAttribute('data-reaction') || '', created: created};
  }
  function seed(){
    T.rows = []; T.seq = 0;
    document.querySelectorAll('#sec-allergy .allergy-entry').forEach(function(ent){
      var key = ent.getAttribute('data-allergy-key'), badge = document.getElementById(key + '-visit-badge');
      var meta = document.getElementById(key + '-meta-display'), created = meta ? shortDate(meta.getAttribute('data-added-date')) : '';
      var r = snapshot(key, created, badge && badge.classList.contains('on') ? visitNo() : ''); if(r) T.rows.push(r);
    });
  }
  function log(key){ var r = snapshot(key, nowStamp(), visitNo()); if(r) T.rows.push(r); var b = document.getElementById('alTlWin-b'); if(b) render(); }

  /* ---------- windows (same centered overlay used by the other v4 windows) ---------- */
  function modal(id, title, foot, cls){
    var old = document.getElementById(id); if(old) old.remove();
    var sc = document.createElement('div'); sc.className = 'overlay-scrim vs-modal mx-modal ' + (cls || ''); sc.id = id;
    sc.innerHTML = '<div class="overlay-panel" role="dialog" aria-modal="true" aria-labelledby="'+id+'-t"><div class="overlay-hd"><h2 id="'+id+'-t">'+e(title)+(cls && cls.indexOf('mx-prompt') >= 0 ? '' : ' <i class="fa-solid fa-circle-question vs-help" aria-hidden="true"></i>')+'</h2><div class="spacer"></div>'+
      '<button type="button" class="btn btn-ghost btn-sm vs-x" data-alclose="'+id+'" aria-label="Close"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button></div><div class="overlay-bd" id="'+id+'-b"></div><div class="overlay-ft">'+foot+'</div></div>';
    sc.addEventListener('click', function(ev){ var c = ev.target.closest('[data-alclose]'); if(c){ var x = document.getElementById(c.getAttribute('data-alclose')); if(x) x.remove(); if(typeof hidePbiTooltip === 'function') hidePbiTooltip(); } });
    document.body.appendChild(sc); return sc;
  }
  function confirm(msg, onYes){
    var sc = modal('alPrompt', 'Allergy Timeline', '<button type="button" class="btn btn-sm" data-alclose="alPrompt">No</button><button type="button" class="btn btn-sm btn-primary" id="alPromptYes">Yes</button>', 'mx-prompt');
    document.getElementById('alPrompt-b').innerHTML = '<p class="mx-prompt-msg">'+e(msg)+'</p>';
    document.getElementById('alPromptYes').addEventListener('click', function(){ sc.remove(); onYes(); });
    document.getElementById('alPromptYes').focus();
  }
  var COLS = [['allergen','Allergen'],['update','Update Date','c'],['visit','Visit No.','c'],['status','Status'],['verification','Verification'],['risk','Risk'],['reaction','Reaction'],['created','Created Date','r']];
  function filtered(){
    var f = T.f;
    return T.rows.filter(function(r){
      var t = dnum(r.update);
      return (!f.allergen || r.allergen.toLowerCase().indexOf(f.allergen.toLowerCase()) >= 0) && (!f.status || r.status === f.status) &&
             (!f.from || !(t < dnum(f.from))) && (!f.to || !(t > dnum(f.to)));
    }).slice().sort(function(a, b){ return (dnum(b.update) || 0) - (dnum(a.update) || 0) || (b.id > a.id ? 1 : -1); });
  }
  function body(){
    var f = T.f, rows = filtered(), total = rows.length, pages = Math.max(1, Math.ceil(total / T.size)); if(T.page > pages) T.page = pages;
    var start = (T.page - 1) * T.size, page = rows.slice(start, start + T.size), nf = ['allergen','status','from','to'].filter(function(k){ return f[k]; }).length;
    var sts = []; T.rows.forEach(function(r){ if(r.status && sts.indexOf(r.status) < 0) sts.push(r.status); });
    var h = '<div class="vsg-fbar"><div class="vsg-fbar-row"><button type="button" class="vsg-ftoggle" onclick="AL.tlFilters()" aria-expanded="'+(T.fopen ? 'true' : 'false')+'"><i class="fa-solid fa-chevron-right vsg-fchev'+(T.fopen ? ' vs-rot' : '')+'" aria-hidden="true"></i><i class="fa-solid fa-filter vsg-fico" aria-hidden="true"></i><span>Filters</span>'+(nf ? '<span class="vsg-fcount">'+nf+'</span>' : '')+'</button>'+
      '<div class="vsg-actions"><div class="vsg-grp"><button type="button" class="btn btn-ghost btn-sm vsg-link" onclick="AL.tlReset()">Reset</button><button type="button" class="btn btn-primary btn-sm vsg-apply" onclick="AL.tlFilter()"><i class="fa-solid fa-filter" aria-hidden="true"></i>Filter</button></div></div></div>'+
