.prob-row{display:flex;align-items:flex-start;gap:10px;padding:9px 0;border-bottom:1px solid var(--line-soft);}
.prob-row:last-child{border-bottom:none;}
.prob-code{font-family:var(--font-mono);font-size:12.5px;background:var(--paper);border:1px solid var(--line);border-radius:5px;padding:2px 6px;flex:none;height:fit-content;}
