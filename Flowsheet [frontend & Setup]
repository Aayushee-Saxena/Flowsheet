let apAddContext=null;
const AP_TEMPLATES={
  problem:['Type 2 diabetes mellitus, uncomplicated (E11.9)','Hyperlipidemia (E78.5)','GERD (K21.9)','Obesity (E66.9)'],
  rx:['Amoxicillin-Clavulanate 875mg PO BID x7 days','Azithromycin 250mg PO daily x5 days','Ibuprofen 400mg PO q6h PRN pain','Loratadine 10mg PO daily'],
