

<meta name="color-scheme" content="only light">
<title>Visit Note — Tabbed Layout v4</title>
<style id="vdCss">
/* ==================================================================
   VN DOCUMENT VIEWER — portable core styles (pair with vndocs.core.js)
   Every selector is .vd-* / #vd* / .vdp-*. Theme through the --vd-*
   variables; the host positions .vd-modal and styles its own icons.
   ================================================================== */
:root{--vd-brand:#1B6A9C;--vd-brand-dk:#145A87;--vd-soft:#E8F1F8;--vd-bg:#fff;--vd-ink:#1f2937;--vd-line:#D9E0E8;
  --vd-font:"Segoe UI",Roboto,system-ui,sans-serif}
.vd-svg{width:1em;height:1em;display:block;flex:none}
.vd-rot{transform:rotate(90deg)}

/* ---------- the widget search ---------- */
.vd-search{position:relative;flex:1;min-width:0;display:flex;align-items:center}
.vd-search input{width:100%;min-width:0;height:24px;border:1px solid #C9D3DF;border-radius:6px;padding:0 6px 0 24px;
  font-size:12px;background:#fff;color:var(--vd-ink)}
.vd-search input:focus{outline:none;border-color:var(--vd-brand);box-shadow:0 0 0 3px rgba(27,106,156,.14)}
.vd-si{position:absolute;left:7px;top:50%;transform:translateY(-50%);color:#94a3b8;font-size:12px;pointer-events:none}
.vd-sres{position:absolute;top:calc(100% + 4px);left:0;width:max(100%,270px);max-height:360px;overflow:auto;z-index:70;
  background:#fff;border:1px solid #D9E0E8;border-radius:8px;box-shadow:0 14px 36px rgba(15,23,42,.18);padding:4px;display:none}
.vd-sres.on{display:block}
.vd-sr{display:flex;align-items:baseline;gap:8px;padding:6px 8px;border-radius:6px;cursor:pointer;font-size:12.5px}
.vd-sr .t{color:var(--vd-ink);font-weight:600;white-space:nowrap}
.vd-sr .m{margin-left:auto;color:#94a3b8;font-size:11px;white-space:nowrap}
.vd-sr.hi,.vd-sr:hover{background:var(--vd-soft)}
.vd-sr.none{color:#94a3b8;cursor:default;font-style:italic}

/* the widget the search landed on */
@keyframes vdFlash{0%,35%{box-shadow:inset 3px 0 0 var(--vd-brand);background:var(--vd-soft)}100%{box-shadow:inset 3px 0 0 transparent}}
.vd-flash{animation:vdFlash 1.6s ease-out}

/* ---------- the modal: the host decides its box (position/inset) ---------- */
.vd-modal{position:absolute;inset:0;z-index:25;background:var(--vd-bg);border:1px solid var(--vd-line);border-radius:10px;
  box-shadow:0 10px 30px rgba(15,23,42,.14);display:flex;flex-direction:column;overflow:hidden;container-type:inline-size;
  font-size:13px;color:var(--vd-ink);font-family:var(--vd-font)}

.vd-sp{flex:1}
.vd-hd{display:flex;align-items:center;gap:6px;padding:8px 10px 6px 14px;border-bottom:1px solid #EDF0F5;flex:none}
.vd-hd b{font-size:15px}
.vd-help{width:15px;height:15px;border-radius:50%;background:#64748b;color:#fff;font-size:10px;font-weight:800;display:grid;place-items:center;cursor:help}
.vd-x,.vd-back{width:26px;height:26px;display:grid;place-items:center;border:0;background:transparent;border-radius:6px;color:#334155;font-size:15px;padding:0}
.vd-x:hover,.vd-back:hover{background:#F1F5F9}
.vd-sub{display:flex;align-items:center;gap:8px;padding:7px 14px;flex:none;background:#FAFBFD;border-bottom:1px solid #EDF0F5}
.vd-ctx{display:inline-flex;align-items:center;gap:4px;border:0;background:transparent;font-size:12.5px;color:#334155;padding:2px 0}
.vd-ctx .vd-svg{font-size:10px}
.vd-up{border:0;background:var(--vd-brand);color:#fff;border-radius:6px;padding:5px 12px;font-size:12.5px;font-weight:600;white-space:nowrap}
.vd-up:hover{background:var(--vd-brand-dk)}
.vd-body{flex:1;min-height:0;display:flex;gap:8px;padding:8px}
.vd-tree{width:206px;flex:none;display:flex;flex-direction:column;border:1px solid #E3E8EF;border-radius:8px;min-height:0}
.vd-tree.off{display:none}
.vd-ts{display:flex;align-items:center;gap:4px;padding:6px 6px 6px 8px;border-bottom:1px solid #F1F5F9;color:#94a3b8}
.vd-tsi{font-size:12px}
.vd-ts input{flex:1;min-width:0;border:0;font-size:12.5px;padding:2px;background:transparent}
.vd-ts input:focus{outline:none}
.vd-add,.vd-col{width:20px;height:20px;border:0;background:transparent;display:grid;place-items:center;border-radius:4px;color:var(--vd-brand);font-size:13px;padding:0}
.vd-add{background:var(--vd-brand);color:#fff;border-radius:50%;font-size:11px;width:17px;height:17px}
.vd-col:hover{background:#F1F5F9}
.vd-tl{flex:1;overflow-y:auto;padding:3px 0}
.vd-f{display:flex;align-items:center;gap:6px;width:100%;border:0;background:transparent;text-align:left;padding:5px 8px 5px 4px;font-size:12.5px;color:var(--vd-ink)}
.vd-f:hover{background:#F5F8FB}
.vd-f.on{background:var(--vd-soft);color:var(--vd-brand-dk)}
.vd-chev{width:10px;flex:none;color:#94a3b8;font-size:10px}
.vd-fi{color:#64748b;font-size:14px;flex:none}
.vd-f.has .vd-fi,.vd-f.on .vd-fi{color:var(--vd-brand)}
.vd-fn{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.vd-none{padding:10px;color:#94a3b8;font-size:12px;font-style:italic}
.vd-treeopen{flex:none;writing-mode:vertical-rl;transform:rotate(180deg);display:flex;align-items:center;gap:6px;border:1px solid #E3E8EF;
  border-radius:8px;background:#FAFBFD;color:var(--vd-brand-dk);font-size:12px;padding:8px 3px}
.vd-treeopen .vd-svg{transform:rotate(180deg)}
.vd-files{flex:1;min-width:0;overflow:auto}
.vd-tbl{width:100%;border-collapse:collapse;font-size:12.5px}
.vd-tbl th{position:sticky;top:0;background:#fff;text-align:left;font-weight:700;padding:8px;border-bottom:1px solid #E3E8EF;white-space:nowrap;z-index:1}
.vd-tbl td{padding:7px 8px;border-bottom:1px solid #EEF1F5;white-space:nowrap}
.vd-tbl .c-s,.vd-tbl .c-c,.vd-tbl .c-e,.vd-tbl .c-z{text-align:center}
.vd-tbl .c-z{text-align:right}
.vd-tbl td.c-f{max-width:1px;width:100%;white-space:normal;overflow-wrap:anywhere}
.vd-fmeta{display:none;font-size:11px;color:#94a3b8;margin:1px 0 0 22px}
.vd-row{cursor:pointer}
.vd-row:hover td{background:#F5F8FB}
.vd-row.last td{background:var(--vd-soft)}
.vd-row:focus{outline:2px solid var(--vd-brand);outline-offset:-2px}
.vd-ft-ic{display:inline-block;vertical-align:-3px;margin-right:6px;color:#ea580c;font-size:15px}
.vd-ft-ic.img{color:#0f766e}
.vd-row:hover .vd-fname{color:var(--vd-brand);text-decoration:underline}
.vd-tbl td.c-a{display:flex;gap:2px;justify-content:flex-end}
.vd-tbl td.c-a button{width:22px;height:22px;display:grid;place-items:center;border:0;background:transparent;border-radius:4px;color:#475569;font-size:14px;padding:0}
.vd-tbl td.c-a button:hover:not(:disabled){background:var(--vd-soft);color:var(--vd-brand)}
.vd-tbl td.c-a button:disabled{color:#CBD5E1;cursor:not-allowed}
.vd-empty{text-align:center;color:#94a3b8;padding:28px 8px!important;white-space:normal!important}
.vd-foot{flex:none;display:flex;justify-content:flex-end;padding:6px 10px;border-top:1px solid #EDF0F5}
.vd-close{border:1px solid #CBD5E1;background:#fff;border-radius:6px;padding:4px 14px;font-size:12.5px;color:#334155}
.vd-close:hover{border-color:var(--vd-brand);color:var(--vd-brand)}
/* as the side narrows: Expiry goes, then Created, then Service and Size move under the name */
@container (max-width:820px){.vd-tbl .c-e{display:none}}
@container (max-width:720px){.vd-tbl .c-c{display:none}.vd-tree{width:180px}}
@container (max-width:600px){.vd-tbl .c-s,.vd-tbl .c-z{display:none}.vd-fmeta{display:block}.vd-tree{width:160px}.vd-hd b{font-size:14px}}
@container (max-width:420px){.vd-tree{width:132px}.vd-f{font-size:12px}}

/* ---------- the viewer: the whole modal ---------- */
.vd-vh{display:flex;align-items:center;gap:8px;padding:6px 10px 6px 6px;border-bottom:1px solid #EDF0F5;flex:none}
.vd-vname{font-weight:600;font-size:13.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}
.vd-tb{flex:none;display:flex;align-items:center;gap:2px;padding:5px 8px;background:#38383D;color:#F9F9FA;flex-wrap:nowrap;overflow:hidden}
.vd-tbtn{width:26px;height:26px;display:grid;place-items:center;border:0;border-radius:4px;background:transparent;color:#F9F9FA;font-size:14px;padding:0;flex:none}
.vd-tbtn:hover:not(:disabled){background:rgba(255,255,255,.12)}
.vd-tbtn:disabled{opacity:.45}
.vd-tbtn.light{color:#334155}
.vd-tbtn.light:hover{background:#F1F5F9}
.vd-pg{width:38px;height:22px;border:1px solid #5B5B66;background:#1C1B22;color:#fff;border-radius:3px;text-align:right;padding:0 4px;font-size:12px;margin-left:4px}
.vd-of{font-size:12px;margin:0 4px 0 5px;white-space:nowrap}
.vd-zoom{height:24px;background:#1C1B22;color:#fff;border:1px solid #5B5B66;border-radius:3px;font-size:12px;max-width:128px;margin-left:2px}
@container (max-width:470px){.vd-tb .vd-tbtn[disabled],.vd-tb [data-vd="print"]{display:none}.vd-zoom{max-width:96px}}
.vd-pages{flex:1;min-height:0;overflow:auto;background:#2B2A33;padding:6px 0 14px}
.vd-page{width:816px;min-height:1056px;margin:10px auto;background:#fff;box-shadow:0 1px 4px rgba(0,0,0,.5);position:relative}
.vd-page.img{width:520px;min-height:330px;background:transparent;box-shadow:none}

/* ---------- document pages (also used in "open in new tab") ---------- */
.vdp{padding:56px 64px 48px;font:13px/1.55 "Segoe UI",Roboto,system-ui,sans-serif;color:var(--vd-ink)}
.vd-page.img .vdp{padding:0}
.vdp h4{font-size:15px;font-weight:700;margin:22px 0 8px;padding-bottom:3px;border-bottom:2px solid #1f2937}
.vdp ul{margin:0;padding-left:20px}
.vdp p{margin:6px 0}
.vdp-h{display:flex;justify-content:space-between;align-items:flex-start;border-bottom:3px solid #1f3a5f;padding-bottom:10px;margin-bottom:12px}
.vdp-org{font-size:22px;font-weight:800;color:#1f3a5f;letter-spacing:-.01em}
.vdp-r{text-align:right;font-size:12px;line-height:1.5}
.vdp-kv{border-collapse:collapse;font-size:12.5px;margin:4px 0}
.vdp-kv td{padding:2px 14px 2px 0}
.vdp-kv td:nth-child(odd){color:#64748b}
.vdp-t{width:100%;border-collapse:collapse;font-size:12.5px}
.vdp-t th{text-align:left;border-bottom:1px solid #94a3b8;padding:5px 6px;font-weight:700}
.vdp-t td{padding:5px 6px;border-bottom:1px solid #e5e7eb}
.vdp-t tr.abn td{color:#b91c1c}
.vdp-note{font-size:12px;color:#475569;font-style:italic;margin-top:12px!important}
.vdp-foot{margin-top:46px;padding-top:6px;border-top:1px solid #e5e7eb;font-size:10.5px;color:#94a3b8;text-align:center}
.vdp-vnhead{display:flex;justify-content:flex-end;margin-bottom:18px}
.vdp-vnpt{display:flex;gap:18px;align-items:flex-start}
.vdp-photo{width:170px;height:120px;flex:none;background:linear-gradient(135deg,#d4d4d8,#a1a1aa);color:#52525b;font-size:10px;display:grid;place-items:center}
.vdp-name{font-size:19px;font-weight:800}
.vdp-grid{display:grid;grid-template-columns:1fr 1fr;gap:4px 28px}
.vdp-card{width:520px;height:330px;border-radius:18px;background:linear-gradient(135deg,#0b4a8b,var(--vd-brand) 60%,#3a8cc4);color:#fff;
  padding:24px 28px;box-shadow:0 8px 24px rgba(0,0,0,.35);font:14px/1.5 "Segoe UI",system-ui,sans-serif;position:relative}
.vdp-card .c-top{font-size:20px;font-weight:800;margin-bottom:22px}
.vdp-card .c-row span{opacity:.75;margin-right:8px;font-size:12px}
.vdp-card .c-foot{position:absolute;bottom:18px;left:28px;font-size:11px;opacity:.8}
.vdp-card.back{background:#f8fafc;color:var(--vd-ink);padding-top:70px}
.vdp-card.back .c-strip{position:absolute;top:26px;left:0;right:0;height:34px;background:#1f2937}

#vdToast{position:fixed;left:50%;bottom:22px;transform:translate(-50%,20px);opacity:0;pointer-events:none;background:#22303f;color:#fff;
  font-size:12.5px;padding:9px 14px;border-radius:8px;box-shadow:0 12px 30px rgba(0,0,0,.25);z-index:2147483000;transition:opacity .2s,transform .2s;max-width:min(560px,92vw)}
#vdToast.on{opacity:1;transform:translate(-50%,0)}


/* ============================= HISTORY TAB -- Medical History (list-detail rows + conditions table) ============================= */
.hx-list .vq.pe-quick > .vq-q .vq-qt{color:var(--ink-faint);font-weight:600;}
.mht-wrap{margin-top:14px;border-top:1px solid var(--line-soft);padding-top:10px;}
.mht-hd{display:flex;align-items:center;gap:8px;margin-bottom:8px;}
.mht-t{font-size:13.5px;font-weight:600;color:var(--ink);margin-right:auto;}
.mht-scroll{overflow-x:auto;border:1px solid var(--line);border-radius:var(--radius-s);}
.mht{width:100%;border-collapse:collapse;font-size:13px;min-width:680px;}
.mht th,.mht td{padding:5px 8px;border-bottom:1px solid var(--line-soft);text-align:left;vertical-align:middle;}
.mht thead th{position:sticky;top:0;background:var(--paper);font-size:11.5px;font-weight:700;letter-spacing:.03em;text-transform:uppercase;color:var(--ink-soft);border-bottom:1px solid var(--line);z-index:1;}
.mht tbody tr:last-child th,.mht tbody tr:last-child td{border-bottom:0;}
.mht tbody tr:hover{background:var(--line-soft);}
.mht tbody tr:focus-within{background:var(--brand-soft);}
.mht .mht-cond{width:30%;font-weight:600;color:var(--ink);}
.mht td.mht-c,.mht th.mht-c{width:76px;text-align:center;}
.mht input[type=checkbox]{width:17px;height:17px;margin:0;accent-color:var(--brand);cursor:pointer;}
.mht input[type=date],.mht input[type=text]{width:100%;min-width:0;height:28px;box-sizing:border-box;border:1px solid var(--line);border-radius:var(--radius-s);background:var(--card);color:var(--ink);font:inherit;font-size:13px;padding:2px 8px;}
.mht input[type=date]{min-width:132px;}
.mht input:focus{outline:none;border-color:var(--brand);box-shadow:0 0 0 2px var(--brand-soft);}
.mht .mht-spec{display:block;margin-top:4px;font-weight:400;}
.mht tr.mht-pos-on .mht-cond span{color:var(--rose);}
.hx-pending{display:flex;gap:12px;align-items:flex-start;padding:16px 4px;color:var(--ink-faint);font-size:13px;}
.hx-pending i{font-size:18px;margin-top:2px;}
@media (max-width:760px){ .mht .mht-cond{width:auto;} }

/* ============================= [v4] REVIEWED INDICATOR -- LEFT PANEL (all tabs, all sections) ============================= */
/* same icon + colours as the reviewed control in the section header; driven only by <key>-reviewed-pill */
.vrv-nav{display:inline-flex;align-items:center;justify-content:center;flex:none;width:24px;height:20px;border-radius:5px;background:var(--blue-soft);border:1px solid var(--blue-line);color:var(--brand-ink);cursor:pointer;}
.vrv-nav .vn-rv-ico{font-size:11px;margin-right:4px;color:var(--brand-ink);}
.vrv-nav .vn-rv-ico .vn-rv-chk{font-size:7px;right:-5px;}
.vrv-nav:focus-visible{outline:2px solid var(--brand);outline-offset:1px;}
.nav-item.active .vrv-nav{box-shadow:0 0 0 1px var(--card);}
.nav-item .mas-badges .mas-rev{display:none!important;}   /* MA Record: one reviewed icon in the left panel (this one) */

/* ============================= [v4] VISIT TYPE -> ACCOMPANIED BY REQUIRED ============================= */
.vq.vq-ld.vav-missing{background:var(--rose-soft);box-shadow:inset 3px 0 0 var(--rose-line);border-radius:var(--radius-s);}

/* ============================= HISTORY TAB -- Surgical History (year fields) + Family History table ============================= */
.hxs-list .vq-ld-field.hxs-yr input[type=text]{flex:0 0 64px;width:64px;}
.fht-wrap{margin-top:14px;border-top:1px solid var(--line-soft);padding-top:10px;}
.fht-scroll{overflow:auto;max-height:min(68vh,620px);border:1px solid var(--line);border-radius:var(--radius-s);}
.fht-scroll:focus-visible{outline:2px solid var(--brand);outline-offset:1px;}
.fht{width:100%;border-collapse:separate;border-spacing:0;font-size:13px;min-width:860px;}
.fht th,.fht td{padding:6px 8px;border-bottom:1px solid var(--line-soft);text-align:left;vertical-align:middle;background:var(--card);}
.fht thead th{position:sticky;top:0;z-index:2;background:var(--paper);font-size:11px;font-weight:700;letter-spacing:.03em;text-transform:uppercase;color:var(--ink-soft);border-bottom:1px solid var(--line);line-height:1.25;}
.fht .fht-cond{position:sticky;left:0;z-index:1;min-width:170px;width:190px;font-weight:600;color:var(--ink);background:var(--paper);border-right:1px solid var(--line);}
.fht thead th.fht-cond{z-index:3;}
.fht .fht-c{width:84px;text-align:center;}
.fht .fht-o{min-width:150px;}
.fht .fht-cb{display:inline-flex;flex-direction:column;align-items:center;gap:4px;}
.fht input[type=checkbox]{width:17px;height:17px;margin:0;accent-color:var(--brand);cursor:pointer;}
.fht input[type=text]{width:100%;min-width:0;height:28px;box-sizing:border-box;border:1px solid var(--line);border-radius:var(--radius-s);background:var(--card);color:var(--ink);font:inherit;font-size:13px;padding:2px 8px;}
.fht input.fht-spec{width:72px;height:24px;font-size:12px;padding:1px 6px;}
.fht input:focus{outline:none;border-color:var(--brand);box-shadow:0 0 0 2px var(--brand-soft);}
.fht tbody tr.fht-row:hover > *{background:var(--line-soft);}
.fht tbody tr.fht-row:focus-within > *{background:var(--brand-soft);}
.fht tbody tr.fht-on > th.fht-cond{color:var(--brand-ink);}
.fht tbody tr.fht-on > th.fht-cond::before{content:"";display:inline-block;width:3px;height:14px;margin:0 7px -2px -4px;border-radius:2px;background:var(--brand);}
.fht tbody tr.fht-sep > td{padding:0;height:6px;background:var(--line-soft);border-bottom:1px solid var(--line);}
.fht tbody tr:last-child > *{border-bottom:0;}
.fht-after{margin-top:10px;}
@media (max-width:760px){ .fht .fht-cond{min-width:130px;width:130px;} }

/* ============================= [v4] STICKY SECTION HEADER + HEADER ACTIONS ============================= */
/* the open section's header stays at the top of the middle panel (below the question search bar); content scrolls under it */
#center .center-inner > .card > .card-hd{position:sticky;top:var(--vn-hd-top,0px);z-index:12;background:var(--card);border-radius:var(--radius-l) var(--radius-l) 0 0;border-bottom:1px solid var(--line-soft);}
#center .center-inner > .card.vn-hd-stuck > .card-hd{box-shadow:0 4px 8px -6px rgba(18,24,38,.28);border-radius:0;}
#center .card-bd .vq,#center .card-bd [id]{scroll-margin-top:calc(var(--vn-hd-top,0px) + var(--vn-hd-h,52px) + 10px);}
/* actions: [Save & Next] [Reset] ... [More] */
.card-hd .hdr-act{display:inline-flex;align-items:center;gap:6px;flex:none;}
.card-hd .hdr-more-wrap{margin-left:6px;}
.card-hd .btn.vn-hdtxt{font-weight:600;white-space:nowrap;min-width:0;}
.card-hd .btn.vn-hdtxt .hl-dot{position:static;margin-left:5px;}
.card-hd .btn.hdr-next-btn.vn-hdtxt{background:var(--brand);border-color:var(--brand);color:#fff;}
.card-hd .btn.hdr-next-btn.vn-hdtxt:hover{filter:brightness(.95);}
.card-hd .btn.hdr-next-btn.vn-hdtxt:disabled{opacity:.55;filter:none;}
/* bottom Reset / Save & Next -- now in the header */
.card > .sec-continue{display:none!important;}

/* ============================= [v4] LEFT PANEL: SELECTION LINE + THREE STATUS ICONS ============================= */
/* selection only: #264e82 side line on the selected section (status icons never change with selection) */
#navBody .nav-item.active::before{content:'';position:absolute;left:0;top:4px;bottom:4px;width:3px;border-radius:0 3px 3px 0;background:#264e82;pointer-events:none;}
/* removed: circled status dots, "needs provider review" circle, MA badges and ROS lock in the left panel (the three icons below replace them) */
.nav-item > .statico:not(.pd-navico),.nav-item > .pr-badge,.nav-item > .mas-badges,.nav-item > .ros-lock-nav{display:none!important;}
/* order: name | Other user | Saved | Reviewed  (right-aligned, compact) */
.nav-item > *{order:5;}
.nav-item > .statico{order:0;}
.nav-item > .nm{order:1;}
.nav-item > .vst-other{order:2;}
.nav-item > .vst-saved{order:3;}
.nav-item > .vrv-nav{order:4;}
.vst{display:inline-flex;align-items:center;justify-content:center;flex:none;width:22px;height:20px;border-radius:5px;border:1px solid;font-size:10.5px;line-height:1;cursor:default;}
.vst:focus-visible{outline:2px solid var(--brand);outline-offset:1px;}
.vst-other{color:var(--teal);background:var(--teal-soft);border-color:color-mix(in srgb,var(--teal) 40%,transparent);}
