.mx-pd-pr{display:flex;align-items:center;gap:6px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.mx-pd-dot{width:6px;height:6px;border-radius:50%;background:var(--flag);flex:none;}
.mx-pd-vit div{white-space:nowrap;}
.mx-pd-vit span{display:inline-block;min-width:78px;text-align:right;color:var(--ink-faint);}
.mx-pd-tags{display:flex;gap:6px;align-items:center;padding:6px 12px;background:var(--card);border-bottom:1px solid var(--line);font-size:12.5px;}
.mx-pd-main{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(240px,1fr);flex:1;min-height:0;}
.mx-pd-left{padding:12px 14px;overflow:auto;background:var(--card);}
.mx-pd-right{border-left:1px solid var(--line);background:var(--card);padding:10px 12px;overflow:auto;}
.mx-pd-elhd{display:flex;align-items:center;gap:6px;font-weight:600;color:var(--ink);padding-bottom:6px;border-bottom:1px solid var(--line-soft);}
.mx-pd-elhd > i,.mx-pd-elhd > svg{color:var(--flag);}
.mx-pd-el{margin:8px 0 0;padding-left:18px;font-size:12.5px;color:var(--ink);}
.mx-pd-form{display:flex;flex-direction:column;gap:7px;}
.mx-pd-2{display:grid;grid-template-columns:1fr 1fr;gap:7px 14px;}
.mx-pd-3{display:grid;grid-template-columns:1.3fr 1fr 1.1fr;gap:7px 14px;}
.mx-pd-f{display:grid;grid-template-columns:96px minmax(0,1fr);align-items:center;column-gap:8px;min-width:0;}
.mx-pd-3 .mx-pd-f{grid-template-columns:auto minmax(0,1fr);}
.mx-pd-l{font-size:12px;font-weight:600;color:var(--ink-soft);text-align:right;white-space:nowrap;}
.mx-pd-l .req-star{color:var(--rose);}
.mx-pd-c{min-width:0;display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
.mx-drug-req.is-empty .mx-in{border-color:var(--rose);box-shadow:0 0 0 2px var(--rose-soft);}
.mx-chk{display:inline-flex;align-items:center;gap:5px;font-size:12.5px;color:var(--ink);cursor:pointer;white-space:nowrap;}
.mx-chk input{width:15px;height:15px;margin:0;}
.mx-daw{border-radius:15px;}
.mx-seg{display:inline-flex;border:1px solid var(--line);border-radius:5px;overflow:hidden;}
.mx-seg button{border:none;background:var(--card);font:inherit;font-size:12.5px;color:var(--ink-soft);padding:0 10px;height:28px;cursor:pointer;}
.mx-seg button + button{border-left:1px solid var(--line);}
.mx-seg button.on{background:var(--brand-soft);color:var(--brand-ink);font-weight:600;}
.mx-num{max-width:96px;}
.mx-num-s{max-width:60px;}
.mx-tot{font-size:12.5px;color:var(--ink-soft);margin-left:8px;}
.mx-pd-ft{display:flex;align-items:center;gap:8px;width:100%;}
@media (max-width:860px){ .mx-pd-banner{grid-template-columns:1fr 1fr;} .mx-pd-main{grid-template-columns:1fr;} .mx-pd-right{border-left:none;border-top:1px solid var(--line);} .mx-pd-2,.mx-pd-3{grid-template-columns:1fr;} .mx-dc-pt{grid-template-columns:1fr 1fr;} }

/* ============================= [v4] ACTIVE STATUS BADGE (global) ============================= */
.vn-st-active,.pill.vn-st-active,.status-pill.vn-st-active,.mx-status.mx-st-active{display:inline-flex;align-items:center;height:20px;padding:0 8px;border-radius:10px;border:1px solid transparent!important;background:#ff69b44d!important;color:#ff69b4!important;font-size:11.5px;font-weight:700;letter-spacing:.2px;line-height:1;text-transform:none;white-space:nowrap;vertical-align:middle;}
.allergy-entry-meta .vn-st-active,.dx-entry-meta .vn-st-active{margin-right:2px;}
table td .vn-st-active{height:18px;font-size:11px;}
.segctrl button.on.st-active{background:#ff69b44d;color:#ff69b4;font-weight:700;}

/* ============================= [v4] ALLERGIES (MA Record) ============================= */
.vn-st-moved{display:none;}
.allergy-entry-hd .al-chip{margin-left:-2px;}
.allergy-entry-hd .btn.al-ico{min-width:30px;justify-content:center;}
.al-tl td,.al-tl th{white-space:nowrap;}
.al-tl .al-del{width:40px;text-align:center;}
.al-link{border:none;background:none;padding:0;font:inherit;font-weight:700;color:var(--brand);text-decoration:underline;cursor:pointer;}
.al-link:hover,.al-link:focus-visible{color:var(--brand-ink);}
.al-tlwin .overlay-bd{display:flex;flex-direction:column;gap:10px;}

/* ============================= [v4] ROS (MA Record) -- List-Detail rows, one per body system ============================= */
.ros-groups{display:flex;flex-direction:column;gap:8px;min-width:0;}
.ros-grp{display:grid;grid-template-columns:72px minmax(0,1fr);column-gap:10px;align-items:start;}
.ros-grp.ros-grp-nol{grid-template-columns:minmax(0,1fr);}
.ros-grp-l{font-size:11.5px;font-weight:600;color:var(--ink-faint);padding-top:7px;}
.ros-row .vq-ld-opts{grid-template-columns:repeat(auto-fill,minmax(190px,1fr));}
.ros-row > .vq-q{flex-direction:column;align-items:flex-start;gap:6px;}
.ros-row > .vq-q .ros-sys-bulk{margin-left:0;}
.ros-row.vq.vq-ld{grid-template-columns:minmax(120px,170px) minmax(0,1fr);}
.ros-item{display:flex;flex-direction:column;gap:4px;min-width:0;}
.ros-item .cx-chip.vq-ld-tile{width:100%;}
.ros-det{display:none;height:28px;border:1px solid var(--line);border-radius:5px;padding:0 8px;font:inherit;font-size:12.5px;background:var(--card);color:var(--ink);min-width:0;}
.ros-item:has(> .cx-chip.on) .ros-det,.ros-det:not(:placeholder-shown){display:block;}
.ros-det:focus{outline:2px solid var(--brand-soft-line);outline-offset:0;border-color:var(--brand);}
.ros-fld input[type=number]{width:80px!important;flex:none!important;}
.ros-bulk-btn:disabled{opacity:.35;cursor:not-allowed;}
/* selection states: All Normal = green; every other selection = red */
#maros-questionnaire-block .cx-chip.vq-ld-tile.on{background:var(--rose-soft);border-color:var(--rose);color:var(--rose);font-weight:600;}
#maros-questionnaire-block .cx-chip.vq-ld-tile.on[data-ros-kind="normal"]{background:var(--green-soft);border-color:var(--green);color:var(--green);}
/* Obstetric History */
.ros-ob{display:flex;flex-direction:column;gap:12px;}
.ros-ob-t{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--ink-faint);margin-bottom:6px;}
.ros-ob-grid{display:grid;gap:8px 18px;}
.ros-ob-grid.ros-ob-n{grid-template-columns:repeat(auto-fill,minmax(150px,1fr));}
.ros-ob-grid.ros-ob-f{grid-template-columns:repeat(auto-fill,minmax(240px,1fr));}
.vq-ld-opts .ros-ob-fld,.ros-ob-fld{display:flex!important;flex-direction:column;align-items:stretch!important;gap:4px;}
.ros-ob-fld > label{font-size:12px!important;font-weight:600;color:var(--ink-soft)!important;white-space:normal!important;}
.ros-ob-fld > label::after{content:''!important;}
.ros-ob-fld input{height:30px;border:1px solid var(--line);border-radius:5px;padding:0 8px;font:inherit;font-size:13px;background:var(--card);color:var(--ink);width:100%!important;}
.ros-ob-fld.ros-num input{width:100px!important;text-align:right;font-variant-numeric:tabular-nums;}
.ros-ob-fld input:focus{outline:2px solid var(--brand-soft-line);border-color:var(--brand);}
@media (max-width:760px){ .ros-grp{grid-template-columns:1fr;} .ros-grp-l{padding-top:0;} }

/* ============================= [v4] THIS VISIT SUMMARY -- independent cards, plain text ============================= */
#ssumTabThisVisit > details.ssum-sec,#vntScope{display:none!important;}
.vns-wrap{display:flex;flex-direction:column;min-width:0;}
/* each section is its own card, grouped under the Visit Note tab names */
.vns-doc{display:flex;flex-direction:column;gap:12px;font-size:13.2px;line-height:1.55;color:var(--ink);min-width:0;}
.vns-tab{display:flex;flex-direction:column;gap:8px;min-width:0;}
.vns-tab + .vns-tab{margin-top:4px;}
.vns-tab-t{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--ink-faint);padding:2px 2px 0;cursor:default;scroll-margin-top:12px;}
.vns-sec{background:var(--card);border:1px solid var(--line);border-radius:var(--radius-m);box-shadow:var(--shadow-sm);padding:0 0 10px;scroll-margin-top:12px;min-width:0;overflow:hidden;}
.vns-sec[hidden]{display:none;}
.vns-sec.hl-active{box-shadow:inset 3px 0 0 var(--hl-color),var(--shadow-sm);}
.vns-sec-hd{display:flex;align-items:center;flex-wrap:wrap;gap:6px 8px;min-height:38px;padding:6px 10px 6px 12px;margin-bottom:8px;background:var(--paper);border-bottom:1px solid var(--line-soft);cursor:default;}
.vns-sec-t{font-weight:700;font-size:13.5px;color:var(--ink);min-width:0;}
.vns-unsaved{font-size:10.5px;font-weight:700;color:var(--amber);background:var(--amber-soft);border-radius:4px;padding:0 5px;line-height:16px;}
.vns-acts{margin-left:auto;display:inline-flex;align-items:center;gap:6px;flex:none;}
.vns-btn{display:inline-flex;align-items:center;gap:5px;height:24px;padding:0 9px;border-radius:5px;font:inherit;font-size:12px;font-weight:600;cursor:pointer;white-space:nowrap;}
.vns-save{border:1px solid var(--brand);background:var(--brand);color:#fff;}
.vns-save:hover{background:var(--brand-ink);}
.vns-go{border:1px solid var(--line);background:var(--card);color:var(--brand-ink);}
.vns-go:hover{background:var(--brand-soft);border-color:var(--brand-soft-line);}
.vns-go i,.vns-go svg{font-size:10px;}
.vns-btn:focus-visible{outline:2px solid var(--brand);outline-offset:1px;}
/* plain text summary under each card header -- no formatting controls */
.vns-body{padding:0 12px;}
.vns-ta{display:block;width:100%;min-height:64px;resize:vertical;border:1px solid var(--line);border-radius:var(--radius-s);padding:8px 10px;background:var(--card);color:var(--ink);font-family:inherit;font-size:13.2px;line-height:1.55;white-space:pre-wrap;overflow-wrap:anywhere;overflow:hidden;}
.vns-ta:focus{outline:none;border-color:var(--brand);box-shadow:0 0 0 2px var(--brand-soft);}
.vns-ta::placeholder{color:var(--ink-faint);}
.vns-tabta{min-height:34px;font-size:12.5px;background:var(--paper);border-style:dashed;}
.vns-tabta:focus,.vns-tabta:not(:placeholder-shown){background:var(--card);border-style:solid;}
.vns-rm{margin-top:6px;display:flex;align-items:center;gap:6px;font-size:11.5px;color:var(--ink-faint);cursor:default;}
.vns-rm button{border:none;background:none;padding:0;font:inherit;font-weight:700;color:var(--brand);text-decoration:underline;cursor:pointer;}
@media (pointer:coarse){ .vns-btn{height:30px;padding:0 12px;} }

/* ============================= [v4] EDIT WINDOW (MA of Record / ROS) ============================= */
.overlay-scrim.vn-edit-win > .overlay-panel{width:min(1180px,100%);}
.overlay-scrim.vn-edit-win .overlay-bd{background:var(--card);}
.overlay-scrim.vn-edit-win .overlay-ft .btn{min-width:84px;justify-content:center;}
.vn-edit-bulk{margin-right:6px;}

/* ============================= [v4] COLLAPSED PATIENT BAR ============================= */
/* only: name + chart no. | gender · DOB (age) | Referred By | patient tags (expanded bar unchanged) */
.pdbar.pdb-collapsed .pdb-zone,.pdbar.pdb-collapsed .pb-id .pron{display:none!important;}
.pdbar.pdb-collapsed .pdb-id{flex:1 1 auto;min-width:0;}
.pdbar.pdb-collapsed .pdb-idtext{display:flex;flex-direction:row;align-items:center;flex-wrap:wrap;gap:4px 12px;min-width:0;}
.pdbar.pdb-collapsed .pdb-idtext > .pdb-l2{display:flex!important;flex-wrap:wrap;align-items:center;gap:4px 12px;}
.pdbar.pdb-collapsed .pdb-l2 > .pdb-f-lang,.pdbar.pdb-collapsed .pdb-l2 > .pdb-f-next,.pdbar.pdb-collapsed .pdb-l2 > .pdb-f-refdr,.pdbar.pdb-collapsed .pdb-l2 > .pdb-more{display:none!important;}
.pdbar.pdb-collapsed .pdb-l2 > .pdb-f-ref{order:1;padding-left:12px;border-left:1px solid var(--line);}
.pdbar.pdb-collapsed .pdb-l2 > .pdb-f-ref .k{font-size:0;margin-right:0;}
.pdbar.pdb-collapsed .pdb-l2 > .pdb-f-ref .k::before{content:"Referred By";font-size:10.5px;margin-right:4px;}
.pdbar.pdb-collapsed .pdb-l2 > .pb-tags-row{order:2;padding:0;gap:5px;}
@media (max-width:760px){ .pdbar.pdb-collapsed .pdb-l2 > .pdb-f-ref{padding-left:0;border-left:none;} }

/* ============================= [v4] MA RECORD SECTION STATUS ============================= */
.mas-sec > .card-hd .meta,.mas-sec > .card-hd .hdr-filled{display:none!important;}   /* the long "Filled by …" text moves into the badge tooltip */
.mas-badges{display:inline-flex;align-items:center;gap:3px;flex:none;}
.mas-badges[hidden]{display:none;}
.card-hd h3 .mas-badges{margin-left:8px;vertical-align:middle;}
.mas-b{display:inline-flex;align-items:center;justify-content:center;width:20px;height:20px;border-radius:5px;border:1px solid;font-size:10.5px;line-height:1;cursor:default;}
.card-hd h3 .mas-b{width:22px;height:22px;font-size:11px;}
.mas-b:focus-visible{outline:2px solid var(--brand);outline-offset:1px;}
.mas-filled{color:var(--teal);background:var(--teal-soft);border-color:color-mix(in srgb,var(--teal) 40%,transparent);}
.mas-edit{color:var(--amber);background:var(--amber-soft);border-color:var(--amber-line);}
.mas-rev{color:var(--brand-ink);background:var(--blue-soft);border-color:var(--blue-line);width:24px;}
.mas-rev .vn-rv-ico{font-size:11px;margin-right:4px;}
.mas-rev .vn-rv-ico .vn-rv-chk{font-size:7px;right:-5px;}
.nav-item.active .mas-b{box-shadow:0 0 0 1px var(--card);}
/* [v4] active (currently being worked on) section: left-edge bar on its left-panel item -- no icon */
.nav-item{position:relative;}
/* middle panel: no Unsaved chip / label / mark (save logic and the Summary panel's own indicator unchanged) */
#center .pill-unsaved,.card-hd .pill-unsaved,.ap-savebar .pill-unsaved{display:none!important;}

/* [v4] Patient Bar tag colours -- colour only; text, size, shape and spacing unchanged */
#patientbar .ptag.ptag-est{background:#fb4e2f;color:#ffc2b7;border-color:#fb4e2f;}
#patientbar .ptag.ptag-ccm{background:#a9e620;color:#2d4100;border-color:#a9e620;}

/* ============================= [v4] ROS LOCKED BY ANOTHER USER ============================= */
.ros-lock-nav{display:inline-flex;align-items:center;justify-content:center;flex:none;width:20px;height:20px;margin-left:4px;border-radius:5px;border:1px solid var(--rose-line);background:var(--rose-soft);color:var(--rose);font-size:10px;}
.ros-lock-nav:focus-visible,.ros-lock-big:focus-visible{outline:2px solid var(--brand);outline-offset:2px;}
/* overlay -- white wash over the read-only content, large slate padlock centred, message right beneath */
#sec-maros.ros-locked > .card-bd{position:relative;}
.ros-lock-ov{position:absolute;inset:0;z-index:5;background:rgba(255,255,255,.55);display:flex;justify-content:center;align-items:flex-start;pointer-events:none;border-radius:inherit;}
.ros-lock-ov-in{position:sticky;top:calc(50vh - 60px);margin-top:min(120px,20%);display:flex;flex-direction:row;align-items:center;gap:8px;}
.ros-lock-big{display:inline-flex;align-items:center;justify-content:center;flex:none;color:#5f7896;line-height:0;pointer-events:auto;cursor:default;border-radius:4px;}
.ros-lock-big svg{width:19px;height:22px;display:block;}   /* status-icon scale (header badges are 22px) */
.ros-lock-msg{font-size:14px;font-weight:600;line-height:22px;color:#1f2a37;white-space:nowrap;}
/* ROS summary card: same lock + message above the read-only summary text */
.ros-lock-row{display:flex;align-items:center;gap:8px;margin:0 0 6px;}
.vns-sec.ros-locked-sum .vns-ta{background:var(--line-soft);color:var(--ink-soft);cursor:not-allowed;}
.vns-sec.ros-locked-sum .vns-btn:disabled,.vns-sec.ros-locked-sum .vns-rm button:disabled{opacity:.45;cursor:not-allowed;}
#sec-maros.ros-locked button:disabled,#sec-maros.ros-locked input:disabled,#sec-maros.ros-locked select:disabled,#sec-maros.ros-locked textarea:disabled{cursor:not-allowed;}
#sec-maros.ros-locked > .card-hd button:disabled{opacity:.45;}
#sec-maros.ros-locked .cx-chip:disabled{opacity:1;}   /* selections keep their colours (read-only) */
@media (max-width:760px){ .ros-lock-msg{white-space:normal;line-height:1.3;} }

/* [v4] middle-panel copy of the left-panel completion tick (same .statico.complete look) */
.card-hd h3 > .statico.vn-hd-tick{display:inline-flex;vertical-align:middle;margin-left:8px;color:var(--ink-soft);font-size:13.3px;font-weight:500;}

/* ============================= ROS LOCKED BY ANOTHER USER -- header lock indication ============================= */
#sec-maros.ros-locked .ros-lock-ov{display:none!important;}            /* replaces the centred overlay */
.rl-hd{display:inline-flex;align-items:center;gap:6px;flex:none;max-width:100%;height:24px;box-sizing:border-box;padding:0 10px 0 2px;border-radius:999px;border:1px solid var(--rose-line);background:var(--rose-soft);vertical-align:middle;}
/* lock icon at the app's status-icon scale (header status badges are 20-22px with a ~10-11px glyph) */
.rl-ico{display:inline-flex;align-items:center;justify-content:center;flex:none;width:20px;height:20px;border-radius:50%;background:var(--rose);color:#fff;cursor:default;}
.rl-ico i{font-size:10px;line-height:1;display:block;}
.rl-ico:focus-visible{outline:2px solid var(--brand);outline-offset:2px;}
.rl-msg{font-size:12.5px;font-weight:600;color:var(--rose);line-height:20px;white-space:nowrap;}
#sec-maros.ros-locked > .card-bd{background:repeating-linear-gradient(135deg,transparent 0 10px,rgba(0,0,0,.018) 10px 20px);}
#sec-maros.ros-locked > .card-bd > :not(.ros-lock-ov){opacity:.66;}   /* read-only: data stays visible */
/* Summary card: same pill above the read-only text */
.vns-sec.ros-locked-sum .ros-lock-row{display:flex;align-items:center;margin:0 0 6px;}
.vns-sec.ros-locked-sum .ros-lock-row .ros-lock-big{display:none;}
.vns-sec.ros-locked-sum .ros-lock-row .ros-lock-msg{display:none;}
@media (max-width:760px){ .rl-hd{height:auto;min-height:24px;padding-top:2px;padding-bottom:2px;} .rl-msg{white-space:normal;line-height:1.3;} }

/* ============================= SCREENING TOOLS -- standard form rows (label | controls | clear) ============================= */
.scr-list .vq.vq-ld{align-items:center;}
.scr-list .vq.vq-ld > .vq-q{padding-top:0;}
.scr-ctl{display:flex;flex-wrap:wrap;align-items:center;gap:8px 16px;min-width:0;}
.scr-f{display:inline-flex;align-items:center;gap:6px;min-width:0;margin:0;}
.scr-l{font-size:12.5px;font-weight:600;color:var(--ink-faint);white-space:nowrap;padding:0;}
.scr-f input{height:30px;box-sizing:border-box;border:1px solid var(--line);border-radius:var(--radius-s);background:var(--card);color:var(--ink);font:inherit;font-size:13px;padding:3px 8px;width:150px;min-width:0;}
.scr-f input[type=date]{width:148px;}
.scr-f.scr-f-wide input{width:220px;}
.scr-f input:focus{outline:none;border-color:var(--brand);box-shadow:0 0 0 2px var(--brand-soft);}
.scr-rg{display:inline-flex;flex-wrap:wrap;align-items:center;gap:4px 12px;border:0;margin:0;padding:0;min-width:0;}
.scr-rg > legend{float:left;margin-right:2px;}
.scr-opt{display:inline-flex;align-items:center;gap:5px;font-size:13px;color:var(--ink);cursor:pointer;white-space:nowrap;}
.scr-opt input{margin:0;width:15px;height:15px;accent-color:var(--brand);cursor:pointer;}
.scr-opt:has(input:checked) > span{font-weight:600;color:var(--brand-ink);}
.scr-list .vq-ctx{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;}
@media (max-width:760px){
  .scr-ctl{gap:8px 12px;}
  .scr-f{flex:1 1 100%;} .scr-f input,.scr-f.scr-f-wide input,.scr-f input[type=date]{flex:1;width:auto;}
  .scr-l{min-width:96px;}
}

/* ============================= ASSESSMENT & PLAN -- picker + plan (A&P.png) ============================= */
.apx-root{--apx-h:380px;}
.apx-left{display:flex;flex-direction:column;min-width:0;border-right:1px solid var(--line);min-height:var(--apx-h);}
.apx-tabs{display:flex;align-items:flex-end;gap:2px;padding:6px 10px 0;border-bottom:1px solid var(--line-soft);}
.apx-tab{border:0;background:none;padding:7px 10px 8px;font:inherit;font-size:13px;font-weight:600;color:var(--ink-soft);border-bottom:2px solid transparent;margin-bottom:-1px;cursor:pointer;}
.apx-tab:hover{color:var(--ink);}
.apx-tab.on{color:var(--brand);border-bottom-color:var(--brand);}
.apx-sp{flex:1;}
.apx-to{padding:6px 12px;font-size:12px;color:var(--ink-soft);background:var(--line-soft);border-bottom:1px solid var(--line-soft);}
.apx-to b{color:var(--ink);font-weight:600;}
.apx-warn{display:inline-flex;align-items:center;gap:6px;color:var(--amber);font-weight:600;}
.apx-pick{display:flex;flex:1;min-height:0;}
.apx-cats{width:38%;min-width:150px;max-width:240px;border-right:1px solid var(--line-soft);display:flex;flex-direction:column;}
.apx-cats.collapsed{width:auto;min-width:0;}
.apx-cats.collapsed .apx-catlist,.apx-cats.collapsed input{display:none;}
.apx-items{flex:1;min-width:0;display:flex;flex-direction:column;}
.apx .ap-pick-search,.apx-srch.ap-pick-search{display:flex;align-items:center;gap:7px;width:auto;margin:0;padding:6px 10px;border:0;border-bottom:1px solid var(--line-soft);border-radius:0;background:transparent;color:var(--ink-faint);font-size:12px;}
.apx-srch input{flex:1;min-width:0;border:0;outline:none;background:transparent;font:inherit;font-size:13px;color:var(--ink);padding:2px 0;}
.apx-srch:focus-within{border-bottom-color:var(--brand);}
.apx-catlist,.apx-ilist{flex:1;overflow:auto;max-height:var(--apx-h);padding:4px 0;}
.apx-cat{display:block;width:100%;text-align:left;border:0;background:none;padding:6px 14px;font:inherit;font-size:13px;color:var(--ink);cursor:pointer;}
.apx-cat:hover{background:var(--line-soft);}
.apx-cat.on{background:var(--brand-soft);color:var(--brand-ink);font-weight:600;box-shadow:inset 3px 0 0 var(--brand);}
.apx-it{display:flex;align-items:flex-start;gap:9px;width:100%;text-align:left;border:0;background:none;padding:5px 12px;font:inherit;font-size:13px;color:var(--ink);cursor:pointer;line-height:1.35;}
.apx-it > i{color:var(--ink-faint);font-size:11px;margin-top:4px;width:12px;flex:none;}
.apx-it:hover{background:var(--line-soft);}
.apx-it:hover > i{color:var(--brand);}
.apx-it.on{color:var(--ink-faint);}
.apx-it.on > i{color:var(--green);}
.apx-empty{padding:10px 14px;font-size:12.5px;color:var(--ink-faint);}
.apx-fuq{display:flex;align-items:center;gap:6px;padding:8px 12px;border-bottom:1px solid var(--line-soft);font-size:13px;color:var(--ink-soft);}
.apx-fuq input,.apx-fuq select{height:28px;border:1px solid var(--line);border-radius:6px;background:var(--card);font:inherit;font-size:13px;padding:0 6px;color:var(--ink);}
.apx-fun{width:64px;}
/* layout: diagnosis list full width; Quick Add puts the picker beside it */
.apx-wrap{display:grid;grid-template-columns:minmax(0,1fr);border:1px solid var(--line);border-radius:var(--radius-s);background:var(--card);}
.apx-wrap.qa-open{grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);}
.apx-right{display:flex;flex-direction:column;min-width:0;}
.apx-hint{color:var(--ink-faint);font-weight:400;}
/* diagnosis rows (a&p_diagnosis.png) */
.apd-list{padding:6px 8px;flex:1;}
.apd-dx + .apd-dx{border-top:1px solid var(--line-soft);}
.apd-row{display:flex;align-items:center;flex-wrap:wrap;gap:6px 8px;padding:6px 6px 6px 8px;border-radius:6px;position:relative;box-shadow:inset 3px 0 0 var(--apd-hl,transparent);}
.apd-row:hover{background:var(--line-soft);}
.apd-row.tgt{background:var(--brand-soft);}
.apd-dot{width:8px;height:8px;border-radius:50%;background:var(--ink-soft);flex:none;}
.apd-row.off .apd-dot{background:transparent;border:1.5px solid var(--ink-faint);}
.apd-name{border:0;background:none;padding:0;font:inherit;font-size:14px;font-weight:700;color:var(--brand-ink);cursor:pointer;text-align:left;line-height:1.3;}
.apd-row.off .apd-name{color:var(--ink-soft);font-weight:600;}
.apd-info{color:var(--ink-soft);font-size:13px;cursor:help;display:inline-flex;}
.apd-st{font-size:11.5px;font-weight:600;padding:1px 8px;border-radius:4px;border:1px solid #ff69b44d;background:#ff69b41a;color:#ff69b4;}
.apd-st.st-inactive{border-color:var(--line);background:var(--line-soft);color:var(--ink-soft);}
.apd-st.st-resolved{border-color:var(--green-line,#a9dcbf);background:var(--green-soft);color:var(--green);}
.apd-acts{display:inline-flex;align-items:center;gap:2px;}
.apd-ico{width:28px;height:28px;display:inline-flex;align-items:center;justify-content:center;border:0;background:none;border-radius:6px;color:var(--ink-soft);font-size:14px;cursor:pointer;}
.apd-ico:hover,.apd-ico.on{background:var(--card);color:var(--brand);box-shadow:0 0 0 1px var(--line);}
.apd-ico.is-visit{color:var(--brand);cursor:default;}
.apd-ico.to-visit{color:var(--ink-faint);}
.apd-ico.to-visit:hover{color:var(--brand);}
.apd-ico.del:hover{color:var(--rose);}
.apd-ico:focus-visible,.apd-name:focus-visible,.apd-pbtn:focus-visible,.apd-info:focus-visible{outline:2px solid var(--brand);outline-offset:1px;}
.apd-pop,.apd-plan{position:relative;display:inline-flex;}
.apd-plan{border:1px solid var(--line);border-radius:6px;background:var(--card);}
.apd-pbtn{border:0;background:none;padding:3px 10px;font:inherit;font-size:12.5px;font-weight:600;color:var(--ink-soft);cursor:pointer;height:28px;}
.apd-pbtn:hover{color:var(--brand);}
.apd-caret{border-left:1px solid var(--line);padding:3px 8px;font-size:10px;}
.apd-menu,.apd-pal{position:absolute;top:calc(100% + 4px);left:0;z-index:40;background:var(--card);border:1px solid var(--line);border-radius:6px;box-shadow:var(--shadow-md,0 8px 24px rgba(0,0,0,.14));}
.apd-menu{min-width:170px;padding:4px 0;display:flex;flex-direction:column;}
.apd-menu button{border:0;background:none;text-align:left;padding:7px 12px;font:inherit;font-size:13px;color:var(--ink-soft);cursor:pointer;}
.apd-menu button:hover,.apd-menu button:focus-visible{background:var(--brand-soft);color:var(--brand-ink);outline:none;}
.apd-pal{display:flex;flex-wrap:wrap;gap:6px;padding:8px;width:156px;}
.apd-sw{width:24px;height:24px;border-radius:50%;border:2px solid var(--card);box-shadow:0 0 0 1px var(--line);cursor:pointer;}
.apd-items{margin:0 0 6px 30px;border-left:2px solid var(--line-soft);padding-left:10px;}
.apd-item{display:flex;align-items:center;gap:8px;min-height:28px;padding:1px 4px;border-radius:5px;}
.apd-item:hover{background:var(--line-soft);}
.apd-kind{flex:none;font-size:10px;font-weight:700;letter-spacing:.3px;text-transform:uppercase;padding:1px 6px;border-radius:4px;background:var(--line-soft);color:var(--ink-soft);}
.apd-kind.k-rx{background:var(--brand-soft);color:var(--brand-ink);} .apd-kind.k-ho{background:var(--teal-soft);color:var(--teal);}
.apd-kind.k-fu{background:var(--amber-soft);color:var(--amber);} .apd-kind.k-im{background:var(--green-soft);color:var(--green);}
.apd-kind.k-au{background:var(--ai-soft,#efe9fb);color:var(--ai,#6d4bc4);}
.apd-itxt{flex:1;min-width:0;font-size:13px;color:var(--ink);}
.apd-iacts{display:inline-flex;opacity:.6;}
.apd-item:hover .apd-iacts,.apd-item:focus-within .apd-iacts{opacity:1;}
.apd-iacts .apd-ico{width:26px;height:26px;font-size:12px;}
.apd-form{margin:4px 6px 8px 30px;padding:10px 12px;border:1px solid var(--line);border-left:3px solid var(--brand);border-radius:6px;background:var(--card);}
.apd-fh{display:flex;align-items:center;gap:7px;font-size:13px;font-weight:700;color:var(--ink);margin-bottom:8px;}
.apd-fh i{color:var(--brand);}
.apd-for{font-weight:500;color:var(--ink-faint);font-size:12px;}
.apd-fields{display:flex;flex-wrap:wrap;gap:8px 12px;}
.apd-f{display:flex;flex-direction:column;gap:3px;font-size:11.5px;font-weight:600;color:var(--ink-faint);min-width:110px;}
.apd-f.wide{flex:1 1 240px;}
.apd-f input,.apd-f select,.apd-f textarea{height:30px;border:1px solid var(--line);border-radius:6px;padding:0 8px;font:inherit;font-size:13px;font-weight:400;color:var(--ink);background:var(--card);}
.apd-f textarea{height:auto;padding:6px 8px;resize:vertical;}
.apd-f input:focus,.apd-f select:focus,.apd-f textarea:focus{outline:none;border-color:var(--brand);box-shadow:0 0 0 2px var(--brand-soft);}
.apd-factions{display:flex;gap:6px;margin-top:10px;}
.apd-sub{margin:10px 6px 2px;font-size:11px;font-weight:700;letter-spacing:.4px;text-transform:uppercase;color:var(--ink-faint);}
.apd-empty{display:flex;gap:8px;align-items:center;padding:16px 10px;font-size:13px;color:var(--ink-faint);}
.apx-flag{display:none;}
.apx-savebar{display:flex;align-items:center;justify-content:flex-end;gap:10px;padding:8px 10px;border-top:1px solid var(--line-soft);}
.apx-savedat{display:inline-flex;align-items:center;gap:5px;font-size:12px;color:var(--green);}
/* Problem List: Move to this visit */
.plx-st{background:#ff69b41a!important;color:#ff69b4!important;border:1px solid #ff69b44d;}
.plx-move{display:inline-flex;align-items:center;gap:5px;}
.plx-move.is-visit{color:var(--brand);border-color:var(--brand-soft-line,var(--line));background:var(--brand-soft);cursor:default;}
#apQuickAddBtn.on{background:var(--brand-soft);color:var(--brand-ink);border-color:var(--brand-soft-line,var(--line));}
/* bottom quick add */
.apx-quick{position:relative;margin-top:8px;border:1px solid var(--line);border-radius:var(--radius-s);background:var(--card);}
.apx-quick .apx-srch{border-bottom:0;}
.apx-qlist{position:absolute;left:0;right:0;bottom:100%;margin-bottom:4px;z-index:30;background:var(--card);border:1px solid var(--line);border-radius:var(--radius-s);box-shadow:var(--shadow-md,0 6px 20px rgba(0,0,0,.12));max-height:260px;overflow:auto;padding:4px 0;}
/* Diagnosis section: the same diagnosis picker above the existing diagnosis list */
.apx-dxpick{border:1px solid var(--line);border-radius:var(--radius-s);background:var(--card);margin-bottom:12px;}
.apx-dxpick .apx-pick{height:250px;}
.apx-dxpick .apx-catlist,.apx-dxpick .apx-ilist{max-height:none;}
.apx-dxhd{display:flex;align-items:center;gap:8px;flex-wrap:wrap;padding:8px 12px;border-bottom:1px solid var(--line-soft);font-size:13px;font-weight:600;color:var(--ink);}
.apx-dxhd > i{color:var(--brand);}
.apx-dxsub{font-weight:500;font-size:12px;color:var(--ink-faint);}
@media (max-width:900px){
  .apx-wrap.qa-open{grid-template-columns:1fr;}
  .apx-left{border-right:0;border-bottom:1px solid var(--line);}
  .apx-root{--apx-h:260px;}
}
@media (max-width:560px){
  .apx-cats{min-width:118px;width:42%;}
  .apx-tab{padding:7px 7px 8px;}
}
.apx-ico{width:24px;height:24px;display:inline-flex;align-items:center;justify-content:center;border:0;background:none;border-radius:5px;color:var(--ink-soft);font-size:12px;cursor:pointer;flex:none;}
.apx-ico:hover{background:var(--line-soft);color:var(--brand);}
.apx-ico:focus-visible,.apx-it:focus-visible,.apx-cat:focus-visible,.apx-tab:focus-visible{outline:2px solid var(--brand);outline-offset:1px;}
.apx-tabs .apx-ico{align-self:center;margin-bottom:4px;}
@media (max-width:560px){ .apd-items,.apd-form{margin-left:12px;} .apd-row{gap:4px 6px;} }

.apx-dxwrap .apx-dxpick{margin-bottom:10px;}
/* ============================= A&P plan forms (a&P_med / handout / followup / immunization / authorization / freeplan) ============================= */
.apd-item{box-shadow:inset 3px 0 0 var(--apd-ihl,transparent);}
.apf{margin:4px 6px 10px 26px;padding:6px 12px 10px;border:1px solid var(--line);border-left:3px solid var(--apf-hl,var(--brand));border-radius:6px;background:var(--card);}
.apf-hd{display:flex;align-items:center;gap:6px;min-height:30px;}
.apf-title{font-size:13px;font-weight:700;color:var(--ink);min-width:0;}
.apf-hd .apd-ico{width:26px;height:26px;font-size:13px;}
.apf-pal{left:auto;right:auto;}
.apf-back{display:inline-flex;align-items:center;gap:6px;border:0;background:none;font:inherit;font-size:12.5px;font-weight:600;color:var(--brand);cursor:pointer;padding:4px 6px;border-radius:5px;}
.apf-back:hover{background:var(--brand-soft);}
.apf-new{font-size:13px;font-weight:600;color:var(--ink-soft);margin:2px 0 6px;}
.apf-grid{display:grid;grid-template-columns:1fr 1fr;border:1px solid var(--line-soft);border-radius:4px;}
.apf-grid.one{grid-template-columns:1fr;}
.apf-c{display:flex;flex-direction:column;min-width:0;padding:6px 8px 4px;border-bottom:1px solid var(--line-soft);margin:0;}
.apf-grid > .apf-c:nth-child(odd):not(.full){border-right:1px solid var(--line-soft);}
.apf-c.full{grid-column:1/-1;}
.apf-c:focus-within{background:var(--brand-soft);}
.apf-l{font-size:11.5px;font-weight:600;color:var(--ink-faint);line-height:1.2;}
.apf-req{color:var(--rose);margin-left:3px;font-weight:700;}
.apf-ctl{display:flex;align-items:center;gap:6px;position:relative;min-height:30px;}
.apf-ctl input,.apf-ctl select,.apf-ctl textarea,.apf-c > textarea{flex:1;min-width:0;width:100%;border:0;background:transparent;font:inherit;font-size:13.5px;color:var(--ink);padding:4px 2px;outline:none;}
.apf-ctl select{appearance:none;-webkit-appearance:none;padding-right:20px;cursor:pointer;}
.apf-dd{position:absolute;right:4px;font-size:10px;color:var(--ink-soft);pointer-events:none;}
.apf-ctl textarea,.apf-c > textarea{resize:vertical;min-height:28px;}
.apf-grid.one textarea{min-height:96px;}
.apf-tools{color:var(--ink-faint);font-size:13px;}
.apf-pn{display:inline-flex;border:1px solid var(--line);border-radius:4px;overflow:hidden;flex:none;}
.apf-tg{border:0;background:var(--card);width:28px;height:24px;font:inherit;font-size:12px;font-weight:700;color:var(--ink-soft);cursor:pointer;}
.apf-tg + .apf-tg{border-left:1px solid var(--line);}
.apf-tg.on{background:var(--brand);color:#fff;}
.apf-ft{display:flex;justify-content:flex-end;gap:8px;padding-top:10px;}
.apf-ft .btn{border-radius:999px;min-width:72px;justify-content:center;}
.apf-ft .btn-primary:disabled{opacity:.45;cursor:not-allowed;}
/* follow up: segmented picker + note/date column */
.apf-fu{display:grid;grid-template-columns:minmax(0,2fr) minmax(0,1fr);border:1px solid var(--line-soft);border-radius:4px;overflow:hidden;}
.apf-fugrid{display:flex;flex-direction:column;border-right:1px solid var(--line-soft);}
.apf-segrow{display:grid;border-bottom:1px solid var(--line-soft);}
.apf-segrow:last-child{border-bottom:0;}
.apf-segrow.r2{grid-template-columns:1fr 1fr;} .apf-segrow.r6{grid-template-columns:repeat(6,1fr);} .apf-segrow.r4{grid-template-columns:repeat(4,1fr);}
.apf-seg{border:0;border-right:1px solid var(--line-soft);background:var(--card);padding:6px 4px;font:inherit;font-size:12.5px;color:var(--ink);cursor:pointer;}
.apf-seg:last-child{border-right:0;}
.apf-seg:hover{background:var(--line-soft);}
.apf-seg.on{background:#5f7896;color:#fff;font-weight:600;}
.apf-seg:focus-visible,.apf-tg:focus-visible,.apf-chip:focus-visible,.apf-back:focus-visible{outline:2px solid var(--brand);outline-offset:-2px;}
.apf-segin{border:0;text-align:center;font:inherit;font-size:12.5px;width:100%;min-width:0;padding:6px 4px;background:var(--card);color:var(--ink);}
.apf-segin.on{background:#5f7896;color:#fff;}
.apf-funote{display:flex;flex-direction:column;}
.apf-funote input{border:0;border-bottom:1px solid var(--line-soft);padding:8px 10px;font:inherit;font-size:13px;outline:none;background:transparent;color:var(--ink);}
.apf-funote input:focus{background:var(--brand-soft);}
.apf-fudate{display:flex;align-items:center;gap:7px;padding:8px 10px;font-size:13px;color:var(--ink);}
.apf-fudate i{color:var(--ink-faint);}
/* authorization: Dx / CPT search rows and chips */
.apf-boxed .apf-ctl{border:1px solid var(--line);border-radius:5px;padding:0 6px;margin-top:3px;background:var(--card);}
.apf-boxed .apf-c{border-right:0!important;border-bottom:0;padding:8px 10px 2px;}
.apf-srow{display:flex;align-items:center;gap:8px;margin-top:4px;}
.apf-big{font-size:15px;font-weight:600;color:var(--ink-soft);white-space:nowrap;}
.apf-muted{color:var(--ink-faint);font-size:12.5px;}
.apf-sel{flex:1;position:relative;display:flex;align-items:center;border:1px solid var(--line);border-radius:5px;background:var(--card);}
.apf-sel select{flex:1;border:0;background:transparent;font:inherit;font-size:13px;padding:5px 24px 5px 8px;appearance:none;-webkit-appearance:none;color:var(--ink-soft);cursor:pointer;outline:none;}
.apf-sug{font-size:12.5px;font-weight:600;color:var(--ink);margin:8px 0 4px;}
.apf-chips{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:6px;}
.apf-chip{display:inline-flex;align-items:center;gap:5px;border:1px solid var(--line);background:var(--card);color:var(--ink-soft);border-radius:999px;padding:2px 12px;font:inherit;font-size:12.5px;cursor:pointer;}
.apf-chip.on{border-color:var(--blue-line,#b9cdf3);background:var(--blue-soft,#eaf1fd);color:var(--brand-ink);}
.apf-sep{border-top:1px solid var(--line-soft);padding-top:10px;margin-top:6px;}
.apf-x{border:0;background:none;padding:0 0 0 2px;color:inherit;cursor:pointer;font-size:11px;}
@media (max-width:760px){
  .apf{margin-left:8px;}
  .apf-grid,.apf-fu{grid-template-columns:1fr;}
  .apf-grid > .apf-c:nth-child(odd):not(.full){border-right:0;}
  .apf-fugrid{border-right:0;border-bottom:1px solid var(--line-soft);}
  .apf-back span,.apf-back{font-size:12px;}
}
/* ============================= A&P populated state (diagnosis -> plan lines) ============================= */
.apd-list{padding:8px 10px;}
.apd-row{flex-wrap:nowrap;}
.apd-name{min-width:0;max-width:min(560px,60%);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.apd-row > .apd-st,.apd-row > .apd-acts,.apd-row > .apd-plan,.apd-row > .apd-info{flex:none;}
.apd-items{margin:2px 0 8px 22px;border-left:0;padding-left:0;}
.api{display:flex;align-items:flex-start;gap:12px;padding:5px 8px 5px 14px;border-radius:6px;box-shadow:inset 3px 0 0 var(--apd-ihl,transparent);}
.api + .api{margin-top:2px;}
.api:hover{background:var(--line-soft);}
.api > .apd-dot{margin-top:9px;background:#5f7896;}
.api.off{opacity:.6;}
.api-main{flex:1;min-width:0;}
.api-hd{display:flex;align-items:center;flex-wrap:wrap;gap:4px 6px;min-height:28px;}
.api-name{font-size:13.5px;font-weight:700;color:var(--ink);}
.api-name.brand{color:var(--brand-ink);text-transform:uppercase;letter-spacing:.1px;}
.k-im .api-name.brand{text-transform:none;}
.api-help{color:var(--ink-faint);font-size:13px;cursor:help;display:inline-flex;}
.api-dose{font-size:13px;color:var(--ink-soft);}
.api-dose b{color:var(--ink);}
.api-st{display:inline-flex;align-items:center;font-size:11.5px;font-weight:600;padding:1px 8px;border-radius:4px;border:1px solid var(--line);background:var(--line-soft);color:var(--ink-soft);line-height:1.5;}
.api-st.ok{border-color:var(--green-line,#a9dcbf);background:var(--green-soft);color:var(--green);}
.api-st.pend{border-color:#ff69b44d;background:#ff69b41a;color:#ff69b4;}
.k-au .api-st.pend{border-color:var(--amber-line,#f0d49a);background:var(--amber-soft);color:var(--amber);}
.api-st.wide{min-width:96px;justify-content:center;}
.api-st.lav{border-color:#d9cdf5;background:#f3effc;color:#8a74c9;}
.api-st.bad{border-color:var(--rose-line);background:var(--rose-soft);color:var(--rose);}
.api-st.muted{color:var(--ink-faint);}
.api .apd-ico{width:26px;height:26px;font-size:13px;}
.api .apd-ico.on{color:var(--brand);}
.api-right{margin-left:auto;display:inline-flex;align-items:center;gap:4px;}
.api-lang{font-size:12px;font-weight:600;padding:1px 9px;border-radius:4px;border:1px solid #d9cdf5;background:#f3effc;color:#6f5bb5;}
.api-sub{font-size:12.5px;color:var(--ink-soft);margin:0 0 2px;line-height:1.45;display:flex;flex-wrap:wrap;align-items:center;gap:4px 6px;}
.api-dim{color:var(--ink-faint);}
.api-text{color:var(--ink);font-size:13px;}
.api-prev{display:inline-flex;align-items:center;gap:6px;background:var(--line-soft);border-radius:5px;padding:4px 8px;}
.api-menu{min-width:180px;}
