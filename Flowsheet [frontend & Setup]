<script>
/* =====================================================================
   [v4] Left panel status icons (every section, every tab):
     Filled by someone else -> teal user-pen   (existing data: MA "Filled by" map + legacy "Filled by" header lines)
     Saved by current user  -> green floppy    (set only when Save & Next completes its save)
     Reviewed by me         -> existing reviewed icon (.vrv-nav, unchanged)
   They can show together and stay through section / tab changes. Selection is the #264e82 line only.
   ===================================================================== */
(function(){
  var ME = 'Dr. Gyllenhaal', SAVED = {}, IN = null, HDR = {};
  window.VN_SAVED_BY_ME = SAVED;
  function esc(s){ return String(s).replace(/[&<>"]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }
  function stamp(){ try{ return fmtNowStamp(); }catch(e){ return new Date().toLocaleString(); } }
  function otherUser(k){
    var M = window.VN_FILLED_BY || {};
    if(M[k]) return (typeof VNF_STATE !== 'undefined' && VNF_STATE[k]) ? 'Filled by ' + M[k] : '';   /* same rule as the MA Record badges */
    if(!(k in HDR)){   /* legacy "Filled by <user> · <time>" header line (static in the note) */
      var m = document.querySelector('#sec-' + k + ' > .card-hd .hdr-filled, #sec-' + k + ' > .card-hd .meta');
      var t = m ? m.textContent.replace(/\s+/g, ' ').trim() : '';
