  function icon(cls, tip, ico){ return '<span class="vst ' + cls + '" role="img" tabindex="0" aria-label="' + esc(tip) + '" aria-describedby="pbiTooltip" data-tt="' + esc(tip) + '"><i class="fa-solid ' + ico + '" aria-hidden="true"></i></span>'; }
  function put(it, cls, tip, ico){
    var el = it.querySelector(':scope > .' + cls);
    if(!tip){ if(el){ if(typeof hidePbiTooltip === 'function' && el.matches(':hover,:focus')) hidePbiTooltip(); el.remove(); } return; }
    if(el && el.getAttribute('data-tt') === tip) return;
    var tmp = document.createElement('span'); tmp.innerHTML = icon(cls, tip, ico); var n = tmp.firstChild;
    if(el) el.replaceWith(n); else it.appendChild(n);
    if(typeof bindPbiTooltip === 'function') bindPbiTooltip(n);
  }
  function paint(k){
    if(!k) return;
    var o = reviewed(k) ? '' : otherUser(k), s = SAVED[k] ? 'Saved by ' + ME + ' · ' + SAVED[k] : '';
    var card = document.getElementById('sec-' + k); if(card && card.classList.contains('vn-rv-done') !== reviewed(k)) card.classList.toggle('vn-rv-done', reviewed(k));
    document.querySelectorAll('.nav-item[data-key="' + k + '"]').forEach(function(it){
      put(it, 'vst-other', o, 'fa-user-pen');
      put(it, 'vst-saved', s, 'fa-floppy-disk');
    });
  }
  function all(){ var seen = {}; document.querySelectorAll('.nav-item[data-key]').forEach(function(it){ var k = it.getAttribute('data-key'); if(!seen[k]){ seen[k] = 1; paint(k); } }); }
  window.vnNavStatus = {refresh: paint, refreshAll: all};

  function init(){
    /* Save & Next: the existing save path calls vnActiveSaved(key) only after the section is saved
       (required-field / Accompanied by checks stop it before that) -> that is the success signal */
    var sn = window.saveAndContinueSection;
    if(typeof sn === 'function') window.saveAndContinueSection = function(k){
      var prev = IN; IN = k;
      try{ return sn.apply(this, arguments); } finally { IN = prev; }
    };
    try{ if(typeof saveAndContinueSection !== 'undefined') saveAndContinueSection = window.saveAndContinueSection; }catch(e){}
    var as = window.vnActiveSaved;
    window.vnActiveSaved = function(k){
      if(k && IN === k){ SAVED[k] = stamp(); paint(k); }
