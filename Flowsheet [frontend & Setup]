  function hoCard(h){
    var d = dxById(h.dx);
    return '<div class="ap-card"><div class="ap-card-top"><span class="ap-name">'+E(h.title)+'</span>'+(d ? '<span class="ap-tag link">for DX: '+E(dxLabel(d))+'</span>' : '')+'</div>'+
      '<div class="ap-fields">'+f('Given via', sel('via', h.id, ['Printed','Patient portal','Email'], h.via))+f('Associated diagnosis', '<select data-apf="dx" data-id="'+h.id+'">'+dxOptions(h.dx)+'</select>')+'</div>'+
      '<div class="ap-actions"><span class="spacer"></span>'+btn('ho-remove', h.id, 'Remove', '', 'Takes it off this visit; it can be restored')+
