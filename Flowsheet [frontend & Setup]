  /* ---------- Add New / Edit (inline, add_vital.png) ---------- */
  function opts(list, sel, blank){ return (blank ? '<option value="">'+e(blank)+'</option>' : '') + list.map(function(o){ return '<option'+(o === sel ? ' selected' : '')+'>'+e(o)+'</option>'; }).join(''); }
  function fv(k){ return (S.form.v[k] || [{}])[0] || {}; }
