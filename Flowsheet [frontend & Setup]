  };
  window.vqsClose = function(){
    var e = els(); if(!e.box || e.box.hidden) return;
    if(e.inp.value) e.clr.click();                         /* existing clear path: restores every question */
    e.box.hidden = true; e.btn.hidden = false; e.btn.setAttribute('aria-expanded','false');
    e.btn.focus(); arrows();
  };
  function init(){
    var e = els(); if(!e.inp) return;
    /* Esc: first clears the text (existing behaviour), a second Esc closes */
    e.inp.addEventListener('keydown', function(ev){ if(ev.key === 'Escape' && !e.inp.value){ ev.preventDefault(); vqsClose(); } });
    /* leaving an empty field folds it back to the icon */
    e.tool.addEventListener('focusout', function(){ setTimeout(function(){
      if(!e.tool.contains(document.activeElement) && !e.inp.value && !e.box.hidden){
        e.box.hidden = true; e.btn.hidden = false; e.btn.setAttribute('aria-expanded','false'); arrows();
