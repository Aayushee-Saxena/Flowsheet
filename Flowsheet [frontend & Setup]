    drugCheck: openDc, drugHistory: openDh,
    education: function(id){ var m = id ? byId(id) : null, d = m ? m.drug : ((document.getElementById('mxf-drug') || document.getElementById('mxp-drug') || {}).value || ''); toast(d ? 'Opening drug education for ' + d + '…' : 'Select a drug to view drug education.'); },
    toggleVisit: function(id){ var m = byId(id); if(!m) return; m.inVisit = !m.inVisit; commit(); toast(m.drug + (m.inVisit ? ' added to this visit.' : ' removed from this visit.')); },
