/* ---- Status system (SOAP left panel: 2-state completion + separate provider-review flag) ---- */
const SECTION_TITLES={cc:'Complaints',hpi:'HPI',ros:'Review of Systems',mh:'Past Medical History / Surgical History',medrec:'Medications',allergy:'Allergies',sh:'Social History',fh:'Family History',screen:'Screening Tools',vitals:'Vital Signs',pe:'Physical Exam Findings',results:'Results',problemlist:'Problem List',assess:'Diagnosis',clinimpression:'Clinical Impression',orders:'Orders',medchanges:'Medication Changes',patiented:'Patient Education',followup:'Follow-up',billing:'Superbill',attest:'Signoff',addendum:'Addendum'};
