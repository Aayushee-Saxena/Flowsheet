<script>
/* ==== [req 2] This Visit Summary: Vitals + Allergies (live from the form) ==== */
(function(){
  var ABBR={'Blood Pressure':'BP','Heart Rate':'Pulse','Weight':'Wt','BMI':'BMI','Temperature':'Temp',
            'Respiratory Rate':'RR','SpO₂':'SpO₂','Height':'Ht','Pain Score (0–10)':'Pain'};
  function esc(s){ return String(s).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];}); }
  function renderTvsVitals(){
    var out=document.getElementById('tvsVitals'); if(!out) return;
    var block=document.getElementById('vitals-questionnaire-block'); /* may be inside the Form Window */
    var rows=[];
    if(block) block.querySelectorAll('.cx-field').forEach(function(f){
      var lb=f.querySelector('label'), inp=f.querySelector('input,select,textarea');
      if(!lb||!inp) return;
      var val=(inp.value||'').trim(); if(!val) return;          /* only vitals actually recorded */
      var full=lb.textContent.replace('*','').trim();
      rows.push('<div class="tvs-vt" title="'+esc(full)+': '+esc(val)+'"><div class="k">'+esc(ABBR[full]||full)+'</div><div class="v">'+esc(val)+'</div></div>');
    });
    out.innerHTML = rows.length ? rows.join('') : '<div class="tvs-empty">No vitals recorded for this visit yet.</div>';
  }
  function renderTvsAllergies(){
    var out=document.getElementById('tvsAllergies'), cnt=document.getElementById('tvsAllergyCount'); if(!out) return;
    var list=document.getElementById('allergyRecordsList'), nka=document.getElementById('allergyNkaBanner');
    if(nka && !nka.hidden){ out.innerHTML='<div class="tvs-nka-msg">Patient has no known allergies.</div>'; if(cnt) cnt.textContent=''; return; }
    /* [req 4] Allergy | Reaction | Type of Allergy | Date -- plain table, no red; current-visit rows first */
    var rows=[];
    if(list) list.querySelectorAll('.allergy-entry').forEach(function(e){
      var key=e.getAttribute('data-allergy-key')||'';
      var nm=e.querySelector('.allergy-name'); if(!nm||!nm.textContent.trim()) return;
      var meta=e.querySelector('.allergy-entry-meta');
      var cat=document.getElementById('qe-'+key+'-category');
      var type=(cat&&cat.value)||'';
      type=type.replace(/\s+Allergy$/,'');                       /* "Drug Allergy" -> "Drug" */
      var cur=e.getAttribute('data-this-visit')==='1';
      rows.push({cur:cur,html:'<tr class="'+(cur?'is-cur':'')+'"><td class="al-nm">'+esc(nm.textContent.trim())+'</td><td>'+esc(e.getAttribute('data-reaction')||'—')+'</td><td>'+esc(type||'—')+'</td><td class="al-dt"><span class="mono">'+esc(fmtDisp(meta?meta.getAttribute('data-added-date'):''))+'</span><span class="tvs-when">'+(cur?'This visit':'Previous')+'</span></td></tr>'});
    });
    rows.sort(function(a,b){ return (b.cur?1:0)-(a.cur?1:0); });
    out.innerHTML = rows.length ? '<table class="tvs-tbl"><thead><tr><th>Allergy</th><th>Reaction</th><th>Type</th><th>Date</th></tr></thead><tbody>'+rows.map(function(r){return r.html;}).join('')+'</tbody></table>' : '<div class="tvs-empty">No allergies recorded.</div>';
    if(cnt) cnt.textContent = rows.length ? rows.length : '';
  }
  var MON=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  /* "25 Sep 2026" / "18 Sept 2026" -> "Sep 25, 2026" */
  function fmtDisp(s){
    var m=/(\d{1,2})\s+([A-Za-z]+)\.?\s+(\d{4})/.exec(s||''); if(!m) return s||'—';
    var i=MON.indexOf(m[2].slice(0,1).toUpperCase()+m[2].slice(1,3).toLowerCase());
    return (i>-1?MON[i]:m[2])+' '+m[1]+', '+m[3];
  }
  window.tvsFmtDisp=fmtDisp;
  window.renderTvsVitals=renderTvsVitals; window.renderTvsAllergies=renderTvsAllergies;
  function init(){
    /* the allergy recorded during this visit carries today's date (same convention as saveDxNew) */
    document.querySelectorAll('#allergyRecordsList .allergy-entry[data-this-visit="1"]').forEach(function(e){
      var meta=e.querySelector('.allergy-entry-meta'); if(!meta||typeof fmtTodayLong!=='function') return;
      var old=meta.getAttribute('data-added-date')||'', t=fmtTodayLong();
      meta.setAttribute('data-added-date',t); meta.textContent=meta.textContent.replace(old,t);
    });
    renderTvsVitals(); renderTvsAllergies();
    /* vitals: any edit in the Vital Signs fields (in the card or in its Form Window) */
    ['input','change'].forEach(function(t){ document.addEventListener(t,function(ev){
      if(ev.target && ev.target.closest && ev.target.closest('#vitals-questionnaire-block')) renderTvsVitals();
    }); });
    /* reset / commit hooks (Reset restores the block's innerHTML without input events) */
    if(typeof onSectionFieldCommitted==='function'){
      var orig=onSectionFieldCommitted;
      window.onSectionFieldCommitted=onSectionFieldCommitted=function(key){ var r=orig.apply(this,arguments);
        if(key==='vitals') renderTvsVitals(); if(key==='allergy') renderTvsAllergies(); return r; };
    }
    /* allergies: add / quick edit / delete / NKA all mutate the records area */
    var wrap=document.getElementById('allergy-questionnaire-block'); /* survives Reset (innerHTML swap) */
    if(wrap && window.MutationObserver) new MutationObserver(function(){ renderTvsAllergies(); })
      .observe(wrap,{subtree:true,childList:true,characterData:true,attributes:true,attributeFilter:['hidden']});
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',init); else init();
})();
</script>

<script>
/* ==== [req 4] Visit Note Summary -> Diagnosis: the patient's previous diagnoses
   (history, from prior visits) with "Move to This Visit". Moving copies the
   diagnosis into this visit's Diagnosis (A&P / DX) section using the same row
   template/cloning path as "Add new" (saveDxNew), and associates it with today's
   visit. History rows are never removed. A diagnosis whose code is already on
   today's visit is shown as "In This Visit" and cannot be added twice; if it is
   on the patient's DX list but not yet on the visit, it is associated instead of
   duplicated. ==== */
var PREV_DX=[
  {code:'A90',   name:'Dengue fever [classic dengue]',                 date:'Jun 10, 2026', status:'Active',   category:'Infectious Disease', verification:'Confirmed'},
  {code:'J20.9', name:'Acute bronchitis, unspecified',                 date:'Jul 15, 2025', status:'Resolved', category:'Respiratory',        verification:'Confirmed'},
  {code:'I10',   name:'Essential (primary) hypertension',              date:'Jan 15, 2025', status:'Active',   category:'Cardiovascular',     verification:'Confirmed'},
  {code:'E11.9', name:'Type 2 diabetes mellitus without complications',date:'Aug 20, 2024', status:'Active',   category:'Endocrine',          verification:'Confirmed'}
];
function tvsDxRows(code){
  var list=document.getElementById('assess-dx-list'); if(!list) return [];
  return [].slice.call(list.querySelectorAll('.dx-entry')).filter(function(e){
    var k=e.getAttribute('data-dx-key'), c=document.getElementById(k+'-code-display');
    return c && c.textContent.trim().toUpperCase()===code.toUpperCase();
  });
}
function tvsDxInVisit(code){
  return tvsDxRows(code).some(function(e){ var b=document.getElementById(e.getAttribute('data-dx-key')+'-visit-badge'); return b && b.classList.contains('on'); });
}
function renderTvsDx(){
  var out=document.getElementById('tvsDx'), cnt=document.getElementById('tvsDxCount'); if(!out) return;
  function esc(s){ return String(s).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];}); }
  out.innerHTML=PREV_DX.map(function(d,i){
    var inV=tvsDxInVisit(d.code);
    var act=inV
      ? '<button type="button" class="btn btn-xs is-done" onclick="goToSection(\'assess\')" title="Already on this visit — go to Diagnosis"><i class="icon fa-solid fa-check" aria-hidden="true"></i><span>In This Visit</span></button>'
      : '<button type="button" class="btn btn-xs" onclick="moveDxToVisit('+i+')" title="Add this diagnosis to this visit\'s Diagnosis (A&amp;P)"><i class="icon fa-solid fa-arrow-right-to-bracket" aria-hidden="true"></i><span>Move to This Visit</span></button>';
    return '<div class="tvs-dx-row" data-code="'+esc(d.code)+'"><div class="tvs-dx-main"><span class="prob-code">'+esc(d.code)+'</span><span class="tvs-dx-nm">'+esc(d.name)+'</span>'+
      '<div class="tvs-dx-sub"><span class="mono">'+esc(d.date)+'</span> · '+esc(d.status)+' · '+esc(d.category)+'</div></div><div class="tvs-dx-act">'+act+'</div></div>';
  }).join('');
  if(cnt) cnt.textContent=PREV_DX.length;
}
function moveDxToVisit(i){
  var d=PREV_DX[i]; if(!d) return;
  if(tvsDxInVisit(d.code)){ toast(d.code+' is already on this visit.'); renderTvsDx(); return; }
  var existing=tvsDxRows(d.code)[0];
  if(existing){                                   /* on the DX list but not the visit: associate, don't duplicate */
    toggleAddToVisit(existing.getAttribute('data-dx-key'));
  } else {
    var g=function(id){ return document.getElementById(id); };
    var templateSrc=document.querySelector('#assess-dx-list .dx-entry') || document.querySelector('.dx-entry');
    if(!templateSrc || typeof cloneDxRow!=='function'){ toast('Could not move diagnosis — no template row available.'); return; }
    dxRowSeq++;
    var newKey='dx-'+dxRowSeq;
    var clone=cloneDxRow(templateSrc.getAttribute('data-dx-key'), newKey);
    if(!clone){ toast('Could not move diagnosis.'); return; }
    var list=g('assess-dx-list'); list.hidden=false; list.appendChild(clone);
    var cd=g(newKey+'-code-display'); if(cd) cd.textContent=d.code;
    var nd=g(newKey+'-name-display'); if(nd) nd.textContent=d.name;
    var sp=g(newKey+'-status-pill'); if(sp) sp.textContent=d.status;
    var badge=g(newKey+'-visit-badge'), avb=g(newKey+'-addvisit-btn');
    if(badge){ badge.classList.remove('on'); badge.innerHTML='<i class="fa-solid fa-list" aria-hidden="true"></i>Master List'; }
    if(avb){ avb.innerHTML='<i class="icon fa-solid fa-calendar-plus" aria-hidden="true"></i><span>Add to this visit</span>'; }
    var today=fmtTodayLong();
    var meta=g(newKey+'-meta-display');
    if(meta){ meta.textContent=[d.status,d.category,d.verification,today].filter(Boolean).join(' · '); meta.setAttribute('data-added-date',today); }
    if(typeof setSegByValue==='function') setSegByValue('qe-'+newKey+'-status', d.status);
    var qv=g('qe-'+newKey+'-verification'); if(qv) qv.value=d.verification;
    toggleAddToVisit(newKey);                     /* now a diagnosis for the current visit */
    var emptyNote=g('dxEmptyNote'); if(emptyNote) emptyNote.style.display='none';
  }
  markPartial('assess');
  setStatus('assess','complete');
  onSectionFieldCommitted('assess');
  renderTvsDx();
  toast(d.code+' – '+d.name+' moved to this visit.');
}
(function(){
  function init(){
    renderTvsDx();
    var list=document.getElementById('assess-dx-list');   /* keeps button state in sync with the DX section */
    if(list && window.MutationObserver) new MutationObserver(function(){ renderTvsDx(); })
      .observe(list,{subtree:true,childList:true,characterData:true,attributes:true,attributeFilter:['class']});
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',init); else init();
})();
</script>

