  /* ---- DX ---- */
  function planItems(d){
    var items = [];
    AP.rx.forEach(function(m){ if(m.dx===d.id && !m.removed) items.push({t:'rx', id:m.id, txt: m.name + (m.sig ? ' — '+m.sig : '') + (m.qty ? ' · Qty '+m.qty : '') + (m.ref ? ' · Refills '+m.ref : '')}); });
    AP.ho.forEach(function(h){ if(h.dx===d.id && !h.removed) items.push({t:'ho', id:h.id, txt: h.title + (h.via ? ' ('+h.via+')' : '')}); });
    AP.fu.forEach(function(x){ if(x.dx===d.id && !x.removed) items.push({t:'fu', id:x.id, txt: fuText(x)}); });
    d.plans.forEach(function(p){ items.push({t:p.t, id:p.id, txt:p.txt}); });
    return items;
  }
  function planForm(d){
    var pf = AP.pform[d.id]; if(!pf) return '';
