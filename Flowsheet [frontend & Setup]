<script>
/* ==================================================================
   VN DOCUMENT VIEWER — adapter for the "compact search nav" Visit Note
   (visit-note-compact-search-nav-v4-ros-locked.html)
   ------------------------------------------------------------------
   Same behaviour as G#30 in the VN gallery, wired to THIS page:

   * Left icon  — in the section list header (.nav-cx, beside expand /
     collapse all). Opens the documents over the LEFT side: the section
     list + the form (#navrail … #center). The right icon becomes the
     widget search.
   * Right icon — in the "Visit Note Summary" header at the top of the
     summary pane (#sectionSummaryPanel), made sticky so it is always
     at the top. Opens the documents over the RIGHT side: the summary
     pane only. The left icon becomes the widget search, as a full row
     in the section list header (the same place this page's own
     "Search sections" row opens).
   * The modal is position:fixed and re-measured every frame while
     open, so it stays exactly the box of its side through the two
     splitters, window resizes and the narrow-screen slide-overs. The
     right toolbar column (#toolsdock) is never covered.
   * Widget search lists every section card on every Visit Note tab
     (VNT_TABS); picking one switches tab (vntSwitch), clicks that
     section's own nav item, scrolls the summary to its row and
     flashes both — without closing the documents.

   Needs: vndocs.core.js, vndocs.core.css (as <style id="vdCss">),
   vndocs.data.renata.js. Touches nothing of the page's own code.
   ================================================================== */
(function(){
  if (!window.VDocs || !window.VD_DATA) return;
  const $ = (s, r) => (r || document).querySelector(s);
  const D = window.VDocs;
  const M = D.modal, SR = D.search;
  let side = null, raf = 0, last = '';

  /* ---------- what the search lists, and how it navigates ---------- */
  const tabs = () => (window.VNT_TABS || []).filter(t => t.id !== 'summary');
  function titleOf(cid){
    const it = document.querySelector(`.nav-item[data-target="${cid}"]`);
    if (it){ const nm = it.querySelector('.nm'); return (it.getAttribute('title') || (nm && nm.textContent) || '').trim(); }
    const c = document.getElementById(cid), h = c && c.querySelector('h2,h3,.card-title,.ttl');
    return h ? h.textContent.trim() : cid.replace(/^sec-/, '');
  }
  function widgets(){
    const out = [], seen = new Set(), cur = window.vntActive;
    tabs().forEach(t => (t.cards || []).forEach(cid => {
      if (cid.indexOf('sec-') !== 0 || seen.has(cid)) return;
      seen.add(cid); out.push({ id: cid, t: titleOf(cid), m: t.name, here: t.id === cur });
    }));
    /* the current tab's sections first, then every other tab in tab order */
    return out.filter(w => w.here).concat(out.filter(w => !w.here));
  }
  function flash(el){ if (!el) return; el.classList.remove('vd-flash'); void el.offsetWidth; el.classList.add('vd-flash'); }
  function go(cid){
    const cur = window.vntActive;
    const t = tabs().find(x => x.id === cur && x.cards.includes(cid)) || tabs().find(x => x.cards.includes(cid));
    if (t && t.id !== cur && typeof window.vntSwitch === 'function') window.vntSwitch(t.id);
    requestAnimationFrame(() => {
      const it = document.querySelector(`#navBody .nav-item[data-target="${cid}"]`);
      if (it) it.click(); else if (typeof window.jump === 'function') window.jump(cid);
      const card = document.getElementById(cid);
      if (card && card.classList.contains('collapsed')){ const t = card.querySelector('.card-hd,.card-head,header'); if (t) t.click(); }
      flash(card);
      /* the summary keeps a row per section — bring it into view too */
      const key = cid.slice(4), sp = document.getElementById('sectionSummaryPanel');
      const row = document.getElementById('vns-sec-' + key) || document.querySelector(`#sectionSummaryPanel .ssum-sec[data-key="${key}"]:not(.vnt-off)`);
      if (row && sp && side !== 'right' && row.getBoundingClientRect().height > 0){
        const top = sp.scrollTop + row.getBoundingClientRect().top - sp.getBoundingClientRect().top - 46;
        sp.scrollTo({ top: Math.max(0, top), behavior: 'smooth' }); flash(row); }
    });
  }

  /* ---------- icons ---------- */
  function iconBtn(id, which){
    const b = document.createElement('button');
    b.type = 'button'; b.id = id; b.className = 'btn btn-xs vd-hic';
    b.setAttribute('aria-label', 'Documents — open on the ' + which + ' side');
    b.setAttribute('data-tt', which === 'left' ? 'Documents — open over the form, keep the summary' : 'Documents — open over the summary, keep the form');
    b.setAttribute('aria-describedby', 'pbiTooltip');
    b.innerHTML = D.icon.docs;
    b.addEventListener('click', () => D.open(which));
    if (typeof window.bindPbiTooltip === 'function') try { window.bindPbiTooltip(b); } catch(e){}
    return b;
  }
  const navHd = () => $('#navrail .nav-hd');
  const navCx = () => $('#navrail .nav-cx');
  const sumHd = () => $('#sectionSummaryPanel .ssum-panel-hd');
  function sumSlot(){
    const hd = sumHd(); if (!hd) return null;
    hd.classList.add('vd-hd-host');
    let s = hd.querySelector(':scope > .vd-hdslot');
    if (!s){ s = document.createElement('span'); s.className = 'vd-hdslot'; hd.appendChild(s); }
    return s;
  }
  function place(){
    const cx = navCx(), slot = sumSlot();
    if (!side || side === 'fs'){
      if (SR.isConnected) SR.remove();
      if (cx && !$('#vdIcL')) cx.insertBefore(iconBtn('vdIcL', 'left'), cx.firstChild);
      if (slot && !$('#vdIcR')) slot.appendChild(iconBtn('vdIcR', 'right'));
      const h = navHd(); if (h) h.classList.remove('vd-searching');
      return;
    }
    ['vdIcL', 'vdIcR'].forEach(id => { const e = document.getElementById(id); if (e) e.remove(); });
    if (side === 'right'){
      const h = navHd(); if (h){ h.classList.add('vd-searching'); if (SR.parentElement !== h) h.appendChild(SR); }
    } else if (slot && SR.parentElement !== slot){ slot.appendChild(SR); }
  }

  /* ---------- the modal: exactly the box of its side, every frame ---------- */
  const shown = el => { if (!el) return null; const cs = getComputedStyle(el); if (cs.display === 'none' || cs.visibility === 'hidden') return null;
    const r = el.getBoundingClientRect(); if (r.width < 2 || r.height < 2 || r.right <= 0 || r.left >= innerWidth) return null;
    if (cs.position === 'fixed' && !el.classList.contains('open')) return null; return r; };
  function box(){
    if (side === 'fs'){             /* over the Flowsheet window it was opened from */
      const p = document.querySelector('#fsScrim:not([hidden]) > .overlay-panel');
      return { r: shown(p), fixed: true, top: true };
    }
    if (side === 'right'){
      const sp = document.getElementById('sectionSummaryPanel');
      if (sp && getComputedStyle(sp).position === 'fixed' && !sp.classList.contains('open')) sp.classList.add('open');   /* narrow screens: the summary is a slide-over */
      return { r: shown(sp), fixed: sp && getComputedStyle(sp).position === 'fixed' };
    }
    const rs = ['navrail', 'vnSplitL', 'center'].map(id => shown(document.getElementById(id))).filter(Boolean);
    if (!rs.length) return { r: null };
    const L = Math.min(...rs.map(r => r.left)), T = Math.min(...rs.map(r => r.top)),
          R = Math.max(...rs.map(r => r.right)), B = Math.max(...rs.map(r => r.bottom));
    return { r: { left: L, top: T, width: R - L, height: B - T }, fixed: false };
  }
  function follow(){
    raf = 0; if (!side) return;
    const b = box();
    if (b.r){
      const k = [b.r.left, b.r.top, b.r.width, b.r.height].map(Math.round).join(',') + (b.fixed ? 'f' : '');
      if (k !== last){
        last = k;
        Object.assign(M.style, { left: Math.round(b.r.left) + 'px', top: Math.round(b.r.top) + 'px',
          width: Math.round(b.r.width) + 'px', height: Math.round(b.r.height) + 'px', display: '', zIndex: b.top ? 2147483000 : b.fixed ? 76 : 65 });
        D.fit();
      }
    } else if (M.style.display !== 'none'){ M.style.display = 'none'; last = ''; }
    place();
    raf = requestAnimationFrame(follow);
  }

  /* ---------- wiring ---------- */
  D.init({
    data: window.VD_DATA, folder: 'Visit Note', widgets, go,
    onOpen(s){
      side = s; M.classList.add('vd-fixed'); M.dataset.side = s;
      if (M.parentElement !== document.body) document.body.appendChild(M);
      last = ''; place(); if (!raf) raf = requestAnimationFrame(follow);
    },
    onClose(){
      side = null; if (raf) cancelAnimationFrame(raf); raf = 0; last = '';
      if (M.isConnected) M.remove(); place();
    }
  });
  /* the page rewrites the summary header's text on its document toggle — put the icon back */
  function watch(){
    const hd = sumHd(); if (hd) new MutationObserver(() => place()).observe(hd, { childList: true });
    const nh = navHd(); if (nh) new MutationObserver(() => place()).observe(nh, { childList: true });
    place();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', () => setTimeout(watch, 0)); else setTimeout(watch, 0);
  window.vdDocs = { open: D.open, close: D.close, state: D.state, side: () => side, show: D.show };
  /* opened over the Flowsheet: Esc closes the document, not the Flowsheet */
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && side === 'fs'){ e.preventDefault(); e.stopImmediatePropagation(); D.close(); } }, true);
})();

</script>

