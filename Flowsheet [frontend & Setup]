function genField(k){return document.querySelector(`#defFields [data-k="${k}"]`);}
function genVal(k){const el=genField(k);return !el?'':el.type==='checkbox'?el.checked:(el.value||'').trim();}
function genInt(s){return /^\d+$/.test(String(s))?+s:NaN;}
function genErrors(){
 const e={};
 if(!catGeneral())return e;
 const n=genVal('vncount');
 if(n!==''){const v=genInt(n);
  if(isNaN(v))e.vncount='Whole number only';
  else if(v<VN_COUNT.min||v>VN_COUNT.max)e.vncount=`Between ${VN_COUNT.min} and ${VN_COUNT.max}, or empty for all`;}
 const a=genVal('agefrom'),b=genVal('ageto');
 const av=a===''?null:genInt(a),bv=b===''?null:genInt(b);
 if(a!==''&&(isNaN(av)||av<AGE.min||av>AGE.max))e.agefrom=`${AGE.min}–${AGE.max} years`;
 if(b!==''&&(isNaN(bv)||bv<AGE.min||bv>AGE.max))e.ageto=`${AGE.min}–${AGE.max} years`;
 if(!e.agefrom&&!e.ageto&&av!==null&&bv!==null&&av>bv)e.ageto='“To” must be ≥ “From”';
