/* ---------------- grid ---------------- */
function cellHTML(r,v){
 if(r.pdoc&&!labMode)return pdocCell(r,v);
 if(r.lobs&&!labMode){const x=lobsCell(r,v,visits());if(x)return x;}
 const c=(V[r.id]&&V[r.id][v.id])||{v:'',by:'—',at:'—',src:'—'};
 const val=fmt(r,c),bad=oor(r,c.v),sv=esc(val);
 const title=esc(`${r.lbl} · ${v.vn} ${v.d}\nsource: ${c.src}\nentered by: ${c.by} at ${c.at}${r.note?'\n'+r.note:''}`);
 const ro=!r.ed||!CFG.editable;
 const cls=`fscell${ro?' fs-ro':''}${bad?' fs-oor':''}${c.ch?' fs-chg':''}${(r.t==='rta'||r.t==='multi')?' fs-txt':''}`;
 const A=`'${r.id}','${v.id}'`,lab=esc(r.lbl+' '+v.vn);
 const empty=t=>`<span class="fs-empty">${t}</span>`;
 let inner;
 if(ro){
  const hl=bad&&r.lab?(r.hi!==undefined&&+c.v>r.hi?'H':'L'):'';
  inner=`<div class="${cls}" title="${title}${hl?' · '+(hl==='H'?'High':'Low'):''}">${sv||empty('—')}${hl?`<span class="fs-flag" aria-label="${hl==='H'?'High':'Low'}">${hl}</span>`:''}</div>`;
 }else if(r.t==='checkbox'){
  inner=`<div class="${cls} fs-chkwrap"><input type="checkbox" ${c.v?'checked':''} aria-label="${lab}" onchange="FS.setV(${A},this.checked)" title="${title}"/></div>`;
 }else if(r.t==='select'||r.t==='capsule'){
  inner=`<select class="${cls}" title="${title}" aria-label="${lab}" onchange="FS.setV(${A},this.value)">${(r.opts||['']).map(o=>`<option ${o===c.v?'selected':''}>${esc(o)}</option>`).join('')}</select>`;
 }else if(r.t==='multi'){
  inner=`<button type="button" class="${cls}" title="${title}" onclick="FS.multi(${A})">${sv||empty('select…')}</button>`;
 }else if(r.t==='rta'){
  inner=`<button type="button" class="${cls} fs-ellip" title="${title}" onclick="FS.note(${A})">${val?esc(String(val).slice(0,26))+(String(val).length>26?'…':''):empty('write…')}</button>`;
 }else if(r.t==='doc'){
  inner=`<button type="button" class="${cls}" title="${title}" onclick="FS.doc(${A})">${val?`<span class="fs-doclink">${sv}</span>`:empty('attach…')}</button>`;
 }else if(r.t==='date'){
  inner=`<input class="${cls}" value="${sv}" placeholder="mm/dd/yy" title="${title}" aria-label="${lab}" onchange="FS.setV(${A},this.value)"/>`;
 }else{
  inner=`<input class="${cls}" value="${sv}" title="${title}" aria-label="${lab}" onchange="FS.setV(${A},this.value)"/>`;
 }
 const drill=r.drill?`<span class="fs-drill" title="Double-click to open the ${r.drill} editor">⤢</span>`:'';
 const dot=(c.v!==''&&c.v!==false)?'<span class="fs-provdot"></span>':'';
 return `<td class="fs-cellwrap"${r.drill?` ondblclick="FS.drill('${r.drill}',${A})"`:''}>${inner}${dot}${drill}</td>`;
}

function render(){
 const grid=$('fsGrid');if(!grid)return;
 const vis=visits(),showEmpty=$('fsEmpty').checked;
 const sl=grid.scrollLeft,st=grid.scrollTop;
 let h='';
 if(ori==='rows'){
  h=`<table class="fst"><thead><tr><th class="fs-rl">Row <span class="fs-thnote">(${vis.length} visits · scroll →)</span></th>`+
   vis.map(v=>{const act=ACT[v.id],mine=mineCount(v.id);
    const marks=(mine?`<span class="fs-hmark fs-mine" title="${mine} unsaved change${mine===1?'':'s'} by you in this visit"></span>`:'')
      +(act?`<span class="fs-hmark fs-other" title="${act.n} change${act.n===1?'':'s'} by ${act.who} · ${act.when} — ${act.what}"></span>`:'');
    return `<th${v.cur?' class="fs-cur"':''}><div class="fs-hcell"><a href="#" onclick="FS.flash('Opens ${v.vn} in the note');return false">${v.vn}</a>${marks}</div><div class="fs-hsub">${v.d}${sameDay(v)?`<span class="fs-htime" title="More than one visit on this date — time shown to tell them apart">${v.t}</span>`:''}${v.cur?'<span class="fs-hcur">current</span>':''}</div></th>`;}).join('')+'</tr></thead><tbody>';
  GROUPS.forEach(g=>{
   const rows=g.rows.filter(r=>rowOn(r)&&(showEmpty||hasData(r.id,vis)));
   if(!rows.length&&(!showEmpty||labMode))return;
   h+=`<tr class="fs-gp"><td class="fs-rl"><button type="button" class="fschev${g.open?' fs-op':''}" onclick="FS.tg('${g.id}')" aria-expanded="${g.open}" aria-label="${g.open?'Collapse':'Expand'} ${esc(g.label)}">▶</button> ${esc(g.label)}</td><td colspan="${vis.length}" class="fs-gpmeta">&nbsp;${g.src} · ${rows.length} row${rows.length===1?'':'s'}</td></tr>`;
   if(g.open)lobsOrder(rows).forEach(it=>{
    if(it.test){h+=`<tr class="fs-lt"><td class="fs-rl"><span class="fs-ltname">${esc(it.test)}</span><span class="fs-ltcfg" title="Flowsheet Setup → Lab display settings">${esc(it.cfg)}</span></td><td colspan="${vis.length}" class="fs-gpmeta"></td></tr>`;return;}
    const r=it.row;
    const lbl=`<td class="fs-rl${it.sub?' fs-ltrow':''}"><div class="fs-rowlbl"><span class="fs-nm">${esc(r.lbl)}</span>${r.u?`<span class="fs-un">${esc(r.u)}</span>`:''}${r.ref?`<span class="fs-un fs-ref" title="Reference range">ref ${esc(r.ref)}</span>`:''}${gtg(r)}${r.note?`<span class="fs-info" title="${esc(r.note)}">ⓘ</span>`:''}</div></td>`;
    if(isChart(r)){h+=`<tr class="fs-ichartrow">${lbl}<td class="fsichart" colspan="${vis.length}" data-row="${r.id}"></td></tr>`;return;}
    h+=`<tr>${lbl}`+vis.map(v=>cellHTML(r,v)).join('')+'</tr>';});
  });
  h+='</tbody></table>';
 }else{
  const rows=[];GROUPS.forEach(g=>{if(g.open)g.rows.filter(r=>rowOn(r)&&(showEmpty||hasData(r.id,vis))).forEach(r=>rows.push(r));});
  h=`<table class="fst"><thead><tr><th class="fs-rl">Visit</th>`+rows.map(r=>`<th>${r.test?`<span class="fs-thnote">${esc(r.test)}</span><br>`:''}${esc(r.lbl)}<div class="fs-thnote">${esc(r.u||'')}${r.ref?' · ref '+esc(r.ref):''}</div></th>`).join('')+'</tr></thead><tbody>';
  vis.forEach(v=>{h+=`<tr><td class="fs-rl"><b>${v.vn}</b> <span class="fs-thnote">${v.d}</span>${sameDay(v)?`<span class="fs-htime" style="margin-left:5px">${v.t}</span>`:''}${v.cur?' <span class="fs-tb fs-tb-auto">current</span>':''}</td>`+rows.map(r=>cellHTML(r,v)).join('')+'</tr>';});
  h+='</tbody></table>';
 }
 if(labMode&&!vis.length)h=`<div class="fs-labempty" role="status"><i class="fa-solid fa-flask" aria-hidden="true"></i><b>No lab results in this case</b><span>Choose <b>All cases</b> in Case to see every visit.</span></div>`;
 else if(labMode&&labSel&&!labSel.size)h=`<div class="fs-labempty" role="status"><i class="fa-solid fa-vials" aria-hidden="true"></i><b>No lab tests selected</b><span>Use <b>Tests…</b> to choose what to compare.</span></div>`;
 grid.innerHTML=h;
 grid.scrollLeft=sl;grid.scrollTop=st;
 $('fsMeta').textContent=`${GROUPS.length} groups · ${GROUPS.reduce((a,g)=>a+g.rows.length,0)} rows · ${vis.length} of ${totalVisits()} visits shown`;
 $('fsPgTxt').textContent=`1 - ${vis.length} of ${totalVisits()} visits`;
 syncSeg();paintInline();annotate();
}

