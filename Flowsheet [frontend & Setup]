(function(){
  function complaintState(){
    var row = document.querySelector('#sec-painsx .pc-cx-row'); if(!row) return '';
    var on = row.querySelector('[data-pc-cx].on'); return on ? on.getAttribute('data-pc-cx') : '';
  }
  /* Complaints tab: Pain/Symptoms Complaint + Reason for Visit follow the No Complaints / Complaints choice */
  function complaintRule(){ var c = complaintState(); return c === 'no' ? 'hide' : c === 'yes' ? 'show' : 'content'; }
  var RULES = window.VN_SUMMARY_RULES = window.VN_SUMMARY_RULES || {};
  RULES.painsx = complaintRule;
  RULES.rfvisit = complaintRule;

  function mode(k){ var r = RULES[k]; try{ return r ? r(k) : 'show'; }catch(e){ return 'show'; } }
  function hasData(k){ try{ return (extractSectionFacts(k) || []).length > 0; }catch(e){ return false; } }
  window.vnSummaryApplicable = function(k){ var m = mode(k); return m === 'show' || (m === 'content' && hasData(k)); };

  /* Sections that stay in the left panel but are not listed in the summary PANEL for their tab.
     (VN General, Vital Signs and Allergies are already left out by the summary engine itself.)
     The compiled Document view is not affected. */
  var PANEL_EXCLUDE = window.VN_SUMMARY_PANEL_EXCLUDE = window.VN_SUMMARY_PANEL_EXCLUDE || {};
  /* Complaints tab: summary lists Pain/Symptoms Complaint + Reason for Visit only */
  PANEL_EXCLUDE.vngeneral = PANEL_EXCLUDE.vitals = PANEL_EXCLUDE.allergy = PANEL_EXCLUDE.medrec = 1;

  /* the selected tab's sections, read from the left panel the user sees (#navBody) */
  function navKeys(){
