/* =====================================================================
   ROW TYPE + CUSTOM FORM + QUESTIONNAIRE
   ---------------------------------------------------------------------
   Each row now carries a Type (what family of data it reads) and, for
   Custom Form rows, the form. Unit, precision, normal range and item
   type are inherited from the bound item and no longer set per row;
   editability is one flag for the whole flowsheet (General → Allow Editing Flowsheet).
   Type decides which source classes the picker offers; a Custom Form row
   is further scoped to its form's container.
   Custom forms are the 'Custom Form' containers of CAT — the setup's own
   catalogue. Nothing here invents a form or a question.
   ===================================================================== */
const ROW_TYPES=[
 {k:'vitals',l:'Vitals',          cls:['Vitals','Computed']},
 {k:'form',  l:'Custom Form',     cls:['Custom Form','Computed']},
 {k:'lab',   l:'Lab Observation', cls:['Lab Order']},
 {k:'pdoc',  l:'Patient Documents',cls:['Doc Category']},    /* replaces Ultrasound: the application's document categories */
 {k:'img',   l:'Medical Imaging', cls:['Document']},
 {k:'custom',l:'Custom Column',   cls:['Custom']}       /* no source: typed at each visit — configured with its own single choice (Text / Number / Date / Note) */
];
/* rows with no source family: custom columns and auto values */
const ROW_NA={Custom:'custom column',Auto:'auto value'};
const rowType=k=>ROW_TYPES.find(t=>t.k===k);
const FORMS=()=>(CAT['Custom Form']||[]).map(c=>c.c);
const formOf=path=>String(path||'').split(' -> ')[0].replace(/^sum\(/,'');
const rEsc=s=>String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');

/* seed Type / form for the rows that predate the field, from what they are bound to */
function rowSeedType(r){
 if(r.type!==undefined)return;
 r.type='';r.form='';
 if(r.src==='Custom'){r.type='custom';return;}
 if(ROW_NA[r.src])return;
 if(r.src==='Vitals')r.type='vitals';
 else if(r.src==='Lab Order')r.type='lab';
 else if(r.src==='Custom Form'){r.type='form';r.form=FORMS().includes(formOf(r.path))?formOf(r.path):'';}
 else if(r.src==='Computed'){const f=formOf(r.path);if(FORMS().includes(f)){r.type='form';r.form=f;}else r.type='vitals';}
 else if(r.src==='Doc Category')r.type='pdoc';
 else if(r.src==='Document')r.type='img';                     /* Ultrasound was retired: its document rows read as Medical Imaging */
}
function rowsSeed(){GROUPS.forEach(g=>g.rows.forEach(r=>{if(r.type==='us'){r.type=r.src==='Document'?'img':'';if(r.src==='Module')rowClear(r);}rowSeedType(r);}));}
/* a binding that no longer fits the row's Type / form is cleared, not kept silently */
function rowFits(r){
 if(!r.path||ROW_NA[r.src])return true;
 const t=rowType(r.type);if(!t||!t.cls.includes(r.src))return false;
 if(r.type==='form'&&r.form&&formOf(r.path)!==r.form)return false;
 return true;
}
function rowClear(r){r.path='';r.it='';r.src='';r.invalid=true;}
function setType(rid,v){const r=findRow(rid);if(!r)return;
 const was=r.type;
 r.type=rowType(v)?v:'';
 if(r.type!=='form')r.form='';                       /* no longer applicable */
 if(r.type==='custom'){                               /* a custom column: no source, a long-text note until another kind is chosen */
  if(r.src!=='Custom'||!CUSTOM.has(r.it)){r.src='Custom';r.path='Custom -> Note (long text)';r.it='cnote';r.dt='Long text';}
  r.invalid=false;
  fsToast('Custom column — typed at each visit. Pick Text, Number, Date or Note from its Source cell.');
 }else if(was==='custom'||r.src==='Custom'){rowClear(r);}
 else if(!rowFits(r)){rowClear(r);fsToast('Source cleared — it does not belong to the new Type. Pick one from the Source cell.');}
 renderGrid();dirty();}
function setForm(rid,v){const r=findRow(rid);if(!r)return;
 r.form=FORMS().includes(v)?v:'';
 if(!rowFits(r)){rowClear(r);}
 renderGrid();dirty();}

