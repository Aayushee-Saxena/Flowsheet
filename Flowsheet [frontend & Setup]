<script>
/* ==== Question search: open from the icon, close back to the icon ==== */
(function(){
  function els(){ return {tool:document.getElementById('vqsTool'), btn:document.getElementById('vqsToggle'), box:document.getElementById('vqsBox'),
                          inp:document.getElementById('vqsInput'), clr:document.getElementById('vqsClear')}; }
  function arrows(){ if(typeof vntUpdateArrows === 'function') setTimeout(vntUpdateArrows, 160); }
  window.vqsOpen = function(){
    var e = els(); if(!e.box) return;
    e.box.hidden = false; e.btn.hidden = true; e.btn.setAttribute('aria-expanded','true');
    if(typeof hidePbiTooltip === 'function') hidePbiTooltip();
