   +(n<=16?`<text x="${X(p[0]).toFixed(1)}" y="${(Y(p[1])-8).toFixed(1)}" text-anchor="middle" font-size="10" font-weight="600" style="fill:${bad?BAD:'var(--ink-soft)'}">${lbl}</text>`:'')+'</g>';
 }).join('');
