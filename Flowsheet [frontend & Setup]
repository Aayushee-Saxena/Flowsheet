function catDefaults(){
 const fields={};document.querySelectorAll('#defFields [data-k]').forEach(el=>{if(el.dataset.k!=='cat')fields[el.dataset.k]=el.type==='checkbox'?el.checked:el.value;});
 rowsSeed();
 const base=clone(GROUPS);
 CAT_KEYS.forEach(k=>{const f={};catKeys(k).forEach(x=>{f[x]=fields[x];});if('name' in f)f.name=catName(k);CAT_DEFAULT[k]={name:catName(k),fields:f,groups:[]};});
 CAT_DEFAULT.flowsheet.groups=base;
}

/* ---------- show only what the category uses ---------- */
function catApply(){
 const sp=catSpec();
 const keys=catKeys(CAT_CUR);
 document.querySelectorAll('#defFields .f').forEach(f=>{if(f.querySelector('#catSel'))return;
  const own=[...f.querySelectorAll('[data-k]')].map(e=>e.dataset.k).concat(f.dataset.for?[f.dataset.for]:[]);
  f.hidden=!own.some(k=>keys.includes(k));});
 const lab=document.getElementById('secLab');if(lab)lab.hidden=!sp.lab;
 document.querySelectorAll('.secchip[data-sec="secLab"]').forEach(c=>c.hidden=!sp.lab);
 const rows=document.getElementById('secRows');rows.hidden=!sp.rows;rows.classList.toggle('cat-vnc',catVnc());
 document.querySelectorAll('.secchip[data-sec="secRows"]').forEach(c=>c.hidden=!sp.rows);
 const t=document.getElementById('defTitle');
 if(t)t.textContent=catName(CAT_CUR);
 if(sp.lab)lcRender();
 secPaint();
}
function catPaintDirty(){
 const cur=sig(catCollect())!==sig(CAT_BASE[CAT_CUR]);
 document.getElementById('btnSave').disabled=!cur;document.getElementById('btnCancel').disabled=!cur;
 const sel=document.getElementById('catSel')||{options:[]};
 [...sel.options].forEach(o=>{const k=o.value,st=k===CAT_CUR?catCollect():CAT_STATE[k];
  const d=sig(st)!==sig(CAT_BASE[k]);
  o.textContent=CAT_SPEC[k].label+(d?' • unsaved':'');});
