<script>
/* =====================================================================
   [v4] Feature registry -- features kept in the code but switched off in the current UI
   (future requirements). Set a flag to true to bring the feature back; nothing else changes.
   ===================================================================== */
window.VN_FEATURES = {
  /* Visit Summary document: one part per Visit Note tab + the Sign Off block */
  summaryTabSections: {marecord: false, history: false, hx: false, screening: false, acp: false, billing: false},
  summarySignOff: false,
  /* right panel "This Visit Summary": one heading + note per Visit Note tab
     (MA Record, HPI, History, Screening Tools, Assessment & Care Plan, Billing & Care Coordination) and the Signoff block */
  summaryPanelTabHeadings: false,
  summaryPanelSignOff: false,
  /* AI suggestions */
  aiDiagnosisSuggestions: false,   /* Diagnosis -> "AI Suggested Diagnosis" */
  aiSignoffReview: false           /* Sign Off  -> "AI Pre-Sign-off Review" */
};
window.vnFeature = function(name, sub){
  var f = (window.VN_FEATURES || {})[name];
  if(f && typeof f === 'object') return sub === undefined ? true : f[sub] !== false;
  return f !== false;
};
(function(){   /* UI blocks tagged data-vn-feature="<name>" are shown only when their flag is on */
  var root = document.documentElement;
  Object.keys(window.VN_FEATURES).forEach(function(k){ if(window.VN_FEATURES[k] === true) root.classList.add('vnf-on-' + k); });
})();
</script>

