<script>
/* =====================================================================
   [v4] Left panel -- active section side border (replaces the pencil icon
   in the left panel). The bar shows only while the user has focus inside a
   section's editable content (middle panel or its Edit window). Selecting /
   opening / jumping to a section, or focus placed there by navigation, does
   not light it; typing or the user's own click / keyboard focus does.
   Save & Next (successful) clears it before the existing navigation runs.
   Filled / completed / reviewed indicators are untouched.
   ===================================================================== */
(function(){
  var ACTIVE = null, lastPtr = {t: 0, k: null}, lastKey = 0;
  function secKey(el){   /* section the element belongs to, editable or not */
    if(!el || !el.closest) return null;
    var b = el.closest('[id$="-questionnaire-block"]'); if(b) return b.id.replace(/-questionnaire-block$/, '');
    var f = el.closest('.overlay-scrim[id$="FormScrim"]'); if(f) return f.id.replace(/FormScrim$/, '');
    if(el.closest('#vsDetailScrim')) return 'vitals';
    var c = el.closest('#center .card[id^="sec-"]'); return c ? c.id.slice(4) : null;
  }
  function editKey(el){  /* section whose editable content holds el (header / Save & Next / reset bar excluded) */
    if(!el || el === document.body || !el.closest) return null;
    if(el.closest('[hidden], .vss-off, .vnt-parked, .ros-locked')) return null;
    if(el.closest('.card-hd, .sec-continue, .ssum-confirm')) return null;
    return secKey(el);
  }
  function userFocus(k, el){
    var now = Date.now();
    if(now - lastKey < 600) return true;                                  /* Tab / keyboard */
    if(now - lastPtr.t < 600 && lastPtr.k === k) return true;              /* clicked inside this section */
    return !!(el && el.closest && el.closest('.overlay-scrim[id$="FormScrim"], #vsDetailScrim'));   /* user-opened Edit window */
  }
  function paint(){
    document.querySelectorAll('.nav-item.vn-working').forEach(function(it){ if(it.getAttribute('data-key') !== ACTIVE) it.classList.remove('vn-working'); });
    if(ACTIVE) document.querySelectorAll('.nav-item[data-key="' + ACTIVE + '"]').forEach(function(it){ it.classList.add('vn-working'); });
    if(typeof window.masPaint === 'function') window.masPaint();
  }
  function set(k){ if(k !== ACTIVE){ ACTIVE = k; paint(); } }
  function refocus(){
    var el = document.activeElement, k = editKey(el);
    if(!k) return set(null);
    if(k === ACTIVE) return;
    set(userFocus(k, el) ? k : null);
  }
  window.vnActiveKey = function(){ return ACTIVE; };
  window.vnActiveSaved = function(k){ if(!k || ACTIVE === k) set(null); };
  function init(){
    document.addEventListener('pointerdown', function(e){ lastPtr = {t: Date.now(), k: secKey(e.target)}; }, true);
    document.addEventListener('keydown', function(e){ if(e.key === 'Tab' || e.key.length === 1 || /^Arrow/.test(e.key)) lastKey = Date.now(); }, true);
    document.addEventListener('focusin', function(){ setTimeout(refocus, 0); }, true);
    document.addEventListener('focusout', function(){ setTimeout(refocus, 0); }, true);
    document.addEventListener('input', function(e){ var k = editKey(e.target); if(k && k === editKey(document.activeElement)) set(k); }, true);   /* user started editing */
    var ss = window.saveAndContinueSummarySection;
    if(typeof ss === 'function') window.saveAndContinueSummarySection = function(key){ var r = ss.apply(this, arguments); window.vnActiveSaved(key); return r; };
    var sw = window.vntSwitch; if(typeof sw === 'function') window.vntSwitch = function(){ var r = sw.apply(this, arguments); setTimeout(refocus, 0); setTimeout(paint, 0); return r; };
    if(window.MutationObserver){   /* nav rebuilt -> re-apply the bar */
      var nb = document.getElementById('navBody'), t;
      if(nb) new MutationObserver(function(){ clearTimeout(t); t = setTimeout(function(){ if(ACTIVE && !document.querySelector('.nav-item.vn-working')) paint(); }, 0); }).observe(nb, {childList: true, subtree: true});
    }
  }
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function(){ setTimeout(init, 20); }); else setTimeout(init, 20);
})();
</script>

