  return {hasDx, emSelected, attested};
}
function updateSignState(){
  const {hasDx, emSelected, attested} = requiredStatus();
  const missing=[];
  if(!hasDx) missing.push('at least one diagnosis');
  if(!emSelected) missing.push('Billing E/M level');
  if(!attested) missing.push('attestation checkbox');
  const help=document.getElementById('reqHelp');
  const btn=document.getElementById('signBtn');
  /* [v4] Diagnosis / Superbill / Attestation no longer gate Sign Off: the button stays enabled, no blocking message */
  if(btn) btn.disabled=false;
  if(help){ help.hidden=true; help.textContent=''; }
  return;
  if(missing.length){
    help.className='req-help bad';
    help.textContent=missing.length+' required item'+(missing.length===1?'':'s')+' remaining: '+missing.join(', ')+'.';
    btn.disabled=true;
  } else {
    help.className='req-help good';
    help.textContent='All required items complete — ready to sign.';
    btn.disabled=false;
  }
}
