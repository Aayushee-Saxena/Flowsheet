        (inPl ? '' : btn('dx-to-pl', d.id, ico('fa-notes-medical')+' Add to Problem List', '', 'Adds this diagnosis to the patient\'s Problem List'))+
        '<span class="spacer"></span>'+btn('dx-remove', d.id, 'Remove from Assessment', '', 'Takes it out of this assessment; it is kept and can be restored')+
        btn('dx-delete', d.id, ico('fa-trash-can')+' Delete', 'ap-danger', 'Deletes the diagnosis and its plan items from this Visit Note')+'</div>'+plan+'</div>';
  }
  /* ---- other entity cards ---- */
  function probCard(p){
