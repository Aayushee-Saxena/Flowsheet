/* Carried-forward tracking, read by the AI "What's New" list so copied
   historical content is never mislabeled as newly authored this visit. */
let carriedForwardLog={};
function logCarried(key,date,text){
  (carriedForwardLog[key]=carriedForwardLog[key]||[]).push({date,text});
}
/* Generic, additive insertion for narrative-style sections (Complaints, ROS,
   PMH/SH, Social History, Plan/Orders). Never touches existing fields --
   only appends a visually distinct "Carried forward" box, and is a no-op if
   that exact fact was already carried forward earlier. */
function insertCarriedForward(targetKey, text, date){
  const block=document.getElementById(targetKey+'-questionnaire-block');
  if(!block) return false;
  let box=block.querySelector('.carried-forward-box');
  if(!box){
    box=document.createElement('div');
    box.className='carried-forward-box';
    box.innerHTML='<div class="carried-forward-hd"><i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i><span>Carried forward from previous visit</span></div><div class="carried-forward-list"></div>';
    const comments=document.getElementById(targetKey+'-custom-comments');
    const headers=document.getElementById(targetKey+'-custom-headers');
    const after = comments || headers;
    if(after && after.parentNode===block) after.insertAdjacentElement('afterend', box);
    else block.prepend(box);
  }
  const list=box.querySelector('.carried-forward-list');
  const srcKey=date+'|'+text;
  if([...list.children].some(it=>it.dataset.src===srcKey)) return false;
  const item=document.createElement('div');
  item.className='carried-forward-item';
  item.dataset.src=srcKey;
  const dateSpan=document.createElement('span'); dateSpan.className='cf-date'; dateSpan.textContent=date;
  const textSpan=document.createElement('span'); textSpan.className='cf-text'; textSpan.textContent=text;
  item.appendChild(dateSpan); item.appendChild(textSpan);
  list.appendChild(item);
  return true;
}
/* Structured insertion for Diagnosis -- reuses the exact .prob-row markup
   acceptPrimaryDx() already produces, so a carried-forward diagnosis becomes
   a real Diagnosis entry (not a text blurb), just tagged "Carried Forward"
   instead of "New today". Skips an exact code+title duplicate. */
function insertCarriedDx(dx, date){
  const block=document.getElementById('assess-questionnaire-block');
  if(!block) return false;
  const dupe=[...block.querySelectorAll('.prob-row')].some(r=>{
    const codeEl=r.querySelector('.prob-code'); const titleEl=r.querySelector('.prob-title');
    return codeEl && titleEl && codeEl.textContent.trim()===dx.code && titleEl.textContent.trim()===dx.title;
  });
  if(dupe) return false;
  const row=document.createElement('div');
  row.className='prob-row cf-row';
  row.innerHTML='<div class="prob-code"></div><div class="prob-main"><div class="prob-title"></div><div class="prob-sub"></div></div><div class="prob-actions"><span class="cf-badge">Carried Forward</span><button class="btn btn-xs" onclick="toast(\'Added to Problem List\')">Add to Problem List</button></div>';
  row.querySelector('.prob-code').textContent=dx.code;
  row.querySelector('.prob-title').textContent=dx.title;
  row.querySelector('.prob-sub').textContent='Carried forward from previous visit ('+date+') · '+dx.sub;
  block.prepend(row);
  const emptyNote=document.getElementById('dxEmptyNote'); if(emptyNote) emptyNote.style.display='none';
  return true;
}
function applyCopy(){
  const dateKey=Object.keys(COPY_VISITS).find(k=>COPY_VISITS[k].label===document.getElementById('copyVisitLabel').textContent) || '07/15/2025';
  const checked=[...document.querySelectorAll('#copySections .copy-item:checked')];
  let count=0;
  checked.forEach(chk=>{
    let payload;
    try{ payload=JSON.parse(decodeURIComponent(chk.dataset.payload)); }catch(e){ return; }
    let didInsert=false;
    if(payload.mode==='dx'){
      didInsert=insertCarriedDx(payload, dateKey);
      if(didInsert){
        markPartial('assess'); setStatus('assess','complete'); setReview('assess',false);
        onSectionFieldCommitted('assess'); updateSignState();
        logCarried('assess', dateKey, payload.code+' — '+payload.title);
      }
    } else {
      didInsert=insertCarriedForward(payload.key, payload.text, dateKey);
      if(didInsert){
        markPartial(payload.key); onSectionFieldCommitted(payload.key);
        logCarried(payload.key, dateKey, payload.text);
      }
    }
    if(didInsert) count++;
  });
  closeCopyPanel();
  const pill=document.getElementById('hpi-copied-pill');
  if(pill){ pill.textContent='Copied from '+dateKey; pill.style.display='inline-flex'; }
  toast(count>0 ? (count+' item(s) copied from '+dateKey+' into this Visit Note.') : 'Nothing new to copy — the selected items were already carried forward.');
}

