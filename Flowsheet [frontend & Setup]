.vsd-group-t{margin:0;padding:7px 14px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--ink-faint);background:var(--paper);border-bottom:1px solid var(--line-soft);}
.vsd-row{display:grid;grid-template-columns:200px minmax(0,1fr);column-gap:16px;align-items:start;padding:9px 14px;border-bottom:1px solid var(--line-soft);}
