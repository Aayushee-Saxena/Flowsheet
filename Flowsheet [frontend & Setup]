    pdMore: function(btn){ menu(btn, [{label: 'Drug Check', icon: 'fa-shield-halved', run: openDc}, {label: 'Drug History', icon: 'fa-clock-rotate-left', run: openDh}]); },
    mhCols: function(btn){ colsPop(btn, MH_COLS, S.mh.cols, function(){ document.getElementById('mxMhWin-b').innerHTML = mhBody(); }); },
