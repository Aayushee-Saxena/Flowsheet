      out.push(name + ': ' + [p ? 'Positive' : n ? 'Negative' : '', d, tx, no].filter(Boolean).join(' · '));
    });
    return out;
  };
})();
</script>
<script>
/* =====================================================================
   [v4] Reviewed indicator -- left panel, every section of every tab.
   Single source of truth: the section's existing "<key>-reviewed-pill" (shown = reviewed),
   set by Mark as Reviewed / auto-review and cleared by unreview / Reset. The header keeps
   the existing reviewed control (same pill); this mirrors it next to the section name.
   API: vnReviewedNav.refresh(key) / refreshAll()
   ===================================================================== */
(function(){
  var ICON = '<span class="vn-rv-ico" aria-hidden="true"><i class="fa-solid fa-user"></i><i class="fa-solid fa-check vn-rv-chk"></i></span>';
  function esc(s){ return String(s).replace(/[&<>"]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }
  function info(k){
    var p = document.getElementById(k + '-reviewed-pill');
    if(!p || !p.style.display || p.style.display === 'none') return '';
    var t = (p.querySelector('.vn-rv-txt') || p).textContent.replace(/^\s*(✓|&#10003;)\s*/, '').replace(/\s*·\s*/, ' · ').replace(/\s+/g, ' ').trim();
    return /^Reviewed\b/i.test(t) ? t.charAt(0).toUpperCase() + t.slice(1) : 'Reviewed';
  }
  function paint(k){
    if(!k) return;
    var tip = info(k);
    document.querySelectorAll('.nav-item[data-key="' + k + '"]').forEach(function(it){
      var b = it.querySelector(':scope > .vrv-nav');
      if(!tip){ if(b){ if(typeof hidePbiTooltip === 'function' && b.matches(':hover,:focus')) hidePbiTooltip(); b.remove(); } return; }
      if(!b){
        b = document.createElement('span'); b.className = 'vrv-nav'; b.setAttribute('role', 'img'); b.setAttribute('tabindex', '0');
        b.setAttribute('aria-describedby', 'pbiTooltip'); b.innerHTML = ICON;
        var nm = it.querySelector(':scope > .nm'); if(nm) nm.after(b); else it.appendChild(b);
        if(typeof bindPbiTooltip === 'function') bindPbiTooltip(b);
      }
      if(b.getAttribute('data-tt') !== tip){ b.setAttribute('data-tt', tip); b.setAttribute('aria-label', tip); }
    });
  }
  function keys(){
    var s = {};
    document.querySelectorAll('[id$="-reviewed-pill"]').forEach(function(p){ s[p.id.replace(/-reviewed-pill$/, '')] = 1; });
    return Object.keys(s);
  }
  function refreshAll(){ keys().forEach(paint); }
  window.vnReviewedNav = {refresh: paint, refreshAll: refreshAll};

  function init(){
    /* immediate update for the acted-on section */
    ['markReviewed', 'markReviewedSilently', 'vnUnreview', 'doResetSection'].forEach(function(n){
      var f = window[n]; if(typeof f !== 'function') return;
      window[n] = function(k){ var r = f.apply(this, arguments); if(typeof k === 'string') paint(k); return r; };
    });
    /* any other path that shows / hides a reviewed pill */
    if(window.MutationObserver) new MutationObserver(function(ms){
      var seen = {};
      for(var i = 0; i < ms.length; i++){
        var x = ms[i].target, id = x && x.id;
        if(id && /-reviewed-pill$/.test(id) && !seen[id]){ seen[id] = 1; paint(id.replace(/-reviewed-pill$/, '')); }
      }
    }).observe(document.body, {subtree: true, attributes: true, attributeFilter: ['style']});
    refreshAll();
  }
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function(){ setTimeout(init, 90); }); else setTimeout(init, 90);
  window.addEventListener('load', function(){ setTimeout(refreshAll, 40); });
})();
</script>
<script>
/* =====================================================================
   [v4] Visit Type -> "Accompanied by" required when leaving the Visit Type section.
   Visit Type answered (any question in the Visit Type section other than Accompanied by)
   + Accompanied by empty + an attempt to open another section / tab / Save & Next
   -> existing Required dialog ("Few questions are required to fill", OK only)
   -> OK: Visit Type section shown, Accompanied by scrolled into view with a soft red highlight.
   The highlight clears once Accompanied by is answered, Visit Type is cleared, or the section is reset.
   ===================================================================== */
(function(){
  var KEY = 'hpivisittype', CARD = 'sec-' + KEY, MSG = 'Few questions are required to fill';
  var pending = false, bypass = false, origMsg = null;
  function accRow(){ var l = document.getElementById(KEY + '-q2-lbl'); return l ? l.closest('.vq') : null; }
  function answered(row){
    if(!row) return false;
    if(row.querySelector('.cx-chip.on, [aria-pressed="true"]')) return true;
    return [].slice.call(row.querySelectorAll('input, select, textarea')).some(function(c){
      if(c.type === 'checkbox' || c.type === 'radio') return c.checked;
      return String(c.value || '').trim() !== '';
    });
  }
  function visitTypeFilled(){
    var acc = accRow(), blk = document.getElementById(KEY + '-questionnaire-block'); if(!blk) return false;
    return [].slice.call(blk.querySelectorAll('.vq')).some(function(r){ return r !== acc && answered(r); });
  }
  function needs(){ return visitTypeFilled() && !answered(accRow()); }
  function leaving(targetCard){ return !bypass && vssCurrent === CARD && targetCard !== CARD && needs(); }

  function msgNode(){ var m = document.getElementById('reqDlgMsg'); if(!m) return null; for(var n = m.lastChild; n; n = n.previousSibling) if(n.nodeType === 3) return n; return null; }
  function showDlg(){
    var dlg = document.getElementById('reqDlg'), n = msgNode();
    if(!dlg){ highlight(); return; }
    if(n){ if(origMsg === null) origMsg = n.nodeValue; n.nodeValue = MSG; }
    pending = true; dlg.hidden = false;
    setTimeout(function(){ var ok = document.getElementById('reqDlgOk'); if(ok) ok.focus(); }, 0);
  }
  function restoreMsg(){ var n = msgNode(); if(n && origMsg !== null) n.nodeValue = origMsg; }
  function highlight(){
    bypass = true;
    try{
      if(typeof vntEnsure === 'function') vntEnsure(CARD);
      if(vssCurrent !== CARD && typeof vssShow === 'function') vssShow(CARD);
    } finally { bypass = false; }
    var row = accRow(); if(!row) return;
    row.classList.add('vav-missing');
    var center = document.getElementById('center');
    if(center && center.contains(row)) center.scrollTop = Math.max(0, row.getBoundingClientRect().top - center.getBoundingClientRect().top + center.scrollTop - (typeof vnStickyOffset === 'function' ? vnStickyOffset() + 12 : 80));
    else row.scrollIntoView({block: 'center'});
    var f = row.querySelector('.cx-chip, input, select, textarea'); if(f) setTimeout(function(){ try{ f.focus({preventScroll: true}); }catch(e){} }, 50);
  }
  function recheck(){
    var row = accRow(); if(!row || !row.classList.contains('vav-missing')) return;
    if(answered(row) || !visitTypeFilled()) row.classList.remove('vav-missing');
  }

  function init(){
    var oOk = window.reqDlgOk;
    window.reqDlgOk = function(){
      if(!pending) return oOk.apply(this, arguments);
      pending = false; document.getElementById('reqDlg').hidden = true; restoreMsg(); highlight();
    };
    function guard(name, target){
      var f = window[name]; if(typeof f !== 'function') return;
      window[name] = function(){
        if(pending) return;
        if(leaving(target.apply(this, arguments))){ showDlg(); return; }
        return f.apply(this, arguments);
      };
    }
    guard('jump', function(id){ return id; });
    guard('goToSection', function(k){ return 'sec-' + k; });
    guard('vssShow', function(id){ return id; });
    guard('vntSwitch', function(id){ return id === vntActive ? CARD : 'tab:' + id; });
    guard('saveAndContinueSection', function(k){ return k === KEY ? 'next' : CARD; });
    try{ if(typeof saveAndContinueSection !== 'undefined') saveAndContinueSection = window.saveAndContinueSection; }catch(e){}
    var oReset = window.doResetSection;
    if(typeof oReset === 'function') window.doResetSection = function(k){ var r = oReset.apply(this, arguments); if(k === KEY){ var row = accRow(); if(row) row.classList.remove('vav-missing'); } return r; };
    ['input', 'change', 'click'].forEach(function(t){ document.addEventListener(t, function(){ setTimeout(recheck, 0); }, true); });
  }
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function(){ setTimeout(init, 120); }); else setTimeout(init, 120);
})();
</script>
<script>
/* History tab: Family History table -- row "has answers" mark, Clear, summary lines (filled / reviewed / status use the existing logic) */
(function(){
  function commit(el){ var c = el.closest('.card[id^="sec-"]'); if(!c) return; var k = c.id.slice(4);
    if(typeof markPartial === 'function') markPartial(k); if(typeof onSectionFieldCommitted === 'function') onSectionFieldCommitted(k);
    if(typeof vnfQueue === 'function') vnfQueue(k); }
  function rowVal(r){
    var rel = [].slice.call(r.querySelectorAll('input[type=checkbox]')).filter(function(c){ return c.checked; }).map(function(c){
      var sp = c.parentNode.querySelector('.fht-spec'); return c.getAttribute('data-rel') + (sp && sp.value.trim() ? ' (' + sp.value.trim() + ')' : ''); });
    var o = r.querySelector('.fht-other'); if(o && o.value.trim()) rel.push('Other: ' + o.value.trim());
    return rel;
  }
  function mark(r){ var on = rowVal(r).length > 0 || [].some.call(r.querySelectorAll('.fht-spec'), function(s){ return s.value.trim(); }); if(r.classList.contains('fht-on') !== on) r.classList.toggle('fht-on', on); }
  ['change', 'input'].forEach(function(t){ document.addEventListener(t, function(ev){ var r = ev.target.closest && ev.target.closest('tr.fht-row'); if(r) mark(r); }, true); });
  window.fhtClear = function(btn){
    var w = btn.closest('.fht-wrap'); w.querySelectorAll('input').forEach(function(i){ if(i.type === 'checkbox') i.checked = false; else i.value = ''; });
    w.querySelectorAll('tr.fht-row').forEach(mark); commit(btn); if(typeof toast === 'function') toast('Family history table cleared.');
  };
  var ef = window.extractSectionFacts;
  if(typeof ef === 'function') window.extractSectionFacts = extractSectionFacts = function(k){
    var out = ef.apply(this, arguments) || [], card = document.getElementById('sec-' + k), tbl = card && card.querySelector('.fht');
    if(!tbl) return out;
    tbl.querySelectorAll('tr.fht-row').forEach(function(r){ var v = rowVal(r); if(v.length) out.push(r.getAttribute('data-cond') + ': ' + v.join(', ')); });
    return out;
  };
})();
</script>
<script>
/* =====================================================================
   [v4] Section header: sticky + text actions.
   Header actions become  [Save & Next] [Reset] .... [More]  (same elements, same handlers:
   saveAndContinueSection / confirmResetSection / toggleHlPop). The Edit button is removed
   from the header (openFormWindow itself is untouched). Bottom Reset / Save & Next are hidden.
   Re-applied whenever the existing header arrangement runs again.
   ===================================================================== */
(function(){
  function untip(b){ ['data-tt', 'aria-describedby', 'title'].forEach(function(a){ b.removeAttribute(a); }); }
  function text(b, label, cls){
    if(!b) return;
    if(!b.classList.contains('vn-hdtxt')){
