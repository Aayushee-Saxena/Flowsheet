/* ---- Patient-info icon tooltips (Consents, plus any other [data-tt] icon) ----
   Positioned in JS (fixed, from getBoundingClientRect) rather than pure CSS
   so it's never clipped regardless of where in the layout the trigger sits
   (.pb-compact wraps rather than scrolling, but other [data-tt] triggers live
   inside containers that do scroll/clip). Shows on mouse hover AND keyboard
   focus so it's reachable
   via Tab, not just a mouse. */
function placePbiTooltip(el){
  const tt=document.getElementById('pbiTooltip');
  if(!tt) return;
  const r=el.getBoundingClientRect();
  tt.hidden=false;
  tt.textContent=el.getAttribute('data-tt')||'';
  tt.style.left='0px'; tt.style.top='0px';
  const tw=tt.offsetWidth;
  let left=Math.round(r.left + r.width/2 - tw/2);
  left=Math.max(6, Math.min(left, window.innerWidth-6-tw));
  tt.style.left=left+'px';
  tt.style.top=Math.round(r.bottom+8)+'px';
}
function hidePbiTooltip(){
  const tt=document.getElementById('pbiTooltip');
  if(tt) tt.hidden=true;
}
function pbiTooltipShow(e){
  const el=e.currentTarget;
  if(!el.hasAttribute('data-tt')) return;
  placePbiTooltip(el);
}
/* Idempotent — safe to call more than once on the same element (e.g. a
   Summary-panel row that only gains data-tt later, when a color is applied). */
function bindPbiTooltip(el){
  if(!el || el.dataset.ttBound) return;
  el.dataset.ttBound='1';
  el.addEventListener('mouseenter', pbiTooltipShow);
  el.addEventListener('mouseleave', hidePbiTooltip);
  el.addEventListener('focus', pbiTooltipShow);
  el.addEventListener('blur', hidePbiTooltip);
}
function initPbiTooltips(){
  document.querySelectorAll('[data-tt]').forEach(bindPbiTooltip);
}
/* ---- Family History questionnaire table: drag-to-resize columns ----
   Scoped to #fhMatrixTable only. Each <th> has a thin .fh-col-resizer strip
   at its right edge; dragging it (mouse or touch, via Pointer Events so both
   share one code path) adjusts that column's <col> width in the table's
   <colgroup>, which is what actually controls the rendered column width
   under table-layout:fixed. Per-resizer data-min enforces a reasonable
   minimum so a column can't be dragged down to unusable/hidden content, and
   because each column is driven by its own <col>, resizing one never
   reflows or overlaps the others. */
function initFhMatrixResize(){
  const table=document.getElementById('fhMatrixTable');
  const wrap=document.getElementById('fhMatrixWrap');
  if(!table || !wrap) return;
  const cols=table.querySelectorAll(':scope > colgroup > col');
  const resizers=table.querySelectorAll(':scope > thead .fh-col-resizer');
  resizers.forEach((handle, i)=>{
    const col=cols[i];
    const th=handle.closest('th');
    if(!col || !th) return;
    const minWidth=parseInt(handle.dataset.min, 10) || 60;
    let startX=0, startWidth=0, dragging=false;
    function onMove(e){
      if(!dragging) return;
      const dx=e.clientX-startX;
      const next=Math.max(minWidth, Math.round(startWidth+dx));
      col.style.width=next+'px';
    }
    function onUp(e){
      if(!dragging) return;
      dragging=false;
      handle.classList.remove('is-resizing');
      wrap.classList.remove('fh-col-resizing');
      try{ handle.releasePointerCapture(e.pointerId); }catch(err){}
      window.removeEventListener('pointermove', onMove);
      window.removeEventListener('pointerup', onUp);
    }
    handle.addEventListener('pointerdown', (e)=>{
      dragging=true;
      startX=e.clientX;
      startWidth=th.getBoundingClientRect().width;
      handle.classList.add('is-resizing');
      wrap.classList.add('fh-col-resizing');
      try{ handle.setPointerCapture(e.pointerId); }catch(err){}
      window.addEventListener('pointermove', onMove);
      window.addEventListener('pointerup', onUp);
      e.preventDefault();
    });
  });
}
