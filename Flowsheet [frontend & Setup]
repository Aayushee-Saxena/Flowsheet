<script>
/* =====================================================================
   [v4] Filled-section indicator.
   ONE state source:  section -> its questionnaire block -> vnfIsFilled()
                      -> VNF_STATE[key] -> vnfApply(key) paints BOTH the
                      left-nav item and the main-panel section header.
   "Filled" = at least one meaningful entered/selected value or record in
   the section's own question area. It is independent of the existing
   pending / complete / reviewed status icons, which are left untouched.
   ===================================================================== */
var VNF_STATE = {};
(function(){
  /* regions inside a section that are tools / chrome, not answers */
  var SKIP = '.hl-pop,.vn-tools-menu,.vn-tools-sub,.ssum-confirm,.vn-annot-list,.dxplan-quickadd,.ap-pick-list,.ap-pick-search,.ap-pick-tabs,.vn-ph,script,template';
  /* added records (rows / entries / list items / code chips) count as entered data */
  var RECORDS = '.mx-rec.mx-cur,.vs-rec.vs-cur,.prob-row,.plan-item,.summary-line,.code-chip,.dx-entry,.allergy-entry,.ap-card,.allergy-nka-banner,.ap-saved .ap-srow';
  /* selected chip / segmented / toggle controls */
  var TOGGLES = '.cx-chip.on,.segctrl button.on,.em-chip.on,.em-chip.sel,.em-chip.selected,[aria-pressed="true"],.is-on';
  var TEXTISH = /^(text|search|email|tel|url|number|date|time|datetime-local|month|week|password)$/;

  function keyOfBlock(b){ return b.id.replace(/-questionnaire-block$/, ''); }
  function blockOf(key){ return document.getElementById(key + '-questionnaire-block'); }

  /* hidden by the section's own logic (hidden attr) between el and the block root;
     parking in the tab store / form window / collapse / search-filter does NOT count */
  function hiddenWithin(el, root){
    for(var n = el; n && n !== root; n = n.parentElement){ if(n.hasAttribute && n.hasAttribute('hidden')) return true; }
    return false;
  }
  function usable(el, root){ return !el.closest(SKIP) && !hiddenWithin(el, root); }

  function isPlaceholderOpt(o){ if(!o) return true; var t = o.textContent; return o.value === '' || /^\s*(select|choose)\b/i.test(t) || /^\s*[-–—]+\s*$/.test(t); }
  function selectFilled(s){
    var opts = [].slice.call(s.options);
    if(s.multiple) return opts.some(function(o){ return o.selected && !isPlaceholderOpt(o); });
    var cur = s.options[s.selectedIndex]; if(!cur) return false;
    if(opts.some(isPlaceholderOpt)) return !isPlaceholderOpt(cur);
    /* no placeholder option: only a change away from the as-loaded default counts */
    var defIdx = 0; opts.forEach(function(o, i){ if(o.defaultSelected) defIdx = i; });
    return s.selectedIndex !== defIdx;
  }
  function fieldFilled(el){
    var tag = el.tagName;
    if(tag === 'SELECT') return selectFilled(el);
    if(tag === 'TEXTAREA') return el.value.trim() !== '';
    var t = (el.type || 'text').toLowerCase();
    if(t === 'checkbox' || t === 'radio') return el.checked;
    if(t === 'range') return el.value !== el.defaultValue;
    if(TEXTISH.test(t)) return el.value.trim() !== '';
    return false;   /* hidden / button / file / color etc. are not answers */
  }

  /* the single reusable decision */
  window.vnfIsFilled = function(key){
    var root = blockOf(key); if(!root) return false;
    var i, l;
    l = root.querySelectorAll('input,select,textarea');
    for(i = 0; i < l.length; i++) if(usable(l[i], root) && fieldFilled(l[i])) return true;
    l = root.querySelectorAll('[contenteditable="true"]');
    for(i = 0; i < l.length; i++) if(usable(l[i], root) && l[i].textContent.trim()) return true;
    l = root.querySelectorAll(TOGGLES);
    for(i = 0; i < l.length; i++) if(usable(l[i], root)) return true;
    l = root.querySelectorAll(RECORDS);
    for(i = 0; i < l.length; i++) if(usable(l[i], root)) return true;
    l = root.querySelectorAll('table.results td');
    for(i = 0; i < l.length; i++) if(usable(l[i], root) && l[i].textContent.trim()) return true;
    return false;
  };

  /* filled state -> classes only (the blue dot indicator was removed) */
  window.vnfApply = function(key){
    var on = !!VNF_STATE[key];
    document.querySelectorAll('.nav-item[data-key="' + key + '"]').forEach(function(it){ it.classList.toggle('vnf-filled', on); });
    var card = document.getElementById('sec-' + key); if(card) card.classList.toggle('vnf-filled', on);
  };
  window.vnfRefresh = function(key){
    if(!key || !blockOf(key)) return;
    VNF_STATE[key] = vnfIsFilled(key);
    vnfApply(key);
  };
  window.vnfRefreshAll = function(){
    document.querySelectorAll('[id$="-questionnaire-block"]').forEach(function(b){ vnfRefresh(keyOfBlock(b)); });
  };

  /* ---- dirty-key queue: every trigger funnels into the same refresh ---- */
  var dirty = {}, timer = null;
  function queue(key){ if(!key) return; dirty[key] = 1; if(timer) return; timer = setTimeout(flush, 30); }
  function flush(){ timer = null; var ks = Object.keys(dirty); dirty = {}; ks.forEach(vnfRefresh); }
  function keyFromNode(n){
    var el = n && (n.nodeType === 1 ? n : n.parentElement); if(!el || !el.closest) return null;
    var b = el.closest('[id$="-questionnaire-block"]'); if(b) return keyOfBlock(b);
    var c = el.closest('.card[id^="sec-"]'); return c ? c.id.slice(4) : null;
  }
  window.vnfQueue = queue;

  function init(){
    /* user input of every kind */
    ['input', 'change'].forEach(function(t){ document.addEventListener(t, function(e){ queue(keyFromNode(e.target)); }, true); });
    /* chip / toggle / add / remove buttons run their own handlers first */
    document.addEventListener('click', function(e){ var k = keyFromNode(e.target); if(k) setTimeout(function(){ queue(k); }, 0); }, true);
    /* programmatic changes: class toggles, records added/removed, Reset (innerHTML swap) */
    if(window.MutationObserver){
      new MutationObserver(function(muts){
        for(var i = 0; i < muts.length; i++){
          var m = muts[i], t = m.target;
          queue(keyFromNode(t));
        }
      }).observe(document.body, {subtree: true, childList: true, attributes: true, attributeFilter: ['class', 'hidden', 'aria-pressed', 'checked', 'selected']});
    }
    /* legacy commit points that can set .value / .checked without firing events
       (copy from previous visit, templates, applySection, reset, form window) */
    ['onSectionFieldCommitted', 'markPartial', 'doResetSection', 'setStatus', 'closeFormWindow', 'openFormWindow', 'applySection'].forEach(function(fn){
      var o = window[fn]; if(typeof o !== 'function') return;
      window[fn] = function(key){ var r = o.apply(this, arguments); if(typeof key === 'string') queue(key); return r; };
    });
    /* copy / template overlays touch several sections at once */
    ['applyCopy', 'applyTemplate', 'insertQuickPhrase', 'insertAIDraft', 'setAllNormal', 'applyDxAddToProblemList'].forEach(function(fn){
      var o = window[fn]; if(typeof o !== 'function') return;
      window[fn] = function(){ var r = o.apply(this, arguments); setTimeout(vnfRefreshAll, 0); return r; };
    });
    /* nav items are re-parented on tab switch: repaint from stored state (never recomputed to empty) */
    var os = window.vntSwitch;
    if(typeof os === 'function') window.vntSwitch = function(){ var r = os.apply(this, arguments); Object.keys(VNF_STATE).forEach(vnfApply); return r; };
    vnfRefreshAll();
  }
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function(){ setTimeout(init, 0); });
  else setTimeout(init, 0);
})();
</script>
<script>
/* =====================================================================
   [v4] Single-section ("page") view in the middle panel.
   The tab engine still places the active tab's section cards in
   .center-inner; this layer only toggles visibility on those SAME
   elements (class .vss-off on every card except the current one), so
   nothing is cloned or re-created and every entered value, review state,
   tool, highlight and filled indicator stays exactly where it was.
   ===================================================================== */
var vssCurrent = null;
(function(){
  function inner(){ return document.querySelector('#center .center-inner'); }
  function cardsInTab(){ var i = inner(); return i ? [].slice.call(i.querySelectorAll(':scope > .card[id]')) : []; }

  /* first question section of the active tab, in left-nav order (Patient Demographics
     is the header bar and VN General a read-only summary -- both stay one click away) */
  function firstSection(){
    var items = document.querySelectorAll('#navBody .nav-item[data-target^="sec-"]');
    for(var i = 0; i < items.length; i++){
      var el = document.getElementById(items[i].dataset.target);
      if(el && el.classList.contains('card') && el.closest('.center-inner') &&
         document.getElementById(el.id.slice(4) + '-questionnaire-block')) return el.id;   /* skip read-only VN General */
    }
    for(i = 0; i < items.length; i++){ var e2 = document.getElementById(items[i].dataset.target); if(e2 && e2.classList.contains('card') && e2.closest('.center-inner')) return e2.id; }
    var c = cardsInTab(); return c.length ? c[0].id : null;
  }

  function highlight(id){
    document.querySelectorAll('.nav-item').forEach(function(r){ r.classList.remove('active'); });
    var item = document.querySelector('#navBody .nav-item[data-target="' + id + '"]');
    if(item){ item.classList.add('active'); if(item.scrollIntoViewIfNeeded) item.scrollIntoViewIfNeeded(false); }
  }

  /* the one place that decides what the middle panel shows */
  window.vssShow = function(id, opts){
    opts = opts || {};
    var el = document.getElementById(id);
    if(!el || !el.classList.contains('card') || !el.closest('.center-inner')) return false;
    cardsInTab().forEach(function(c){ c.classList.toggle('vss-off', c !== el); });
    el.classList.add('vss-cur');
    if(vssCurrent && vssCurrent !== id){ var p = document.getElementById(vssCurrent); if(p) p.classList.remove('vss-cur'); }
    vssCurrent = id;
    var center = document.getElementById('center'); if(center) center.scrollTop = 0;
    highlight(id);
    if(typeof activeSectionKey !== 'undefined' && id.indexOf('sec-') === 0){ try{ activeSectionKey = id.slice(4); }catch(e){} }
    /* an open question search follows the page to its new section */
    var q = document.getElementById('vqsInput');
    if(!opts.quiet && q && q.value.trim()) q.dispatchEvent(new Event('input', {bubbles: true}));
    return true;
  };

  function init(){
    /* section navigation (left nav, patient bar, summary panel "go to", Save & Next, Go To flyout) */
    var oJump = window.jump;
    window.jump = function(id){
      if(typeof vntEnsure === 'function' && !vntEnsure(id)) return;
      vssShow(id);
      return oJump.apply(this, arguments);
    };
    var oGo = window.goToSection;
    window.goToSection = function(key){
      if(typeof vntEnsure === 'function' && !vntEnsure('sec-' + key)) return;
      vssShow('sec-' + key);
      return oGo.apply(this, arguments);
    };
    /* a tab switch always opens that tab's first section */
    var oSw = window.vntSwitch;
    window.vntSwitch = function(){
      var r = oSw.apply(this, arguments);
      vssShow(firstSection());
      return r;
    };
    /* Patient Demographics is the header bar, not a page: keep the shown section selected */
    var oDemo = window.focusDemoBar;
    if(typeof oDemo === 'function') window.focusDemoBar = function(){ var r = oDemo.apply(this, arguments); if(vssCurrent) highlight(vssCurrent); return r; };
    /* a card that arrives in the column later (tab engine re-parenting) never stacks */
    var i = inner();
    if(i && window.MutationObserver) new MutationObserver(function(){
      if(vssCurrent && document.getElementById(vssCurrent) && document.getElementById(vssCurrent).closest('.center-inner'))
        cardsInTab().forEach(function(c){ var off = c.id !== vssCurrent; if(c.classList.contains('vss-off') !== off) c.classList.toggle('vss-off', off); });
    }).observe(i, {childList: true});
    document.getElementById('center').classList.add('vss-on');
    vssShow(firstSection(), {quiet: true});
  }
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function(){ setTimeout(init, 0); });
  else setTimeout(init, 0);
})();
</script>

<script>
/* [v4] List-Detail row clear: empties every answer in that one question (tiles + typed fields) */
function vqLdClear(btn){
  var q = btn.closest('.vq'), card = q && q.closest('.card[id^="sec-"]'); if(!q || !card) return;
  q.querySelectorAll('.cx-chip.on').forEach(function(c){ c.classList.remove('on'); c.setAttribute('aria-pressed','false'); });
  q.querySelectorAll('input, textarea').forEach(function(i){ if(i.type === 'checkbox' || i.type === 'radio') i.checked = false; else i.value = ''; });
  q.querySelectorAll('select').forEach(function(s){ s.selectedIndex = 0; });
