<script>
/* =====================================================================
   [v4] ROS selection logic
   - All Normal (green) is the "positive" state; every other option (red)
     is "negative". All Normal and individual options never coexist.
   - Select All Positive  -> All Normal only (scope's All Normal), rest cleared
   - Select All Negative  -> every finding in scope selected, All Normal cleared
   - Reset / De-select All -> everything in scope cleared
   - Manual option -> clears All Normal; manual All Normal -> clears the rest
   Scope = one system (row buttons) or the whole ROS (header buttons;
   the section's All Normal is the one on the "All" row).
   ===================================================================== */
(function(){
  /* the ROS rows live in the questionnaire block, which the Edit window borrows while it is open */
  function sec(){ return document.getElementById('maros-questionnaire-block') || document.getElementById('sec-maros'); }
  function topRow(){ return document.querySelector('#maros-questionnaire-block .ros-row[data-ros-row="all"]'); }
  function set(chip, on){
    chip.classList.toggle('on', !!on); chip.removeAttribute('data-ros');
    chip.setAttribute('aria-pressed', on ? 'true' : 'false');
    if(!on){ var d = chip.parentElement && chip.parentElement.querySelector('.ros-det'); if(d) d.value = ''; }
  }
  function clear(scope, keep){ scope.querySelectorAll('.cx-chip[data-ros-kind]').forEach(function(c){ if(c !== keep && (c.classList.contains('on') || c.hasAttribute('data-ros'))) set(c, false); }); }
  function clearNormals(row){
    var t = topRow(); if(t) t.querySelectorAll('.cx-chip[data-ros-kind="normal"].on').forEach(function(c){ set(c, false); });
    if(row) row.querySelectorAll('.cx-chip[data-ros-kind="normal"].on').forEach(function(c){ set(c, false); });
  }
  function commit(){ if(typeof markPartial === 'function') markPartial('maros'); if(typeof onSectionFieldCommitted === 'function') onSectionFieldCommitted('maros'); }
  function isTop(row){ return row && row.getAttribute('data-ros-row') === 'all'; }
  function selectNormal(chip){
    var row = chip.closest('.ros-row');
    clear(isTop(row) ? sec() : row, chip);          /* the section All Normal clears everything; a system's clears that system */
    if(!isTop(row)) clearNormals(null);              /* …and the section-level All Normal */
    set(chip, true);
  }
  window.rosTap = function(chip){
    var row = chip.closest('.ros-row');
    if(chip.classList.contains('on')){ set(chip, false); commit(); return; }
    if(chip.getAttribute('data-ros-kind') === 'normal') selectNormal(chip);
    else { set(chip, true); clearNormals(isTop(row) ? null : row); }
    commit();
  };
  window.rosBulk = function(btn, pol){
    var row = btn ? btn.closest('.ros-row') : null, scopeRow = row || topRow(), scope = row || sec(); if(!scope) return;
    if(pol === 'pos'){
      var an = scopeRow && scopeRow.querySelector('.cx-chip[data-ros-kind="normal"]');
      if(!an){ toast('No All Normal option in this subsection.'); return; }
      selectNormal(an);
    } else {
      clear(scope, null); clearNormals(row);
      scope.querySelectorAll('.cx-chip[data-ros-kind="finding"]').forEach(function(c){ set(c, true); });
    }
    commit();
    var where = row ? 'in ' + row.querySelector('.vq-qt').textContent.trim() + '.' : 'across ROS.';
    toast(pol === 'pos' ? 'All Normal selected ' + where : 'All negative options selected ' + where);
  };
  window.rosReset = function(btn){
    var row = btn ? btn.closest('.ros-row') : null, scope = row || sec(); if(!scope) return;
    clear(scope, null); commit();
    toast(row ? row.querySelector('.vq-qt').textContent.trim() + ' selections reset.' : 'All ROS selections cleared.');
  };
  var rs = window.vntResetSel;
  if(typeof rs === 'function') window.vntResetSel = function(key){ if(key === 'maros') return rosReset(null); return rs.apply(this, arguments); };
  /* section summary / compiled note: "System: option (details), …" */
  var ef = window.extractSectionFacts;
  if(typeof ef === 'function') window.extractSectionFacts = extractSectionFacts = function(k){
    if(k !== 'maros') return ef.apply(this, arguments);
    var out = [];
    document.querySelectorAll('#maros-questionnaire-block .ros-row').forEach(function(row){
      var parts = [];
      row.querySelectorAll('.ros-item').forEach(function(it){ var c = it.querySelector('.cx-chip'), d = it.querySelector('.ros-det'); if(!c || !c.classList.contains('on')) return;
        parts.push(c.textContent.trim() + (d && d.value.trim() ? ' (' + d.value.trim() + ')' : '')); });
      row.querySelectorAll('.ros-fld').forEach(function(f){ var i = f.querySelector('input'), l = f.querySelector('label');
        if(i && i.value.trim()) parts.push(l.textContent.replace(/^.*— /, '').trim() + ': ' + i.value.trim()); });
      if(parts.length) out.push(row.querySelector('.vq-qt').textContent.trim() + ': ' + parts.join(', '));
    });
    return out;
  };
  function init(){ document.querySelectorAll('#sec-maros [data-tt]').forEach(function(el){ if(typeof bindPbiTooltip === 'function') bindPbiTooltip(el); }); }
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function(){ setTimeout(init, 0); }); else setTimeout(init, 0);
})();
</script>
<script>
/* =====================================================================
   [v4] This Visit Summary -> one card per section, plain text area in each.
   Built on the existing summary data layer (window.SSM: per section the
   question-generated lines + the user's own text) so nothing about how
   lines are generated, edited, removed or restored changes.
   - one surface for the whole Visit Note, grouped by the Visit Note tabs
     in their tab order; it is never duplicated or rebuilt on tab switch
   - question-generated lines are protected, identifiable blocks
   - the user can type in any gap: before, between or after them
   - Save sits on the right of each section header (Go to This Section removed from the summary)
   - switching tabs scrolls the document to that tab's first section
   ===================================================================== */
(function(){
  var esc = function(s){ return String(s == null ? '' : s).replace(/[&<>"]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); };
  var TABNOTES = {};
  var ORDER = [], OWNER = {};
  function title(k){ return (typeof SECTION_TITLES !== 'undefined' && SECTION_TITLES[k]) || (typeof VNT_TITLES !== 'undefined' && VNT_TITLES[k]) || k; }
  var ALWAYS = {maros: 1};   /* ROS: its own card even before any answer */
  function locked(k){ return !!(window.VN_LOCKED && window.VN_LOCKED[k]); }   /* section being edited by another user (ROS) */
  function lockRow(){ return '<div class="ros-lock-row" role="status"><span class="ros-lock-big" role="img" aria-label="Section locked" aria-describedby="pbiTooltip" data-tt="Section locked" tabindex="0">' + (window.ROS_LOCK_SVG || '<i class="fa-solid fa-lock" aria-hidden="true"></i>') + '</span><span class="ros-lock-msg">Currently being worked upon by Allen, Kris.</span></div>'; }
  function rec(k){ var S = window.SSM || {}; return S[k] || null; }
  function ta(k){ return document.querySelector('.ssum-textarea[data-key="'+k+'"]'); }
  function doc(){ return document.getElementById('vnsDoc'); }
  function plain(html){ var d = document.createElement('div'); d.innerHTML = html || ''; d.querySelectorAll('br').forEach(function(b){ b.replaceWith('\n'); }); d.querySelectorAll('div,p,li').forEach(function(b){ b.append('\n'); }); return d.textContent.replace(/\n{3,}/g, '\n\n').trim(); }
  function encA(a){ return encodeURIComponent(a); }
  function decA(a){ try{ return decodeURIComponent(a); }catch(e){ return a; } }

  /* ---------- notes (the user's own text) live on the SSM record, keyed by the line they follow; plain text only ---------- */
  function toPlain(v){ return /<\/?[a-z][^>]*>/i.test(v || '') ? plain(v) : (v || ''); }
  function notes(k){
    var r = rec(k); if(!r) return {};
    if(!r.notes){ r.notes = {}; if((r.manual || '').trim()) r.notes.__end = r.manual; }
    Object.keys(r.notes).forEach(function(a){ r.notes[a] = toPlain(r.notes[a]); });
    return r.notes;
  }
  /* the section's plain-text summary: question lines ("• …") with the user's own lines where they put them */
  function compose(k){
    var r = rec(k); if(!r) return '';
    var n = notes(k), out = [], seen = {};
    function addNote(a){ seen[a] = 1; var t = (n[a] || '').replace(/\s+$/, ''); if(t.trim()) out.push(t); }
    addNote('__top');
    r.items.forEach(function(it){ if(!it.removed) out.push('• ' + it.t); addNote(it.f); });
    Object.keys(n).forEach(function(a){ if(!seen[a]) addNote(a); });
    return out.join('\n');
  }
  /* edits in the text area map back: "• " lines are the question lines (in order), everything else is the user's text */
  function parse(k, val){
    var r = rec(k); if(!r) return;
    var vis = r.items.filter(function(it){ return !it.removed; }), vi = 0, anchor = '__top', nn = {};
    val.replace(/\r/g, '').split('\n').forEach(function(line){
      var m = /^\s*•\s?(.*)$/.exec(line);
      if(m && vi < vis.length){
        var t = m[1].replace(/\s+/g, ' ').trim(), j = -1;
        for(var x = vi; x < vis.length; x++) if(vis[x].t === t){ j = x; break; }
        if(j >= 0){ for(var y = vi; y < j; y++) vis[y].removed = true; vi = j; }
        var it = vis[vi++];
        if(!t){ it.removed = true; return; }
        if(t !== it.t){ it.t = t; it.edited = (t !== it.f); }
        anchor = it.f; return;
      }
      nn[anchor] = (anchor in nn ? nn[anchor] + '\n' : '') + line;
    });
    for(; vi < vis.length; vi++) vis[vi].removed = true;
    Object.keys(nn).forEach(function(a){ if(!nn[a].trim()) delete nn[a]; else nn[a] = nn[a].replace(/^\n+|\s+$/g, ''); });
    r.notes = nn;
  }
  function writeBack(k){
    var r = rec(k); if(!r) return;
    var n = notes(k); r.manual = Object.keys(n).map(function(a){ return n[a]; }).filter(function(t){ return t.trim(); }).join('\n');
    var text = compose(k), el = ta(k);
    if(el) el.value = text;
