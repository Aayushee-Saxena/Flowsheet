   if(r.hi!==undefined&&Y(r.hi)>0&&Y(r.hi)<h)band+=`<line x1="0" y1="${Y(r.hi).toFixed(1)}" x2="${w}" y2="${Y(r.hi).toFixed(1)}" style="stroke:var(--green-line)" stroke-dasharray="3 3"/>`;
   if(r.lo!==undefined&&Y(r.lo)>0&&Y(r.lo)<h)band+=`<line x1="0" y1="${Y(r.lo).toFixed(1)}" x2="${w}" y2="${Y(r.lo).toFixed(1)}" style="stroke:var(--green-line)" stroke-dasharray="3 3"/>`;
  }
