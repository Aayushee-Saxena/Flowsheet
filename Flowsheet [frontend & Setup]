  /* ---------- formatting ---------- */
  function has(r){ return r && !r.nr && (r.val || r.sys || r.dia || r.val2); }
  function fmtOne(k, r, grid){
    if(!r) return '';
    if(r.nr) return grid ? 'NR' : 'Not Recorded';
    if(!has(r)) return '';
