    if(window.MutationObserver) new MutationObserver(function(){ if(!busy) soon(); })
      .observe(d, {subtree: true, childList: true, attributes: true, attributeFilter: ['hidden', 'class']});
    apply();
  }
  /* the summary document is built after load; init() waits for it (no dependency on the load event) */
  setTimeout(init, 300);
})();
</script>
