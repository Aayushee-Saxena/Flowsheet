/* Patient Documents: the application's document categories (the Documents viewer's folders), handed in by the host */
CAT['Doc Category']=[{c:'Document Categories',items:(Array.isArray(window.DOC_CATEGORIES)?window.DOC_CATEGORIES:[]).map(n=>[n,'doc'])}];
/* ---------------- Source: one shared multi-select for every sourced Type ----------------
   Vitals, Custom Form, Lab Observation, Ultrasound and Medical Imaging all open the same list:
   the Type's source classes (chips when there is more than one), each container as a section,
   items and sublevels with checkboxes. Applying creates one row per checked entry in the group
   the picker was opened from, named after the entry; an entry already in that group is shown
   checked and cannot be added twice. The empty row the picker was opened from takes the first.
   Vitals list only the Vitals catalogue, in one section; a Custom Form row lists its own form
   (plus the computed expressions over it). Custom Column keeps its single choice (Text / Number /
   Date / Note) — it has no source. */
let pkMulti=null;    /* {rid, gid, type, form, cls:[…], cur, sel:Map(path→entry), have:Set(path)} */
function groupOf(rid){return GROUPS.find(g=>g.rows.some(r=>r.id===rid));}
function multiClasses(type){const t=rowType(type);if(!t)return [];return type==='vitals'?['Vitals']:t.cls.filter(c=>CAT[c]);}
function multiEntries(cls,type,form){
 const out=[];
 (CAT[cls]||[]).filter(cn=>!(cls==='Custom Form'&&form&&cn.c!==form)).forEach(cn=>cn.items.forEach(([nm,ty,subs])=>{
  if(cls==='Computed'&&type==='form'&&formOf(nm)!==form)return;            /* a form row: only expressions over its form */
  if(cls==='Computed'&&type!=='form'&&FORMS().includes(formOf(nm)))return;  /* other rows: none over a form */
  const p=`${cn.c} -> ${nm}`;out.push({cls,cont:cn.c,p,nm,ty,sub:false});
  (subs||[]).forEach(x=>out.push({cls,cont:cn.c,p:`${p} -> ${x[0]}`,nm:`${nm} ${x[0]}`,ty:x[1],sub:true}));}));
 return out;}
/* ---------------- Lab Observation display settings ----------------
   Stored on every lab observation row as r.lcfg = {res, dur, by, batch}. One bulk add = one batch:
   every observation added in that action gets the same settings (and the same batch id); a row
   added before keeps its own. Rows without lcfg use the defaults. The Flowsheet reads these to
   decide which results it shows (Display Results), over which window (Duration, from today) and
   on which date (Display By). */
const LOBS_RES=[['patient',"Patient's Lab Result"],['visit','Visit Lab Results']];
const LOBS_DUR=[['1m','One Month'],['2m','Two Month(s)'],['6m','Six Month(s)'],['1y','One Year'],['2y','Two Years'],['5y','Five Years']];
const LOBS_BY=[['collect','Collection Date'],['order','Order Date']];
const LOBS_DEFAULT={res:'visit',dur:'1y',by:'collect'};
const lobsName=(list,k)=>(list.find(x=>x[0]===k)||list[0])[1];
function lobsOf(r){return Object.assign({},LOBS_DEFAULT,r.lcfg||{});}
function isLabObs(r){return r.type==='lab'&&r.src==='Lab Order'&&!!r.path;}
function pkTab(t){
 const set=t==='set';
 document.getElementById('pkTabSrc').classList.toggle('on',!set);document.getElementById('pkTabSrc').setAttribute('aria-selected',String(!set));
 document.getElementById('pkTabSet').classList.toggle('on',set);document.getElementById('pkTabSet').setAttribute('aria-selected',String(set));
 document.getElementById('pkSet').hidden=!set;
 ['pkClasses','pkSearch','pkTree'].forEach(id=>{document.getElementById(id).style.display=set?'none':'';});
 document.querySelector('#pkModal .pkfoot').style.display=set?'none':'';
 if(set&&pkMulti){const n=pkMulti.sel.size;document.getElementById('pkSetNote').textContent=n
   ?`These settings apply to all ${n} lab observation${n===1?'':'s'} you are adding now — each one gets the same Display Results, Duration and Display By.`
   :'Choose lab observations on the Lab Observations tab; these settings apply to every one added with this action.';}
}
function pkLabTabs(on,g,r){
 document.getElementById('pkTabs').style.display=on?'':'none';pkTab('src');
 if(!on)return;
 /* start from the row's own saved settings; a new row starts from the group's most recent lab observations, else the defaults */
 const last=r&&isLabObs(r)?r:g&&[...g.rows].reverse().find(isLabObs),c=last?lobsOf(last):LOBS_DEFAULT;
 document.getElementById('lobsRes').value=c.res;document.getElementById('lobsDur').value=c.dur;document.getElementById('lobsBy').value=c.by;
}
function pkMultiMode(on,title){
 if(!on)pkLabTabs(false);
 document.getElementById('pkMultiApply').hidden=!on;
 const h=document.querySelector('#pkModal .mhead h3');if(h)h.textContent=on?title:'Bind row to a data source';
 document.getElementById('pkSearch').placeholder=on?'Search…':'Search containers, items and sublevels…';
}
function openMultiPicker(rid){
 const r=findRow(rid),g=groupOf(rid),t=r&&rowType(r.type);if(!r||!g||!t)return;
 const cls=multiClasses(r.type);if(!cls.length){fsToast('No sources are configured for '+t.l+'.');return;}
 pkMulti={rid,gid:g.id,type:r.type,form:r.type==='form'?r.form:'',cls,cur:cls[0],sel:new Map(),
  have:new Set(g.rows.filter(x=>x!==r&&x.path&&cls.includes(x.src)).map(x=>x.path)),own:''};
 if(r.path&&cls.includes(r.src)&&r.type!=='pdoc'){const e=cls.flatMap(c=>multiEntries(c,r.type,r.type==='form'?r.form:'')).find(x=>x.p===r.path&&x.cls===r.src);
  if(e){pkMulti.sel.set(e.p,e);pkMulti.own=e.p;}}            /* the row's current source starts checked — uncheck it to replace it */
 if(r.type==='pdoc'){            /* one Patient Documents row holds the categories it shows — reopening edits them */
  pkMulti.pdoc=true;pkMulti.have=new Set();
  const ents=multiEntries(cls[0],r.type,'');(r.cats||[]).forEach(c=>{const e=ents.find(x=>x.nm===c);if(e)pkMulti.sel.set(e.p,e);});
  if(!ents.length){pkMulti=null;fsToast('No document categories are available.');return;}}
 pkClass=cls[0];pkMultiMode(true,r.type==='vitals'?'Select vital signs':r.type==='pdoc'?'Select document categories':`Select ${t.l} sources`);
 pkLabTabs(r.type==='lab',g,r);
 if(r.type==='lab'){              /* the saved state Save is measured against — both tabs */
  pkMulti.lab=true;pkMulti.init={sel:[...pkMulti.sel.keys()].sort().join('\n'),...lobsNow()};
  if(!lobsWired){lobsWired=true;['lobsRes','lobsDur','lobsBy'].forEach(id=>document.getElementById(id).addEventListener('change',()=>{if(pkMulti&&pkMulti.lab)multiFoot();}));}}
 document.getElementById('pkFor').textContent=`into “${g.label}” · ${t.l}${pkMulti.form?' · '+pkMulti.form:''}`;
 document.getElementById('pkSearch').value='';renderMulti();
 document.getElementById('pkBack').classList.add('on');document.getElementById('pkModal').classList.add('on');
 setTimeout(()=>document.getElementById('pkSearch').focus(),0);
}
function multiChip(c){pkMulti.cur=c;pkClass=c;renderMulti();}
function renderMulti(){
 const m=pkMulti,q=(document.getElementById('pkSearch').value||'').toLowerCase();
 document.getElementById('pkClasses').innerHTML=(m.cls.length>1?m.cls.map(c=>`<button type="button" class="${c===m.cur?'on':''}" onclick="multiChip('${c}')">${c}</button>`).join(''):'')
  +`<span style="flex:1"></span><button type="button" onclick="multiSelAll(true)">Select all</button><button type="button" onclick="multiSelAll(false)">Clear</button>`;
 const all=multiEntries(m.cur,m.type,m.form),list=all.filter(e=>!q||e.nm.toLowerCase().includes(q)||e.p.toLowerCase().includes(q));
 const conts=[];list.forEach(e=>{if(conts.indexOf(e.cont)<0)conts.push(e.cont);});
 const head=c=>m.type==='vitals'?`Vital Signs <span class="hint" style="font-weight:400">${all.length} entries</span>`:`${rEsc(c)} <span class="hint" style="font-weight:400">${m.cur==='Custom Form'?'form':'container'}</span>`;
 const html=conts.map(c=>`<div class="tnode"><div class="tcont"><svg class="ic sm" viewBox="0 0 512 512"><path d="M64 480H448c35 0 64-29 64-64V160c0-35-29-64-64-64H288l-32-32c-12-12-28-20-45-20H64C29 44 0 73 0 108v308c0 35 29 64 64 64z"/></svg>${head(c)}</div>`
  +list.filter(e=>e.cont===c).map(e=>{const had=m.have.has(e.p),on=had||m.sel.has(e.p);
   return `<label class="titem multi${e.sub?' sub':''}${had?' had':''}"><input type="checkbox" ${on?'checked':''} ${had?'disabled':''} onchange="multiToggle('${e.p.replace(/'/g,"")}',this.checked)"/>
    <span class="lb">${rEsc(e.nm)}${had?' <span class="hint">· already in this group</span>':''}</span>${badge(e.ty)}<span class="pp">${rEsc(e.p)}</span></label>`;}).join('')+'</div>').join('');
 document.getElementById('pkTree').innerHTML=html||'<div style="padding:14px" class="hint">No matches.</div>';
 multiFoot();
}
let lobsWired=false;
function lobsNow(){return{res:document.getElementById('lobsRes').value,dur:document.getElementById('lobsDur').value,by:document.getElementById('lobsBy').value};}
/* lab observations: what differs from the saved state, across both tabs */
function labChanges(){const m=pkMulti,i=m.init,c=lobsNow();
 return{sel:[...m.sel.keys()].sort().join('\n')!==i.sel,set:c.res!==i.res||c.dur!==i.dur||c.by!==i.by};}
function multiFoot(){const m=pkMulti,n=m.sel.size,b=document.getElementById('pkMultiApply');
if(m.lab){const ch=labChanges(),d=ch.sel||ch.set;
 b.textContent='Save';b.disabled=!d||!n;
 b.title=!d?'No changes to save':!n?'Select at least one lab observation':'Save the selected observations and display settings';
 document.getElementById('pkCount').textContent=`${n} selected · ${m.have.size} already in this group`+(d?' · unsaved changes':'');return;}
 if(m.pdoc){b.disabled=false;b.textContent=n?`Save ${n} categor${n===1?'y':'ies'}`:'Save';document.getElementById('pkCount').textContent=`${n} document categor${n===1?'y':'ies'} selected`;return;}
 const own=m.own&&m.sel.has(m.own),k=n-(own?1:0);
 b.disabled=!n;b.textContent=!m.own?(n?`Add ${n} row${n===1?'':'s'}`:'Add rows'):(own?(k?`Add ${k} row${k===1?'':'s'}`:'Keep source'):(k?`Replace source${k>1?` + add ${k-1}`:''}`:'Apply'));
 document.getElementById('pkCount').textContent=`${n} selected · ${m.have.size} already in this group`;}
function multiToggle(p,on){const m=pkMulti;if(!m||m.have.has(p))return;
 if(on){const e=multiEntries(m.cur,m.type,m.form).find(x=>x.p===p);if(e)m.sel.set(p,e);}else m.sel.delete(p);
 multiFoot();}                                        /* no re-render: focus and scroll stay put */
function multiSelAll(on){const m=pkMulti;if(!m)return;
 multiEntries(m.cur,m.type,m.form).forEach(e=>{if(!m.have.has(e.p))on?m.sel.set(e.p,e):m.sel.delete(e.p);});renderMulti();}
function saveLabObs(){
 const m=pkMulti,ch=labChanges();if(!(ch.sel||ch.set)||!m.sel.size)return;
 const g=GROUPS.find(x=>x.id===m.gid),r=findRow(m.rid);
 if(!g||!r){fsToast('Could not save — the row is no longer in this flowsheet. Your selections are kept.');return;}
 const snap=JSON.stringify(g.rows);
 try{
  const c=lobsNow(),order=m.cls.flatMap(cl=>multiEntries(cl,m.type,m.form));
  /* never twice in the group */
  let picks=order.filter(e=>m.sel.has(e.p)&&!g.rows.some(x=>x!==r&&x.path===e.p&&x.src===e.cls));
  const kept=!!(m.own&&picks.some(e=>e.p===m.own));
  if(kept)picks=picks.filter(e=>e.p!==m.own);
  else if(m.own&&r.path){const old=r.path.split(' -> ').pop();r.path='';if(r.label===old||r.label===old.replace(/ -> /g,' '))r.label='';}
  /* the row's batch keeps sharing one set of settings; new observations join it */
  const batch=(r.lcfg&&r.lcfg.batch)||'b'+Date.now().toString(36)+Math.random().toString(36).slice(2,5);
  const lcfg={res:c.res,dur:c.dur,by:c.by,batch};
  g.rows.forEach(x=>{if(x===r||(isLabObs(x)&&x.lcfg&&x.lcfg.batch===batch))x.lcfg=Object.assign({},lcfg);});
  let at=g.rows.indexOf(r),made=0;
  picks.forEach(e=>{
   if(!r.path){r.path=e.p;r.it=e.ty;r.src=e.cls;r.invalid=false;if(!r.label)r.label=e.nm;r.lcfg=Object.assign({},lcfg);made++;return;}
   g.rows.splice(++at,0,{id:'r'+Math.random().toString(36).slice(2,7),label:e.nm,src:e.cls,path:e.p,it:e.ty,
    dt:NUMERIC.has(e.ty)?'Number':'Text',unit:'',prec:'',lo:'',hi:'',edit:true,invalid:false,type:m.type,form:m.form||'',lcfg:Object.assign({},lcfg)});made++;});
  if(!r.path)throw new Error('no source');
  g.open=true;renumber();renderGrid();dirty();
  closePicker();
  const n=g.rows.filter(x=>isLabObs(x)&&x.lcfg&&x.lcfg.batch===batch).length;
  fsToast(`Saved in “${g.label}”: ${made?`${made} observation${made===1?'':'s'} added · `:''}${n} observation${n===1?'':'s'} show ${lobsName(LOBS_RES,c.res)}, ${lobsName(LOBS_DUR,c.dur)} by ${lobsName(LOBS_BY,c.by)}.`);
 }catch(err){
  g.rows.splice(0,g.rows.length,...JSON.parse(snap));renderGrid();
  fsToast('Could not save — nothing was changed. Your selections and settings are kept.');
 }
}
function applyMulti(){
 const m=pkMulti;if(!m)return;
 if(m.pdoc){                     /* Patient Documents: the row keeps the chosen categories, in list order */
  const r=findRow(m.rid),g=GROUPS.find(x=>x.id===m.gid);if(!r||!g)return;
  const cats=multiEntries(m.cls[0],'pdoc','').filter(e=>m.sel.has(e.p)).map(e=>e.nm);
  r.cats=cats;r.src='Doc Category';r.it='doc';r.path=cats.length?'Document categories -> '+cats.join(', '):'';r.invalid=!cats.length;
  if(!r.label)r.label='Patient Documents';
  closePicker();renumber();renderGrid();dirty();
  fsToast(cats.length?`“${r.label}” shows documents of this visit in: ${cats.join(', ')}.`:'No document category selected — the row needs at least one.');
  return;}
 if(m.lab){saveLabObs();return;}
 if(!m.sel.size)return;
 const g=GROUPS.find(x=>x.id===m.gid),r=findRow(m.rid);if(!g||!r)return;
 /* in list order (class, container, item), never twice in the group */
 const order=m.cls.flatMap(c=>multiEntries(c,m.type,m.form));
 let picks=order.filter(e=>m.sel.has(e.p)&&!g.rows.some(x=>x!==r&&x.path===e.p&&x.src===e.cls));
 let at=g.rows.indexOf(r),made=0,kept=false;
 if(m.own&&picks.some(e=>e.p===m.own)){picks=picks.filter(e=>e.p!==m.own);kept=true;}          /* the row keeps its source */
 else if(m.own&&r.path){const old=r.path.split(' -> ').pop();r.path='';if(r.label===old||r.label===old.replace(/ -> /g,' '))r.label='';}   /* replaced: the row takes the first new pick */
 /* lab observations: one shared set of display settings for the whole batch */
 const lcfg=m.type==='lab'?{res:document.getElementById('lobsRes').value,dur:document.getElementById('lobsDur').value,by:document.getElementById('lobsBy').value,
   batch:'b'+Date.now().toString(36)+Math.random().toString(36).slice(2,5)}:null;
 picks.forEach((e,i)=>{
  if(i===0&&!r.path){r.path=e.p;r.it=e.ty;r.src=e.cls;r.invalid=false;if(!r.label)r.label=e.nm;if(lcfg)r.lcfg=Object.assign({},lcfg);made++;return;}
  if(!picks.length)return;
  const nr={id:'r'+Math.random().toString(36).slice(2,7),label:e.nm,src:e.cls,path:e.p,it:e.ty,
   dt:NUMERIC.has(e.ty)?'Number':'Text',unit:'',prec:'',lo:'',hi:'',edit:true,invalid:false,type:m.type,form:m.form||''};
  if(lcfg)nr.lcfg=Object.assign({},lcfg);
  g.rows.splice(++at,0,nr);made++;
 });
 const gname=g.label,tl=rowType(m.type).l;closePicker();g.open=true;renumber();renderGrid();dirty();
